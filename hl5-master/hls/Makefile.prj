sched_memwb_PIPE_SOFT2 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/stratus_hls.bdr

