	@rm -f $(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/execute_rtl.cpp $(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/stratus_hls.bdr
	@rm -f $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/memwb_rtl.cpp $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/stratus_hls.bdr
	@rm -f $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/hl5_rtl.cpp $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/stratus_hls.bdr


