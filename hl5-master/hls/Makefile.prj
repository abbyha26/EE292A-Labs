hlsc_memwb_RADIX_2_% hls_memwb_RADIX_2_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /RADIX_2/,/RADIX_2_$(*F)/,$(BDW_WORKLIB)/modules/memwb/RADIX_2/memwb_rtl.cpp) BDW_DEP_CYNTH_CONFIG=RADIX_2 BDW_MODULE=memwb BDW_HLS_CONFIG=RADIX_2_$(*F) 
