debug_BASIC_div_10_V_%: 
	@$(MAKE) BDW_DEBUG=1 build_BASIC_div_10_V_$(*F)
	@$(MAKE) run_sim BDW_DEBUG=1 BDW_SIM_CONFIG=BASIC_div_10_V_$(*F)  BDW_BASE_SIM_CONFIG=BASIC_div_10_V BDW_SPEC_NAME=$(*F) RUN_DEBUGGER=1
    
ifeq ($(CWBExec_view),1)
view_BASIC_div_10_V_%:
	@if [ -e $(subst /BASIC_div_10_V/,/BASIC_div_10_V_$(*F)/,$(BDW_WORKLIB)/sims/BASIC_div_10_V/BASIC_div_10_V.shm) ]; then \
	bdw_view_waveform -project project.tcl -simconfig BASIC_div_10_V_$(*F) ;\
	else   \
	$(MAKE) sim_BASIC_div_10_V_$(*F) ;\
	bdw_view_waveform -project project.tcl -simconfig BASIC_div_10_V_$(*F) ;\
    fi
else
view_BASIC_div_10_V_%:
	@bdw_exec -jobproject project.tcl -job view.BASIC_div_10_V_$(*F) $(MAKE) CWBExec_view=1 view_BASIC_div_10_V_$(*F)
endif
    



clean_BASIC_div_10_V_%: clean_hls_BASIC_div_10_V_% clean_sim_BASIC_div_10_V_%

clean_sim_BASIC_div_10_V_%:
	@rm -rf $(BDW_WORKLIB)/jobs/sim.BASIC_div_10_V_$(*F).s
	@rm -rf $(BDW_WORKLIB)/jobs/sim.BASIC_div_10_V_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/build.BASIC_div_10_V_$(*F)
	@rm -f $(BDW_WORKLIB)/modules/hl5/BASIC/xcelium/hl5_rtl.o $(BDW_WORKLIB)/modules/fedec/BASIC/xcelium/fedec_rtl.o $(BDW_WORKLIB)/modules/execute/BASIC/xcelium/execute_rtl.o $(BDW_WORKLIB)/modules/memwb/BASIC/xcelium/memwb_rtl.o
	@rm -rf $(BDW_WORKLIB)/sims/BASIC_div_10_V_$(*F) $(subst .v,_$(*F).v,$(BDW_WORKLIB)/sims/top_BASIC_div_10_V.v) $(BDW_WORKLIB)/sims/BASIC_div_10_V/xcelium/sim_BASIC_div_10_V.so
	@$(MAKE) clean_sim_objs BDW_SIM_CONFIG=BASIC_div_10_V_$(*F)  BDW_BASE_SIM_CONFIG=BASIC_div_10_V BDW_SPEC_NAME=$(*F)



$(BDW_WORKLIB)/sims/top_BASIC_div_10_V.v : top_v.bdt $(BDW_LOGOPTIONS_FILE)   $(BDW_VLOG_DUT_FILES)
	@if [ ! -d $(BDW_WRAPDIR) ]; then mkdir -p $(BDW_WRAPDIR); fi
	$(BDW_WRAPGEN_COMMAND) -project project.tcl -simconfig BASIC_div_10_V -top top

$(subst .v,_%.v,$(BDW_WORKLIB)/sims/top_BASIC_div_10_V.v) : top_v.bdt $(BDW_LOGOPTIONS_FILE)  
	@$(MAKE) `$(BDW_SPEC_FILTER) project.db $(*F) $(BDW_VLOG_DUT_FILES)`
	@if [ ! -d $(BDW_WRAPDIR) ]; then mkdir -p $(BDW_WRAPDIR); fi
	$(BDW_WRAPGEN_COMMAND) -project project.tcl -simconfig BASIC_div_10_V_$(*F) -top top




