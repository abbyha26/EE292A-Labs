build_DPA_aes256_GP_%:
	@bdw_exec -jobproject project.tcl -job build.DPA_aes256_GP_$(*F) $(MAKE) CWBExec_build=1 build_DPA_aes256_GP_$(*F)

build_DPA_aes256_GP_sub_%:
	@bdw_exec -jobproject project.tcl -job build.DPA_aes256_GP_$(*F).s $(MAKE) CWBExec_build=1 build_DPA_aes256_GP_sub_$(*F)
endif


ifeq ($(CWBExec_sim),1)
sim_DPA_aes256_GP_% sim_sub_DPA_aes256_GP_%: build_DPA_aes256_GP_sub_%
	@$(MAKE) run_sim BDW_SIM_CONFIG=DPA_aes256_GP_$(*F)  BDW_BASE_SIM_CONFIG=DPA_aes256_GP BDW_SPEC_NAME=$(*F) 

sim_only_DPA_aes256_GP_%:
