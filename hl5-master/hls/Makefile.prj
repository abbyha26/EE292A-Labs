view_hl5_RADIX_4:
	@echo "ERROR: Schematic viewing target 'view_hl5_RADIX_4' is only supported with 'verdi'"
	@echo "The Stratus IDE includes a schematic view as an alternative."


#
#	RTL object file rule
#
$(BDW_WORKLIB)/modules/hl5/RADIX_4/xcelium/hl5_rtl.o : $(BDW_WORKLIB)/modules/hl5/RADIX_4/hl5_rtl.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(BDW_WORKLIB)/modules/hl5/RADIX_4/hl5_trace.h
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl hl5`
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/RADIX_4/ -I./ $(CCFLAGS_hl5_RADIX_4) $(EXTRACT_LIB_DASHI_hl5_RADIX_4) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/hl5/RADIX_4/xcelium/hl5_rtl.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp

$(BDW_WORKLIB)/modules/hl5/RADIX_4/xcelium/debug/hl5_rtl.o : $(BDW_WORKLIB)/modules/hl5/RADIX_4/hl5_rtl.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(BDW_WORKLIB)/modules/hl5/RADIX_4/hl5_trace.h
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl hl5`
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/RADIX_4/ -I./ $(CCFLAGS_hl5_RADIX_4) $(EXTRACT_LIB_DASHI_hl5_RADIX_4) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/hl5/RADIX_4/xcelium/debug/hl5_rtl.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp

#
