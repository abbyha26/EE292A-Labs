sched_execute_BASIC_POFF_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(subst /BASIC_POFF/,/BASIC_POFF_$(*F)/,$(BDW_WORKLIB)/modules/execute/BASIC_POFF/stratus_hls.bdr)

hlsc_execute_BASIC_POFF_% hls_execute_BASIC_POFF_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /BASIC_POFF/,/BASIC_POFF_$(*F)/,$(BDW_WORKLIB)/modules/execute/BASIC_POFF/execute_rtl.cpp) BDW_DEP_CYNTH_CONFIG=BASIC_POFF BDW_MODULE=execute BDW_HLS_CONFIG=BASIC_POFF_$(*F) 
else
	@bdw_exec -jobproject project.tcl -job hls.execute.BASIC_POFF_$(*F) $(MAKE) CWBExec_hls=1 hlsc_execute_BASIC_POFF_$(*F)
endif

clean_cynth_execute_BASIC_POFF_%: clean_hls_execute_BASIC_POFF_%

clean_execute_BASIC_POFF_%: clean_hls_execute_BASIC_POFF_%

clean_hls_execute_BASIC_POFF_%:
	@rm -rf $(BDW_WORKLIB)/modules/execute/BASIC_POFF_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.execute.BASIC_POFF_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.execute.BASIC_POFF_$(*F).s

kill_hls_execute_BASIC_POFF_%:
	@bdw_kill -job hls.execute.BASIC_POFF_$(*F)
	@bdw_kill -job hls.execute.BASIC_POFF_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),BASIC_POFF)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/execute/BASIC_POFF/execute.d
                -include $(memlib_WORKLIB)/memlib.d
                BDW_LIB_DEPS =  $(memlib_DEPS)
            endif
        endif
    endif
endif


html_execute_BASIC_POFF :
	bdw_htmlgen -project project.tcl -module execute -cynthconfig BASIC_POFF

BDW_execute_BASIC_POFF_HLS_TARGETS := $(BDW_WORKLIB)/modules/execute/BASIC_POFF/execute_rtl.cpp $(BDW_WORKLIB)/modules/execute/BASIC_POFF/execute_rtl.v $(BDW_WORKLIB)/modules/execute/BASIC_POFF/stratus_hls.bdr
ifeq ($(BDW_BDR_ONLY),1)
.PHONY: $(filter %.bdr %.cpp,$(BDW_execute_BASIC_POFF_HLS_TARGETS))
$(filter %.v %.cpp,$(BDW_execute_BASIC_POFF_HLS_TARGETS)) : $(filter %.bdr,$(BDW_execute_BASIC_POFF_HLS_TARGETS))
BDW_execute_BASIC_POFF_HLS_TARGETS := $(filter %.bdr,$(BDW_execute_BASIC_POFF_HLS_TARGETS))
endif
BDW_execute_BASIC_POFF_HLS_SPEC_TARGETS = $(subst /BASIC_POFF/,/BASIC_POFF_%/,$(BDW_execute_BASIC_POFF_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_execute_BASIC_POFF_HLS_TARGETS) :  ../src/execute.cpp   $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/execute/BASIC_POFF ]; then mkdir -p $(BDW_WORKLIB)/modules/execute/BASIC_POFF; fi
	
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=BASIC_POFF BDW_CYNTH_CONFIG=BASIC_POFF \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/execute/BASIC_POFF/execute_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/execute/BASIC_POFF/execute_rtl.cpp \
		BDW_MODULE=execute \
		BDW_CYNTH_CONFIG=BASIC_POFF \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/execute/BASIC_POFF \
		BDW_HLS_CONFIG=BASIC_POFF \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/execute/BASIC_POFF \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_execute_BASIC_POFF)  \
		-d $(BDW_WORKLIB)/modules/execute/BASIC_POFF -o execute_rtl.cpp \
		--hls_module=execute --hls_config=BASIC_POFF --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_execute_BASIC_POFF))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_execute_BASIC_POFF))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_execute_BASIC_POFF))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_execute_BASIC_POFF)   \
		 ../src/execute.cpp
	
	
	
	

else

$(BDW_execute_BASIC_POFF_HLS_TARGETS) :  ../src/execute.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.execute.BASIC_POFF.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_execute_BASIC_POFF_HLS_TARGETS)

endif

	
$(BDW_WORKLIB)/modules/execute/BASIC_POFF/execute_trace.h : $(BDW_WORKLIB)/modules/execute/BASIC_POFF/execute_trace.h.updated

$(BDW_WORKLIB)/modules/execute/BASIC_POFF/execute_trace.h.updated : $(BDW_WORKLIB)/modules/execute/BASIC_POFF/execute_rtl.cpp $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module execute -cynthconfig BASIC_POFF  
	@touch $(BDW_WORKLIB)/modules/execute/BASIC_POFF/execute_trace.h.updated

ifeq ($(CWBExec_hlsc),1)

$(BDW_execute_BASIC_POFF_HLS_SPEC_TARGETS) :  ../src/execute.cpp   $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/execute/BASIC_POFF_$(*F) ]; then mkdir -p $(BDW_WORKLIB)/modules/execute/BASIC_POFF_$(*F); fi
	
	
	$(subst /BASIC_POFF ,/BASIC_POFF_$(*F) ,$(subst =BASIC_POFF ,=BASIC_POFF_$(*F) ,$(subst /execute/BASIC_POFF/,/execute/BASIC_POFF_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=BASIC_POFF BDW_CYNTH_CONFIG=BASIC_POFF \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/execute/BASIC_POFF/execute_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/execute/BASIC_POFF/execute_rtl.cpp \
		BDW_MODULE=execute \
		BDW_CYNTH_CONFIG=BASIC_POFF \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/execute/BASIC_POFF \
		BDW_HLS_CONFIG=BASIC_POFF \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/execute/BASIC_POFF \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_execute_BASIC_POFF)  \
		`cat  $(BDW_SPECLIB)/execute/BASIC_POFF.$(*F).bds | grep '^cmdline:' | sed 's/^cmdline://'`\
		-d $(BDW_WORKLIB)/modules/execute/BASIC_POFF -o execute_rtl.cpp \
		--hls_module=execute --hls_config=BASIC_POFF --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_execute_BASIC_POFF))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_execute_BASIC_POFF))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_execute_BASIC_POFF))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_execute_BASIC_POFF)   \
		 ../src/execute.cpp)))
	
	
	
	

else

$(BDW_execute_BASIC_POFF_HLS_SPEC_TARGETS) :  ../src/execute.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.execute.BASIC_POFF_$(*F).s $(MAKE) -j1 CWBExec_hlsc=1 $(subst %,$(*F),$(BDW_execute_BASIC_POFF_HLS_SPEC_TARGETS))

endif

	

$(subst /BASIC_POFF/,/BASIC_POFF_%/,$(BDW_WORKLIB)/modules/execute/BASIC_POFF/execute_trace.h) : $(subst /BASIC_POFF/,/BASIC_POFF_%/,$(BDW_WORKLIB)/modules/execute/BASIC_POFF/execute_rtl.cpp) $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module execute -cynthconfig BASIC_POFF_$(*F)  

