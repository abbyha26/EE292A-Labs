	bdw_htmlgen -project project.tcl -module execute -cynthconfig BASIC

BDW_execute_BASIC_HLS_TARGETS := $(BDW_WORKLIB)/modules/execute/BASIC/execute_rtl.cpp $(BDW_WORKLIB)/modules/execute/BASIC/execute_rtl.v $(BDW_WORKLIB)/modules/execute/BASIC/stratus_hls.bdr
ifeq ($(BDW_BDR_ONLY),1)
.PHONY: $(filter %.bdr %.cpp,$(BDW_execute_BASIC_HLS_TARGETS))
$(filter %.v %.cpp,$(BDW_execute_BASIC_HLS_TARGETS)) : $(filter %.bdr,$(BDW_execute_BASIC_HLS_TARGETS))
BDW_execute_BASIC_HLS_TARGETS := $(filter %.bdr,$(BDW_execute_BASIC_HLS_TARGETS))
endif
BDW_execute_BASIC_HLS_SPEC_TARGETS = $(subst /BASIC/,/BASIC_%/,$(BDW_execute_BASIC_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_execute_BASIC_HLS_TARGETS) :  ../src/execute.cpp   $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/execute/BASIC ]; then mkdir -p $(BDW_WORKLIB)/modules/execute/BASIC; fi
	
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=BASIC BDW_CYNTH_CONFIG=BASIC \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/execute/BASIC/execute_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/execute/BASIC/execute_rtl.cpp \
		BDW_MODULE=execute \
		BDW_CYNTH_CONFIG=BASIC \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/execute/BASIC \
		BDW_HLS_CONFIG=BASIC \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/execute/BASIC \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_execute_BASIC)  \
		-d $(BDW_WORKLIB)/modules/execute/BASIC -o execute_rtl.cpp \
		--hls_module=execute --hls_config=BASIC --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_execute_BASIC))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_execute_BASIC))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_execute_BASIC))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_execute_BASIC)   \
		 ../src/execute.cpp
	
	
	
	

else

$(BDW_execute_BASIC_HLS_TARGETS) :  ../src/execute.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.execute.BASIC.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_execute_BASIC_HLS_TARGETS)

endif

	
$(BDW_WORKLIB)/modules/execute/BASIC/execute_trace.h : $(BDW_WORKLIB)/modules/execute/BASIC/execute_trace.h.updated

$(BDW_WORKLIB)/modules/execute/BASIC/execute_trace.h.updated : $(BDW_WORKLIB)/modules/execute/BASIC/execute_rtl.cpp $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module execute -cynthconfig BASIC  
	@touch $(BDW_WORKLIB)/modules/execute/BASIC/execute_trace.h.updated

ifeq ($(CWBExec_hlsc),1)

$(BDW_execute_BASIC_HLS_SPEC_TARGETS) :  ../src/execute.cpp   $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/execute/BASIC_$(*F) ]; then mkdir -p $(BDW_WORKLIB)/modules/execute/BASIC_$(*F); fi
	
	
	$(subst /BASIC ,/BASIC_$(*F) ,$(subst =BASIC ,=BASIC_$(*F) ,$(subst /execute/BASIC/,/execute/BASIC_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=BASIC BDW_CYNTH_CONFIG=BASIC \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/execute/BASIC/execute_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/execute/BASIC/execute_rtl.cpp \
		BDW_MODULE=execute \
		BDW_CYNTH_CONFIG=BASIC \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/execute/BASIC \
		BDW_HLS_CONFIG=BASIC \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/execute/BASIC \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_execute_BASIC)  \
		`cat  $(BDW_SPECLIB)/execute/BASIC.$(*F).bds | grep '^cmdline:' | sed 's/^cmdline://'`\
		-d $(BDW_WORKLIB)/modules/execute/BASIC -o execute_rtl.cpp \
		--hls_module=execute --hls_config=BASIC --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_execute_BASIC))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_execute_BASIC))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_execute_BASIC))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_execute_BASIC)   \
		 ../src/execute.cpp)))
	
	
	
	

else

$(BDW_execute_BASIC_HLS_SPEC_TARGETS) :  ../src/execute.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.execute.BASIC_$(*F).s $(MAKE) -j1 CWBExec_hlsc=1 $(subst %,$(*F),$(BDW_execute_BASIC_HLS_SPEC_TARGETS))

endif

	

