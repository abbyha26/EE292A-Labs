view_memwb_PIPE_SOFT2:
	@echo "ERROR: Schematic viewing target 'view_memwb_PIPE_SOFT2' is only supported with 'verdi'"
	@echo "The Stratus IDE includes a schematic view as an alternative."


#
#	RTL object file rule
#
$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/xcelium/memwb_rtl.o : $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/memwb_rtl.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/memwb_trace.h
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl memwb`
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/ -I./ $(CCFLAGS_memwb_PIPE_SOFT2) $(EXTRACT_LIB_DASHI_memwb_PIPE_SOFT2) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/xcelium/memwb_rtl.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp

$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/xcelium/debug/memwb_rtl.o : $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/memwb_rtl.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/memwb_trace.h
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl memwb`
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/ -I./ $(CCFLAGS_memwb_PIPE_SOFT2) $(EXTRACT_LIB_DASHI_memwb_PIPE_SOFT2) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/xcelium/debug/memwb_rtl.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp

#
#	Behavioral object file rule.  Used only for BEH configs that are 
#	associated with HLS config names.
#

$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/xcelium/memwb_beh.o :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(BDW_WORKLIB)/wrappers/memwb_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/ -I./ $(CCFLAGS_BEH_memwb_PIPE_SOFT2) -o $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/xcelium/memwb_beh.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp

$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/xcelium/debug/memwb_beh.o :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(BDW_WORKLIB)/wrappers/memwb_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/ -I./ $(CCFLAGS_BEH_memwb_PIPE_SOFT2) -o $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/xcelium/debug/memwb_beh.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp

#
