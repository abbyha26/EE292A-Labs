prebuild_DPA_aes256_V: bdw_prebuild_wrappers  
	$(MAKE) -j1  hls_fedec_DPA hls_execute_DPA hls_memwb_DPA 
	$(MAKE) -j1  hls_hl5_DPA

prep_DPA_aes256_V: prebuild_DPA_aes256_V
	@$(MAKE) sim_DPA_aes256_V BDW_XRUN_ELAB=-elaborate

ifeq ($(CWBExec_build),1)

dbg_build_DPA_aes256_V:
	@if [ ! -e systemc ] ; then ln -s $(STRATUS_HOME)/tools.lnx86/stratus/systemc ; fi
	@$(MAKE) siminfo BDW_SIM_CONFIG=DPA_aes256_V
	@$(MAKE) BDW_DEBUG=1 build_DPA_aes256_V


build_DPA_aes256_V build_DPA_aes256_V_sub: bdw_prebuild_wrappers  
	$(MAKE) -j1 CWBExec_hls=1  hls_fedec_DPA hls_execute_DPA hls_memwb_DPA 
	$(MAKE) -j1 CWBExec_hls=1  hls_hl5_DPA
	@$(MAKE) siminfo BDW_SIM_CONFIG=DPA_aes256_V
	@$(BDW_EXEC_CMD) $(MAKE) $(BDW_PMAKE_FLG) build_sim_image BDW_SIM_CONFIG=DPA_aes256_V BDW_GENDEPS=1 BDW_BASE_SIM_CONFIG=DPA_aes256_V BDW_SPEC_NAME=

build_only_DPA_aes256_V:
	@$(MAKE) siminfo BDW_SIM_CONFIG=DPA_aes256_V
	@$(BDW_EXEC_CMD) $(MAKE) $(BDW_PMAKE_FLG) build_sim_image BDW_SIM_CONFIG=DPA_aes256_V BDW_GENDEPS=1 BDW_BASE_SIM_CONFIG=DPA_aes256_V BDW_SPEC_NAME=

else
.PHONY: build_DPA_aes256_V
.PHONY: dbg_build_DPA_aes256_V

dbg_build_DPA_aes256_V:
	@bdw_exec -jobproject project.tcl -job dbg_build.DPA_aes256_V $(MAKE) CWBExec_build=1 dbg_build_DPA_aes256_V

build_DPA_aes256_V:
	@bdw_exec -jobproject project.tcl -job build.DPA_aes256_V $(MAKE) CWBExec_build=1 build_DPA_aes256_V

build_DPA_aes256_V_sub:
	@bdw_exec -jobproject project.tcl -job build.DPA_aes256_V.s $(MAKE) CWBExec_build=1 build_DPA_aes256_V_sub
endif


ifeq ($(CWBExec_sim),1)
sim_DPA_aes256_V sim_sub_DPA_aes256_V: build_DPA_aes256_V_sub
	@$(MAKE) run_sim BDW_SIM_CONFIG=DPA_aes256_V  BDW_BASE_SIM_CONFIG=DPA_aes256_V BDW_SPEC_NAME= 

sim_only_DPA_aes256_V:
	@$(MAKE) run_sim BDW_SIM_CONFIG=DPA_aes256_V  BDW_BASE_SIM_CONFIG=DPA_aes256_V BDW_SPEC_NAME= 

else
.PHONY: sim_DPA_aes256_V

sim_DPA_aes256_V:
	@bdw_exec -jobproject project.tcl -job sim.DPA_aes256_V $(BDW_LAUNCH_SIM_COMMAND) $(MAKE) CWBExec_sim=1 sim_DPA_aes256_V

sim_sub_DPA_aes256_V:
	@bdw_exec -jobproject project.tcl -job sim_sub.DPA_aes256_V.s $(BDW_LAUNCH_SIM_COMMAND) $(MAKE) CWBExec_sim=1 sim_sub_DPA_aes256_V
endif


kill_sim_DPA_aes256_V:
	@bdw_kill -job sim.DPA_aes256_V
	@bdw_kill -job sim.DPA_aes256_V.s


catlog_DPA_aes256_V: catVLGLog_fedec_DPA catVLGLog_execute_DPA catVLGLog_memwb_DPA catVLGLog_hl5_DPA
debug_DPA_aes256_V: 
	@$(MAKE) BDW_DEBUG=1 build_DPA_aes256_V
	@$(MAKE) run_sim BDW_DEBUG=1 BDW_SIM_CONFIG=DPA_aes256_V  BDW_BASE_SIM_CONFIG=DPA_aes256_V BDW_SPEC_NAME= RUN_DEBUGGER=1
    
ifeq ($(CWBExec_view),1)
view_DPA_aes256_V:
	@if [ -e $(BDW_WORKLIB)/sims/DPA_aes256_V/DPA_aes256_V.shm ]; then \
	bdw_view_waveform -project project.tcl -simconfig DPA_aes256_V ;\
	else   \
	$(MAKE) sim_DPA_aes256_V ;\
	bdw_view_waveform -project project.tcl -simconfig DPA_aes256_V ;\
    fi
else
view_DPA_aes256_V:
	@bdw_exec -jobproject project.tcl -job view.DPA_aes256_V $(MAKE) CWBExec_view=1 view_DPA_aes256_V
endif
    



clean_DPA_aes256_V: clean_hls_DPA_aes256_V clean_sim_DPA_aes256_V

clean_sim_DPA_aes256_V:
	@rm -rf $(BDW_WORKLIB)/jobs/sim.DPA_aes256_V.s
	@rm -rf $(BDW_WORKLIB)/jobs/sim.DPA_aes256_V
	@rm -rf $(BDW_WORKLIB)/jobs/build.DPA_aes256_V
	@rm -f $(BDW_WORKLIB)/modules/hl5/DPA/xcelium/hl5_rtl.o $(BDW_WORKLIB)/modules/fedec/DPA/xcelium/fedec_rtl.o $(BDW_WORKLIB)/modules/execute/DPA/xcelium/execute_rtl.o $(BDW_WORKLIB)/modules/memwb/DPA/xcelium/memwb_rtl.o
	@rm -rf $(BDW_WORKLIB)/sims/DPA_aes256_V $(subst .v,.v,$(BDW_WORKLIB)/sims/top_DPA_aes256_V.v) $(BDW_WORKLIB)/sims/DPA_aes256_V/xcelium/sim_DPA_aes256_V.so
	@$(MAKE) clean_sim_objs BDW_SIM_CONFIG=DPA_aes256_V  BDW_BASE_SIM_CONFIG=DPA_aes256_V BDW_SPEC_NAME=



