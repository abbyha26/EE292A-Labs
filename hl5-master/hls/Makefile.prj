	$(MAKE) -j1 `$(BDW_SPEC_FILTER) project.db $(*F)  hls_hl5_DPA`

prep_DPA_aes256_10_GP_%: prebuild_DPA_aes256_10_GP_%
	@$(MAKE) sim_DPA_aes256_10_GP_$(*F) BDW_XRUN_ELAB=-elaborate

ifeq ($(CWBExec_build),1)

dbg_build_DPA_aes256_10_GP_%:
	@if [ ! -e systemc ] ; then ln -s $(STRATUS_HOME)/tools.lnx86/stratus/systemc ; fi
	@$(MAKE) siminfo BDW_SIM_CONFIG=DPA_aes256_10_GP_$(*F)
	@$(MAKE) BDW_DEBUG=1 build_DPA_aes256_10_GP_$(*F)


build_DPA_aes256_10_GP_% build_DPA_aes256_10_GP_sub_%: bdw_prebuild_wrappers  
	$(MAKE) -j1 CWBExec_hls=1 `$(BDW_SPEC_FILTER) project.db $(*F)  hls_fedec_DPA hls_execute_DPA hls_memwb_DPA` 
	$(MAKE) -j1 CWBExec_hls=1 `$(BDW_SPEC_FILTER) project.db $(*F)  hls_hl5_DPA`
	@$(MAKE) siminfo BDW_SIM_CONFIG=DPA_aes256_10_GP_$(*F)
	@$(BDW_EXEC_CMD) $(MAKE) $(BDW_PMAKE_FLG) build_sim_image BDW_SIM_CONFIG=DPA_aes256_10_GP_$(*F) BDW_GENDEPS=1 BDW_BASE_SIM_CONFIG=DPA_aes256_10_GP BDW_SPEC_NAME=$(*F)

build_only_DPA_aes256_10_GP_%:
	@$(MAKE) siminfo BDW_SIM_CONFIG=DPA_aes256_10_GP_$(*F)
	@$(BDW_EXEC_CMD) $(MAKE) $(BDW_PMAKE_FLG) build_sim_image BDW_SIM_CONFIG=DPA_aes256_10_GP_$(*F) BDW_GENDEPS=1 BDW_BASE_SIM_CONFIG=DPA_aes256_10_GP BDW_SPEC_NAME=$(*F)

else
.PHONY: build_DPA_aes256_10_GP
.PHONY: dbg_build_DPA_aes256_10_GP

dbg_build_DPA_aes256_10_GP_%:
	@bdw_exec -jobproject project.tcl -job dbg_build.DPA_aes256_10_GP_$(*F) $(MAKE) CWBExec_build=1 dbg_build_DPA_aes256_10_GP_$(*F)

build_DPA_aes256_10_GP_%:
	@bdw_exec -jobproject project.tcl -job build.DPA_aes256_10_GP_$(*F) $(MAKE) CWBExec_build=1 build_DPA_aes256_10_GP_$(*F)

build_DPA_aes256_10_GP_sub_%:
	@bdw_exec -jobproject project.tcl -job build.DPA_aes256_10_GP_$(*F).s $(MAKE) CWBExec_build=1 build_DPA_aes256_10_GP_sub_$(*F)
endif


ifeq ($(CWBExec_sim),1)
sim_DPA_aes256_10_GP_% sim_sub_DPA_aes256_10_GP_%: build_DPA_aes256_10_GP_sub_%
	@$(MAKE) run_sim BDW_SIM_CONFIG=DPA_aes256_10_GP_$(*F)  BDW_BASE_SIM_CONFIG=DPA_aes256_10_GP BDW_SPEC_NAME=$(*F) 

sim_only_DPA_aes256_10_GP_%:
	@$(MAKE) run_sim BDW_SIM_CONFIG=DPA_aes256_10_GP_$(*F)  BDW_BASE_SIM_CONFIG=DPA_aes256_10_GP BDW_SPEC_NAME=$(*F) 

else
.PHONY: sim_DPA_aes256_10_GP_%

sim_DPA_aes256_10_GP_%:
	@bdw_exec -jobproject project.tcl -job sim.DPA_aes256_10_GP_$(*F) $(BDW_LAUNCH_SIM_COMMAND) $(MAKE) CWBExec_sim=1 sim_DPA_aes256_10_GP_$(*F)

sim_sub_DPA_aes256_10_GP_%:
	@bdw_exec -jobproject project.tcl -job sim_sub.DPA_aes256_10_GP_$(*F).s $(BDW_LAUNCH_SIM_COMMAND) $(MAKE) CWBExec_sim=1 sim_sub_DPA_aes256_10_GP_$(*F)
endif


kill_sim_DPA_aes256_10_GP_%:
	@bdw_kill -job sim.DPA_aes256_10_GP_$(*F)
	@bdw_kill -job sim.DPA_aes256_10_GP_$(*F).s


catlog_DPA_aes256_10_GP_%: catVLGLog_fedec_DPA catVLGLog_execute_DPA catVLGLog_memwb_DPA catVLGLog_hl5_DPA
debug_DPA_aes256_10_GP_%: 
	@$(MAKE) BDW_DEBUG=1 build_DPA_aes256_10_GP_$(*F)
	@$(MAKE) run_sim BDW_DEBUG=1 BDW_SIM_CONFIG=DPA_aes256_10_GP_$(*F)  BDW_BASE_SIM_CONFIG=DPA_aes256_10_GP BDW_SPEC_NAME=$(*F) RUN_DEBUGGER=1
    
ifeq ($(CWBExec_view),1)
view_DPA_aes256_10_GP_%:
	@if [ -e $(subst /DPA_aes256_10_GP/,/DPA_aes256_10_GP_$(*F)/,$(BDW_WORKLIB)/sims/DPA_aes256_10_GP/DPA_aes256_10_GP.shm) ]; then \
	bdw_view_waveform -project project.tcl -simconfig DPA_aes256_10_GP_$(*F) ;\
	else   \
	$(MAKE) sim_DPA_aes256_10_GP_$(*F) ;\
	bdw_view_waveform -project project.tcl -simconfig DPA_aes256_10_GP_$(*F) ;\
    fi
else
view_DPA_aes256_10_GP_%:
	@bdw_exec -jobproject project.tcl -job view.DPA_aes256_10_GP_$(*F) $(MAKE) CWBExec_view=1 view_DPA_aes256_10_GP_$(*F)
endif
    



clean_DPA_aes256_10_GP_%: clean_hls_DPA_aes256_10_GP_% clean_sim_DPA_aes256_10_GP_%

clean_sim_DPA_aes256_10_GP_%:
	@rm -rf $(BDW_WORKLIB)/jobs/sim.DPA_aes256_10_GP_$(*F).s
	@rm -rf $(BDW_WORKLIB)/jobs/sim.DPA_aes256_10_GP_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/build.DPA_aes256_10_GP_$(*F)
	@rm -f $(BDW_WORKLIB)/modules/hl5/DPA/xcelium/hl5_rtl.o $(BDW_WORKLIB)/modules/fedec/DPA/xcelium/fedec_rtl.o $(BDW_WORKLIB)/modules/execute/DPA/xcelium/execute_rtl.o $(BDW_WORKLIB)/modules/memwb/DPA/xcelium/memwb_rtl.o
	@rm -rf $(BDW_WORKLIB)/sims/DPA_aes256_10_GP_$(*F) $(subst .v,_$(*F).v,$(BDW_WORKLIB)/sims/top_DPA_aes256_10_GP.v) $(BDW_WORKLIB)/sims/DPA_aes256_10_GP/xcelium/sim_DPA_aes256_10_GP.so
	@$(MAKE) clean_sim_objs BDW_SIM_CONFIG=DPA_aes256_10_GP_$(*F)  BDW_BASE_SIM_CONFIG=DPA_aes256_10_GP BDW_SPEC_NAME=$(*F)



$(BDW_WORKLIB)/sims/top_DPA_aes256_10_GP.v : top_v.bdt $(BDW_LOGOPTIONS_FILE) $(BDW_WORKLIB)/modules/hl5/DPA/hl5_rtl.v   $(BDW_VLOG_DUT_FILES)
	@if [ ! -d $(BDW_WRAPDIR) ]; then mkdir -p $(BDW_WRAPDIR); fi
	$(BDW_WRAPGEN_COMMAND) -project project.tcl -simconfig DPA_aes256_10_GP -top top

$(subst .v,_%.v,$(BDW_WORKLIB)/sims/top_DPA_aes256_10_GP.v) : top_v.bdt $(BDW_LOGOPTIONS_FILE) $(BDW_WORKLIB)/modules/hl5/DPA/hl5_rtl.v  
	@$(MAKE) `$(BDW_SPEC_FILTER) project.db $(*F) $(BDW_VLOG_DUT_FILES)`
	@if [ ! -d $(BDW_WRAPDIR) ]; then mkdir -p $(BDW_WRAPDIR); fi
	$(BDW_WRAPGEN_COMMAND) -project project.tcl -simconfig DPA_aes256_10_GP_$(*F) -top top




