	@if [ ! -d $(subst PIPE_SOFT2,PIPE_SOFT2_$(*F),$(fedec_PIPE_SOFT2_WORKLIB)) ]; then mkdir -p $(subst PIPE_SOFT2,PIPE_SOFT2_$(*F),$(fedec_PIPE_SOFT2_WORKLIB)); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(fedec_PIPE_SOFT2_SRCDIR)_$(*F) -o $(subst PIPE_SOFT2,PIPE_SOFT2_$(*F),$(fedec_PIPE_SOFT2_WORKLIB))/Makefile -module fedec -cynthconfig PIPE_SOFT2_$(*F)   

$(fedec_PIPE_SOFT2_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(subst PIPE_SOFT2,PIPE_SOFT2_$(*F),$(fedec_PIPE_SOFT2_WORKLIB)) ]; then mkdir -p $(subst PIPE_SOFT2,PIPE_SOFT2_$(*F),$(fedec_PIPE_SOFT2_WORKLIB)); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(fedec_PIPE_SOFT2_WORKLIB)/fedec_PIPE_SOFT2.d :
	@if [ ! -d $(fedec_PIPE_SOFT2_WORKLIB) ]; then mkdir -p $(fedec_PIPE_SOFT2_WORKLIB); fi
	@touch $(fedec_PIPE_SOFT2_WORKLIB)/fedec_PIPE_SOFT2.d



#
# HLS config PIPE_SOFT3
#

#
#	stratus_hls rule
#
LIB_DIRS_fedec_PIPE_SOFT3 = $(memlib_SRCDIR) 
LIB_INCLUDES_fedec_PIPE_SOFT3 = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_fedec_PIPE_SOFT3))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_fedec_PIPE_SOFT3 = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_fedec_PIPE_SOFT3 = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_fedec_PIPE_SOFT3 = 
EXTRACT_LIB_DASHI_fedec_PIPE_SOFT3 = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl fedec PIPE_SOFT3]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_fedec_PIPE_SOFT3 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/c_parts -DPIPE_SOFT3=1 -DBDW_RTL_fedec_PIPE_SOFT3=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DPIPE_SOFT_STALL3=1 $(LIB_INCLUDES_fedec_PIPE_SOFT3)
CCFLAGS_COSIM_fedec_PIPE_SOFT3 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/c_parts -DPIPE_SOFT3=1 -DBDW_RTL_fedec_PIPE_SOFT3=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DPIPE_SOFT_STALL3=1 $(LIB_INCLUDES_fedec_PIPE_SOFT3)
CCFLAGS_BEH_fedec_PIPE_SOFT3 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/c_parts -DPIPE_SOFT3=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DPIPE_SOFT_STALL3=1 $(LIB_INCLUDES_fedec_PIPE_SOFT3)
CCFLAGS_fedec_PIPE_SOFT3 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_fedec_PIPE_SOFT3 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_fedec_PIPE_SOFT3 += ${BDW_CCFLAGS_TAIL}

