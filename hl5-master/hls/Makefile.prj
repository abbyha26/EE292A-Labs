#
# Per-hls_config rules
#

cynth_PIPE_SOFT3:  cynth_fedec_PIPE_SOFT3 cynth_execute_PIPE_SOFT3 cynth_memwb_PIPE_SOFT3 cynth_hl5_PIPE_SOFT3
hlsc_PIPE_SOFT3:  
	$(MAKE) -j1 hlsc_fedec_PIPE_SOFT3 hlsc_execute_PIPE_SOFT3 hlsc_memwb_PIPE_SOFT3 
	$(MAKE) -j1 hlsc_hl5_PIPE_SOFT3

cynthvlg_PIPE_SOFT3: hls_PIPE_SOFT3
hls_PIPE_SOFT3:  
	$(MAKE) -j1 hls_fedec_PIPE_SOFT3 hls_execute_PIPE_SOFT3 hls_memwb_PIPE_SOFT3 
	$(MAKE) -j1 hls_hl5_PIPE_SOFT3

elab_PIPE_SOFT3:  
	$(MAKE) -j1 elab_fedec_PIPE_SOFT3 elab_execute_PIPE_SOFT3 elab_memwb_PIPE_SOFT3 
	$(MAKE) -j1 elab_hl5_PIPE_SOFT3

optim_PIPE_SOFT3:  
	$(MAKE) -j1 optim_fedec_PIPE_SOFT3 optim_execute_PIPE_SOFT3 optim_memwb_PIPE_SOFT3 
	$(MAKE) -j1 optim_hl5_PIPE_SOFT3

sched_PIPE_SOFT3:  
	$(MAKE) -j1 sched_fedec_PIPE_SOFT3 sched_execute_PIPE_SOFT3 sched_memwb_PIPE_SOFT3 
	$(MAKE) -j1 sched_hl5_PIPE_SOFT3

view_PIPE_SOFT3:
	@echo "ERROR: Schematic viewing target 'view_PIPE_SOFT3' is only supported with 'verdi'"
	@echo "The Stratus IDE includes a schematic view as an alternative."


clean_PIPE_SOFT3:
	@rm -f $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/fedec_rtl.cpp $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/stratus_hls.bdr
	@rm -f $(BDW_WORKLIB)/modules/execute/PIPE_SOFT3/execute_rtl.cpp $(BDW_WORKLIB)/modules/execute/PIPE_SOFT3/stratus_hls.bdr
	@rm -f $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3/memwb_rtl.cpp $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3/stratus_hls.bdr
	@rm -f $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT3/hl5_rtl.cpp $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT3/stratus_hls.bdr


