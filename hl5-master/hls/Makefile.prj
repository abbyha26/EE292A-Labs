	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_memwb_PIPE_SOFT3)  ../src/memwb.cpp \
	| sed 's|memwb\.o[ :]*|$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3/memwb_rtl.cpp $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3/xcelium/memwb_beh.o $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3/xcelium/debug/memwb_beh.o $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3/memwb.d : $(memlib_WORKLIB)/memlib.d |' $(BDW_DEP_FILTER)  > $@

