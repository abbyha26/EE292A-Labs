	@echo "The Stratus IDE includes a schematic view as an alternative."


#
#	RTL object file rule
#
$(BDW_WORKLIB)/modules/fedec/RADIX_4/xcelium/fedec_rtl.o : $(BDW_WORKLIB)/modules/fedec/RADIX_4/fedec_rtl.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(BDW_WORKLIB)/modules/fedec/RADIX_4/fedec_trace.h
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl fedec`
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/RADIX_4/ -I./ $(CCFLAGS_fedec_RADIX_4) $(EXTRACT_LIB_DASHI_fedec_RADIX_4) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/fedec/RADIX_4/xcelium/fedec_rtl.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp

