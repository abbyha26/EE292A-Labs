	@if [ ! -d $(fedec_RADIX_2_WORKLIB) ]; then mkdir -p $(fedec_RADIX_2_WORKLIB); fi
	@touch $(fedec_RADIX_2_WORKLIB)/fedec_RADIX_2.d



#
# HLS config RADIX_4
#

#
#	stratus_hls rule
#
LIB_DIRS_fedec_RADIX_4 = $(memlib_SRCDIR) 
LIB_INCLUDES_fedec_RADIX_4 = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_fedec_RADIX_4))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_fedec_RADIX_4 = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_fedec_RADIX_4 = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_fedec_RADIX_4 = 
EXTRACT_LIB_DASHI_fedec_RADIX_4 = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl fedec RADIX_4]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_fedec_RADIX_4 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/fedec/RADIX_4/c_parts -DRADIX_4=1 -DBDW_RTL_fedec_RADIX_4=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DDIV_RADIX_4 $(LIB_INCLUDES_fedec_RADIX_4)
CCFLAGS_COSIM_fedec_RADIX_4 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/fedec/RADIX_4/c_parts -DRADIX_4=1 -DBDW_RTL_fedec_RADIX_4=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DDIV_RADIX_4 $(LIB_INCLUDES_fedec_RADIX_4)
CCFLAGS_BEH_fedec_RADIX_4 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/fedec/RADIX_4/c_parts -DRADIX_4=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DDIV_RADIX_4 $(LIB_INCLUDES_fedec_RADIX_4)
CCFLAGS_fedec_RADIX_4 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_fedec_RADIX_4 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_fedec_RADIX_4 += ${BDW_CCFLAGS_TAIL}

.PHONY: hlsc_fedec_RADIX_4 hls_fedec_RADIX_4

