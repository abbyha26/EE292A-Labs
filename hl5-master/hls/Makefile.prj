#
#	Dependency generation rule
#
$(BDW_WORKLIB)/modules/fedec/BASIC_POFF/fedec.d :  ../src/fedec.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config BASIC_POFF of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_fedec_BASIC_POFF)  ../src/fedec.cpp \
	| sed 's|fedec\.o[ :]*|$(BDW_WORKLIB)/modules/fedec/BASIC_POFF/fedec_rtl.cpp $(BDW_WORKLIB)/modules/fedec/BASIC_POFF/xcelium/fedec_beh.o $(BDW_WORKLIB)/modules/fedec/BASIC_POFF/xcelium/debug/fedec_beh.o $(BDW_WORKLIB)/modules/fedec/BASIC_POFF/fedec.d : $(memlib_WORKLIB)/memlib.d |' $(BDW_DEP_FILTER)  > $@

#
#	Library post-proc rules
#



##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/fedec/BASIC_POFF"
##############################################################

fedec_BASIC_POFF_SRCDIR = $(BDW_WORKLIB)/modules/fedec/BASIC_POFF
fedec_BASIC_POFF_BEH_SRCDIR = $(BDW_WORKLIB)/libs/fedec_BASIC_POFF
fedec_BASIC_POFF_LIBNAME = fedec_BASIC_POFF
fedec_BASIC_POFF_WORKLIB = $(BDW_WORKLIB)/modules/fedec/BASIC_POFF/xcelium
fedec_BASIC_POFF_C_PARTS_A = $(fedec_BASIC_POFF_WORKLIB)/objs/libfedec_BASIC_POFF.a

prep_c_fedec_BASIC_POFF : $(fedec_BASIC_POFF_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(fedec_BASIC_POFF_WORKLIB) prep_c

prep_vlog_fedec_BASIC_POFF : $(fedec_BASIC_POFF_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(fedec_BASIC_POFF_WORKLIB) prep_vlog

prep_fedec_BASIC_POFF : $(fedec_BASIC_POFF_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(fedec_BASIC_POFF_WORKLIB) prep

$(fedec_BASIC_POFF_WORKLIB)/Makefile : $(fedec_BASIC_POFF_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(fedec_BASIC_POFF_WORKLIB) ]; then mkdir -p $(fedec_BASIC_POFF_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(fedec_BASIC_POFF_SRCDIR) -o $(fedec_BASIC_POFF_WORKLIB)/Makefile -module fedec -cynthconfig BASIC_POFF   

$(fedec_BASIC_POFF_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(fedec_BASIC_POFF_WORKLIB) ]; then mkdir -p $(fedec_BASIC_POFF_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



prep_c_fedec_BASIC_POFF_% : $(subst BASIC_POFF,BASIC_POFF_%,$(fedec_BASIC_POFF_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst BASIC_POFF,BASIC_POFF_$(*F),$(fedec_BASIC_POFF_WORKLIB)) prep_c

prep_vlog_fedec_BASIC_POFF_% : $(subst BASIC_POFF,BASIC_POFF_%,$(fedec_BASIC_POFF_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst BASIC_POFF,BASIC_POFF_$(*F),$(fedec_BASIC_POFF_WORKLIB)) prep_vlog

prep_fedec_BASIC_POFF_% : $(subst BASIC_POFF,BASIC_POFF_%,$(fedec_BASIC_POFF_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst BASIC_POFF,BASIC_POFF_$(*F),$(fedec_BASIC_POFF_WORKLIB)) prep

$(subst BASIC_POFF,BASIC_POFF_%,$(fedec_BASIC_POFF_WORKLIB))/Makefile : $(fedec_BASIC_POFF_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(subst BASIC_POFF,BASIC_POFF_$(*F),$(fedec_BASIC_POFF_WORKLIB)) ]; then mkdir -p $(subst BASIC_POFF,BASIC_POFF_$(*F),$(fedec_BASIC_POFF_WORKLIB)); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(fedec_BASIC_POFF_SRCDIR)_$(*F) -o $(subst BASIC_POFF,BASIC_POFF_$(*F),$(fedec_BASIC_POFF_WORKLIB))/Makefile -module fedec -cynthconfig BASIC_POFF_$(*F)   

$(fedec_BASIC_POFF_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(subst BASIC_POFF,BASIC_POFF_$(*F),$(fedec_BASIC_POFF_WORKLIB)) ]; then mkdir -p $(subst BASIC_POFF,BASIC_POFF_$(*F),$(fedec_BASIC_POFF_WORKLIB)); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(fedec_BASIC_POFF_WORKLIB)/fedec_BASIC_POFF.d :
	@if [ ! -d $(fedec_BASIC_POFF_WORKLIB) ]; then mkdir -p $(fedec_BASIC_POFF_WORKLIB); fi
	@touch $(fedec_BASIC_POFF_WORKLIB)/fedec_BASIC_POFF.d



#
# HLS config DPA
#

#
#	stratus_hls rule
#
LIB_DIRS_fedec_DPA = $(memlib_SRCDIR) 
LIB_INCLUDES_fedec_DPA = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_fedec_DPA))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_fedec_DPA = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_fedec_DPA = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_fedec_DPA = 
EXTRACT_LIB_DASHI_fedec_DPA = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl fedec DPA]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_fedec_DPA = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/fedec/DPA/c_parts -DDPA=1 -DBDW_RTL_fedec_DPA=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_fedec_DPA)
CCFLAGS_COSIM_fedec_DPA = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/fedec/DPA/c_parts -DDPA=1 -DBDW_RTL_fedec_DPA=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_fedec_DPA)
CCFLAGS_BEH_fedec_DPA = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/fedec/DPA/c_parts -DDPA=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_fedec_DPA)
CCFLAGS_fedec_DPA += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_fedec_DPA += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_fedec_DPA += ${BDW_CCFLAGS_TAIL}

.PHONY: hlsc_fedec_DPA hls_fedec_DPA

hls_fedec_DPA : hlsc_fedec_DPA

cynth_fedec_DPA : hlsc_fedec_DPA

elab_fedec_DPA : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/fedec/DPA/stratus_hls.bdr

optim_fedec_DPA : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/fedec/DPA/stratus_hls.bdr

sched_fedec_DPA : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/fedec/DPA/stratus_hls.bdr

hlsc_fedec_DPA : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/fedec/DPA/fedec_rtl.cpp BDW_DEP_CYNTH_CONFIG=DPA BDW_MODULE=fedec BDW_HLS_CONFIG=DPA 
else
	@bdw_exec -jobproject project.tcl -job hls.fedec.DPA $(MAKE) CWBExec_hls=1 hlsc_fedec_DPA
endif

clean_cynth_fedec_DPA: clean_hls_fedec_DPA

clean_fedec_DPA: clean_hls_fedec_DPA

clean_hls_fedec_DPA:
	@rm -rf $(BDW_WORKLIB)/modules/fedec/DPA
	@rm -rf $(BDW_WORKLIB)/jobs/hls.fedec.DPA
	@rm -rf $(BDW_WORKLIB)/jobs/hls.fedec.DPA.s

kill_hls_fedec_DPA:
	@bdw_kill -job hls.fedec.DPA
	@bdw_kill -job hls.fedec.DPA.s


hls_fedec_DPA_% : hlsc_fedec_DPA_%

cynth_fedec_DPA_% : hlsc_fedec_DPA_%

elab_fedec_DPA_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(subst /DPA/,/DPA_$(*F)/,$(BDW_WORKLIB)/modules/fedec/DPA/stratus_hls.bdr)

optim_fedec_DPA_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(subst /DPA/,/DPA_$(*F)/,$(BDW_WORKLIB)/modules/fedec/DPA/stratus_hls.bdr)

sched_fedec_DPA_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(subst /DPA/,/DPA_$(*F)/,$(BDW_WORKLIB)/modules/fedec/DPA/stratus_hls.bdr)

hlsc_fedec_DPA_% hls_fedec_DPA_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /DPA/,/DPA_$(*F)/,$(BDW_WORKLIB)/modules/fedec/DPA/fedec_rtl.cpp) BDW_DEP_CYNTH_CONFIG=DPA BDW_MODULE=fedec BDW_HLS_CONFIG=DPA_$(*F) 
else
	@bdw_exec -jobproject project.tcl -job hls.fedec.DPA_$(*F) $(MAKE) CWBExec_hls=1 hlsc_fedec_DPA_$(*F)
endif

clean_cynth_fedec_DPA_%: clean_hls_fedec_DPA_%

clean_fedec_DPA_%: clean_hls_fedec_DPA_%

clean_hls_fedec_DPA_%:
	@rm -rf $(BDW_WORKLIB)/modules/fedec/DPA_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.fedec.DPA_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.fedec.DPA_$(*F).s

kill_hls_fedec_DPA_%:
	@bdw_kill -job hls.fedec.DPA_$(*F)
	@bdw_kill -job hls.fedec.DPA_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),DPA)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/fedec/DPA/fedec.d
                -include $(memlib_WORKLIB)/memlib.d
                BDW_LIB_DEPS =  $(memlib_DEPS)
            endif
        endif
    endif
endif


html_fedec_DPA :
	bdw_htmlgen -project project.tcl -module fedec -cynthconfig DPA

BDW_fedec_DPA_HLS_TARGETS := $(BDW_WORKLIB)/modules/fedec/DPA/fedec_rtl.cpp $(BDW_WORKLIB)/modules/fedec/DPA/fedec_rtl.v $(BDW_WORKLIB)/modules/fedec/DPA/stratus_hls.bdr
ifeq ($(BDW_BDR_ONLY),1)
.PHONY: $(filter %.bdr %.cpp,$(BDW_fedec_DPA_HLS_TARGETS))
$(filter %.v %.cpp,$(BDW_fedec_DPA_HLS_TARGETS)) : $(filter %.bdr,$(BDW_fedec_DPA_HLS_TARGETS))
BDW_fedec_DPA_HLS_TARGETS := $(filter %.bdr,$(BDW_fedec_DPA_HLS_TARGETS))
endif
BDW_fedec_DPA_HLS_SPEC_TARGETS = $(subst /DPA/,/DPA_%/,$(BDW_fedec_DPA_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_fedec_DPA_HLS_TARGETS) :  ../src/fedec.cpp   $(BDW_LIB_DEPS)
	+make --no-print-directory  $(BDW_WORKLIB)/wrappers/hl5_wrap.h
	@if [ ! -d $(BDW_WORKLIB)/modules/fedec/DPA ]; then mkdir -p $(BDW_WORKLIB)/modules/fedec/DPA; fi
	
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=DPA BDW_CYNTH_CONFIG=DPA \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/fedec/DPA/fedec_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/fedec/DPA/fedec_rtl.cpp \
		BDW_MODULE=fedec \
		BDW_CYNTH_CONFIG=DPA \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/fedec/DPA \
		BDW_HLS_CONFIG=DPA \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/fedec/DPA \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_fedec_DPA)  \
		-d $(BDW_WORKLIB)/modules/fedec/DPA -o fedec_rtl.cpp \
		--hls_module=fedec --hls_config=DPA --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_fedec_DPA))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_fedec_DPA))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_fedec_DPA))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_fedec_DPA)   \
		 ../src/fedec.cpp
	
	
	
	

else

$(BDW_fedec_DPA_HLS_TARGETS) :  ../src/fedec.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.fedec.DPA.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_fedec_DPA_HLS_TARGETS)

endif

	
$(BDW_WORKLIB)/modules/fedec/DPA/fedec_trace.h : $(BDW_WORKLIB)/modules/fedec/DPA/fedec_trace.h.updated

$(BDW_WORKLIB)/modules/fedec/DPA/fedec_trace.h.updated : $(BDW_WORKLIB)/modules/fedec/DPA/fedec_rtl.cpp $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module fedec -cynthconfig DPA  
	@touch $(BDW_WORKLIB)/modules/fedec/DPA/fedec_trace.h.updated

ifeq ($(CWBExec_hlsc),1)

$(BDW_fedec_DPA_HLS_SPEC_TARGETS) :  ../src/fedec.cpp   $(BDW_LIB_DEPS)
	+make --no-print-directory  $(BDW_WORKLIB)/wrappers/hl5_wrap.h
	@if [ ! -d $(BDW_WORKLIB)/modules/fedec/DPA_$(*F) ]; then mkdir -p $(BDW_WORKLIB)/modules/fedec/DPA_$(*F); fi
	
	
	$(subst /DPA ,/DPA_$(*F) ,$(subst =DPA ,=DPA_$(*F) ,$(subst /fedec/DPA/,/fedec/DPA_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=DPA BDW_CYNTH_CONFIG=DPA \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/fedec/DPA/fedec_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/fedec/DPA/fedec_rtl.cpp \
		BDW_MODULE=fedec \
		BDW_CYNTH_CONFIG=DPA \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/fedec/DPA \
		BDW_HLS_CONFIG=DPA \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/fedec/DPA \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_fedec_DPA)  \
		`cat  $(BDW_SPECLIB)/fedec/DPA.$(*F).bds | grep '^cmdline:' | sed 's/^cmdline://'`\
		-d $(BDW_WORKLIB)/modules/fedec/DPA -o fedec_rtl.cpp \
		--hls_module=fedec --hls_config=DPA --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_fedec_DPA))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_fedec_DPA))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_fedec_DPA))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_fedec_DPA)   \
		 ../src/fedec.cpp)))
	
	
	
	

else

$(BDW_fedec_DPA_HLS_SPEC_TARGETS) :  ../src/fedec.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.fedec.DPA_$(*F).s $(MAKE) -j1 CWBExec_hlsc=1 $(subst %,$(*F),$(BDW_fedec_DPA_HLS_SPEC_TARGETS))

endif

	

