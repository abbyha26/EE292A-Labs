	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/ -I./ $(CCFLAGS_COSIM_fedec_PIPE_SOFT3) -o $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/xcelium/fedec.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp
    

$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/xcelium/fedec_hoist.o :  ../src/fedec.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(BDW_WORKLIB)/wrappers/fedec_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
