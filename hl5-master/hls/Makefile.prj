		`cat  $(BDW_SPECLIB)/hl5/PIPE_SOFT3.$(*F).bds | grep '^cmdline:' | sed 's/^cmdline://'`\
		-d $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT3 -o hl5_rtl.cpp \
		--hls_module=hl5 --hls_config=PIPE_SOFT3 --project=project.tcl \
