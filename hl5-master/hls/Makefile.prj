	@echo "ERROR: Schematic viewing target 'view_memwb_RADIX_2' is only supported with 'verdi'"
	@echo "The Stratus IDE includes a schematic view as an alternative."


#
#	RTL object file rule
#
$(BDW_WORKLIB)/modules/memwb/RADIX_2/xcelium/memwb_rtl.o : $(BDW_WORKLIB)/modules/memwb/RADIX_2/memwb_rtl.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(BDW_WORKLIB)/modules/memwb/RADIX_2/memwb_trace.h
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl memwb`
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/RADIX_2/ -I./ $(CCFLAGS_memwb_RADIX_2) $(EXTRACT_LIB_DASHI_memwb_RADIX_2) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/memwb/RADIX_2/xcelium/memwb_rtl.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp

$(BDW_WORKLIB)/modules/memwb/RADIX_2/xcelium/debug/memwb_rtl.o : $(BDW_WORKLIB)/modules/memwb/RADIX_2/memwb_rtl.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(BDW_WORKLIB)/modules/memwb/RADIX_2/memwb_trace.h
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl memwb`
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/RADIX_2/ -I./ $(CCFLAGS_memwb_RADIX_2) $(EXTRACT_LIB_DASHI_memwb_RADIX_2) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/memwb/RADIX_2/xcelium/debug/memwb_rtl.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp

#
#	Behavioral object file rule.  Used only for BEH configs that are 
#	associated with HLS config names.
#

$(BDW_WORKLIB)/modules/memwb/RADIX_2/xcelium/memwb_beh.o :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(BDW_WORKLIB)/wrappers/memwb_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/RADIX_2/ -I./ $(CCFLAGS_BEH_memwb_RADIX_2) -o $(BDW_WORKLIB)/modules/memwb/RADIX_2/xcelium/memwb_beh.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp

$(BDW_WORKLIB)/modules/memwb/RADIX_2/xcelium/debug/memwb_beh.o :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(BDW_WORKLIB)/wrappers/memwb_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/RADIX_2/ -I./ $(CCFLAGS_BEH_memwb_RADIX_2) -o $(BDW_WORKLIB)/modules/memwb/RADIX_2/xcelium/debug/memwb_beh.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp

#
# Cosim object file rule
#

$(BDW_WORKLIB)/modules/memwb/RADIX_2/xcelium/memwb.o :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(BDW_WORKLIB)/wrappers/memwb_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/RADIX_2/ -I./ $(CCFLAGS_COSIM_memwb_RADIX_2) -o $(BDW_WORKLIB)/modules/memwb/RADIX_2/xcelium/memwb.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp
    

$(BDW_WORKLIB)/modules/memwb/RADIX_2/xcelium/memwb_hoist.o :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(BDW_WORKLIB)/wrappers/memwb_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/RADIX_2/ -I./ $(CCFLAGS_memwb_RADIX_2) $(EXTRACT_LIB_DASHI_memwb_RADIX_2) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/memwb/RADIX_2/xcelium/memwb_hoist.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp
    

$(BDW_WORKLIB)/modules/memwb/RADIX_2/xcelium/debug/memwb.o :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(BDW_WORKLIB)/wrappers/memwb_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/RADIX_2/ -I./ $(CCFLAGS_COSIM_memwb_RADIX_2) -o $(BDW_WORKLIB)/modules/memwb/RADIX_2/xcelium/debug/memwb.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp


$(BDW_WORKLIB)/modules/memwb/RADIX_2/xcelium/debug/memwb_hoist.o :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(BDW_WORKLIB)/wrappers/memwb_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/RADIX_2/ -I./ $(CCFLAGS_memwb_RADIX_2) $(EXTRACT_LIB_DASHI_memwb_RADIX_2) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/memwb/RADIX_2/xcelium/debug/memwb_hoist.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp
    

