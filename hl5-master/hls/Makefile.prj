## Parts Library "$(BDW_WORKLIB)/modules/execute/RADIX_4"
##############################################################

execute_RADIX_4_SRCDIR = $(BDW_WORKLIB)/modules/execute/RADIX_4
execute_RADIX_4_BEH_SRCDIR = $(BDW_WORKLIB)/libs/execute_RADIX_4
execute_RADIX_4_LIBNAME = execute_RADIX_4
execute_RADIX_4_WORKLIB = $(BDW_WORKLIB)/modules/execute/RADIX_4/xcelium
execute_RADIX_4_C_PARTS_A = $(execute_RADIX_4_WORKLIB)/objs/libexecute_RADIX_4.a

prep_c_execute_RADIX_4 : $(execute_RADIX_4_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(execute_RADIX_4_WORKLIB) prep_c

prep_vlog_execute_RADIX_4 : $(execute_RADIX_4_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(execute_RADIX_4_WORKLIB) prep_vlog

prep_execute_RADIX_4 : $(execute_RADIX_4_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(execute_RADIX_4_WORKLIB) prep

$(execute_RADIX_4_WORKLIB)/Makefile : $(execute_RADIX_4_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(execute_RADIX_4_WORKLIB) ]; then mkdir -p $(execute_RADIX_4_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(execute_RADIX_4_SRCDIR) -o $(execute_RADIX_4_WORKLIB)/Makefile -module execute -cynthconfig RADIX_4   

$(execute_RADIX_4_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(execute_RADIX_4_WORKLIB) ]; then mkdir -p $(execute_RADIX_4_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



prep_c_execute_RADIX_4_% : $(subst RADIX_4,RADIX_4_%,$(execute_RADIX_4_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst RADIX_4,RADIX_4_$(*F),$(execute_RADIX_4_WORKLIB)) prep_c

prep_vlog_execute_RADIX_4_% : $(subst RADIX_4,RADIX_4_%,$(execute_RADIX_4_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst RADIX_4,RADIX_4_$(*F),$(execute_RADIX_4_WORKLIB)) prep_vlog

prep_execute_RADIX_4_% : $(subst RADIX_4,RADIX_4_%,$(execute_RADIX_4_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst RADIX_4,RADIX_4_$(*F),$(execute_RADIX_4_WORKLIB)) prep

$(subst RADIX_4,RADIX_4_%,$(execute_RADIX_4_WORKLIB))/Makefile : $(execute_RADIX_4_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(subst RADIX_4,RADIX_4_$(*F),$(execute_RADIX_4_WORKLIB)) ]; then mkdir -p $(subst RADIX_4,RADIX_4_$(*F),$(execute_RADIX_4_WORKLIB)); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(execute_RADIX_4_SRCDIR)_$(*F) -o $(subst RADIX_4,RADIX_4_$(*F),$(execute_RADIX_4_WORKLIB))/Makefile -module execute -cynthconfig RADIX_4_$(*F)   

$(execute_RADIX_4_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(subst RADIX_4,RADIX_4_$(*F),$(execute_RADIX_4_WORKLIB)) ]; then mkdir -p $(subst RADIX_4,RADIX_4_$(*F),$(execute_RADIX_4_WORKLIB)); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(execute_RADIX_4_WORKLIB)/execute_RADIX_4.d :
	@if [ ! -d $(execute_RADIX_4_WORKLIB) ]; then mkdir -p $(execute_RADIX_4_WORKLIB); fi
	@touch $(execute_RADIX_4_WORKLIB)/execute_RADIX_4.d



##############################################################
## HLS Module "memwb"
##############################################################


#
# Dependency Generation rule for BEH module
#
$(BDW_OBJDIR)/memwb.d :  ../src/memwb.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for $< "
	@set -e; $(BDW_CCDEP) -MM -MG $(BDW_CCFLAGS)  ../src/memwb.cpp \
	| sed 's|memwb\.o[ :]*|$(BDW_OBJDIR)/memwb.o $(BDW_OBJDIR)/memwb.d : |' $(BDW_DEP_FILTER)  > $@

$(BDW_WORKLIB)/wrappers/memwb_trace.h : $(BDW_WORKLIB)/wrappers/memwb_trace.h.updated

$(BDW_WORKLIB)/wrappers/memwb_trace.h.updated :  ../src/memwb.cpp $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module memwb  
	@touch $(BDW_WORKLIB)/wrappers/memwb_trace.h.updated



$(BDW_WORKLIB)/sims/$(BDW_SIM_CONFIG)/xcelium/memwb.o:  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(BDW_WORKLIB)/wrappers/memwb_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " $(BDW_CCFLAGS) -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -o $(BDW_WORKLIB)/sims/$(BDW_SIM_CONFIG)/xcelium/memwb.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp

$(BDW_WORKLIB)/sims/$(BDW_SIM_CONFIG)/xcelium/debug/memwb.o:  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(BDW_WORKLIB)/wrappers/memwb_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " $(BDW_CCFLAGS) -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -o $(BDW_WORKLIB)/sims/$(BDW_SIM_CONFIG)/xcelium/debug/memwb.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp

.INTERMEDIATE : memwb_wrap.h

memwb_wrap.h : $(BDW_WORKLIB)/wrappers/memwb_wrap.h

$(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(BDW_WORKLIB)/wrappers/memwb_cosim.v   : $(BDW_WRAPDIR)/memwb.updated

$(BDW_WRAPDIR)/memwb.updated :  ../src/memwb.cpp 
	@if [ ! -d $(BDW_WRAPDIR) ]; then mkdir -p $(BDW_WRAPDIR); fi
	$(BDW_WRAPGEN_COMMAND) -project project.tcl -module memwb "-I$(BDW_WRAPDIR) $(BDW_LIB_DASHI) $(BDW_CCOPTIONS) $(BDW_EXTRA_CCFLAGS)"
	@touch $(BDW_WRAPDIR)/memwb.updated
	$(STRATUS_HOME)/bin/bdw_tracegen -module memwb  
	@touch $(BDW_WORKLIB)/wrappers/memwb_trace.h.updated

$(BDW_WORKLIB)/wrappers/memwb_wrap.d :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@set -e; $(BDW_CCDEP) -MM -MG $(BDW_CCFLAGS) -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  ../src/memwb.cpp \
		| sed 's|memwb\.o[ :]*|$(BDW_WRAPDIR)/memwb.updated $(BDW_WORKLIB)/wrappers/memwb_wrap.d :  memlib/memlib.bdl |' $(BDW_DEP_FILTER) > $(BDW_WORKLIB)/wrappers/memwb_wrap.d 




##############################################################
## HLS Module "memwb" - cynthConfigs
##############################################################


#
# HLS config PIN
#

#
#	stratus_hls rule
#
LIB_DIRS_memwb_PIN = $(memlib_SRCDIR) 
LIB_INCLUDES_memwb_PIN = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_memwb_PIN))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_memwb_PIN = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_memwb_PIN = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_memwb_PIN = 
EXTRACT_LIB_DASHI_memwb_PIN = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl memwb PIN]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_memwb_PIN = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/memwb/PIN/c_parts  -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_memwb_PIN)
CCFLAGS_COSIM_memwb_PIN = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/memwb/PIN/c_parts  -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_memwb_PIN)
CCFLAGS_BEH_memwb_PIN = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/memwb/PIN/c_parts  -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_memwb_PIN)
CCFLAGS_memwb_PIN += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_memwb_PIN += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_memwb_PIN += ${BDW_CCFLAGS_TAIL}

.PHONY: hlsc_memwb_PIN hls_memwb_PIN

hls_memwb_PIN : hlsc_memwb_PIN

cynth_memwb_PIN : hlsc_memwb_PIN

elab_memwb_PIN : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/memwb/PIN/stratus_hls.bdr

optim_memwb_PIN : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/memwb/PIN/stratus_hls.bdr

sched_memwb_PIN : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/memwb/PIN/stratus_hls.bdr

hlsc_memwb_PIN : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/memwb/PIN/memwb_rtl.cpp BDW_DEP_CYNTH_CONFIG=PIN BDW_MODULE=memwb BDW_HLS_CONFIG=PIN 
else
	@bdw_exec -jobproject project.tcl -job hls.memwb.PIN $(MAKE) CWBExec_hls=1 hlsc_memwb_PIN
endif

clean_cynth_memwb_PIN: clean_hls_memwb_PIN

clean_memwb_PIN: clean_hls_memwb_PIN

clean_hls_memwb_PIN:
	@rm -rf $(BDW_WORKLIB)/modules/memwb/PIN
	@rm -rf $(BDW_WORKLIB)/jobs/hls.memwb.PIN
	@rm -rf $(BDW_WORKLIB)/jobs/hls.memwb.PIN.s

kill_hls_memwb_PIN:
	@bdw_kill -job hls.memwb.PIN
	@bdw_kill -job hls.memwb.PIN.s


hls_memwb_PIN_% : hlsc_memwb_PIN_%

cynth_memwb_PIN_% : hlsc_memwb_PIN_%

elab_memwb_PIN_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(subst /PIN/,/PIN_$(*F)/,$(BDW_WORKLIB)/modules/memwb/PIN/stratus_hls.bdr)

optim_memwb_PIN_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(subst /PIN/,/PIN_$(*F)/,$(BDW_WORKLIB)/modules/memwb/PIN/stratus_hls.bdr)

sched_memwb_PIN_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(subst /PIN/,/PIN_$(*F)/,$(BDW_WORKLIB)/modules/memwb/PIN/stratus_hls.bdr)

hlsc_memwb_PIN_% hls_memwb_PIN_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /PIN/,/PIN_$(*F)/,$(BDW_WORKLIB)/modules/memwb/PIN/memwb_rtl.cpp) BDW_DEP_CYNTH_CONFIG=PIN BDW_MODULE=memwb BDW_HLS_CONFIG=PIN_$(*F) 
else
	@bdw_exec -jobproject project.tcl -job hls.memwb.PIN_$(*F) $(MAKE) CWBExec_hls=1 hlsc_memwb_PIN_$(*F)
endif

clean_cynth_memwb_PIN_%: clean_hls_memwb_PIN_%

clean_memwb_PIN_%: clean_hls_memwb_PIN_%

clean_hls_memwb_PIN_%:
	@rm -rf $(BDW_WORKLIB)/modules/memwb/PIN_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.memwb.PIN_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.memwb.PIN_$(*F).s

kill_hls_memwb_PIN_%:
	@bdw_kill -job hls.memwb.PIN_$(*F)
	@bdw_kill -job hls.memwb.PIN_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),PIN)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/memwb/PIN/memwb.d
                -include $(memlib_WORKLIB)/memlib.d
                BDW_LIB_DEPS =  $(memlib_DEPS)
            endif
        endif
    endif
endif


html_memwb_PIN :
	bdw_htmlgen -project project.tcl -module memwb -cynthconfig PIN

BDW_memwb_PIN_HLS_TARGETS := $(BDW_WORKLIB)/modules/memwb/PIN/memwb_rtl.cpp $(BDW_WORKLIB)/modules/memwb/PIN/memwb_rtl.v $(BDW_WORKLIB)/modules/memwb/PIN/stratus_hls.bdr
ifeq ($(BDW_BDR_ONLY),1)
.PHONY: $(filter %.bdr %.cpp,$(BDW_memwb_PIN_HLS_TARGETS))
$(filter %.v %.cpp,$(BDW_memwb_PIN_HLS_TARGETS)) : $(filter %.bdr,$(BDW_memwb_PIN_HLS_TARGETS))
BDW_memwb_PIN_HLS_TARGETS := $(filter %.bdr,$(BDW_memwb_PIN_HLS_TARGETS))
endif
BDW_memwb_PIN_HLS_SPEC_TARGETS = $(subst /PIN/,/PIN_%/,$(BDW_memwb_PIN_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_memwb_PIN_HLS_TARGETS) :  ../src/memwb.cpp   $(BDW_LIB_DEPS)
	+make --no-print-directory  $(BDW_WORKLIB)/wrappers/hl5_wrap.h
	@if [ ! -d $(BDW_WORKLIB)/modules/memwb/PIN ]; then mkdir -p $(BDW_WORKLIB)/modules/memwb/PIN; fi
	
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=PIN BDW_CYNTH_CONFIG=PIN \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/memwb/PIN/memwb_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/memwb/PIN/memwb_rtl.cpp \
		BDW_MODULE=memwb \
		BDW_CYNTH_CONFIG=PIN \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/memwb/PIN \
		BDW_HLS_CONFIG=PIN \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/memwb/PIN \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_memwb_PIN)  \
		-d $(BDW_WORKLIB)/modules/memwb/PIN -o memwb_rtl.cpp \
		--hls_module=memwb --hls_config=PIN --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_memwb_PIN))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_memwb_PIN))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_memwb_PIN))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_memwb_PIN)   \
		 ../src/memwb.cpp
	
	
	
	

else

$(BDW_memwb_PIN_HLS_TARGETS) :  ../src/memwb.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.memwb.PIN.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_memwb_PIN_HLS_TARGETS)

endif

	
$(BDW_WORKLIB)/modules/memwb/PIN/memwb_trace.h : $(BDW_WORKLIB)/modules/memwb/PIN/memwb_trace.h.updated

$(BDW_WORKLIB)/modules/memwb/PIN/memwb_trace.h.updated : $(BDW_WORKLIB)/modules/memwb/PIN/memwb_rtl.cpp $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module memwb -cynthconfig PIN  
	@touch $(BDW_WORKLIB)/modules/memwb/PIN/memwb_trace.h.updated

ifeq ($(CWBExec_hlsc),1)

$(BDW_memwb_PIN_HLS_SPEC_TARGETS) :  ../src/memwb.cpp   $(BDW_LIB_DEPS)
	+make --no-print-directory  $(BDW_WORKLIB)/wrappers/hl5_wrap.h
	@if [ ! -d $(BDW_WORKLIB)/modules/memwb/PIN_$(*F) ]; then mkdir -p $(BDW_WORKLIB)/modules/memwb/PIN_$(*F); fi
	
	
	$(subst /PIN ,/PIN_$(*F) ,$(subst =PIN ,=PIN_$(*F) ,$(subst /memwb/PIN/,/memwb/PIN_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=PIN BDW_CYNTH_CONFIG=PIN \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/memwb/PIN/memwb_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/memwb/PIN/memwb_rtl.cpp \
		BDW_MODULE=memwb \
		BDW_CYNTH_CONFIG=PIN \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/memwb/PIN \
		BDW_HLS_CONFIG=PIN \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/memwb/PIN \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_memwb_PIN)  \
		`cat  $(BDW_SPECLIB)/memwb/PIN.$(*F).bds | grep '^cmdline:' | sed 's/^cmdline://'`\
		-d $(BDW_WORKLIB)/modules/memwb/PIN -o memwb_rtl.cpp \
		--hls_module=memwb --hls_config=PIN --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_memwb_PIN))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_memwb_PIN))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_memwb_PIN))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_memwb_PIN)   \
		 ../src/memwb.cpp)))
	
	
	
	

else

$(BDW_memwb_PIN_HLS_SPEC_TARGETS) :  ../src/memwb.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.memwb.PIN_$(*F).s $(MAKE) -j1 CWBExec_hlsc=1 $(subst %,$(*F),$(BDW_memwb_PIN_HLS_SPEC_TARGETS))

endif

	

$(subst /PIN/,/PIN_%/,$(BDW_WORKLIB)/modules/memwb/PIN/memwb_trace.h) : $(subst /PIN/,/PIN_%/,$(BDW_WORKLIB)/modules/memwb/PIN/memwb_rtl.cpp) $(BDW_LOGOPTIONS_FILE)
