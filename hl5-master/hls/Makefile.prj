build_PIPE_SOFT1_aes256_10_V_%:
	@bdw_exec -jobproject project.tcl -job build.PIPE_SOFT1_aes256_10_V_$(*F) $(MAKE) CWBExec_build=1 build_PIPE_SOFT1_aes256_10_V_$(*F)

build_PIPE_SOFT1_aes256_10_V_sub_%:
	@bdw_exec -jobproject project.tcl -job build.PIPE_SOFT1_aes256_10_V_$(*F).s $(MAKE) CWBExec_build=1 build_PIPE_SOFT1_aes256_10_V_sub_$(*F)
endif


ifeq ($(CWBExec_sim),1)
sim_PIPE_SOFT1_aes256_10_V_% sim_sub_PIPE_SOFT1_aes256_10_V_%: build_PIPE_SOFT1_aes256_10_V_sub_%
	@$(MAKE) run_sim BDW_SIM_CONFIG=PIPE_SOFT1_aes256_10_V_$(*F)  BDW_BASE_SIM_CONFIG=PIPE_SOFT1_aes256_10_V BDW_SPEC_NAME=$(*F) 

sim_only_PIPE_SOFT1_aes256_10_V_%:
	@$(MAKE) run_sim BDW_SIM_CONFIG=PIPE_SOFT1_aes256_10_V_$(*F)  BDW_BASE_SIM_CONFIG=PIPE_SOFT1_aes256_10_V BDW_SPEC_NAME=$(*F) 

else
