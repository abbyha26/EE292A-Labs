#	associated with HLS config names.
#

$(subst /RADIX_4/,/RADIX_4$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/fedec/RADIX_4/xcelium/fedec_beh.o) :  ../src/fedec.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(subst /RADIX_4/,/RADIX_4$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/fedec_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /RADIX_4/,/RADIX_4$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/RADIX_4/ -I./ $(CCFLAGS_BEH_fedec_RADIX_4) -o $(BDW_WORKLIB)/modules/fedec/RADIX_4/xcelium/fedec_beh.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp)

$(subst /RADIX_4/,/RADIX_4$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/fedec/RADIX_4/xcelium/debug/fedec_beh.o) :  ../src/fedec.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(subst /RADIX_4/,/RADIX_4$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/fedec_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /RADIX_4/,/RADIX_4$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/RADIX_4/ -I./ $(CCFLAGS_BEH_fedec_RADIX_4) -o $(BDW_WORKLIB)/modules/fedec/RADIX_4/xcelium/debug/fedec_beh.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp)

#
# Cosim object file rule
#

$(subst /RADIX_4/,/RADIX_4$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/fedec/RADIX_4/xcelium/fedec.o) :  ../src/fedec.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(subst /RADIX_4/,/RADIX_4$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/fedec_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /RADIX_4/,/RADIX_4$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/RADIX_4/ -I./ $(CCFLAGS_COSIM_fedec_RADIX_4) -o $(BDW_WORKLIB)/modules/fedec/RADIX_4/xcelium/fedec.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp)
    

$(subst /RADIX_4/,/RADIX_4$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/fedec/RADIX_4/xcelium/fedec_hoist.o) :  ../src/fedec.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(subst /RADIX_4/,/RADIX_4$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/fedec_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /RADIX_4/,/RADIX_4$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/RADIX_4/ -I./ $(CCFLAGS_fedec_RADIX_4) $(EXTRACT_LIB_DASHI_fedec_RADIX_4) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/fedec/RADIX_4/xcelium/fedec_hoist.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp)
    

$(subst /RADIX_4/,/RADIX_4$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/fedec/RADIX_4/xcelium/debug/fedec.o) :  ../src/fedec.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(subst /RADIX_4/,/RADIX_4$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/fedec_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /RADIX_4/,/RADIX_4$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/RADIX_4/ -I./ $(CCFLAGS_COSIM_fedec_RADIX_4) -o $(BDW_WORKLIB)/modules/fedec/RADIX_4/xcelium/debug/fedec.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp)


$(subst /RADIX_4/,/RADIX_4$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/fedec/RADIX_4/xcelium/debug/fedec_hoist.o) :  ../src/fedec.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(subst /RADIX_4/,/RADIX_4$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/fedec_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /RADIX_4/,/RADIX_4$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/RADIX_4/ -I./ $(CCFLAGS_fedec_RADIX_4) $(EXTRACT_LIB_DASHI_fedec_RADIX_4) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/fedec/RADIX_4/xcelium/debug/fedec_hoist.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp)
    
endif

#
#	Dependency generation rule
#
$(BDW_WORKLIB)/modules/fedec/RADIX_4/fedec.d :  ../src/fedec.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config RADIX_4 of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_fedec_RADIX_4)  ../src/fedec.cpp \
	| sed 's|fedec\.o[ :]*|$(BDW_WORKLIB)/modules/fedec/RADIX_4/fedec_rtl.cpp $(BDW_WORKLIB)/modules/fedec/RADIX_4/xcelium/fedec_beh.o $(BDW_WORKLIB)/modules/fedec/RADIX_4/xcelium/debug/fedec_beh.o $(BDW_WORKLIB)/modules/fedec/RADIX_4/fedec.d : $(memlib_WORKLIB)/memlib.d |' $(BDW_DEP_FILTER)  > $@

#
#	Library post-proc rules
#



##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/fedec/RADIX_4"
##############################################################

fedec_RADIX_4_SRCDIR = $(BDW_WORKLIB)/modules/fedec/RADIX_4
fedec_RADIX_4_BEH_SRCDIR = $(BDW_WORKLIB)/libs/fedec_RADIX_4
fedec_RADIX_4_LIBNAME = fedec_RADIX_4
fedec_RADIX_4_WORKLIB = $(BDW_WORKLIB)/modules/fedec/RADIX_4/xcelium
fedec_RADIX_4_C_PARTS_A = $(fedec_RADIX_4_WORKLIB)/objs/libfedec_RADIX_4.a

prep_c_fedec_RADIX_4 : $(fedec_RADIX_4_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(fedec_RADIX_4_WORKLIB) prep_c

prep_vlog_fedec_RADIX_4 : $(fedec_RADIX_4_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(fedec_RADIX_4_WORKLIB) prep_vlog

prep_fedec_RADIX_4 : $(fedec_RADIX_4_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(fedec_RADIX_4_WORKLIB) prep

$(fedec_RADIX_4_WORKLIB)/Makefile : $(fedec_RADIX_4_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(fedec_RADIX_4_WORKLIB) ]; then mkdir -p $(fedec_RADIX_4_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(fedec_RADIX_4_SRCDIR) -o $(fedec_RADIX_4_WORKLIB)/Makefile -module fedec -cynthconfig RADIX_4   

$(fedec_RADIX_4_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(fedec_RADIX_4_WORKLIB) ]; then mkdir -p $(fedec_RADIX_4_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



prep_c_fedec_RADIX_4_% : $(subst RADIX_4,RADIX_4_%,$(fedec_RADIX_4_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst RADIX_4,RADIX_4_$(*F),$(fedec_RADIX_4_WORKLIB)) prep_c

prep_vlog_fedec_RADIX_4_% : $(subst RADIX_4,RADIX_4_%,$(fedec_RADIX_4_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst RADIX_4,RADIX_4_$(*F),$(fedec_RADIX_4_WORKLIB)) prep_vlog

prep_fedec_RADIX_4_% : $(subst RADIX_4,RADIX_4_%,$(fedec_RADIX_4_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst RADIX_4,RADIX_4_$(*F),$(fedec_RADIX_4_WORKLIB)) prep

$(subst RADIX_4,RADIX_4_%,$(fedec_RADIX_4_WORKLIB))/Makefile : $(fedec_RADIX_4_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(subst RADIX_4,RADIX_4_$(*F),$(fedec_RADIX_4_WORKLIB)) ]; then mkdir -p $(subst RADIX_4,RADIX_4_$(*F),$(fedec_RADIX_4_WORKLIB)); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(fedec_RADIX_4_SRCDIR)_$(*F) -o $(subst RADIX_4,RADIX_4_$(*F),$(fedec_RADIX_4_WORKLIB))/Makefile -module fedec -cynthconfig RADIX_4_$(*F)   

$(fedec_RADIX_4_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(subst RADIX_4,RADIX_4_$(*F),$(fedec_RADIX_4_WORKLIB)) ]; then mkdir -p $(subst RADIX_4,RADIX_4_$(*F),$(fedec_RADIX_4_WORKLIB)); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(fedec_RADIX_4_WORKLIB)/fedec_RADIX_4.d :
	@if [ ! -d $(fedec_RADIX_4_WORKLIB) ]; then mkdir -p $(fedec_RADIX_4_WORKLIB); fi
	@touch $(fedec_RADIX_4_WORKLIB)/fedec_RADIX_4.d



##############################################################
## HLS Module "execute"
##############################################################


#
# Dependency Generation rule for BEH module
#
$(BDW_OBJDIR)/execute.d :  ../src/execute.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for $< "
	@set -e; $(BDW_CCDEP) -MM -MG $(BDW_CCFLAGS)  ../src/execute.cpp \
	| sed 's|execute\.o[ :]*|$(BDW_OBJDIR)/execute.o $(BDW_OBJDIR)/execute.d : |' $(BDW_DEP_FILTER)  > $@

$(BDW_WORKLIB)/wrappers/execute_trace.h : $(BDW_WORKLIB)/wrappers/execute_trace.h.updated

$(BDW_WORKLIB)/wrappers/execute_trace.h.updated :  ../src/execute.cpp $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module execute  
	@touch $(BDW_WORKLIB)/wrappers/execute_trace.h.updated



$(BDW_WORKLIB)/sims/$(BDW_SIM_CONFIG)/xcelium/execute.o:  ../src/execute.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/execute_cosim.h $(BDW_WORKLIB)/wrappers/execute_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " $(BDW_CCFLAGS) -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -o $(BDW_WORKLIB)/sims/$(BDW_SIM_CONFIG)/xcelium/execute.o " $(BDW_WORKLIB)/wrappers/execute_wrap.cpp

$(BDW_WORKLIB)/sims/$(BDW_SIM_CONFIG)/xcelium/debug/execute.o:  ../src/execute.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/execute_cosim.h $(BDW_WORKLIB)/wrappers/execute_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " $(BDW_CCFLAGS) -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -o $(BDW_WORKLIB)/sims/$(BDW_SIM_CONFIG)/xcelium/debug/execute.o " $(BDW_WORKLIB)/wrappers/execute_wrap.cpp

.INTERMEDIATE : execute_wrap.h

execute_wrap.h : $(BDW_WORKLIB)/wrappers/execute_wrap.h

$(BDW_WORKLIB)/wrappers/execute_wrap.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/execute_cosim.h $(BDW_WORKLIB)/wrappers/execute_cosim.v   : $(BDW_WRAPDIR)/execute.updated

$(BDW_WRAPDIR)/execute.updated :  ../src/execute.cpp 
	@if [ ! -d $(BDW_WRAPDIR) ]; then mkdir -p $(BDW_WRAPDIR); fi
	$(BDW_WRAPGEN_COMMAND) -project project.tcl -module execute "-I$(BDW_WRAPDIR) $(BDW_LIB_DASHI) $(BDW_CCOPTIONS) $(BDW_EXTRA_CCFLAGS)"
	@touch $(BDW_WRAPDIR)/execute.updated
	$(STRATUS_HOME)/bin/bdw_tracegen -module execute  
	@touch $(BDW_WORKLIB)/wrappers/execute_trace.h.updated

$(BDW_WORKLIB)/wrappers/execute_wrap.d :  ../src/execute.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@set -e; $(BDW_CCDEP) -MM -MG $(BDW_CCFLAGS) -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  ../src/execute.cpp \
		| sed 's|execute\.o[ :]*|$(BDW_WRAPDIR)/execute.updated $(BDW_WORKLIB)/wrappers/execute_wrap.d :  memlib/memlib.bdl |' $(BDW_DEP_FILTER) > $(BDW_WORKLIB)/wrappers/execute_wrap.d 




##############################################################
## HLS Module "execute" - cynthConfigs
##############################################################


#
# HLS config PIN
#

#
#	stratus_hls rule
#
LIB_DIRS_execute_PIN = $(memlib_SRCDIR) 
LIB_INCLUDES_execute_PIN = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_execute_PIN))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_execute_PIN = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_execute_PIN = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_execute_PIN = 
EXTRACT_LIB_DASHI_execute_PIN = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl execute PIN]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_execute_PIN = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/execute/PIN/c_parts  -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_execute_PIN)
CCFLAGS_COSIM_execute_PIN = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/execute/PIN/c_parts  -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_execute_PIN)
CCFLAGS_BEH_execute_PIN = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/execute/PIN/c_parts  -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_execute_PIN)
CCFLAGS_execute_PIN += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_execute_PIN += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_execute_PIN += ${BDW_CCFLAGS_TAIL}

.PHONY: hlsc_execute_PIN hls_execute_PIN

hls_execute_PIN : hlsc_execute_PIN

cynth_execute_PIN : hlsc_execute_PIN

elab_execute_PIN : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/execute/PIN/stratus_hls.bdr

optim_execute_PIN : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/execute/PIN/stratus_hls.bdr

sched_execute_PIN : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/execute/PIN/stratus_hls.bdr

hlsc_execute_PIN : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/execute/PIN/execute_rtl.cpp BDW_DEP_CYNTH_CONFIG=PIN BDW_MODULE=execute BDW_HLS_CONFIG=PIN 
else
	@bdw_exec -jobproject project.tcl -job hls.execute.PIN $(MAKE) CWBExec_hls=1 hlsc_execute_PIN
endif

clean_cynth_execute_PIN: clean_hls_execute_PIN

clean_execute_PIN: clean_hls_execute_PIN

clean_hls_execute_PIN:
	@rm -rf $(BDW_WORKLIB)/modules/execute/PIN
	@rm -rf $(BDW_WORKLIB)/jobs/hls.execute.PIN
	@rm -rf $(BDW_WORKLIB)/jobs/hls.execute.PIN.s

kill_hls_execute_PIN:
	@bdw_kill -job hls.execute.PIN
	@bdw_kill -job hls.execute.PIN.s


hls_execute_PIN_% : hlsc_execute_PIN_%

cynth_execute_PIN_% : hlsc_execute_PIN_%

elab_execute_PIN_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(subst /PIN/,/PIN_$(*F)/,$(BDW_WORKLIB)/modules/execute/PIN/stratus_hls.bdr)

optim_execute_PIN_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(subst /PIN/,/PIN_$(*F)/,$(BDW_WORKLIB)/modules/execute/PIN/stratus_hls.bdr)

sched_execute_PIN_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(subst /PIN/,/PIN_$(*F)/,$(BDW_WORKLIB)/modules/execute/PIN/stratus_hls.bdr)

hlsc_execute_PIN_% hls_execute_PIN_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /PIN/,/PIN_$(*F)/,$(BDW_WORKLIB)/modules/execute/PIN/execute_rtl.cpp) BDW_DEP_CYNTH_CONFIG=PIN BDW_MODULE=execute BDW_HLS_CONFIG=PIN_$(*F) 
else
	@bdw_exec -jobproject project.tcl -job hls.execute.PIN_$(*F) $(MAKE) CWBExec_hls=1 hlsc_execute_PIN_$(*F)
endif

clean_cynth_execute_PIN_%: clean_hls_execute_PIN_%

clean_execute_PIN_%: clean_hls_execute_PIN_%

clean_hls_execute_PIN_%:
	@rm -rf $(BDW_WORKLIB)/modules/execute/PIN_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.execute.PIN_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.execute.PIN_$(*F).s

kill_hls_execute_PIN_%:
	@bdw_kill -job hls.execute.PIN_$(*F)
	@bdw_kill -job hls.execute.PIN_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),PIN)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/execute/PIN/execute.d
                -include $(memlib_WORKLIB)/memlib.d
                BDW_LIB_DEPS =  $(memlib_DEPS)
            endif
        endif
    endif
endif


html_execute_PIN :
	bdw_htmlgen -project project.tcl -module execute -cynthconfig PIN

BDW_execute_PIN_HLS_TARGETS := $(BDW_WORKLIB)/modules/execute/PIN/execute_rtl.cpp $(BDW_WORKLIB)/modules/execute/PIN/execute_rtl.v $(BDW_WORKLIB)/modules/execute/PIN/stratus_hls.bdr
ifeq ($(BDW_BDR_ONLY),1)
.PHONY: $(filter %.bdr %.cpp,$(BDW_execute_PIN_HLS_TARGETS))
$(filter %.v %.cpp,$(BDW_execute_PIN_HLS_TARGETS)) : $(filter %.bdr,$(BDW_execute_PIN_HLS_TARGETS))
BDW_execute_PIN_HLS_TARGETS := $(filter %.bdr,$(BDW_execute_PIN_HLS_TARGETS))
endif
BDW_execute_PIN_HLS_SPEC_TARGETS = $(subst /PIN/,/PIN_%/,$(BDW_execute_PIN_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_execute_PIN_HLS_TARGETS) :  ../src/execute.cpp   $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/execute/PIN ]; then mkdir -p $(BDW_WORKLIB)/modules/execute/PIN; fi
	
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=PIN BDW_CYNTH_CONFIG=PIN \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/execute/PIN/execute_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/execute/PIN/execute_rtl.cpp \
		BDW_MODULE=execute \
		BDW_CYNTH_CONFIG=PIN \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/execute/PIN \
		BDW_HLS_CONFIG=PIN \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/execute/PIN \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_execute_PIN)  \
		-d $(BDW_WORKLIB)/modules/execute/PIN -o execute_rtl.cpp \
		--hls_module=execute --hls_config=PIN --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_execute_PIN))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_execute_PIN))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_execute_PIN))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_execute_PIN)   \
		 ../src/execute.cpp
	
	
	
	

else

$(BDW_execute_PIN_HLS_TARGETS) :  ../src/execute.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.execute.PIN.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_execute_PIN_HLS_TARGETS)

endif

	
$(BDW_WORKLIB)/modules/execute/PIN/execute_trace.h : $(BDW_WORKLIB)/modules/execute/PIN/execute_trace.h.updated

$(BDW_WORKLIB)/modules/execute/PIN/execute_trace.h.updated : $(BDW_WORKLIB)/modules/execute/PIN/execute_rtl.cpp $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module execute -cynthconfig PIN  
	@touch $(BDW_WORKLIB)/modules/execute/PIN/execute_trace.h.updated

ifeq ($(CWBExec_hlsc),1)

$(BDW_execute_PIN_HLS_SPEC_TARGETS) :  ../src/execute.cpp   $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/execute/PIN_$(*F) ]; then mkdir -p $(BDW_WORKLIB)/modules/execute/PIN_$(*F); fi
	
	
	$(subst /PIN ,/PIN_$(*F) ,$(subst =PIN ,=PIN_$(*F) ,$(subst /execute/PIN/,/execute/PIN_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=PIN BDW_CYNTH_CONFIG=PIN \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/execute/PIN/execute_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/execute/PIN/execute_rtl.cpp \
		BDW_MODULE=execute \
		BDW_CYNTH_CONFIG=PIN \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/execute/PIN \
		BDW_HLS_CONFIG=PIN \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/execute/PIN \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_execute_PIN)  \
		`cat  $(BDW_SPECLIB)/execute/PIN.$(*F).bds | grep '^cmdline:' | sed 's/^cmdline://'`\
		-d $(BDW_WORKLIB)/modules/execute/PIN -o execute_rtl.cpp \
		--hls_module=execute --hls_config=PIN --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_execute_PIN))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_execute_PIN))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_execute_PIN))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_execute_PIN)   \
		 ../src/execute.cpp)))
	
	
	
	

else

$(BDW_execute_PIN_HLS_SPEC_TARGETS) :  ../src/execute.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.execute.PIN_$(*F).s $(MAKE) -j1 CWBExec_hlsc=1 $(subst %,$(*F),$(BDW_execute_PIN_HLS_SPEC_TARGETS))

endif

	

$(subst /PIN/,/PIN_%/,$(BDW_WORKLIB)/modules/execute/PIN/execute_trace.h) : $(subst /PIN/,/PIN_%/,$(BDW_WORKLIB)/modules/execute/PIN/execute_rtl.cpp) $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module execute -cynthconfig PIN_$(*F)  

catHLLog_execute_PIN:
	cat $(BDW_WORKLIB)/modules/execute/PIN/stratus_hls.log

#
#	stratus_vlg rule
#
cynthvlg_execute_PIN : hls_execute_PIN 


.PHONY: hls_execute_PIN

hls_execute_PIN hlsv_execute_PIN: $(addprefix prep_vlog_,$(LIB_NAMES_FOR_VLOG_execute_PIN)) 

.PHONY: hls_execute_PIN

