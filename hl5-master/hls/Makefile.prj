#
#	Dependency generation rule
#
$(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/execute.d :  ../src/execute.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config PIPE_SOFT2 of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_execute_PIPE_SOFT2)  ../src/execute.cpp \
	| sed 's|execute\.o[ :]*|$(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/execute_rtl.cpp $(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/xcelium/execute_beh.o $(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/xcelium/debug/execute_beh.o $(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/execute.d : $(memlib_WORKLIB)/memlib.d |' $(BDW_DEP_FILTER)  > $@

#
#	Library post-proc rules
#



##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/execute/PIPE_SOFT2"
##############################################################

execute_PIPE_SOFT2_SRCDIR = $(BDW_WORKLIB)/modules/execute/PIPE_SOFT2
execute_PIPE_SOFT2_BEH_SRCDIR = $(BDW_WORKLIB)/libs/execute_PIPE_SOFT2
execute_PIPE_SOFT2_LIBNAME = execute_PIPE_SOFT2
execute_PIPE_SOFT2_WORKLIB = $(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/xcelium
execute_PIPE_SOFT2_C_PARTS_A = $(execute_PIPE_SOFT2_WORKLIB)/objs/libexecute_PIPE_SOFT2.a

prep_c_execute_PIPE_SOFT2 : $(execute_PIPE_SOFT2_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(execute_PIPE_SOFT2_WORKLIB) prep_c

prep_vlog_execute_PIPE_SOFT2 : $(execute_PIPE_SOFT2_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(execute_PIPE_SOFT2_WORKLIB) prep_vlog

prep_execute_PIPE_SOFT2 : $(execute_PIPE_SOFT2_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(execute_PIPE_SOFT2_WORKLIB) prep

$(execute_PIPE_SOFT2_WORKLIB)/Makefile : $(execute_PIPE_SOFT2_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(execute_PIPE_SOFT2_WORKLIB) ]; then mkdir -p $(execute_PIPE_SOFT2_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(execute_PIPE_SOFT2_SRCDIR) -o $(execute_PIPE_SOFT2_WORKLIB)/Makefile -module execute -cynthconfig PIPE_SOFT2   

$(execute_PIPE_SOFT2_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(execute_PIPE_SOFT2_WORKLIB) ]; then mkdir -p $(execute_PIPE_SOFT2_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



prep_c_execute_PIPE_SOFT2_% : $(subst PIPE_SOFT2,PIPE_SOFT2_%,$(execute_PIPE_SOFT2_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst PIPE_SOFT2,PIPE_SOFT2_$(*F),$(execute_PIPE_SOFT2_WORKLIB)) prep_c

prep_vlog_execute_PIPE_SOFT2_% : $(subst PIPE_SOFT2,PIPE_SOFT2_%,$(execute_PIPE_SOFT2_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst PIPE_SOFT2,PIPE_SOFT2_$(*F),$(execute_PIPE_SOFT2_WORKLIB)) prep_vlog

prep_execute_PIPE_SOFT2_% : $(subst PIPE_SOFT2,PIPE_SOFT2_%,$(execute_PIPE_SOFT2_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst PIPE_SOFT2,PIPE_SOFT2_$(*F),$(execute_PIPE_SOFT2_WORKLIB)) prep

$(subst PIPE_SOFT2,PIPE_SOFT2_%,$(execute_PIPE_SOFT2_WORKLIB))/Makefile : $(execute_PIPE_SOFT2_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(subst PIPE_SOFT2,PIPE_SOFT2_$(*F),$(execute_PIPE_SOFT2_WORKLIB)) ]; then mkdir -p $(subst PIPE_SOFT2,PIPE_SOFT2_$(*F),$(execute_PIPE_SOFT2_WORKLIB)); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(execute_PIPE_SOFT2_SRCDIR)_$(*F) -o $(subst PIPE_SOFT2,PIPE_SOFT2_$(*F),$(execute_PIPE_SOFT2_WORKLIB))/Makefile -module execute -cynthconfig PIPE_SOFT2_$(*F)   

$(execute_PIPE_SOFT2_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(subst PIPE_SOFT2,PIPE_SOFT2_$(*F),$(execute_PIPE_SOFT2_WORKLIB)) ]; then mkdir -p $(subst PIPE_SOFT2,PIPE_SOFT2_$(*F),$(execute_PIPE_SOFT2_WORKLIB)); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(execute_PIPE_SOFT2_WORKLIB)/execute_PIPE_SOFT2.d :
	@if [ ! -d $(execute_PIPE_SOFT2_WORKLIB) ]; then mkdir -p $(execute_PIPE_SOFT2_WORKLIB); fi
	@touch $(execute_PIPE_SOFT2_WORKLIB)/execute_PIPE_SOFT2.d



#
# HLS config PIPE_SOFT3
#

#
#	stratus_hls rule
#
LIB_DIRS_execute_PIPE_SOFT3 = $(memlib_SRCDIR) 
LIB_INCLUDES_execute_PIPE_SOFT3 = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_execute_PIPE_SOFT3))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_execute_PIPE_SOFT3 = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_execute_PIPE_SOFT3 = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_execute_PIPE_SOFT3 = 
EXTRACT_LIB_DASHI_execute_PIPE_SOFT3 = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl execute PIPE_SOFT3]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_execute_PIPE_SOFT3 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/execute/PIPE_SOFT3/c_parts -DPIPE_SOFT3=1 -DBDW_RTL_execute_PIPE_SOFT3=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DPIPE_SOFT_STALL3=1 $(LIB_INCLUDES_execute_PIPE_SOFT3)
CCFLAGS_COSIM_execute_PIPE_SOFT3 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/execute/PIPE_SOFT3/c_parts -DPIPE_SOFT3=1 -DBDW_RTL_execute_PIPE_SOFT3=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DPIPE_SOFT_STALL3=1 $(LIB_INCLUDES_execute_PIPE_SOFT3)
CCFLAGS_BEH_execute_PIPE_SOFT3 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/execute/PIPE_SOFT3/c_parts -DPIPE_SOFT3=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DPIPE_SOFT_STALL3=1 $(LIB_INCLUDES_execute_PIPE_SOFT3)
CCFLAGS_execute_PIPE_SOFT3 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_execute_PIPE_SOFT3 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_execute_PIPE_SOFT3 += ${BDW_CCFLAGS_TAIL}

.PHONY: hlsc_execute_PIPE_SOFT3 hls_execute_PIPE_SOFT3

hls_execute_PIPE_SOFT3 : hlsc_execute_PIPE_SOFT3

cynth_execute_PIPE_SOFT3 : hlsc_execute_PIPE_SOFT3

elab_execute_PIPE_SOFT3 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/execute/PIPE_SOFT3/stratus_hls.bdr

optim_execute_PIPE_SOFT3 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/execute/PIPE_SOFT3/stratus_hls.bdr

sched_execute_PIPE_SOFT3 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/execute/PIPE_SOFT3/stratus_hls.bdr

hlsc_execute_PIPE_SOFT3 : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/execute/PIPE_SOFT3/execute_rtl.cpp BDW_DEP_CYNTH_CONFIG=PIPE_SOFT3 BDW_MODULE=execute BDW_HLS_CONFIG=PIPE_SOFT3 
else
	@bdw_exec -jobproject project.tcl -job hls.execute.PIPE_SOFT3 $(MAKE) CWBExec_hls=1 hlsc_execute_PIPE_SOFT3
endif

clean_cynth_execute_PIPE_SOFT3: clean_hls_execute_PIPE_SOFT3

clean_execute_PIPE_SOFT3: clean_hls_execute_PIPE_SOFT3

clean_hls_execute_PIPE_SOFT3:
	@rm -rf $(BDW_WORKLIB)/modules/execute/PIPE_SOFT3
	@rm -rf $(BDW_WORKLIB)/jobs/hls.execute.PIPE_SOFT3
	@rm -rf $(BDW_WORKLIB)/jobs/hls.execute.PIPE_SOFT3.s

kill_hls_execute_PIPE_SOFT3:
	@bdw_kill -job hls.execute.PIPE_SOFT3
	@bdw_kill -job hls.execute.PIPE_SOFT3.s


hls_execute_PIPE_SOFT3_% : hlsc_execute_PIPE_SOFT3_%

cynth_execute_PIPE_SOFT3_% : hlsc_execute_PIPE_SOFT3_%

