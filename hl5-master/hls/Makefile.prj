	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/PIN/ -I./ $(CCFLAGS_BEH_memwb_PIN) -o $(BDW_WORKLIB)/modules/memwb/PIN/xcelium/memwb_beh.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp

