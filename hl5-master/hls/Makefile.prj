#
# HLS config PIPE_SOFT2
#

#
#	stratus_hls rule
#
LIB_DIRS_memwb_PIPE_SOFT2 = $(memlib_SRCDIR) 
LIB_INCLUDES_memwb_PIPE_SOFT2 = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_memwb_PIPE_SOFT2))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_memwb_PIPE_SOFT2 = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_memwb_PIPE_SOFT2 = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_memwb_PIPE_SOFT2 = 
EXTRACT_LIB_DASHI_memwb_PIPE_SOFT2 = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl memwb PIPE_SOFT2]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_memwb_PIPE_SOFT2 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/c_parts -DPIPE_SOFT2=1 -DBDW_RTL_memwb_PIPE_SOFT2=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DPIPE_SOFT_STALL2=1 $(LIB_INCLUDES_memwb_PIPE_SOFT2)
CCFLAGS_COSIM_memwb_PIPE_SOFT2 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/c_parts -DPIPE_SOFT2=1 -DBDW_RTL_memwb_PIPE_SOFT2=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DPIPE_SOFT_STALL2=1 $(LIB_INCLUDES_memwb_PIPE_SOFT2)
CCFLAGS_BEH_memwb_PIPE_SOFT2 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/c_parts -DPIPE_SOFT2=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DPIPE_SOFT_STALL2=1 $(LIB_INCLUDES_memwb_PIPE_SOFT2)
CCFLAGS_memwb_PIPE_SOFT2 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_memwb_PIPE_SOFT2 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_memwb_PIPE_SOFT2 += ${BDW_CCFLAGS_TAIL}

.PHONY: hlsc_memwb_PIPE_SOFT2 hls_memwb_PIPE_SOFT2

