sched_execute_PIPE_SOFT3_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(subst /PIPE_SOFT3/,/PIPE_SOFT3_$(*F)/,$(BDW_WORKLIB)/modules/execute/PIPE_SOFT3/stratus_hls.bdr)

hlsc_execute_PIPE_SOFT3_% hls_execute_PIPE_SOFT3_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /PIPE_SOFT3/,/PIPE_SOFT3_$(*F)/,$(BDW_WORKLIB)/modules/execute/PIPE_SOFT3/execute_rtl.cpp) BDW_DEP_CYNTH_CONFIG=PIPE_SOFT3 BDW_MODULE=execute BDW_HLS_CONFIG=PIPE_SOFT3_$(*F) 
else
	@bdw_exec -jobproject project.tcl -job hls.execute.PIPE_SOFT3_$(*F) $(MAKE) CWBExec_hls=1 hlsc_execute_PIPE_SOFT3_$(*F)
endif

clean_cynth_execute_PIPE_SOFT3_%: clean_hls_execute_PIPE_SOFT3_%

clean_execute_PIPE_SOFT3_%: clean_hls_execute_PIPE_SOFT3_%

clean_hls_execute_PIPE_SOFT3_%:
	@rm -rf $(BDW_WORKLIB)/modules/execute/PIPE_SOFT3_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.execute.PIPE_SOFT3_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.execute.PIPE_SOFT3_$(*F).s

kill_hls_execute_PIPE_SOFT3_%:
	@bdw_kill -job hls.execute.PIPE_SOFT3_$(*F)
	@bdw_kill -job hls.execute.PIPE_SOFT3_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),PIPE_SOFT3)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/execute/PIPE_SOFT3/execute.d
                -include $(memlib_WORKLIB)/memlib.d
                BDW_LIB_DEPS =  $(memlib_DEPS)
            endif
        endif
    endif
endif


html_execute_PIPE_SOFT3 :
	bdw_htmlgen -project project.tcl -module execute -cynthconfig PIPE_SOFT3

BDW_execute_PIPE_SOFT3_HLS_TARGETS := $(BDW_WORKLIB)/modules/execute/PIPE_SOFT3/execute_rtl.cpp $(BDW_WORKLIB)/modules/execute/PIPE_SOFT3/execute_rtl.v $(BDW_WORKLIB)/modules/execute/PIPE_SOFT3/stratus_hls.bdr
ifeq ($(BDW_BDR_ONLY),1)
.PHONY: $(filter %.bdr %.cpp,$(BDW_execute_PIPE_SOFT3_HLS_TARGETS))
$(filter %.v %.cpp,$(BDW_execute_PIPE_SOFT3_HLS_TARGETS)) : $(filter %.bdr,$(BDW_execute_PIPE_SOFT3_HLS_TARGETS))
BDW_execute_PIPE_SOFT3_HLS_TARGETS := $(filter %.bdr,$(BDW_execute_PIPE_SOFT3_HLS_TARGETS))
endif
BDW_execute_PIPE_SOFT3_HLS_SPEC_TARGETS = $(subst /PIPE_SOFT3/,/PIPE_SOFT3_%/,$(BDW_execute_PIPE_SOFT3_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_execute_PIPE_SOFT3_HLS_TARGETS) :  ../src/execute.cpp   $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/execute/PIPE_SOFT3 ]; then mkdir -p $(BDW_WORKLIB)/modules/execute/PIPE_SOFT3; fi
	
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=PIPE_SOFT3 BDW_CYNTH_CONFIG=PIPE_SOFT3 \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/execute/PIPE_SOFT3/execute_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/execute/PIPE_SOFT3/execute_rtl.cpp \
		BDW_MODULE=execute \
		BDW_CYNTH_CONFIG=PIPE_SOFT3 \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/execute/PIPE_SOFT3 \
		BDW_HLS_CONFIG=PIPE_SOFT3 \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/execute/PIPE_SOFT3 \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_execute_PIPE_SOFT3)  \
		-d $(BDW_WORKLIB)/modules/execute/PIPE_SOFT3 -o execute_rtl.cpp \
		--hls_module=execute --hls_config=PIPE_SOFT3 --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_execute_PIPE_SOFT3))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_execute_PIPE_SOFT3))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_execute_PIPE_SOFT3))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_execute_PIPE_SOFT3)   \
		 ../src/execute.cpp
	
	
	
	

else

$(BDW_execute_PIPE_SOFT3_HLS_TARGETS) :  ../src/execute.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.execute.PIPE_SOFT3.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_execute_PIPE_SOFT3_HLS_TARGETS)

endif

	
$(BDW_WORKLIB)/modules/execute/PIPE_SOFT3/execute_trace.h : $(BDW_WORKLIB)/modules/execute/PIPE_SOFT3/execute_trace.h.updated

$(BDW_WORKLIB)/modules/execute/PIPE_SOFT3/execute_trace.h.updated : $(BDW_WORKLIB)/modules/execute/PIPE_SOFT3/execute_rtl.cpp $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module execute -cynthconfig PIPE_SOFT3  
	@touch $(BDW_WORKLIB)/modules/execute/PIPE_SOFT3/execute_trace.h.updated

ifeq ($(CWBExec_hlsc),1)

$(BDW_execute_PIPE_SOFT3_HLS_SPEC_TARGETS) :  ../src/execute.cpp   $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/execute/PIPE_SOFT3_$(*F) ]; then mkdir -p $(BDW_WORKLIB)/modules/execute/PIPE_SOFT3_$(*F); fi
	
	
	$(subst /PIPE_SOFT3 ,/PIPE_SOFT3_$(*F) ,$(subst =PIPE_SOFT3 ,=PIPE_SOFT3_$(*F) ,$(subst /execute/PIPE_SOFT3/,/execute/PIPE_SOFT3_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=PIPE_SOFT3 BDW_CYNTH_CONFIG=PIPE_SOFT3 \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/execute/PIPE_SOFT3/execute_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/execute/PIPE_SOFT3/execute_rtl.cpp \
		BDW_MODULE=execute \
		BDW_CYNTH_CONFIG=PIPE_SOFT3 \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/execute/PIPE_SOFT3 \
		BDW_HLS_CONFIG=PIPE_SOFT3 \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/execute/PIPE_SOFT3 \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_execute_PIPE_SOFT3)  \
		`cat  $(BDW_SPECLIB)/execute/PIPE_SOFT3.$(*F).bds | grep '^cmdline:' | sed 's/^cmdline://'`\
		-d $(BDW_WORKLIB)/modules/execute/PIPE_SOFT3 -o execute_rtl.cpp \
		--hls_module=execute --hls_config=PIPE_SOFT3 --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_execute_PIPE_SOFT3))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_execute_PIPE_SOFT3))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_execute_PIPE_SOFT3))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_execute_PIPE_SOFT3)   \
		 ../src/execute.cpp)))
	
	
	
	

else

$(BDW_execute_PIPE_SOFT3_HLS_SPEC_TARGETS) :  ../src/execute.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.execute.PIPE_SOFT3_$(*F).s $(MAKE) -j1 CWBExec_hlsc=1 $(subst %,$(*F),$(BDW_execute_PIPE_SOFT3_HLS_SPEC_TARGETS))

endif

	

$(subst /PIPE_SOFT3/,/PIPE_SOFT3_%/,$(BDW_WORKLIB)/modules/execute/PIPE_SOFT3/execute_trace.h) : $(subst /PIPE_SOFT3/,/PIPE_SOFT3_%/,$(BDW_WORKLIB)/modules/execute/PIPE_SOFT3/execute_rtl.cpp) $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module execute -cynthconfig PIPE_SOFT3_$(*F)  

