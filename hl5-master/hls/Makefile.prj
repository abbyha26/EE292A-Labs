optim_execute_RADIX_4_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(subst /RADIX_4/,/RADIX_4_$(*F)/,$(BDW_WORKLIB)/modules/execute/RADIX_4/stratus_hls.bdr)

sched_execute_RADIX_4_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(subst /RADIX_4/,/RADIX_4_$(*F)/,$(BDW_WORKLIB)/modules/execute/RADIX_4/stratus_hls.bdr)

hlsc_execute_RADIX_4_% hls_execute_RADIX_4_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /RADIX_4/,/RADIX_4_$(*F)/,$(BDW_WORKLIB)/modules/execute/RADIX_4/execute_rtl.cpp) BDW_DEP_CYNTH_CONFIG=RADIX_4 BDW_MODULE=execute BDW_HLS_CONFIG=RADIX_4_$(*F) 
else
	@bdw_exec -jobproject project.tcl -job hls.execute.RADIX_4_$(*F) $(MAKE) CWBExec_hls=1 hlsc_execute_RADIX_4_$(*F)
endif

clean_cynth_execute_RADIX_4_%: clean_hls_execute_RADIX_4_%

clean_execute_RADIX_4_%: clean_hls_execute_RADIX_4_%

clean_hls_execute_RADIX_4_%:
	@rm -rf $(BDW_WORKLIB)/modules/execute/RADIX_4_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.execute.RADIX_4_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.execute.RADIX_4_$(*F).s

kill_hls_execute_RADIX_4_%:
	@bdw_kill -job hls.execute.RADIX_4_$(*F)
	@bdw_kill -job hls.execute.RADIX_4_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),RADIX_4)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/execute/RADIX_4/execute.d
                -include $(memlib_WORKLIB)/memlib.d
                BDW_LIB_DEPS =  $(memlib_DEPS)
            endif
        endif
    endif
endif


html_execute_RADIX_4 :
	bdw_htmlgen -project project.tcl -module execute -cynthconfig RADIX_4

BDW_execute_RADIX_4_HLS_TARGETS := $(BDW_WORKLIB)/modules/execute/RADIX_4/execute_rtl.cpp $(BDW_WORKLIB)/modules/execute/RADIX_4/execute_rtl.v $(BDW_WORKLIB)/modules/execute/RADIX_4/stratus_hls.bdr
ifeq ($(BDW_BDR_ONLY),1)
.PHONY: $(filter %.bdr %.cpp,$(BDW_execute_RADIX_4_HLS_TARGETS))
$(filter %.v %.cpp,$(BDW_execute_RADIX_4_HLS_TARGETS)) : $(filter %.bdr,$(BDW_execute_RADIX_4_HLS_TARGETS))
BDW_execute_RADIX_4_HLS_TARGETS := $(filter %.bdr,$(BDW_execute_RADIX_4_HLS_TARGETS))
endif
BDW_execute_RADIX_4_HLS_SPEC_TARGETS = $(subst /RADIX_4/,/RADIX_4_%/,$(BDW_execute_RADIX_4_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_execute_RADIX_4_HLS_TARGETS) :  ../src/execute.cpp   $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/execute/RADIX_4 ]; then mkdir -p $(BDW_WORKLIB)/modules/execute/RADIX_4; fi
	
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=RADIX_4 BDW_CYNTH_CONFIG=RADIX_4 \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/execute/RADIX_4/execute_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/execute/RADIX_4/execute_rtl.cpp \
		BDW_MODULE=execute \
		BDW_CYNTH_CONFIG=RADIX_4 \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/execute/RADIX_4 \
		BDW_HLS_CONFIG=RADIX_4 \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/execute/RADIX_4 \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_execute_RADIX_4)  \
		-d $(BDW_WORKLIB)/modules/execute/RADIX_4 -o execute_rtl.cpp \
		--hls_module=execute --hls_config=RADIX_4 --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_execute_RADIX_4))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_execute_RADIX_4))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_execute_RADIX_4))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_execute_RADIX_4)   \
		 ../src/execute.cpp
	
	
	
	

else

$(BDW_execute_RADIX_4_HLS_TARGETS) :  ../src/execute.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.execute.RADIX_4.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_execute_RADIX_4_HLS_TARGETS)

endif

	
$(BDW_WORKLIB)/modules/execute/RADIX_4/execute_trace.h : $(BDW_WORKLIB)/modules/execute/RADIX_4/execute_trace.h.updated

$(BDW_WORKLIB)/modules/execute/RADIX_4/execute_trace.h.updated : $(BDW_WORKLIB)/modules/execute/RADIX_4/execute_rtl.cpp $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module execute -cynthconfig RADIX_4  
	@touch $(BDW_WORKLIB)/modules/execute/RADIX_4/execute_trace.h.updated

ifeq ($(CWBExec_hlsc),1)

$(BDW_execute_RADIX_4_HLS_SPEC_TARGETS) :  ../src/execute.cpp   $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/execute/RADIX_4_$(*F) ]; then mkdir -p $(BDW_WORKLIB)/modules/execute/RADIX_4_$(*F); fi
	
	
	$(subst /RADIX_4 ,/RADIX_4_$(*F) ,$(subst =RADIX_4 ,=RADIX_4_$(*F) ,$(subst /execute/RADIX_4/,/execute/RADIX_4_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=RADIX_4 BDW_CYNTH_CONFIG=RADIX_4 \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/execute/RADIX_4/execute_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/execute/RADIX_4/execute_rtl.cpp \
		BDW_MODULE=execute \
		BDW_CYNTH_CONFIG=RADIX_4 \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/execute/RADIX_4 \
		BDW_HLS_CONFIG=RADIX_4 \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/execute/RADIX_4 \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_execute_RADIX_4)  \
		`cat  $(BDW_SPECLIB)/execute/RADIX_4.$(*F).bds | grep '^cmdline:' | sed 's/^cmdline://'`\
		-d $(BDW_WORKLIB)/modules/execute/RADIX_4 -o execute_rtl.cpp \
		--hls_module=execute --hls_config=RADIX_4 --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_execute_RADIX_4))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_execute_RADIX_4))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_execute_RADIX_4))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_execute_RADIX_4)   \
		 ../src/execute.cpp)))
	
	
	
	

else

$(BDW_execute_RADIX_4_HLS_SPEC_TARGETS) :  ../src/execute.cpp  $(BDW_LIB_DEPS)
