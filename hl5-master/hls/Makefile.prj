BDW_NCSC_INPUT_FILE = -input $(BDW_SIM_CONFIG_DIR)/ncsim_cmd.tcl
BDW_ESC_LIB = $(libesc_WORKDIR)/libesc.a
BDW_SIM_CONFIG_DIR  =   $(BDW_SIMDIR)/$(BDW_SIM_CONFIG)
ifeq ($(BDW_DEBUG),1)
SIM_OBJS			=	$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/xcelium/debug/fedec_hoist.o $(BDW_WORKLIB)/modules/execute/PIPE_SOFT1/xcelium/debug/execute.o $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3/xcelium/debug/memwb_hoist.o $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT1/xcelium/debug/hl5_hoist.o $(BDW_WORKLIB)/modules/main/PIN/xcelium/debug/sc_main_beh.o $(BDW_WORKLIB)/modules/system/PIN/xcelium/debug/system_beh.o $(BDW_WORKLIB)/modules/tb/PIN/xcelium/debug/tb_beh.o $(BDW_OBJS) 
