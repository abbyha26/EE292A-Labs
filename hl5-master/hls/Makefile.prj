$(BDW_WORKLIB)/sims/top_DPA_basic_GP.v : top_v.bdt $(BDW_LOGOPTIONS_FILE) $(BDW_WORKLIB)/modules/hl5/DPA/hl5_rtl.v   $(BDW_VLOG_DUT_FILES)
	@if [ ! -d $(BDW_WRAPDIR) ]; then mkdir -p $(BDW_WRAPDIR); fi
	$(BDW_WRAPGEN_COMMAND) -project project.tcl -simconfig DPA_basic_GP -top top

$(subst .v,_%.v,$(BDW_WORKLIB)/sims/top_DPA_basic_GP.v) : top_v.bdt $(BDW_LOGOPTIONS_FILE) $(BDW_WORKLIB)/modules/hl5/DPA/hl5_rtl.v  
	@$(MAKE) `$(BDW_SPEC_FILTER) project.db $(*F) $(BDW_VLOG_DUT_FILES)`
	@if [ ! -d $(BDW_WRAPDIR) ]; then mkdir -p $(BDW_WRAPDIR); fi
	$(BDW_WRAPGEN_COMMAND) -project project.tcl -simconfig DPA_basic_GP_$(*F) -top top




