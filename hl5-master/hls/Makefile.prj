	@rm -f $(BDW_WORKLIB)/modules/execute/PIN/execute_rtl.cpp $(BDW_WORKLIB)/modules/execute/PIN/stratus_hls.bdr
	@rm -f $(BDW_WORKLIB)/modules/memwb/PIN/memwb_rtl.cpp $(BDW_WORKLIB)/modules/memwb/PIN/stratus_hls.bdr
	@rm -f $(BDW_WORKLIB)/modules/hl5/PIN/hl5_rtl.cpp $(BDW_WORKLIB)/modules/hl5/PIN/stratus_hls.bdr



##############################################################################
#   start of rules for logic synthesis
##############################################################################

synth1target:
	@echo "NOTE 02926: BEGIN EXTERNAL TOOL PROCESSING"
ifneq ($(PASSED_LOG),)
	rm -f $(PASSED_LOG)
endif
	@if [ ! -d $(BDW_LS_CONFIG_DIR) ]; then mkdir -p $(BDW_LS_CONFIG_DIR); fi
	@rm -rf $(BDW_LS_CONFIG_LOGS)
	@$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_synthinfo.tcl
ifeq ($(BDW_USE_GRID_INT),1)
	@date +"INFO: %D %T ${@} in `pwd` BDW_LS_LIC='${BDW_LS_LIC}' BDW_LS_CMD='${BDW_LS_CMD}' STARTED"
ifeq ($(BDW_LS_LIC),)
	@echo "****** Error: synth1target FAILED because BDW_LS_LIC was not set"; exit 1
endif
endif
ifeq ($(CWBExec_ls_tool),1)
	@$(BDW_LS_CMD)
else
	@$(BDW_EXEC_CMD) bdw_exec -jobproject project.tcl -job ls.$(BDW_LS_CONFIG).s $(BDW_LS_CMD)
endif
ifeq ($(BDW_USE_GRID_INT),1)
	@date +"INFO: %D %T ${@} in `pwd` BDW_LS_LIC='${BDW_LS_LIC}' BDW_LS_CMD='${BDW_LS_CMD}' FINISHED"
endif


#
#   Rules for logicSynth config G_BASIC
#


ifeq ($(CWBExec_ls),1)
ls_G_BASIC:
	@$(BDW_LAUNCH_LOGIC_SYNTHESIS_COMMAND) $(MAKE) $(BDW_WORKLIB)/logicsynth/G_BASIC/hl5_gates.v
else
.PHONY: ls_G_BASIC

ls_G_BASIC:
	@bdw_exec -jobproject project.tcl -job ls.G_BASIC $(MAKE) CWBExec_ls=1 ls_G_BASIC

ls_sub_G_BASIC:
	@bdw_exec -jobproject project.tcl -job ls_sub.G_BASIC.s $(MAKE) CWBExec_ls=1 ls_G_BASIC
endif

kill_ls_G_BASIC:
	@bdw_kill -job ls.G_BASIC
	@bdw_kill -job ls.G_BASIC.s

clean_ls_G_BASIC:
	@rm -rf $(BDW_WORKLIB)/logicsynth/G_BASIC
	@rm -rf $(BDW_WORKLIB)/jobs/ls.G_BASIC
	@rm -rf $(BDW_WORKLIB)/jobs/ls.G_BASIC.s

$(BDW_WORKLIB)/logicsynth/G_BASIC/hl5_gates.v:  $(BDW_WORKLIB)/modules/fedec/BASIC/fedec_rtl.v  $(BDW_WORKLIB)/modules/execute/BASIC/execute_rtl.v  $(BDW_WORKLIB)/modules/memwb/BASIC/memwb_rtl.v  $(BDW_WORKLIB)/modules/hl5/BASIC/hl5_rtl.v 
	@$(MAKE) -j1  $(BDW_WORKLIB)/modules/fedec/BASIC/fedec_rtl.v  $(BDW_WORKLIB)/modules/execute/BASIC/execute_rtl.v  $(BDW_WORKLIB)/modules/memwb/BASIC/memwb_rtl.v 
	@$(MAKE) -j1  $(BDW_WORKLIB)/modules/hl5/BASIC/hl5_rtl.v 

ifneq ($(BDW_VLOG_LIBPREP),)
	@$(MAKE) $(BDW_VLOG_LIBPREP)
endif 
	@$(MAKE) synth1target BDW_LS_CONFIG=G_BASIC BDW_MODULE=hl5 \
		BDW_LS_CONFIG_DIR=$(BDW_WORKLIB)/logicsynth/G_BASIC \
		BDW_LS_CONFIG_LOGS="$(BDW_WORKLIB)/logicsynth/G_BASIC/hl5.log $(BDW_WORKLIB)/logicsynth/G_BASIC/hl5.bdr $(BDW_WORKLIB)/logicsynth/G_BASIC/fedec.log $(BDW_WORKLIB)/logicsynth/G_BASIC/fedec.bdr $(BDW_WORKLIB)/logicsynth/G_BASIC/execute.log $(BDW_WORKLIB)/logicsynth/G_BASIC/execute.bdr $(BDW_WORKLIB)/logicsynth/G_BASIC/memwb.log $(BDW_WORKLIB)/logicsynth/G_BASIC/memwb.bdr" \
		BDW_LS_CMD="bdw_rungenus" \
		BDW_UPF_DATA_FILES="$(BDW_WORKLIB)/modules/hl5/BASIC/hl5_upf.data $(BDW_WORKLIB)/modules/fedec/BASIC/fedec_upf.data $(BDW_WORKLIB)/modules/execute/BASIC/execute_upf.data $(BDW_WORKLIB)/modules/memwb/BASIC/memwb_upf.data" \
		BDW_UPF_MODULES="hl5 fedec execute memwb" \
		BDW_PWR_DASH_NETLIST=0 \
		BDW_LS_INFO=$(BDW_WORKLIB)/logicsynth/G_BASIC/hl5.info \


view_ls_G_BASIC: 
	@echo "ERROR: Schematic viewing target 'view_ls_G_BASIC' is only supported with 'verdi'"
	@echo "The Stratus IDE includes a schematic view as an alternative."

ifeq ($(CWBExec_ls),1)
ls_G_BASIC_%:
	@$(BDW_LAUNCH_LOGIC_SYNTHESIS_COMMAND) $(MAKE) $(subst /G_BASIC,/G_BASIC_$(*F),$(BDW_WORKLIB)/logicsynth/G_BASIC/hl5_gates.v)
else
.PHONY: ls_G_BASIC

ls_G_BASIC_%:
	@bdw_exec -jobproject project.tcl -job ls.G_BASIC_$(*F) $(MAKE) CWBExec_ls=1 ls_G_BASIC_$(*F)

ls_sub_G_BASIC_%:
	@bdw_exec -jobproject project.tcl -job ls_sub.G_BASIC_$(*F).s $(MAKE) CWBExec_ls=1 ls_G_BASIC_$(*F)
endif

kill_ls_G_BASIC_%:
	@bdw_kill -job ls.G_BASIC_$(*F)
	@bdw_kill -job ls.G_BASIC_$(*F).s

clean_ls_G_BASIC_%:
	@rm -rf $(subst /G_BASIC,/G_BASIC_$(*F),$(BDW_WORKLIB)/logicsynth/G_BASIC)
	@rm -rf $(BDW_WORKLIB)/jobs/ls.G_BASIC_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/ls.G_BASIC_$(*F).s

$(subst /G_BASIC/,/G_BASIC_%/,$(BDW_WORKLIB)/logicsynth/G_BASIC/hl5_gates.v):  $(BDW_WORKLIB)/modules/fedec/BASIC/fedec_rtl.v  $(BDW_WORKLIB)/modules/execute/BASIC/execute_rtl.v  $(BDW_WORKLIB)/modules/memwb/BASIC/memwb_rtl.v  $(BDW_WORKLIB)/modules/hl5/BASIC/hl5_rtl.v 
	@$(BDW_SPEC_CHECK) ${BDW_PROJECT_FILE} logic_synth_config G_BASIC_$(*F)
	@$(MAKE) -j1 `$(BDW_SPEC_FILTER) project.db $(*F)  $(BDW_WORKLIB)/modules/fedec/BASIC/fedec_rtl.v  $(BDW_WORKLIB)/modules/execute/BASIC/execute_rtl.v  $(BDW_WORKLIB)/modules/memwb/BASIC/memwb_rtl.v `
	@$(MAKE) -j1 `$(BDW_SPEC_FILTER) project.db $(*F)  $(BDW_WORKLIB)/modules/hl5/BASIC/hl5_rtl.v `

ifneq ($(BDW_VLOG_LIBPREP),)
	@$(MAKE) $(BDW_VLOG_LIBPREP)
endif 
	@$(MAKE) synth1target BDW_LS_CONFIG=G_BASIC_$(*F) BDW_MODULE=hl5 \
		BDW_LS_CONFIG_DIR=$(subst /G_BASIC,/G_BASIC_$(*F),$(BDW_WORKLIB)/logicsynth/G_BASIC) \
		BDW_LS_CONFIG_LOGS=$(subst /G_BASIC/,/G_BASIC_$(*F)/,"$(BDW_WORKLIB)/logicsynth/G_BASIC/hl5.log $(BDW_WORKLIB)/logicsynth/G_BASIC/hl5.bdr $(BDW_WORKLIB)/logicsynth/G_BASIC/fedec.log $(BDW_WORKLIB)/logicsynth/G_BASIC/fedec.bdr $(BDW_WORKLIB)/logicsynth/G_BASIC/execute.log $(BDW_WORKLIB)/logicsynth/G_BASIC/execute.bdr $(BDW_WORKLIB)/logicsynth/G_BASIC/memwb.log $(BDW_WORKLIB)/logicsynth/G_BASIC/memwb.bdr") \
		BDW_LS_CMD="bdw_rungenus" \
		BDW_UPF_DATA_FILES=`$(BDW_SPEC_FILTER) project.db $(*F) "$(BDW_WORKLIB)/modules/hl5/BASIC/hl5_upf.data $(BDW_WORKLIB)/modules/fedec/BASIC/fedec_upf.data $(BDW_WORKLIB)/modules/execute/BASIC/execute_upf.data $(BDW_WORKLIB)/modules/memwb/BASIC/memwb_upf.data"` \
		BDW_UPF_MODULES="hl5 fedec execute memwb" \
		BDW_PWR_DASH_NETLIST=0 \
		BDW_LS_INFO=$(subst /G_BASIC/,/G_BASIC_$(*F)/,$(BDW_WORKLIB)/logicsynth/G_BASIC/hl5.info) \


view_ls_G_BASIC_%: 
	@echo "ERROR: Schematic viewing target 'view_ls_G_BASIC_$(*F)' is only supported with 'verdi'"
	@echo "The Stratus IDE includes a schematic view as an alternative."

