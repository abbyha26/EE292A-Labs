sched_fedec_RADIX_4 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/fedec/RADIX_4/stratus_hls.bdr

hlsc_fedec_RADIX_4 : 
