#
#	RTL object file rule
#
$(subst /PIPE_SOFT3/,/PIPE_SOFT3$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/xcelium/fedec_rtl.o) : $(subst /PIPE_SOFT3/,/PIPE_SOFT3$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/fedec_rtl.cpp) $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(subst /PIPE_SOFT3/,/PIPE_SOFT3$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/fedec_trace.h)
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl fedec`
	$(subst /PIPE_SOFT3/,/PIPE_SOFT3$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/ -I./ $(CCFLAGS_fedec_PIPE_SOFT3) $(EXTRACT_LIB_DASHI_fedec_PIPE_SOFT3) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/xcelium/fedec_rtl.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp)

$(subst /PIPE_SOFT3/,/PIPE_SOFT3$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/xcelium/debug/fedec_rtl.o) : $(subst /PIPE_SOFT3/,/PIPE_SOFT3$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/fedec_rtl.cpp) $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(subst /PIPE_SOFT3/,/PIPE_SOFT3$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/fedec_trace.h)
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl fedec`
	$(subst /PIPE_SOFT3/,/PIPE_SOFT3$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/ -I./ $(CCFLAGS_fedec_PIPE_SOFT3) $(EXTRACT_LIB_DASHI_fedec_PIPE_SOFT3) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/xcelium/debug/fedec_rtl.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp)

#
#	Behavioral object file rule.  Used only for BEH configs that are 
#	associated with HLS config names.
#

$(subst /PIPE_SOFT3/,/PIPE_SOFT3$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/xcelium/fedec_beh.o) :  ../src/fedec.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(subst /PIPE_SOFT3/,/PIPE_SOFT3$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/fedec_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /PIPE_SOFT3/,/PIPE_SOFT3$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/ -I./ $(CCFLAGS_BEH_fedec_PIPE_SOFT3) -o $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/xcelium/fedec_beh.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp)

$(subst /PIPE_SOFT3/,/PIPE_SOFT3$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/xcelium/debug/fedec_beh.o) :  ../src/fedec.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(subst /PIPE_SOFT3/,/PIPE_SOFT3$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/fedec_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /PIPE_SOFT3/,/PIPE_SOFT3$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/ -I./ $(CCFLAGS_BEH_fedec_PIPE_SOFT3) -o $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/xcelium/debug/fedec_beh.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp)

#
# Cosim object file rule
#

$(subst /PIPE_SOFT3/,/PIPE_SOFT3$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/xcelium/fedec.o) :  ../src/fedec.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(subst /PIPE_SOFT3/,/PIPE_SOFT3$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/fedec_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /PIPE_SOFT3/,/PIPE_SOFT3$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/ -I./ $(CCFLAGS_COSIM_fedec_PIPE_SOFT3) -o $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/xcelium/fedec.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp)
    

$(subst /PIPE_SOFT3/,/PIPE_SOFT3$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/xcelium/fedec_hoist.o) :  ../src/fedec.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(subst /PIPE_SOFT3/,/PIPE_SOFT3$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/fedec_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /PIPE_SOFT3/,/PIPE_SOFT3$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/ -I./ $(CCFLAGS_fedec_PIPE_SOFT3) $(EXTRACT_LIB_DASHI_fedec_PIPE_SOFT3) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/xcelium/fedec_hoist.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp)
    

$(subst /PIPE_SOFT3/,/PIPE_SOFT3$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/xcelium/debug/fedec.o) :  ../src/fedec.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(subst /PIPE_SOFT3/,/PIPE_SOFT3$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/fedec_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /PIPE_SOFT3/,/PIPE_SOFT3$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/ -I./ $(CCFLAGS_COSIM_fedec_PIPE_SOFT3) -o $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/xcelium/debug/fedec.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp)


$(subst /PIPE_SOFT3/,/PIPE_SOFT3$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/xcelium/debug/fedec_hoist.o) :  ../src/fedec.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(subst /PIPE_SOFT3/,/PIPE_SOFT3$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/fedec_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /PIPE_SOFT3/,/PIPE_SOFT3$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/ -I./ $(CCFLAGS_fedec_PIPE_SOFT3) $(EXTRACT_LIB_DASHI_fedec_PIPE_SOFT3) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/xcelium/debug/fedec_hoist.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp)
    
endif

#
#	Dependency generation rule
#
$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/fedec.d :  ../src/fedec.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config PIPE_SOFT3 of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_fedec_PIPE_SOFT3)  ../src/fedec.cpp \
	| sed 's|fedec\.o[ :]*|$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/fedec_rtl.cpp $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/xcelium/fedec_beh.o $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/xcelium/debug/fedec_beh.o $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/fedec.d : $(memlib_WORKLIB)/memlib.d |' $(BDW_DEP_FILTER)  > $@

#
#	Library post-proc rules
#



##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3"
##############################################################

fedec_PIPE_SOFT3_SRCDIR = $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3
fedec_PIPE_SOFT3_BEH_SRCDIR = $(BDW_WORKLIB)/libs/fedec_PIPE_SOFT3
fedec_PIPE_SOFT3_LIBNAME = fedec_PIPE_SOFT3
fedec_PIPE_SOFT3_WORKLIB = $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT3/xcelium
fedec_PIPE_SOFT3_C_PARTS_A = $(fedec_PIPE_SOFT3_WORKLIB)/objs/libfedec_PIPE_SOFT3.a

prep_c_fedec_PIPE_SOFT3 : $(fedec_PIPE_SOFT3_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(fedec_PIPE_SOFT3_WORKLIB) prep_c

prep_vlog_fedec_PIPE_SOFT3 : $(fedec_PIPE_SOFT3_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(fedec_PIPE_SOFT3_WORKLIB) prep_vlog

prep_fedec_PIPE_SOFT3 : $(fedec_PIPE_SOFT3_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(fedec_PIPE_SOFT3_WORKLIB) prep

$(fedec_PIPE_SOFT3_WORKLIB)/Makefile : $(fedec_PIPE_SOFT3_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(fedec_PIPE_SOFT3_WORKLIB) ]; then mkdir -p $(fedec_PIPE_SOFT3_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(fedec_PIPE_SOFT3_SRCDIR) -o $(fedec_PIPE_SOFT3_WORKLIB)/Makefile -module fedec -cynthconfig PIPE_SOFT3   

$(fedec_PIPE_SOFT3_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(fedec_PIPE_SOFT3_WORKLIB) ]; then mkdir -p $(fedec_PIPE_SOFT3_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



prep_c_fedec_PIPE_SOFT3_% : $(subst PIPE_SOFT3,PIPE_SOFT3_%,$(fedec_PIPE_SOFT3_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst PIPE_SOFT3,PIPE_SOFT3_$(*F),$(fedec_PIPE_SOFT3_WORKLIB)) prep_c

prep_vlog_fedec_PIPE_SOFT3_% : $(subst PIPE_SOFT3,PIPE_SOFT3_%,$(fedec_PIPE_SOFT3_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst PIPE_SOFT3,PIPE_SOFT3_$(*F),$(fedec_PIPE_SOFT3_WORKLIB)) prep_vlog

prep_fedec_PIPE_SOFT3_% : $(subst PIPE_SOFT3,PIPE_SOFT3_%,$(fedec_PIPE_SOFT3_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst PIPE_SOFT3,PIPE_SOFT3_$(*F),$(fedec_PIPE_SOFT3_WORKLIB)) prep

$(subst PIPE_SOFT3,PIPE_SOFT3_%,$(fedec_PIPE_SOFT3_WORKLIB))/Makefile : $(fedec_PIPE_SOFT3_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(subst PIPE_SOFT3,PIPE_SOFT3_$(*F),$(fedec_PIPE_SOFT3_WORKLIB)) ]; then mkdir -p $(subst PIPE_SOFT3,PIPE_SOFT3_$(*F),$(fedec_PIPE_SOFT3_WORKLIB)); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(fedec_PIPE_SOFT3_SRCDIR)_$(*F) -o $(subst PIPE_SOFT3,PIPE_SOFT3_$(*F),$(fedec_PIPE_SOFT3_WORKLIB))/Makefile -module fedec -cynthconfig PIPE_SOFT3_$(*F)   

$(fedec_PIPE_SOFT3_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(subst PIPE_SOFT3,PIPE_SOFT3_$(*F),$(fedec_PIPE_SOFT3_WORKLIB)) ]; then mkdir -p $(subst PIPE_SOFT3,PIPE_SOFT3_$(*F),$(fedec_PIPE_SOFT3_WORKLIB)); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(fedec_PIPE_SOFT3_WORKLIB)/fedec_PIPE_SOFT3.d :
	@if [ ! -d $(fedec_PIPE_SOFT3_WORKLIB) ]; then mkdir -p $(fedec_PIPE_SOFT3_WORKLIB); fi
	@touch $(fedec_PIPE_SOFT3_WORKLIB)/fedec_PIPE_SOFT3.d



#
# HLS config RADIX_2
#

#
#	stratus_hls rule
#
LIB_DIRS_fedec_RADIX_2 = $(memlib_SRCDIR) 
LIB_INCLUDES_fedec_RADIX_2 = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_fedec_RADIX_2))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_fedec_RADIX_2 = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_fedec_RADIX_2 = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_fedec_RADIX_2 = 
EXTRACT_LIB_DASHI_fedec_RADIX_2 = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl fedec RADIX_2]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_fedec_RADIX_2 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/fedec/RADIX_2/c_parts -DRADIX_2=1 -DBDW_RTL_fedec_RADIX_2=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DDIV_RADIX_2 $(LIB_INCLUDES_fedec_RADIX_2)
CCFLAGS_COSIM_fedec_RADIX_2 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/fedec/RADIX_2/c_parts -DRADIX_2=1 -DBDW_RTL_fedec_RADIX_2=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DDIV_RADIX_2 $(LIB_INCLUDES_fedec_RADIX_2)
CCFLAGS_BEH_fedec_RADIX_2 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/fedec/RADIX_2/c_parts -DRADIX_2=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DDIV_RADIX_2 $(LIB_INCLUDES_fedec_RADIX_2)
CCFLAGS_fedec_RADIX_2 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_fedec_RADIX_2 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_fedec_RADIX_2 += ${BDW_CCFLAGS_TAIL}

.PHONY: hlsc_fedec_RADIX_2 hls_fedec_RADIX_2

hls_fedec_RADIX_2 : hlsc_fedec_RADIX_2

cynth_fedec_RADIX_2 : hlsc_fedec_RADIX_2

elab_fedec_RADIX_2 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/fedec/RADIX_2/stratus_hls.bdr

optim_fedec_RADIX_2 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/fedec/RADIX_2/stratus_hls.bdr

sched_fedec_RADIX_2 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/fedec/RADIX_2/stratus_hls.bdr

hlsc_fedec_RADIX_2 : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/fedec/RADIX_2/fedec_rtl.cpp BDW_DEP_CYNTH_CONFIG=RADIX_2 BDW_MODULE=fedec BDW_HLS_CONFIG=RADIX_2 
else
	@bdw_exec -jobproject project.tcl -job hls.fedec.RADIX_2 $(MAKE) CWBExec_hls=1 hlsc_fedec_RADIX_2
endif

clean_cynth_fedec_RADIX_2: clean_hls_fedec_RADIX_2

clean_fedec_RADIX_2: clean_hls_fedec_RADIX_2

clean_hls_fedec_RADIX_2:
	@rm -rf $(BDW_WORKLIB)/modules/fedec/RADIX_2
	@rm -rf $(BDW_WORKLIB)/jobs/hls.fedec.RADIX_2
	@rm -rf $(BDW_WORKLIB)/jobs/hls.fedec.RADIX_2.s

kill_hls_fedec_RADIX_2:
	@bdw_kill -job hls.fedec.RADIX_2
	@bdw_kill -job hls.fedec.RADIX_2.s


hls_fedec_RADIX_2_% : hlsc_fedec_RADIX_2_%

cynth_fedec_RADIX_2_% : hlsc_fedec_RADIX_2_%

elab_fedec_RADIX_2_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(subst /RADIX_2/,/RADIX_2_$(*F)/,$(BDW_WORKLIB)/modules/fedec/RADIX_2/stratus_hls.bdr)

optim_fedec_RADIX_2_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(subst /RADIX_2/,/RADIX_2_$(*F)/,$(BDW_WORKLIB)/modules/fedec/RADIX_2/stratus_hls.bdr)

sched_fedec_RADIX_2_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(subst /RADIX_2/,/RADIX_2_$(*F)/,$(BDW_WORKLIB)/modules/fedec/RADIX_2/stratus_hls.bdr)

hlsc_fedec_RADIX_2_% hls_fedec_RADIX_2_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /RADIX_2/,/RADIX_2_$(*F)/,$(BDW_WORKLIB)/modules/fedec/RADIX_2/fedec_rtl.cpp) BDW_DEP_CYNTH_CONFIG=RADIX_2 BDW_MODULE=fedec BDW_HLS_CONFIG=RADIX_2_$(*F) 
else
	@bdw_exec -jobproject project.tcl -job hls.fedec.RADIX_2_$(*F) $(MAKE) CWBExec_hls=1 hlsc_fedec_RADIX_2_$(*F)
endif

clean_cynth_fedec_RADIX_2_%: clean_hls_fedec_RADIX_2_%

clean_fedec_RADIX_2_%: clean_hls_fedec_RADIX_2_%

clean_hls_fedec_RADIX_2_%:
	@rm -rf $(BDW_WORKLIB)/modules/fedec/RADIX_2_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.fedec.RADIX_2_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.fedec.RADIX_2_$(*F).s

kill_hls_fedec_RADIX_2_%:
	@bdw_kill -job hls.fedec.RADIX_2_$(*F)
	@bdw_kill -job hls.fedec.RADIX_2_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),RADIX_2)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/fedec/RADIX_2/fedec.d
                -include $(memlib_WORKLIB)/memlib.d
                BDW_LIB_DEPS =  $(memlib_DEPS)
            endif
        endif
    endif
endif


html_fedec_RADIX_2 :
	bdw_htmlgen -project project.tcl -module fedec -cynthconfig RADIX_2

BDW_fedec_RADIX_2_HLS_TARGETS := $(BDW_WORKLIB)/modules/fedec/RADIX_2/fedec_rtl.cpp $(BDW_WORKLIB)/modules/fedec/RADIX_2/fedec_rtl.v $(BDW_WORKLIB)/modules/fedec/RADIX_2/stratus_hls.bdr
ifeq ($(BDW_BDR_ONLY),1)
.PHONY: $(filter %.bdr %.cpp,$(BDW_fedec_RADIX_2_HLS_TARGETS))
$(filter %.v %.cpp,$(BDW_fedec_RADIX_2_HLS_TARGETS)) : $(filter %.bdr,$(BDW_fedec_RADIX_2_HLS_TARGETS))
BDW_fedec_RADIX_2_HLS_TARGETS := $(filter %.bdr,$(BDW_fedec_RADIX_2_HLS_TARGETS))
endif
BDW_fedec_RADIX_2_HLS_SPEC_TARGETS = $(subst /RADIX_2/,/RADIX_2_%/,$(BDW_fedec_RADIX_2_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_fedec_RADIX_2_HLS_TARGETS) :  ../src/fedec.cpp   $(BDW_LIB_DEPS)
	+make --no-print-directory  $(BDW_WORKLIB)/wrappers/hl5_wrap.h
	@if [ ! -d $(BDW_WORKLIB)/modules/fedec/RADIX_2 ]; then mkdir -p $(BDW_WORKLIB)/modules/fedec/RADIX_2; fi
	
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=RADIX_2 BDW_CYNTH_CONFIG=RADIX_2 \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/fedec/RADIX_2/fedec_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/fedec/RADIX_2/fedec_rtl.cpp \
		BDW_MODULE=fedec \
		BDW_CYNTH_CONFIG=RADIX_2 \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/fedec/RADIX_2 \
		BDW_HLS_CONFIG=RADIX_2 \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/fedec/RADIX_2 \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_fedec_RADIX_2)  \
		-d $(BDW_WORKLIB)/modules/fedec/RADIX_2 -o fedec_rtl.cpp \
		--hls_module=fedec --hls_config=RADIX_2 --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_fedec_RADIX_2))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_fedec_RADIX_2))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_fedec_RADIX_2))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_fedec_RADIX_2)   \
		 ../src/fedec.cpp
	
	
	
	

else

$(BDW_fedec_RADIX_2_HLS_TARGETS) :  ../src/fedec.cpp  $(BDW_LIB_DEPS)
