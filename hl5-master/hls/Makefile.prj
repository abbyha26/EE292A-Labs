#

$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/xcelium/memwb.o :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(BDW_WORKLIB)/wrappers/memwb_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/ -I./ $(CCFLAGS_COSIM_memwb_PIPE_SOFT2) -o $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/xcelium/memwb.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp
    

$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/xcelium/memwb_hoist.o :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(BDW_WORKLIB)/wrappers/memwb_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/ -I./ $(CCFLAGS_memwb_PIPE_SOFT2) $(EXTRACT_LIB_DASHI_memwb_PIPE_SOFT2) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/xcelium/memwb_hoist.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp
    

$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/xcelium/debug/memwb.o :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(BDW_WORKLIB)/wrappers/memwb_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/ -I./ $(CCFLAGS_COSIM_memwb_PIPE_SOFT2) -o $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/xcelium/debug/memwb.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp


$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/xcelium/debug/memwb_hoist.o :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(BDW_WORKLIB)/wrappers/memwb_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/ -I./ $(CCFLAGS_memwb_PIPE_SOFT2) $(EXTRACT_LIB_DASHI_memwb_PIPE_SOFT2) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/xcelium/debug/memwb_hoist.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp
    

