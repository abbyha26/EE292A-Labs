#
#	Dependency generation rule
#
$(BDW_WORKLIB)/modules/execute/PIN/execute.d :  ../src/execute.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config PIN of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_execute_PIN)  ../src/execute.cpp \
	| sed 's|execute\.o[ :]*|$(BDW_WORKLIB)/modules/execute/PIN/execute_rtl.cpp $(BDW_WORKLIB)/modules/execute/PIN/xcelium/execute_beh.o $(BDW_WORKLIB)/modules/execute/PIN/xcelium/debug/execute_beh.o $(BDW_WORKLIB)/modules/execute/PIN/execute.d : $(memlib_WORKLIB)/memlib.d |' $(BDW_DEP_FILTER)  > $@

#
#	Library post-proc rules
#



##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/execute/PIN"
##############################################################

execute_PIN_SRCDIR = $(BDW_WORKLIB)/modules/execute/PIN
execute_PIN_BEH_SRCDIR = $(BDW_WORKLIB)/libs/execute_PIN
execute_PIN_LIBNAME = execute_PIN
execute_PIN_WORKLIB = $(BDW_WORKLIB)/modules/execute/PIN/xcelium
execute_PIN_C_PARTS_A = $(execute_PIN_WORKLIB)/objs/libexecute_PIN.a

prep_c_execute_PIN : $(execute_PIN_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(execute_PIN_WORKLIB) prep_c

prep_vlog_execute_PIN : $(execute_PIN_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(execute_PIN_WORKLIB) prep_vlog

prep_execute_PIN : $(execute_PIN_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(execute_PIN_WORKLIB) prep

$(execute_PIN_WORKLIB)/Makefile : $(execute_PIN_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(execute_PIN_WORKLIB) ]; then mkdir -p $(execute_PIN_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(execute_PIN_SRCDIR) -o $(execute_PIN_WORKLIB)/Makefile -module execute -cynthconfig PIN   

$(execute_PIN_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(execute_PIN_WORKLIB) ]; then mkdir -p $(execute_PIN_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



prep_c_execute_PIN_% : $(subst PIN,PIN_%,$(execute_PIN_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst PIN,PIN_$(*F),$(execute_PIN_WORKLIB)) prep_c

prep_vlog_execute_PIN_% : $(subst PIN,PIN_%,$(execute_PIN_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst PIN,PIN_$(*F),$(execute_PIN_WORKLIB)) prep_vlog

prep_execute_PIN_% : $(subst PIN,PIN_%,$(execute_PIN_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst PIN,PIN_$(*F),$(execute_PIN_WORKLIB)) prep

$(subst PIN,PIN_%,$(execute_PIN_WORKLIB))/Makefile : $(execute_PIN_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(subst PIN,PIN_$(*F),$(execute_PIN_WORKLIB)) ]; then mkdir -p $(subst PIN,PIN_$(*F),$(execute_PIN_WORKLIB)); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(execute_PIN_SRCDIR)_$(*F) -o $(subst PIN,PIN_$(*F),$(execute_PIN_WORKLIB))/Makefile -module execute -cynthconfig PIN_$(*F)   

$(execute_PIN_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(subst PIN,PIN_$(*F),$(execute_PIN_WORKLIB)) ]; then mkdir -p $(subst PIN,PIN_$(*F),$(execute_PIN_WORKLIB)); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(execute_PIN_WORKLIB)/execute_PIN.d :
	@if [ ! -d $(execute_PIN_WORKLIB) ]; then mkdir -p $(execute_PIN_WORKLIB); fi
	@touch $(execute_PIN_WORKLIB)/execute_PIN.d



#
# HLS config BASIC
#

#
#	stratus_hls rule
#
LIB_DIRS_execute_BASIC = $(memlib_SRCDIR) 
LIB_INCLUDES_execute_BASIC = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_execute_BASIC))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_execute_BASIC = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_execute_BASIC = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_execute_BASIC = 
EXTRACT_LIB_DASHI_execute_BASIC = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl execute BASIC]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_execute_BASIC = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/execute/BASIC/c_parts -DBASIC=1 -DBDW_RTL_execute_BASIC=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_execute_BASIC)
CCFLAGS_COSIM_execute_BASIC = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/execute/BASIC/c_parts -DBASIC=1 -DBDW_RTL_execute_BASIC=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_execute_BASIC)
CCFLAGS_BEH_execute_BASIC = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/execute/BASIC/c_parts -DBASIC=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_execute_BASIC)
CCFLAGS_execute_BASIC += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_execute_BASIC += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_execute_BASIC += ${BDW_CCFLAGS_TAIL}

.PHONY: hlsc_execute_BASIC hls_execute_BASIC

hls_execute_BASIC : hlsc_execute_BASIC

cynth_execute_BASIC : hlsc_execute_BASIC

elab_execute_BASIC : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/execute/BASIC/stratus_hls.bdr

optim_execute_BASIC : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/execute/BASIC/stratus_hls.bdr

sched_execute_BASIC : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/execute/BASIC/stratus_hls.bdr

hlsc_execute_BASIC : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/execute/BASIC/execute_rtl.cpp BDW_DEP_CYNTH_CONFIG=BASIC BDW_MODULE=execute BDW_HLS_CONFIG=BASIC 
else
	@bdw_exec -jobproject project.tcl -job hls.execute.BASIC $(MAKE) CWBExec_hls=1 hlsc_execute_BASIC
endif

clean_cynth_execute_BASIC: clean_hls_execute_BASIC

clean_execute_BASIC: clean_hls_execute_BASIC

clean_hls_execute_BASIC:
	@rm -rf $(BDW_WORKLIB)/modules/execute/BASIC
	@rm -rf $(BDW_WORKLIB)/jobs/hls.execute.BASIC
	@rm -rf $(BDW_WORKLIB)/jobs/hls.execute.BASIC.s

kill_hls_execute_BASIC:
	@bdw_kill -job hls.execute.BASIC
	@bdw_kill -job hls.execute.BASIC.s


hls_execute_BASIC_% : hlsc_execute_BASIC_%

cynth_execute_BASIC_% : hlsc_execute_BASIC_%

elab_execute_BASIC_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(subst /BASIC/,/BASIC_$(*F)/,$(BDW_WORKLIB)/modules/execute/BASIC/stratus_hls.bdr)

optim_execute_BASIC_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(subst /BASIC/,/BASIC_$(*F)/,$(BDW_WORKLIB)/modules/execute/BASIC/stratus_hls.bdr)

sched_execute_BASIC_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(subst /BASIC/,/BASIC_$(*F)/,$(BDW_WORKLIB)/modules/execute/BASIC/stratus_hls.bdr)

hlsc_execute_BASIC_% hls_execute_BASIC_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /BASIC/,/BASIC_$(*F)/,$(BDW_WORKLIB)/modules/execute/BASIC/execute_rtl.cpp) BDW_DEP_CYNTH_CONFIG=BASIC BDW_MODULE=execute BDW_HLS_CONFIG=BASIC_$(*F) 
else
	@bdw_exec -jobproject project.tcl -job hls.execute.BASIC_$(*F) $(MAKE) CWBExec_hls=1 hlsc_execute_BASIC_$(*F)
endif

clean_cynth_execute_BASIC_%: clean_hls_execute_BASIC_%

clean_execute_BASIC_%: clean_hls_execute_BASIC_%

clean_hls_execute_BASIC_%:
	@rm -rf $(BDW_WORKLIB)/modules/execute/BASIC_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.execute.BASIC_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.execute.BASIC_$(*F).s

kill_hls_execute_BASIC_%:
	@bdw_kill -job hls.execute.BASIC_$(*F)
	@bdw_kill -job hls.execute.BASIC_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),BASIC)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/execute/BASIC/execute.d
                -include $(memlib_WORKLIB)/memlib.d
                BDW_LIB_DEPS =  $(memlib_DEPS)
            endif
        endif
    endif
endif


