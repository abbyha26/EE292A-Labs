	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_fedec_PIPE_SOFT2)  ../src/fedec.cpp \
	| sed 's|fedec\.o[ :]*|$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT2/fedec_rtl.cpp $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT2/xcelium/fedec_beh.o $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT2/xcelium/debug/fedec_beh.o $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT2/fedec.d : $(memlib_WORKLIB)/memlib.d |' $(BDW_DEP_FILTER)  > $@

