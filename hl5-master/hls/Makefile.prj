	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_hl5_BASIC_POFF)  \
		-d $(BDW_WORKLIB)/modules/hl5/BASIC_POFF -o hl5_rtl.cpp \
		--hls_module=hl5 --hls_config=BASIC_POFF --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_hl5_BASIC_POFF))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_hl5_BASIC_POFF))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_hl5_BASIC_POFF))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_hl5_BASIC_POFF)   \
		 ../src/hl5.cpp
	
	
	
	

