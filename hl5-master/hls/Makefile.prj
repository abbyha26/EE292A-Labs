	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/ -I./ $(CCFLAGS_COSIM_execute_PIPE_SOFT2) -o $(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/xcelium/debug/execute.o " $(BDW_WORKLIB)/wrappers/execute_wrap.cpp


