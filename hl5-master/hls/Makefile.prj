	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /PIPE_SOFT2/,/PIPE_SOFT2_$(*F)/,$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT2/fedec_rtl.cpp) BDW_DEP_CYNTH_CONFIG=PIPE_SOFT2 BDW_MODULE=fedec BDW_HLS_CONFIG=PIPE_SOFT2_$(*F) 
