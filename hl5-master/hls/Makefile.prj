	$(subst /BASIC_POFF/,/BASIC_POFF$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/execute/BASIC_POFF/ -I./ $(CCFLAGS_execute_BASIC_POFF) $(EXTRACT_LIB_DASHI_execute_BASIC_POFF) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/execute/BASIC_POFF/xcelium/execute_rtl.o " $(BDW_WORKLIB)/wrappers/execute_wrap.cpp)

$(subst /BASIC_POFF/,/BASIC_POFF$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/execute/BASIC_POFF/xcelium/debug/execute_rtl.o) : $(subst /BASIC_POFF/,/BASIC_POFF$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/execute/BASIC_POFF/execute_rtl.cpp) $(BDW_WORKLIB)/wrappers/execute_wrap.cpp $(BDW_WORKLIB)/wrappers/execute_cosim.h $(subst /BASIC_POFF/,/BASIC_POFF$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/execute/BASIC_POFF/execute_trace.h)
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/execute_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl execute`
	$(subst /BASIC_POFF/,/BASIC_POFF$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/execute/BASIC_POFF/ -I./ $(CCFLAGS_execute_BASIC_POFF) $(EXTRACT_LIB_DASHI_execute_BASIC_POFF) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/execute/BASIC_POFF/xcelium/debug/execute_rtl.o " $(BDW_WORKLIB)/wrappers/execute_wrap.cpp)

#
#	Behavioral object file rule.  Used only for BEH configs that are 
#	associated with HLS config names.
#

$(subst /BASIC_POFF/,/BASIC_POFF$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/execute/BASIC_POFF/xcelium/execute_beh.o) :  ../src/execute.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/execute_cosim.h $(subst /BASIC_POFF/,/BASIC_POFF$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/execute_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /BASIC_POFF/,/BASIC_POFF$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/execute/BASIC_POFF/ -I./ $(CCFLAGS_BEH_execute_BASIC_POFF) -o $(BDW_WORKLIB)/modules/execute/BASIC_POFF/xcelium/execute_beh.o " $(BDW_WORKLIB)/wrappers/execute_wrap.cpp)

$(subst /BASIC_POFF/,/BASIC_POFF$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/execute/BASIC_POFF/xcelium/debug/execute_beh.o) :  ../src/execute.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/execute_cosim.h $(subst /BASIC_POFF/,/BASIC_POFF$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/execute_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /BASIC_POFF/,/BASIC_POFF$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/execute/BASIC_POFF/ -I./ $(CCFLAGS_BEH_execute_BASIC_POFF) -o $(BDW_WORKLIB)/modules/execute/BASIC_POFF/xcelium/debug/execute_beh.o " $(BDW_WORKLIB)/wrappers/execute_wrap.cpp)

#
# Cosim object file rule
#

$(subst /BASIC_POFF/,/BASIC_POFF$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/execute/BASIC_POFF/xcelium/execute.o) :  ../src/execute.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/execute_cosim.h $(subst /BASIC_POFF/,/BASIC_POFF$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/execute_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /BASIC_POFF/,/BASIC_POFF$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/execute/BASIC_POFF/ -I./ $(CCFLAGS_COSIM_execute_BASIC_POFF) -o $(BDW_WORKLIB)/modules/execute/BASIC_POFF/xcelium/execute.o " $(BDW_WORKLIB)/wrappers/execute_wrap.cpp)
    

$(subst /BASIC_POFF/,/BASIC_POFF$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/execute/BASIC_POFF/xcelium/execute_hoist.o) :  ../src/execute.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.cpp $(BDW_WORKLIB)/wrappers/execute_cosim.h $(subst /BASIC_POFF/,/BASIC_POFF$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/execute_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /BASIC_POFF/,/BASIC_POFF$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/execute/BASIC_POFF/ -I./ $(CCFLAGS_execute_BASIC_POFF) $(EXTRACT_LIB_DASHI_execute_BASIC_POFF) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/execute/BASIC_POFF/xcelium/execute_hoist.o " $(BDW_WORKLIB)/wrappers/execute_wrap.cpp)
    

$(subst /BASIC_POFF/,/BASIC_POFF$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/execute/BASIC_POFF/xcelium/debug/execute.o) :  ../src/execute.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/execute_cosim.h $(subst /BASIC_POFF/,/BASIC_POFF$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/execute_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /BASIC_POFF/,/BASIC_POFF$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/execute/BASIC_POFF/ -I./ $(CCFLAGS_COSIM_execute_BASIC_POFF) -o $(BDW_WORKLIB)/modules/execute/BASIC_POFF/xcelium/debug/execute.o " $(BDW_WORKLIB)/wrappers/execute_wrap.cpp)


$(subst /BASIC_POFF/,/BASIC_POFF$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/execute/BASIC_POFF/xcelium/debug/execute_hoist.o) :  ../src/execute.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.cpp $(BDW_WORKLIB)/wrappers/execute_cosim.h $(subst /BASIC_POFF/,/BASIC_POFF$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/execute_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /BASIC_POFF/,/BASIC_POFF$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/execute/BASIC_POFF/ -I./ $(CCFLAGS_execute_BASIC_POFF) $(EXTRACT_LIB_DASHI_execute_BASIC_POFF) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/execute/BASIC_POFF/xcelium/debug/execute_hoist.o " $(BDW_WORKLIB)/wrappers/execute_wrap.cpp)
    
endif

#
#	Dependency generation rule
#
$(BDW_WORKLIB)/modules/execute/BASIC_POFF/execute.d :  ../src/execute.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config BASIC_POFF of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_execute_BASIC_POFF)  ../src/execute.cpp \
	| sed 's|execute\.o[ :]*|$(BDW_WORKLIB)/modules/execute/BASIC_POFF/execute_rtl.cpp $(BDW_WORKLIB)/modules/execute/BASIC_POFF/xcelium/execute_beh.o $(BDW_WORKLIB)/modules/execute/BASIC_POFF/xcelium/debug/execute_beh.o $(BDW_WORKLIB)/modules/execute/BASIC_POFF/execute.d : $(memlib_WORKLIB)/memlib.d |' $(BDW_DEP_FILTER)  > $@

#
#	Library post-proc rules
#



##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/execute/BASIC_POFF"
##############################################################

execute_BASIC_POFF_SRCDIR = $(BDW_WORKLIB)/modules/execute/BASIC_POFF
execute_BASIC_POFF_BEH_SRCDIR = $(BDW_WORKLIB)/libs/execute_BASIC_POFF
execute_BASIC_POFF_LIBNAME = execute_BASIC_POFF
execute_BASIC_POFF_WORKLIB = $(BDW_WORKLIB)/modules/execute/BASIC_POFF/xcelium
execute_BASIC_POFF_C_PARTS_A = $(execute_BASIC_POFF_WORKLIB)/objs/libexecute_BASIC_POFF.a

prep_c_execute_BASIC_POFF : $(execute_BASIC_POFF_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(execute_BASIC_POFF_WORKLIB) prep_c

prep_vlog_execute_BASIC_POFF : $(execute_BASIC_POFF_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(execute_BASIC_POFF_WORKLIB) prep_vlog

prep_execute_BASIC_POFF : $(execute_BASIC_POFF_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(execute_BASIC_POFF_WORKLIB) prep

$(execute_BASIC_POFF_WORKLIB)/Makefile : $(execute_BASIC_POFF_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(execute_BASIC_POFF_WORKLIB) ]; then mkdir -p $(execute_BASIC_POFF_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(execute_BASIC_POFF_SRCDIR) -o $(execute_BASIC_POFF_WORKLIB)/Makefile -module execute -cynthconfig BASIC_POFF   

$(execute_BASIC_POFF_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(execute_BASIC_POFF_WORKLIB) ]; then mkdir -p $(execute_BASIC_POFF_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



prep_c_execute_BASIC_POFF_% : $(subst BASIC_POFF,BASIC_POFF_%,$(execute_BASIC_POFF_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst BASIC_POFF,BASIC_POFF_$(*F),$(execute_BASIC_POFF_WORKLIB)) prep_c

prep_vlog_execute_BASIC_POFF_% : $(subst BASIC_POFF,BASIC_POFF_%,$(execute_BASIC_POFF_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst BASIC_POFF,BASIC_POFF_$(*F),$(execute_BASIC_POFF_WORKLIB)) prep_vlog

prep_execute_BASIC_POFF_% : $(subst BASIC_POFF,BASIC_POFF_%,$(execute_BASIC_POFF_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst BASIC_POFF,BASIC_POFF_$(*F),$(execute_BASIC_POFF_WORKLIB)) prep

$(subst BASIC_POFF,BASIC_POFF_%,$(execute_BASIC_POFF_WORKLIB))/Makefile : $(execute_BASIC_POFF_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(subst BASIC_POFF,BASIC_POFF_$(*F),$(execute_BASIC_POFF_WORKLIB)) ]; then mkdir -p $(subst BASIC_POFF,BASIC_POFF_$(*F),$(execute_BASIC_POFF_WORKLIB)); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(execute_BASIC_POFF_SRCDIR)_$(*F) -o $(subst BASIC_POFF,BASIC_POFF_$(*F),$(execute_BASIC_POFF_WORKLIB))/Makefile -module execute -cynthconfig BASIC_POFF_$(*F)   

$(execute_BASIC_POFF_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(subst BASIC_POFF,BASIC_POFF_$(*F),$(execute_BASIC_POFF_WORKLIB)) ]; then mkdir -p $(subst BASIC_POFF,BASIC_POFF_$(*F),$(execute_BASIC_POFF_WORKLIB)); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(execute_BASIC_POFF_WORKLIB)/execute_BASIC_POFF.d :
	@if [ ! -d $(execute_BASIC_POFF_WORKLIB) ]; then mkdir -p $(execute_BASIC_POFF_WORKLIB); fi
	@touch $(execute_BASIC_POFF_WORKLIB)/execute_BASIC_POFF.d



#
# HLS config DPA
#

#
#	stratus_hls rule
#
LIB_DIRS_execute_DPA = $(memlib_SRCDIR) 
LIB_INCLUDES_execute_DPA = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_execute_DPA))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_execute_DPA = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_execute_DPA = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_execute_DPA = 
EXTRACT_LIB_DASHI_execute_DPA = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl execute DPA]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_execute_DPA = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/execute/DPA/c_parts -DDPA=1 -DBDW_RTL_execute_DPA=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_execute_DPA)
CCFLAGS_COSIM_execute_DPA = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/execute/DPA/c_parts -DDPA=1 -DBDW_RTL_execute_DPA=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_execute_DPA)
CCFLAGS_BEH_execute_DPA = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/execute/DPA/c_parts -DDPA=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_execute_DPA)
CCFLAGS_execute_DPA += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_execute_DPA += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_execute_DPA += ${BDW_CCFLAGS_TAIL}

.PHONY: hlsc_execute_DPA hls_execute_DPA

hls_execute_DPA : hlsc_execute_DPA

cynth_execute_DPA : hlsc_execute_DPA

elab_execute_DPA : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/execute/DPA/stratus_hls.bdr

optim_execute_DPA : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/execute/DPA/stratus_hls.bdr

sched_execute_DPA : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/execute/DPA/stratus_hls.bdr

hlsc_execute_DPA : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/execute/DPA/execute_rtl.cpp BDW_DEP_CYNTH_CONFIG=DPA BDW_MODULE=execute BDW_HLS_CONFIG=DPA 
else
	@bdw_exec -jobproject project.tcl -job hls.execute.DPA $(MAKE) CWBExec_hls=1 hlsc_execute_DPA
endif

clean_cynth_execute_DPA: clean_hls_execute_DPA

clean_execute_DPA: clean_hls_execute_DPA

clean_hls_execute_DPA:
	@rm -rf $(BDW_WORKLIB)/modules/execute/DPA
	@rm -rf $(BDW_WORKLIB)/jobs/hls.execute.DPA
	@rm -rf $(BDW_WORKLIB)/jobs/hls.execute.DPA.s

kill_hls_execute_DPA:
	@bdw_kill -job hls.execute.DPA
	@bdw_kill -job hls.execute.DPA.s


hls_execute_DPA_% : hlsc_execute_DPA_%

cynth_execute_DPA_% : hlsc_execute_DPA_%

elab_execute_DPA_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(subst /DPA/,/DPA_$(*F)/,$(BDW_WORKLIB)/modules/execute/DPA/stratus_hls.bdr)

optim_execute_DPA_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(subst /DPA/,/DPA_$(*F)/,$(BDW_WORKLIB)/modules/execute/DPA/stratus_hls.bdr)

sched_execute_DPA_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(subst /DPA/,/DPA_$(*F)/,$(BDW_WORKLIB)/modules/execute/DPA/stratus_hls.bdr)

hlsc_execute_DPA_% hls_execute_DPA_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /DPA/,/DPA_$(*F)/,$(BDW_WORKLIB)/modules/execute/DPA/execute_rtl.cpp) BDW_DEP_CYNTH_CONFIG=DPA BDW_MODULE=execute BDW_HLS_CONFIG=DPA_$(*F) 
else
	@bdw_exec -jobproject project.tcl -job hls.execute.DPA_$(*F) $(MAKE) CWBExec_hls=1 hlsc_execute_DPA_$(*F)
endif

clean_cynth_execute_DPA_%: clean_hls_execute_DPA_%

clean_execute_DPA_%: clean_hls_execute_DPA_%

clean_hls_execute_DPA_%:
	@rm -rf $(BDW_WORKLIB)/modules/execute/DPA_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.execute.DPA_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.execute.DPA_$(*F).s

kill_hls_execute_DPA_%:
	@bdw_kill -job hls.execute.DPA_$(*F)
	@bdw_kill -job hls.execute.DPA_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),DPA)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/execute/DPA/execute.d
                -include $(memlib_WORKLIB)/memlib.d
                BDW_LIB_DEPS =  $(memlib_DEPS)
            endif
        endif
    endif
endif


html_execute_DPA :
	bdw_htmlgen -project project.tcl -module execute -cynthconfig DPA

BDW_execute_DPA_HLS_TARGETS := $(BDW_WORKLIB)/modules/execute/DPA/execute_rtl.cpp $(BDW_WORKLIB)/modules/execute/DPA/execute_rtl.v $(BDW_WORKLIB)/modules/execute/DPA/stratus_hls.bdr
ifeq ($(BDW_BDR_ONLY),1)
.PHONY: $(filter %.bdr %.cpp,$(BDW_execute_DPA_HLS_TARGETS))
$(filter %.v %.cpp,$(BDW_execute_DPA_HLS_TARGETS)) : $(filter %.bdr,$(BDW_execute_DPA_HLS_TARGETS))
BDW_execute_DPA_HLS_TARGETS := $(filter %.bdr,$(BDW_execute_DPA_HLS_TARGETS))
endif
BDW_execute_DPA_HLS_SPEC_TARGETS = $(subst /DPA/,/DPA_%/,$(BDW_execute_DPA_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_execute_DPA_HLS_TARGETS) :  ../src/execute.cpp   $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/execute/DPA ]; then mkdir -p $(BDW_WORKLIB)/modules/execute/DPA; fi
	
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=DPA BDW_CYNTH_CONFIG=DPA \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/execute/DPA/execute_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/execute/DPA/execute_rtl.cpp \
		BDW_MODULE=execute \
		BDW_CYNTH_CONFIG=DPA \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/execute/DPA \
		BDW_HLS_CONFIG=DPA \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/execute/DPA \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_execute_DPA)  \
		-d $(BDW_WORKLIB)/modules/execute/DPA -o execute_rtl.cpp \
		--hls_module=execute --hls_config=DPA --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_execute_DPA))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_execute_DPA))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_execute_DPA))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_execute_DPA)   \
		 ../src/execute.cpp
	
	
	
	

else

$(BDW_execute_DPA_HLS_TARGETS) :  ../src/execute.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.execute.DPA.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_execute_DPA_HLS_TARGETS)

endif

	
$(BDW_WORKLIB)/modules/execute/DPA/execute_trace.h : $(BDW_WORKLIB)/modules/execute/DPA/execute_trace.h.updated

$(BDW_WORKLIB)/modules/execute/DPA/execute_trace.h.updated : $(BDW_WORKLIB)/modules/execute/DPA/execute_rtl.cpp $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module execute -cynthconfig DPA  
	@touch $(BDW_WORKLIB)/modules/execute/DPA/execute_trace.h.updated

ifeq ($(CWBExec_hlsc),1)

$(BDW_execute_DPA_HLS_SPEC_TARGETS) :  ../src/execute.cpp   $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/execute/DPA_$(*F) ]; then mkdir -p $(BDW_WORKLIB)/modules/execute/DPA_$(*F); fi
	
	
	$(subst /DPA ,/DPA_$(*F) ,$(subst =DPA ,=DPA_$(*F) ,$(subst /execute/DPA/,/execute/DPA_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=DPA BDW_CYNTH_CONFIG=DPA \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/execute/DPA/execute_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/execute/DPA/execute_rtl.cpp \
		BDW_MODULE=execute \
		BDW_CYNTH_CONFIG=DPA \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/execute/DPA \
		BDW_HLS_CONFIG=DPA \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/execute/DPA \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_execute_DPA)  \
		`cat  $(BDW_SPECLIB)/execute/DPA.$(*F).bds | grep '^cmdline:' | sed 's/^cmdline://'`\
		-d $(BDW_WORKLIB)/modules/execute/DPA -o execute_rtl.cpp \
		--hls_module=execute --hls_config=DPA --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_execute_DPA))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_execute_DPA))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_execute_DPA))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_execute_DPA)   \
		 ../src/execute.cpp)))
	
	
	
	

else

$(BDW_execute_DPA_HLS_SPEC_TARGETS) :  ../src/execute.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.execute.DPA_$(*F).s $(MAKE) -j1 CWBExec_hlsc=1 $(subst %,$(*F),$(BDW_execute_DPA_HLS_SPEC_TARGETS))

endif

	

$(subst /DPA/,/DPA_%/,$(BDW_WORKLIB)/modules/execute/DPA/execute_trace.h) : $(subst /DPA/,/DPA_%/,$(BDW_WORKLIB)/modules/execute/DPA/execute_rtl.cpp) $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module execute -cynthconfig DPA_$(*F)  

catHLLog_execute_DPA:
	cat $(BDW_WORKLIB)/modules/execute/DPA/stratus_hls.log

#
#	stratus_vlg rule
#
cynthvlg_execute_DPA : hls_execute_DPA 


.PHONY: hls_execute_DPA

hls_execute_DPA hlsv_execute_DPA: $(addprefix prep_vlog_,$(LIB_NAMES_FOR_VLOG_execute_DPA)) 

.PHONY: hls_execute_DPA

hls_execute_DPA_% hlsv_execute_DPA_%: $(addprefix prep_vlog_,$(LIB_NAMES_FOR_VLOG_execute_DPA)) 

catVLGLog_execute_DPA : catHLLog_execute_DPA
	cat $(BDW_WORKLIB)/modules/execute/DPA/stratus_vlg.log

#
#	view rule
#

view_execute_DPA:
	@echo "ERROR: Schematic viewing target 'view_execute_DPA' is only supported with 'verdi'"
	@echo "The Stratus IDE includes a schematic view as an alternative."


#
#	RTL object file rule
#
