memwb_PIPE_SOFT3_BEH_SRCDIR = $(BDW_WORKLIB)/libs/memwb_PIPE_SOFT3
memwb_PIPE_SOFT3_LIBNAME = memwb_PIPE_SOFT3
memwb_PIPE_SOFT3_WORKLIB = $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3/xcelium
memwb_PIPE_SOFT3_C_PARTS_A = $(memwb_PIPE_SOFT3_WORKLIB)/objs/libmemwb_PIPE_SOFT3.a

prep_c_memwb_PIPE_SOFT3 : $(memwb_PIPE_SOFT3_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(memwb_PIPE_SOFT3_WORKLIB) prep_c

prep_vlog_memwb_PIPE_SOFT3 : $(memwb_PIPE_SOFT3_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(memwb_PIPE_SOFT3_WORKLIB) prep_vlog

