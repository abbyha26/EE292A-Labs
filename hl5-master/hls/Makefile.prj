clean_cynth_memwb_RADIX_2_%: clean_hls_memwb_RADIX_2_%

clean_memwb_RADIX_2_%: clean_hls_memwb_RADIX_2_%

clean_hls_memwb_RADIX_2_%:
	@rm -rf $(BDW_WORKLIB)/modules/memwb/RADIX_2_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.memwb.RADIX_2_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.memwb.RADIX_2_$(*F).s

kill_hls_memwb_RADIX_2_%:
	@bdw_kill -job hls.memwb.RADIX_2_$(*F)
	@bdw_kill -job hls.memwb.RADIX_2_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),RADIX_2)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/memwb/RADIX_2/memwb.d
                -include $(memlib_WORKLIB)/memlib.d
                BDW_LIB_DEPS =  $(memlib_DEPS)
            endif
        endif
    endif
endif


html_memwb_RADIX_2 :
	bdw_htmlgen -project project.tcl -module memwb -cynthconfig RADIX_2

BDW_memwb_RADIX_2_HLS_TARGETS := $(BDW_WORKLIB)/modules/memwb/RADIX_2/memwb_rtl.cpp $(BDW_WORKLIB)/modules/memwb/RADIX_2/memwb_rtl.v $(BDW_WORKLIB)/modules/memwb/RADIX_2/stratus_hls.bdr
ifeq ($(BDW_BDR_ONLY),1)
.PHONY: $(filter %.bdr %.cpp,$(BDW_memwb_RADIX_2_HLS_TARGETS))
$(filter %.v %.cpp,$(BDW_memwb_RADIX_2_HLS_TARGETS)) : $(filter %.bdr,$(BDW_memwb_RADIX_2_HLS_TARGETS))
BDW_memwb_RADIX_2_HLS_TARGETS := $(filter %.bdr,$(BDW_memwb_RADIX_2_HLS_TARGETS))
endif
BDW_memwb_RADIX_2_HLS_SPEC_TARGETS = $(subst /RADIX_2/,/RADIX_2_%/,$(BDW_memwb_RADIX_2_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_memwb_RADIX_2_HLS_TARGETS) :  ../src/memwb.cpp   $(BDW_LIB_DEPS)
	+make --no-print-directory  $(BDW_WORKLIB)/wrappers/hl5_wrap.h
	@if [ ! -d $(BDW_WORKLIB)/modules/memwb/RADIX_2 ]; then mkdir -p $(BDW_WORKLIB)/modules/memwb/RADIX_2; fi
	
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=RADIX_2 BDW_CYNTH_CONFIG=RADIX_2 \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/memwb/RADIX_2/memwb_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/memwb/RADIX_2/memwb_rtl.cpp \
		BDW_MODULE=memwb \
		BDW_CYNTH_CONFIG=RADIX_2 \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/memwb/RADIX_2 \
		BDW_HLS_CONFIG=RADIX_2 \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/memwb/RADIX_2 \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_memwb_RADIX_2)  \
		-d $(BDW_WORKLIB)/modules/memwb/RADIX_2 -o memwb_rtl.cpp \
		--hls_module=memwb --hls_config=RADIX_2 --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_memwb_RADIX_2))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_memwb_RADIX_2))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_memwb_RADIX_2))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_memwb_RADIX_2)   \
		 ../src/memwb.cpp
	
	
	
	

else

$(BDW_memwb_RADIX_2_HLS_TARGETS) :  ../src/memwb.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.memwb.RADIX_2.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_memwb_RADIX_2_HLS_TARGETS)

endif

	
$(BDW_WORKLIB)/modules/memwb/RADIX_2/memwb_trace.h : $(BDW_WORKLIB)/modules/memwb/RADIX_2/memwb_trace.h.updated

$(BDW_WORKLIB)/modules/memwb/RADIX_2/memwb_trace.h.updated : $(BDW_WORKLIB)/modules/memwb/RADIX_2/memwb_rtl.cpp $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module memwb -cynthconfig RADIX_2  
	@touch $(BDW_WORKLIB)/modules/memwb/RADIX_2/memwb_trace.h.updated

ifeq ($(CWBExec_hlsc),1)

$(BDW_memwb_RADIX_2_HLS_SPEC_TARGETS) :  ../src/memwb.cpp   $(BDW_LIB_DEPS)
	+make --no-print-directory  $(BDW_WORKLIB)/wrappers/hl5_wrap.h
	@if [ ! -d $(BDW_WORKLIB)/modules/memwb/RADIX_2_$(*F) ]; then mkdir -p $(BDW_WORKLIB)/modules/memwb/RADIX_2_$(*F); fi
	
	
	$(subst /RADIX_2 ,/RADIX_2_$(*F) ,$(subst =RADIX_2 ,=RADIX_2_$(*F) ,$(subst /memwb/RADIX_2/,/memwb/RADIX_2_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=RADIX_2 BDW_CYNTH_CONFIG=RADIX_2 \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/memwb/RADIX_2/memwb_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/memwb/RADIX_2/memwb_rtl.cpp \
		BDW_MODULE=memwb \
		BDW_CYNTH_CONFIG=RADIX_2 \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/memwb/RADIX_2 \
		BDW_HLS_CONFIG=RADIX_2 \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/memwb/RADIX_2 \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_memwb_RADIX_2)  \
		`cat  $(BDW_SPECLIB)/memwb/RADIX_2.$(*F).bds | grep '^cmdline:' | sed 's/^cmdline://'`\
		-d $(BDW_WORKLIB)/modules/memwb/RADIX_2 -o memwb_rtl.cpp \
		--hls_module=memwb --hls_config=RADIX_2 --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_memwb_RADIX_2))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_memwb_RADIX_2))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_memwb_RADIX_2))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_memwb_RADIX_2)   \
		 ../src/memwb.cpp)))
	
	
	
	

else

$(BDW_memwb_RADIX_2_HLS_SPEC_TARGETS) :  ../src/memwb.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.memwb.RADIX_2_$(*F).s $(MAKE) -j1 CWBExec_hlsc=1 $(subst %,$(*F),$(BDW_memwb_RADIX_2_HLS_SPEC_TARGETS))

endif

	

$(subst /RADIX_2/,/RADIX_2_%/,$(BDW_WORKLIB)/modules/memwb/RADIX_2/memwb_trace.h) : $(subst /RADIX_2/,/RADIX_2_%/,$(BDW_WORKLIB)/modules/memwb/RADIX_2/memwb_rtl.cpp) $(BDW_LOGOPTIONS_FILE)
