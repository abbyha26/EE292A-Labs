sched_hl5_RADIX_4_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(subst /RADIX_4/,/RADIX_4_$(*F)/,$(BDW_WORKLIB)/modules/hl5/RADIX_4/stratus_hls.bdr)

hlsc_hl5_RADIX_4_% hls_hl5_RADIX_4_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /RADIX_4/,/RADIX_4_$(*F)/,$(BDW_WORKLIB)/modules/hl5/RADIX_4/hl5_rtl.cpp) BDW_DEP_CYNTH_CONFIG=RADIX_4 BDW_MODULE=hl5 BDW_HLS_CONFIG=RADIX_4_$(*F) 
else
	@bdw_exec -jobproject project.tcl -job hls.hl5.RADIX_4_$(*F) $(MAKE) CWBExec_hls=1 hlsc_hl5_RADIX_4_$(*F)
endif

clean_cynth_hl5_RADIX_4_%: clean_hls_hl5_RADIX_4_%

clean_hl5_RADIX_4_%: clean_hls_hl5_RADIX_4_%

clean_hls_hl5_RADIX_4_%:
	@rm -rf $(BDW_WORKLIB)/modules/hl5/RADIX_4_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.hl5.RADIX_4_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.hl5.RADIX_4_$(*F).s

kill_hls_hl5_RADIX_4_%:
	@bdw_kill -job hls.hl5.RADIX_4_$(*F)
	@bdw_kill -job hls.hl5.RADIX_4_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),RADIX_4)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/hl5/RADIX_4/hl5.d
                -include $(memlib_WORKLIB)/memlib.d
                BDW_LIB_DEPS =  $(memlib_DEPS)
            endif
        endif
    endif
endif


html_hl5_RADIX_4 :
	bdw_htmlgen -project project.tcl -module hl5 -cynthconfig RADIX_4

BDW_hl5_RADIX_4_HLS_TARGETS := $(BDW_WORKLIB)/modules/hl5/RADIX_4/hl5_rtl.cpp $(BDW_WORKLIB)/modules/hl5/RADIX_4/hl5_rtl.v $(BDW_WORKLIB)/modules/hl5/RADIX_4/stratus_hls.bdr
ifeq ($(BDW_BDR_ONLY),1)
.PHONY: $(filter %.bdr %.cpp,$(BDW_hl5_RADIX_4_HLS_TARGETS))
$(filter %.v %.cpp,$(BDW_hl5_RADIX_4_HLS_TARGETS)) : $(filter %.bdr,$(BDW_hl5_RADIX_4_HLS_TARGETS))
BDW_hl5_RADIX_4_HLS_TARGETS := $(filter %.bdr,$(BDW_hl5_RADIX_4_HLS_TARGETS))
endif
BDW_hl5_RADIX_4_HLS_SPEC_TARGETS = $(subst /RADIX_4/,/RADIX_4_%/,$(BDW_hl5_RADIX_4_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_hl5_RADIX_4_HLS_TARGETS) :  ../src/hl5.cpp  $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/memwb_wrap.h  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/hl5/RADIX_4 ]; then mkdir -p $(BDW_WORKLIB)/modules/hl5/RADIX_4; fi
	
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=RADIX_4 BDW_CYNTH_CONFIG=RADIX_4 \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/hl5/RADIX_4/hl5_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/hl5/RADIX_4/hl5_rtl.cpp \
		BDW_MODULE=hl5 \
		BDW_CYNTH_CONFIG=RADIX_4 \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/hl5/RADIX_4 \
		BDW_HLS_CONFIG=RADIX_4 \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/hl5/RADIX_4 \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_hl5_RADIX_4)  \
		-d $(BDW_WORKLIB)/modules/hl5/RADIX_4 -o hl5_rtl.cpp \
		--hls_module=hl5 --hls_config=RADIX_4 --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_hl5_RADIX_4))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_hl5_RADIX_4))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_hl5_RADIX_4))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_hl5_RADIX_4)   \
		 ../src/hl5.cpp
	
	
	
	

else

$(BDW_hl5_RADIX_4_HLS_TARGETS) :  ../src/hl5.cpp  $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.hl5.RADIX_4.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_hl5_RADIX_4_HLS_TARGETS)

endif

	
$(BDW_WORKLIB)/modules/hl5/RADIX_4/hl5_trace.h : $(BDW_WORKLIB)/modules/hl5/RADIX_4/hl5_trace.h.updated

$(BDW_WORKLIB)/modules/hl5/RADIX_4/hl5_trace.h.updated : $(BDW_WORKLIB)/modules/hl5/RADIX_4/hl5_rtl.cpp $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module hl5 -cynthconfig RADIX_4  
	@touch $(BDW_WORKLIB)/modules/hl5/RADIX_4/hl5_trace.h.updated

ifeq ($(CWBExec_hlsc),1)

$(BDW_hl5_RADIX_4_HLS_SPEC_TARGETS) :  ../src/hl5.cpp  $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/memwb_wrap.h  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/hl5/RADIX_4_$(*F) ]; then mkdir -p $(BDW_WORKLIB)/modules/hl5/RADIX_4_$(*F); fi
	
	
	$(subst /RADIX_4 ,/RADIX_4_$(*F) ,$(subst =RADIX_4 ,=RADIX_4_$(*F) ,$(subst /hl5/RADIX_4/,/hl5/RADIX_4_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=RADIX_4 BDW_CYNTH_CONFIG=RADIX_4 \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/hl5/RADIX_4/hl5_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/hl5/RADIX_4/hl5_rtl.cpp \
		BDW_MODULE=hl5 \
		BDW_CYNTH_CONFIG=RADIX_4 \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/hl5/RADIX_4 \
		BDW_HLS_CONFIG=RADIX_4 \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/hl5/RADIX_4 \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_hl5_RADIX_4)  \
		`cat  $(BDW_SPECLIB)/hl5/RADIX_4.$(*F).bds | grep '^cmdline:' | sed 's/^cmdline://'`\
		-d $(BDW_WORKLIB)/modules/hl5/RADIX_4 -o hl5_rtl.cpp \
		--hls_module=hl5 --hls_config=RADIX_4 --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_hl5_RADIX_4))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_hl5_RADIX_4))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_hl5_RADIX_4))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_hl5_RADIX_4)   \
		 ../src/hl5.cpp)))
	
	
	
	

else

$(BDW_hl5_RADIX_4_HLS_SPEC_TARGETS) :  ../src/hl5.cpp  $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.hl5.RADIX_4_$(*F).s $(MAKE) -j1 CWBExec_hlsc=1 $(subst %,$(*F),$(BDW_hl5_RADIX_4_HLS_SPEC_TARGETS))

endif

	

$(subst /RADIX_4/,/RADIX_4_%/,$(BDW_WORKLIB)/modules/hl5/RADIX_4/hl5_trace.h) : $(subst /RADIX_4/,/RADIX_4_%/,$(BDW_WORKLIB)/modules/hl5/RADIX_4/hl5_rtl.cpp) $(BDW_LOGOPTIONS_FILE)
