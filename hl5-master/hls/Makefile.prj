#
#	Dependency generation rule
#
$(BDW_WORKLIB)/modules/hl5/BASIC/hl5.d :  ../src/hl5.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config BASIC of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_hl5_BASIC)  ../src/hl5.cpp \
	| sed 's|hl5\.o[ :]*|$(BDW_WORKLIB)/modules/hl5/BASIC/hl5_rtl.cpp $(BDW_WORKLIB)/modules/hl5/BASIC/xcelium/hl5_beh.o $(BDW_WORKLIB)/modules/hl5/BASIC/xcelium/debug/hl5_beh.o $(BDW_WORKLIB)/modules/hl5/BASIC/hl5.d : $(memlib_WORKLIB)/memlib.d |' $(BDW_DEP_FILTER)  > $@

#
#	Library post-proc rules
#



##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/hl5/BASIC"
##############################################################

hl5_BASIC_SRCDIR = $(BDW_WORKLIB)/modules/hl5/BASIC
hl5_BASIC_BEH_SRCDIR = $(BDW_WORKLIB)/libs/hl5_BASIC
hl5_BASIC_LIBNAME = hl5_BASIC
hl5_BASIC_WORKLIB = $(BDW_WORKLIB)/modules/hl5/BASIC/xcelium
hl5_BASIC_C_PARTS_A = $(hl5_BASIC_WORKLIB)/objs/libhl5_BASIC.a

prep_c_hl5_BASIC : $(hl5_BASIC_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(hl5_BASIC_WORKLIB) prep_c

prep_vlog_hl5_BASIC : $(hl5_BASIC_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(hl5_BASIC_WORKLIB) prep_vlog

prep_hl5_BASIC : $(hl5_BASIC_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(hl5_BASIC_WORKLIB) prep

$(hl5_BASIC_WORKLIB)/Makefile : $(hl5_BASIC_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(hl5_BASIC_WORKLIB) ]; then mkdir -p $(hl5_BASIC_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(hl5_BASIC_SRCDIR) -o $(hl5_BASIC_WORKLIB)/Makefile -module hl5 -cynthconfig BASIC   

$(hl5_BASIC_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(hl5_BASIC_WORKLIB) ]; then mkdir -p $(hl5_BASIC_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



prep_c_hl5_BASIC_% : $(subst BASIC,BASIC_%,$(hl5_BASIC_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst BASIC,BASIC_$(*F),$(hl5_BASIC_WORKLIB)) prep_c

prep_vlog_hl5_BASIC_% : $(subst BASIC,BASIC_%,$(hl5_BASIC_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst BASIC,BASIC_$(*F),$(hl5_BASIC_WORKLIB)) prep_vlog

prep_hl5_BASIC_% : $(subst BASIC,BASIC_%,$(hl5_BASIC_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst BASIC,BASIC_$(*F),$(hl5_BASIC_WORKLIB)) prep

$(subst BASIC,BASIC_%,$(hl5_BASIC_WORKLIB))/Makefile : $(hl5_BASIC_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(subst BASIC,BASIC_$(*F),$(hl5_BASIC_WORKLIB)) ]; then mkdir -p $(subst BASIC,BASIC_$(*F),$(hl5_BASIC_WORKLIB)); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(hl5_BASIC_SRCDIR)_$(*F) -o $(subst BASIC,BASIC_$(*F),$(hl5_BASIC_WORKLIB))/Makefile -module hl5 -cynthconfig BASIC_$(*F)   

$(hl5_BASIC_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(subst BASIC,BASIC_$(*F),$(hl5_BASIC_WORKLIB)) ]; then mkdir -p $(subst BASIC,BASIC_$(*F),$(hl5_BASIC_WORKLIB)); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(hl5_BASIC_WORKLIB)/hl5_BASIC.d :
	@if [ ! -d $(hl5_BASIC_WORKLIB) ]; then mkdir -p $(hl5_BASIC_WORKLIB); fi
	@touch $(hl5_BASIC_WORKLIB)/hl5_BASIC.d



#
# HLS config BASIC_POFF
#

#
#	stratus_hls rule
#
LIB_DIRS_hl5_BASIC_POFF = $(memlib_SRCDIR) 
LIB_INCLUDES_hl5_BASIC_POFF = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_hl5_BASIC_POFF))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_hl5_BASIC_POFF = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_hl5_BASIC_POFF = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_hl5_BASIC_POFF = 
EXTRACT_LIB_DASHI_hl5_BASIC_POFF = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl hl5 BASIC_POFF]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_hl5_BASIC_POFF = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/hl5/BASIC_POFF/c_parts -DBASIC_POFF=1 -DBDW_RTL_hl5_BASIC_POFF=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_hl5_BASIC_POFF)
CCFLAGS_COSIM_hl5_BASIC_POFF = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/hl5/BASIC_POFF/c_parts -DBASIC_POFF=1 -DBDW_RTL_hl5_BASIC_POFF=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_hl5_BASIC_POFF)
CCFLAGS_BEH_hl5_BASIC_POFF = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/hl5/BASIC_POFF/c_parts -DBASIC_POFF=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_hl5_BASIC_POFF)
CCFLAGS_hl5_BASIC_POFF += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_hl5_BASIC_POFF += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_hl5_BASIC_POFF += ${BDW_CCFLAGS_TAIL}

.PHONY: hlsc_hl5_BASIC_POFF hls_hl5_BASIC_POFF

hls_hl5_BASIC_POFF : hlsc_hl5_BASIC_POFF

cynth_hl5_BASIC_POFF : hlsc_hl5_BASIC_POFF

elab_hl5_BASIC_POFF : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/hl5/BASIC_POFF/stratus_hls.bdr

optim_hl5_BASIC_POFF : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/hl5/BASIC_POFF/stratus_hls.bdr

sched_hl5_BASIC_POFF : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/hl5/BASIC_POFF/stratus_hls.bdr

hlsc_hl5_BASIC_POFF : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/hl5/BASIC_POFF/hl5_rtl.cpp BDW_DEP_CYNTH_CONFIG=BASIC_POFF BDW_MODULE=hl5 BDW_HLS_CONFIG=BASIC_POFF 
else
	@bdw_exec -jobproject project.tcl -job hls.hl5.BASIC_POFF $(MAKE) CWBExec_hls=1 hlsc_hl5_BASIC_POFF
endif

clean_cynth_hl5_BASIC_POFF: clean_hls_hl5_BASIC_POFF

clean_hl5_BASIC_POFF: clean_hls_hl5_BASIC_POFF

clean_hls_hl5_BASIC_POFF:
	@rm -rf $(BDW_WORKLIB)/modules/hl5/BASIC_POFF
	@rm -rf $(BDW_WORKLIB)/jobs/hls.hl5.BASIC_POFF
	@rm -rf $(BDW_WORKLIB)/jobs/hls.hl5.BASIC_POFF.s

kill_hls_hl5_BASIC_POFF:
	@bdw_kill -job hls.hl5.BASIC_POFF
	@bdw_kill -job hls.hl5.BASIC_POFF.s


hls_hl5_BASIC_POFF_% : hlsc_hl5_BASIC_POFF_%

cynth_hl5_BASIC_POFF_% : hlsc_hl5_BASIC_POFF_%

elab_hl5_BASIC_POFF_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(subst /BASIC_POFF/,/BASIC_POFF_$(*F)/,$(BDW_WORKLIB)/modules/hl5/BASIC_POFF/stratus_hls.bdr)

optim_hl5_BASIC_POFF_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(subst /BASIC_POFF/,/BASIC_POFF_$(*F)/,$(BDW_WORKLIB)/modules/hl5/BASIC_POFF/stratus_hls.bdr)

sched_hl5_BASIC_POFF_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(subst /BASIC_POFF/,/BASIC_POFF_$(*F)/,$(BDW_WORKLIB)/modules/hl5/BASIC_POFF/stratus_hls.bdr)

hlsc_hl5_BASIC_POFF_% hls_hl5_BASIC_POFF_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /BASIC_POFF/,/BASIC_POFF_$(*F)/,$(BDW_WORKLIB)/modules/hl5/BASIC_POFF/hl5_rtl.cpp) BDW_DEP_CYNTH_CONFIG=BASIC_POFF BDW_MODULE=hl5 BDW_HLS_CONFIG=BASIC_POFF_$(*F) 
else
	@bdw_exec -jobproject project.tcl -job hls.hl5.BASIC_POFF_$(*F) $(MAKE) CWBExec_hls=1 hlsc_hl5_BASIC_POFF_$(*F)
endif

