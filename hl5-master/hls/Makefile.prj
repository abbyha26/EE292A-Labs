	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT2/stratus_hls.bdr

optim_fedec_PIPE_SOFT2 : 
