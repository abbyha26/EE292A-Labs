		BDW_CYNTH_CONFIG=BASIC_POFF \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/hl5/BASIC_POFF \
		BDW_HLS_CONFIG=BASIC_POFF \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/hl5/BASIC_POFF \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_hl5_BASIC_POFF)  \
		`cat  $(BDW_SPECLIB)/hl5/BASIC_POFF.$(*F).bds | grep '^cmdline:' | sed 's/^cmdline://'`\
		-d $(BDW_WORKLIB)/modules/hl5/BASIC_POFF -o hl5_rtl.cpp \
		--hls_module=hl5 --hls_config=BASIC_POFF --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_hl5_BASIC_POFF))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_hl5_BASIC_POFF))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_hl5_BASIC_POFF))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_hl5_BASIC_POFF)   \
		 ../src/hl5.cpp)))
	
	
	
	

else

$(BDW_hl5_BASIC_POFF_HLS_SPEC_TARGETS) :  ../src/hl5.cpp  $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.hl5.BASIC_POFF_$(*F).s $(MAKE) -j1 CWBExec_hlsc=1 $(subst %,$(*F),$(BDW_hl5_BASIC_POFF_HLS_SPEC_TARGETS))

