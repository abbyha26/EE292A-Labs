	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(hl5_PIPE_SOFT1_WORKLIB) prep_c

prep_vlog_hl5_PIPE_SOFT1 : $(hl5_PIPE_SOFT1_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(hl5_PIPE_SOFT1_WORKLIB) prep_vlog

prep_hl5_PIPE_SOFT1 : $(hl5_PIPE_SOFT1_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(hl5_PIPE_SOFT1_WORKLIB) prep

$(hl5_PIPE_SOFT1_WORKLIB)/Makefile : $(hl5_PIPE_SOFT1_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(hl5_PIPE_SOFT1_WORKLIB) ]; then mkdir -p $(hl5_PIPE_SOFT1_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(hl5_PIPE_SOFT1_SRCDIR) -o $(hl5_PIPE_SOFT1_WORKLIB)/Makefile -module hl5 -cynthconfig PIPE_SOFT1   

$(hl5_PIPE_SOFT1_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(hl5_PIPE_SOFT1_WORKLIB) ]; then mkdir -p $(hl5_PIPE_SOFT1_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



prep_c_hl5_PIPE_SOFT1_% : $(subst PIPE_SOFT1,PIPE_SOFT1_%,$(hl5_PIPE_SOFT1_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst PIPE_SOFT1,PIPE_SOFT1_$(*F),$(hl5_PIPE_SOFT1_WORKLIB)) prep_c

prep_vlog_hl5_PIPE_SOFT1_% : $(subst PIPE_SOFT1,PIPE_SOFT1_%,$(hl5_PIPE_SOFT1_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst PIPE_SOFT1,PIPE_SOFT1_$(*F),$(hl5_PIPE_SOFT1_WORKLIB)) prep_vlog

prep_hl5_PIPE_SOFT1_% : $(subst PIPE_SOFT1,PIPE_SOFT1_%,$(hl5_PIPE_SOFT1_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst PIPE_SOFT1,PIPE_SOFT1_$(*F),$(hl5_PIPE_SOFT1_WORKLIB)) prep

$(subst PIPE_SOFT1,PIPE_SOFT1_%,$(hl5_PIPE_SOFT1_WORKLIB))/Makefile : $(hl5_PIPE_SOFT1_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(subst PIPE_SOFT1,PIPE_SOFT1_$(*F),$(hl5_PIPE_SOFT1_WORKLIB)) ]; then mkdir -p $(subst PIPE_SOFT1,PIPE_SOFT1_$(*F),$(hl5_PIPE_SOFT1_WORKLIB)); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(hl5_PIPE_SOFT1_SRCDIR)_$(*F) -o $(subst PIPE_SOFT1,PIPE_SOFT1_$(*F),$(hl5_PIPE_SOFT1_WORKLIB))/Makefile -module hl5 -cynthconfig PIPE_SOFT1_$(*F)   

$(hl5_PIPE_SOFT1_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(subst PIPE_SOFT1,PIPE_SOFT1_$(*F),$(hl5_PIPE_SOFT1_WORKLIB)) ]; then mkdir -p $(subst PIPE_SOFT1,PIPE_SOFT1_$(*F),$(hl5_PIPE_SOFT1_WORKLIB)); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(hl5_PIPE_SOFT1_WORKLIB)/hl5_PIPE_SOFT1.d :
	@if [ ! -d $(hl5_PIPE_SOFT1_WORKLIB) ]; then mkdir -p $(hl5_PIPE_SOFT1_WORKLIB); fi
	@touch $(hl5_PIPE_SOFT1_WORKLIB)/hl5_PIPE_SOFT1.d



#
# HLS config PIPE_SOFT2
#

#
#	stratus_hls rule
#
LIB_DIRS_hl5_PIPE_SOFT2 = $(memlib_SRCDIR) 
LIB_INCLUDES_hl5_PIPE_SOFT2 = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_hl5_PIPE_SOFT2))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_hl5_PIPE_SOFT2 = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_hl5_PIPE_SOFT2 = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_hl5_PIPE_SOFT2 = 
EXTRACT_LIB_DASHI_hl5_PIPE_SOFT2 = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl hl5 PIPE_SOFT2]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_hl5_PIPE_SOFT2 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/c_parts -DPIPE_SOFT2=1 -DBDW_RTL_hl5_PIPE_SOFT2=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DPIPE_SOFT_STALL2=1 $(LIB_INCLUDES_hl5_PIPE_SOFT2)
CCFLAGS_COSIM_hl5_PIPE_SOFT2 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/c_parts -DPIPE_SOFT2=1 -DBDW_RTL_hl5_PIPE_SOFT2=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DPIPE_SOFT_STALL2=1 $(LIB_INCLUDES_hl5_PIPE_SOFT2)
CCFLAGS_BEH_hl5_PIPE_SOFT2 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/c_parts -DPIPE_SOFT2=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DPIPE_SOFT_STALL2=1 $(LIB_INCLUDES_hl5_PIPE_SOFT2)
CCFLAGS_hl5_PIPE_SOFT2 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_hl5_PIPE_SOFT2 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_hl5_PIPE_SOFT2 += ${BDW_CCFLAGS_TAIL}

.PHONY: hlsc_hl5_PIPE_SOFT2 hls_hl5_PIPE_SOFT2

hls_hl5_PIPE_SOFT2 : hlsc_hl5_PIPE_SOFT2

cynth_hl5_PIPE_SOFT2 : hlsc_hl5_PIPE_SOFT2

elab_hl5_PIPE_SOFT2 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/stratus_hls.bdr

optim_hl5_PIPE_SOFT2 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/stratus_hls.bdr

sched_hl5_PIPE_SOFT2 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/stratus_hls.bdr

hlsc_hl5_PIPE_SOFT2 : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/hl5_rtl.cpp BDW_DEP_CYNTH_CONFIG=PIPE_SOFT2 BDW_MODULE=hl5 BDW_HLS_CONFIG=PIPE_SOFT2 
else
	@bdw_exec -jobproject project.tcl -job hls.hl5.PIPE_SOFT2 $(MAKE) CWBExec_hls=1 hlsc_hl5_PIPE_SOFT2
endif

clean_cynth_hl5_PIPE_SOFT2: clean_hls_hl5_PIPE_SOFT2

clean_hl5_PIPE_SOFT2: clean_hls_hl5_PIPE_SOFT2

clean_hls_hl5_PIPE_SOFT2:
	@rm -rf $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2
	@rm -rf $(BDW_WORKLIB)/jobs/hls.hl5.PIPE_SOFT2
	@rm -rf $(BDW_WORKLIB)/jobs/hls.hl5.PIPE_SOFT2.s

kill_hls_hl5_PIPE_SOFT2:
	@bdw_kill -job hls.hl5.PIPE_SOFT2
	@bdw_kill -job hls.hl5.PIPE_SOFT2.s


hls_hl5_PIPE_SOFT2_% : hlsc_hl5_PIPE_SOFT2_%

cynth_hl5_PIPE_SOFT2_% : hlsc_hl5_PIPE_SOFT2_%

elab_hl5_PIPE_SOFT2_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(subst /PIPE_SOFT2/,/PIPE_SOFT2_$(*F)/,$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/stratus_hls.bdr)

optim_hl5_PIPE_SOFT2_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(subst /PIPE_SOFT2/,/PIPE_SOFT2_$(*F)/,$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/stratus_hls.bdr)

sched_hl5_PIPE_SOFT2_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(subst /PIPE_SOFT2/,/PIPE_SOFT2_$(*F)/,$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/stratus_hls.bdr)

hlsc_hl5_PIPE_SOFT2_% hls_hl5_PIPE_SOFT2_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /PIPE_SOFT2/,/PIPE_SOFT2_$(*F)/,$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/hl5_rtl.cpp) BDW_DEP_CYNTH_CONFIG=PIPE_SOFT2 BDW_MODULE=hl5 BDW_HLS_CONFIG=PIPE_SOFT2_$(*F) 
else
	@bdw_exec -jobproject project.tcl -job hls.hl5.PIPE_SOFT2_$(*F) $(MAKE) CWBExec_hls=1 hlsc_hl5_PIPE_SOFT2_$(*F)
endif

clean_cynth_hl5_PIPE_SOFT2_%: clean_hls_hl5_PIPE_SOFT2_%

clean_hl5_PIPE_SOFT2_%: clean_hls_hl5_PIPE_SOFT2_%

clean_hls_hl5_PIPE_SOFT2_%:
	@rm -rf $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.hl5.PIPE_SOFT2_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.hl5.PIPE_SOFT2_$(*F).s

kill_hls_hl5_PIPE_SOFT2_%:
	@bdw_kill -job hls.hl5.PIPE_SOFT2_$(*F)
	@bdw_kill -job hls.hl5.PIPE_SOFT2_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),PIPE_SOFT2)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/hl5.d
                -include $(memlib_WORKLIB)/memlib.d
                BDW_LIB_DEPS =  $(memlib_DEPS)
            endif
        endif
    endif
endif


html_hl5_PIPE_SOFT2 :
	bdw_htmlgen -project project.tcl -module hl5 -cynthconfig PIPE_SOFT2

BDW_hl5_PIPE_SOFT2_HLS_TARGETS := $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/hl5_rtl.cpp $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/hl5_rtl.v $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/stratus_hls.bdr
ifeq ($(BDW_BDR_ONLY),1)
.PHONY: $(filter %.bdr %.cpp,$(BDW_hl5_PIPE_SOFT2_HLS_TARGETS))
$(filter %.v %.cpp,$(BDW_hl5_PIPE_SOFT2_HLS_TARGETS)) : $(filter %.bdr,$(BDW_hl5_PIPE_SOFT2_HLS_TARGETS))
BDW_hl5_PIPE_SOFT2_HLS_TARGETS := $(filter %.bdr,$(BDW_hl5_PIPE_SOFT2_HLS_TARGETS))
endif
BDW_hl5_PIPE_SOFT2_HLS_SPEC_TARGETS = $(subst /PIPE_SOFT2/,/PIPE_SOFT2_%/,$(BDW_hl5_PIPE_SOFT2_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_hl5_PIPE_SOFT2_HLS_TARGETS) :  ../src/hl5.cpp  $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/memwb_wrap.h  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2 ]; then mkdir -p $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2; fi
	
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=PIPE_SOFT2 BDW_CYNTH_CONFIG=PIPE_SOFT2 \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/hl5_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/hl5_rtl.cpp \
		BDW_MODULE=hl5 \
		BDW_CYNTH_CONFIG=PIPE_SOFT2 \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2 \
		BDW_HLS_CONFIG=PIPE_SOFT2 \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2 \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_hl5_PIPE_SOFT2)  \
		-d $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2 -o hl5_rtl.cpp \
		--hls_module=hl5 --hls_config=PIPE_SOFT2 --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_hl5_PIPE_SOFT2))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_hl5_PIPE_SOFT2))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_hl5_PIPE_SOFT2))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_hl5_PIPE_SOFT2)   \
		 ../src/hl5.cpp
	
	
	
	

else

$(BDW_hl5_PIPE_SOFT2_HLS_TARGETS) :  ../src/hl5.cpp  $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.hl5.PIPE_SOFT2.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_hl5_PIPE_SOFT2_HLS_TARGETS)

endif

	
$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/hl5_trace.h : $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/hl5_trace.h.updated

$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/hl5_trace.h.updated : $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/hl5_rtl.cpp $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module hl5 -cynthconfig PIPE_SOFT2  
	@touch $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/hl5_trace.h.updated

ifeq ($(CWBExec_hlsc),1)

$(BDW_hl5_PIPE_SOFT2_HLS_SPEC_TARGETS) :  ../src/hl5.cpp  $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/memwb_wrap.h  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2_$(*F) ]; then mkdir -p $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2_$(*F); fi
	
	
	$(subst /PIPE_SOFT2 ,/PIPE_SOFT2_$(*F) ,$(subst =PIPE_SOFT2 ,=PIPE_SOFT2_$(*F) ,$(subst /hl5/PIPE_SOFT2/,/hl5/PIPE_SOFT2_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=PIPE_SOFT2 BDW_CYNTH_CONFIG=PIPE_SOFT2 \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/hl5_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/hl5_rtl.cpp \
		BDW_MODULE=hl5 \
		BDW_CYNTH_CONFIG=PIPE_SOFT2 \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2 \
		BDW_HLS_CONFIG=PIPE_SOFT2 \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2 \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_hl5_PIPE_SOFT2)  \
		`cat  $(BDW_SPECLIB)/hl5/PIPE_SOFT2.$(*F).bds | grep '^cmdline:' | sed 's/^cmdline://'`\
		-d $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2 -o hl5_rtl.cpp \
		--hls_module=hl5 --hls_config=PIPE_SOFT2 --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_hl5_PIPE_SOFT2))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_hl5_PIPE_SOFT2))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_hl5_PIPE_SOFT2))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_hl5_PIPE_SOFT2)   \
		 ../src/hl5.cpp)))
	
	
	
	

else

$(BDW_hl5_PIPE_SOFT2_HLS_SPEC_TARGETS) :  ../src/hl5.cpp  $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.hl5.PIPE_SOFT2_$(*F).s $(MAKE) -j1 CWBExec_hlsc=1 $(subst %,$(*F),$(BDW_hl5_PIPE_SOFT2_HLS_SPEC_TARGETS))

endif

	

$(subst /PIPE_SOFT2/,/PIPE_SOFT2_%/,$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/hl5_trace.h) : $(subst /PIPE_SOFT2/,/PIPE_SOFT2_%/,$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/hl5_rtl.cpp) $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module hl5 -cynthconfig PIPE_SOFT2_$(*F)  

catHLLog_hl5_PIPE_SOFT2:
	cat $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/stratus_hls.log

