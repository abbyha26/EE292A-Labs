debug_DPA_aes256_GP_%: 
	@$(MAKE) BDW_DEBUG=1 build_DPA_aes256_GP_$(*F)
	@$(MAKE) run_sim BDW_DEBUG=1 BDW_SIM_CONFIG=DPA_aes256_GP_$(*F)  BDW_BASE_SIM_CONFIG=DPA_aes256_GP BDW_SPEC_NAME=$(*F) RUN_DEBUGGER=1
    
ifeq ($(CWBExec_view),1)
view_DPA_aes256_GP_%:
	@if [ -e $(subst /DPA_aes256_GP/,/DPA_aes256_GP_$(*F)/,$(BDW_WORKLIB)/sims/DPA_aes256_GP/DPA_aes256_GP.shm) ]; then \
	bdw_view_waveform -project project.tcl -simconfig DPA_aes256_GP_$(*F) ;\
	else   \
	$(MAKE) sim_DPA_aes256_GP_$(*F) ;\
	bdw_view_waveform -project project.tcl -simconfig DPA_aes256_GP_$(*F) ;\
    fi
else
view_DPA_aes256_GP_%:
	@bdw_exec -jobproject project.tcl -job view.DPA_aes256_GP_$(*F) $(MAKE) CWBExec_view=1 view_DPA_aes256_GP_$(*F)
endif
    



clean_DPA_aes256_GP_%: clean_hls_DPA_aes256_GP_% clean_sim_DPA_aes256_GP_%

clean_sim_DPA_aes256_GP_%:
	@rm -rf $(BDW_WORKLIB)/jobs/sim.DPA_aes256_GP_$(*F).s
	@rm -rf $(BDW_WORKLIB)/jobs/sim.DPA_aes256_GP_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/build.DPA_aes256_GP_$(*F)
	@rm -f $(BDW_WORKLIB)/modules/hl5/DPA/xcelium/hl5_rtl.o $(BDW_WORKLIB)/modules/fedec/DPA/xcelium/fedec_rtl.o $(BDW_WORKLIB)/modules/execute/DPA/xcelium/execute_rtl.o $(BDW_WORKLIB)/modules/memwb/DPA/xcelium/memwb_rtl.o
	@rm -rf $(BDW_WORKLIB)/sims/DPA_aes256_GP_$(*F) $(subst .v,_$(*F).v,$(BDW_WORKLIB)/sims/top_DPA_aes256_GP.v) $(BDW_WORKLIB)/sims/DPA_aes256_GP/xcelium/sim_DPA_aes256_GP.so
	@$(MAKE) clean_sim_objs BDW_SIM_CONFIG=DPA_aes256_GP_$(*F)  BDW_BASE_SIM_CONFIG=DPA_aes256_GP BDW_SPEC_NAME=$(*F)



$(BDW_WORKLIB)/sims/top_DPA_aes256_GP.v : top_v.bdt $(BDW_LOGOPTIONS_FILE) $(BDW_WORKLIB)/modules/hl5/DPA/hl5_rtl.v   $(BDW_VLOG_DUT_FILES)
	@if [ ! -d $(BDW_WRAPDIR) ]; then mkdir -p $(BDW_WRAPDIR); fi
	$(BDW_WRAPGEN_COMMAND) -project project.tcl -simconfig DPA_aes256_GP -top top

$(subst .v,_%.v,$(BDW_WORKLIB)/sims/top_DPA_aes256_GP.v) : top_v.bdt $(BDW_LOGOPTIONS_FILE) $(BDW_WORKLIB)/modules/hl5/DPA/hl5_rtl.v  
	@$(MAKE) `$(BDW_SPEC_FILTER) project.db $(*F) $(BDW_VLOG_DUT_FILES)`
	@if [ ! -d $(BDW_WRAPDIR) ]; then mkdir -p $(BDW_WRAPDIR); fi
	$(BDW_WRAPGEN_COMMAND) -project project.tcl -simconfig DPA_aes256_GP_$(*F) -top top




