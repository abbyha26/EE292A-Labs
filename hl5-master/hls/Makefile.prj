$(subst /BASIC/,/BASIC$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/fedec/BASIC/xcelium/debug/fedec_beh.o) :  ../src/fedec.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(subst /BASIC/,/BASIC$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/fedec_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
