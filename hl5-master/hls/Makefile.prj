hls_hl5_PIPE_SOFT2 hlsv_hl5_PIPE_SOFT2: $(addprefix prep_vlog_,$(LIB_NAMES_FOR_VLOG_hl5_PIPE_SOFT2)) 

.PHONY: hls_hl5_PIPE_SOFT2

hls_hl5_PIPE_SOFT2_% hlsv_hl5_PIPE_SOFT2_%: $(addprefix prep_vlog_,$(LIB_NAMES_FOR_VLOG_hl5_PIPE_SOFT2)) 

