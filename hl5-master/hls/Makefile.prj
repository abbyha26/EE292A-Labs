	@rm -rf $(BDW_WORKLIB)/sims/DPA_basic_GP_$(*F) $(subst .v,_$(*F).v,$(BDW_WORKLIB)/sims/top_DPA_basic_GP.v) $(BDW_WORKLIB)/sims/DPA_basic_GP/xcelium/sim_DPA_basic_GP.so
