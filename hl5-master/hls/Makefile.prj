#
#	Dependency generation rule
#
$(BDW_WORKLIB)/modules/fedec/BASIC/fedec.d :  ../src/fedec.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config BASIC of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_fedec_BASIC)  ../src/fedec.cpp \
	| sed 's|fedec\.o[ :]*|$(BDW_WORKLIB)/modules/fedec/BASIC/fedec_rtl.cpp $(BDW_WORKLIB)/modules/fedec/BASIC/xcelium/fedec_beh.o $(BDW_WORKLIB)/modules/fedec/BASIC/xcelium/debug/fedec_beh.o $(BDW_WORKLIB)/modules/fedec/BASIC/fedec.d : $(memlib_WORKLIB)/memlib.d |' $(BDW_DEP_FILTER)  > $@

#
#	Library post-proc rules
#



##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/fedec/BASIC"
##############################################################

fedec_BASIC_SRCDIR = $(BDW_WORKLIB)/modules/fedec/BASIC
fedec_BASIC_BEH_SRCDIR = $(BDW_WORKLIB)/libs/fedec_BASIC
fedec_BASIC_LIBNAME = fedec_BASIC
fedec_BASIC_WORKLIB = $(BDW_WORKLIB)/modules/fedec/BASIC/xcelium
fedec_BASIC_C_PARTS_A = $(fedec_BASIC_WORKLIB)/objs/libfedec_BASIC.a

prep_c_fedec_BASIC : $(fedec_BASIC_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(fedec_BASIC_WORKLIB) prep_c

prep_vlog_fedec_BASIC : $(fedec_BASIC_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(fedec_BASIC_WORKLIB) prep_vlog

prep_fedec_BASIC : $(fedec_BASIC_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(fedec_BASIC_WORKLIB) prep

$(fedec_BASIC_WORKLIB)/Makefile : $(fedec_BASIC_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(fedec_BASIC_WORKLIB) ]; then mkdir -p $(fedec_BASIC_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(fedec_BASIC_SRCDIR) -o $(fedec_BASIC_WORKLIB)/Makefile -module fedec -cynthconfig BASIC   

$(fedec_BASIC_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(fedec_BASIC_WORKLIB) ]; then mkdir -p $(fedec_BASIC_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



prep_c_fedec_BASIC_% : $(subst BASIC,BASIC_%,$(fedec_BASIC_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst BASIC,BASIC_$(*F),$(fedec_BASIC_WORKLIB)) prep_c

prep_vlog_fedec_BASIC_% : $(subst BASIC,BASIC_%,$(fedec_BASIC_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst BASIC,BASIC_$(*F),$(fedec_BASIC_WORKLIB)) prep_vlog

prep_fedec_BASIC_% : $(subst BASIC,BASIC_%,$(fedec_BASIC_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst BASIC,BASIC_$(*F),$(fedec_BASIC_WORKLIB)) prep

$(subst BASIC,BASIC_%,$(fedec_BASIC_WORKLIB))/Makefile : $(fedec_BASIC_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(subst BASIC,BASIC_$(*F),$(fedec_BASIC_WORKLIB)) ]; then mkdir -p $(subst BASIC,BASIC_$(*F),$(fedec_BASIC_WORKLIB)); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(fedec_BASIC_SRCDIR)_$(*F) -o $(subst BASIC,BASIC_$(*F),$(fedec_BASIC_WORKLIB))/Makefile -module fedec -cynthconfig BASIC_$(*F)   

$(fedec_BASIC_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(subst BASIC,BASIC_$(*F),$(fedec_BASIC_WORKLIB)) ]; then mkdir -p $(subst BASIC,BASIC_$(*F),$(fedec_BASIC_WORKLIB)); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(fedec_BASIC_WORKLIB)/fedec_BASIC.d :
	@if [ ! -d $(fedec_BASIC_WORKLIB) ]; then mkdir -p $(fedec_BASIC_WORKLIB); fi
	@touch $(fedec_BASIC_WORKLIB)/fedec_BASIC.d



#
# HLS config BASIC_POFF
#

#
#	stratus_hls rule
#
LIB_DIRS_fedec_BASIC_POFF = $(memlib_SRCDIR) 
LIB_INCLUDES_fedec_BASIC_POFF = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_fedec_BASIC_POFF))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_fedec_BASIC_POFF = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_fedec_BASIC_POFF = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_fedec_BASIC_POFF = 
EXTRACT_LIB_DASHI_fedec_BASIC_POFF = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl fedec BASIC_POFF]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_fedec_BASIC_POFF = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/fedec/BASIC_POFF/c_parts -DBASIC_POFF=1 -DBDW_RTL_fedec_BASIC_POFF=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_fedec_BASIC_POFF)
CCFLAGS_COSIM_fedec_BASIC_POFF = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/fedec/BASIC_POFF/c_parts -DBASIC_POFF=1 -DBDW_RTL_fedec_BASIC_POFF=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_fedec_BASIC_POFF)
CCFLAGS_BEH_fedec_BASIC_POFF = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/fedec/BASIC_POFF/c_parts -DBASIC_POFF=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_fedec_BASIC_POFF)
CCFLAGS_fedec_BASIC_POFF += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_fedec_BASIC_POFF += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_fedec_BASIC_POFF += ${BDW_CCFLAGS_TAIL}

.PHONY: hlsc_fedec_BASIC_POFF hls_fedec_BASIC_POFF

hls_fedec_BASIC_POFF : hlsc_fedec_BASIC_POFF

cynth_fedec_BASIC_POFF : hlsc_fedec_BASIC_POFF

elab_fedec_BASIC_POFF : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/fedec/BASIC_POFF/stratus_hls.bdr

optim_fedec_BASIC_POFF : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/fedec/BASIC_POFF/stratus_hls.bdr

sched_fedec_BASIC_POFF : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/fedec/BASIC_POFF/stratus_hls.bdr

hlsc_fedec_BASIC_POFF : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/fedec/BASIC_POFF/fedec_rtl.cpp BDW_DEP_CYNTH_CONFIG=BASIC_POFF BDW_MODULE=fedec BDW_HLS_CONFIG=BASIC_POFF 
else
	@bdw_exec -jobproject project.tcl -job hls.fedec.BASIC_POFF $(MAKE) CWBExec_hls=1 hlsc_fedec_BASIC_POFF
endif

clean_cynth_fedec_BASIC_POFF: clean_hls_fedec_BASIC_POFF

clean_fedec_BASIC_POFF: clean_hls_fedec_BASIC_POFF

clean_hls_fedec_BASIC_POFF:
	@rm -rf $(BDW_WORKLIB)/modules/fedec/BASIC_POFF
	@rm -rf $(BDW_WORKLIB)/jobs/hls.fedec.BASIC_POFF
	@rm -rf $(BDW_WORKLIB)/jobs/hls.fedec.BASIC_POFF.s

kill_hls_fedec_BASIC_POFF:
	@bdw_kill -job hls.fedec.BASIC_POFF
	@bdw_kill -job hls.fedec.BASIC_POFF.s


hls_fedec_BASIC_POFF_% : hlsc_fedec_BASIC_POFF_%

cynth_fedec_BASIC_POFF_% : hlsc_fedec_BASIC_POFF_%

elab_fedec_BASIC_POFF_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(subst /BASIC_POFF/,/BASIC_POFF_$(*F)/,$(BDW_WORKLIB)/modules/fedec/BASIC_POFF/stratus_hls.bdr)

optim_fedec_BASIC_POFF_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(subst /BASIC_POFF/,/BASIC_POFF_$(*F)/,$(BDW_WORKLIB)/modules/fedec/BASIC_POFF/stratus_hls.bdr)

sched_fedec_BASIC_POFF_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(subst /BASIC_POFF/,/BASIC_POFF_$(*F)/,$(BDW_WORKLIB)/modules/fedec/BASIC_POFF/stratus_hls.bdr)

hlsc_fedec_BASIC_POFF_% hls_fedec_BASIC_POFF_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /BASIC_POFF/,/BASIC_POFF_$(*F)/,$(BDW_WORKLIB)/modules/fedec/BASIC_POFF/fedec_rtl.cpp) BDW_DEP_CYNTH_CONFIG=BASIC_POFF BDW_MODULE=fedec BDW_HLS_CONFIG=BASIC_POFF_$(*F) 
else
	@bdw_exec -jobproject project.tcl -job hls.fedec.BASIC_POFF_$(*F) $(MAKE) CWBExec_hls=1 hlsc_fedec_BASIC_POFF_$(*F)
endif

clean_cynth_fedec_BASIC_POFF_%: clean_hls_fedec_BASIC_POFF_%

clean_fedec_BASIC_POFF_%: clean_hls_fedec_BASIC_POFF_%

clean_hls_fedec_BASIC_POFF_%:
	@rm -rf $(BDW_WORKLIB)/modules/fedec/BASIC_POFF_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.fedec.BASIC_POFF_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.fedec.BASIC_POFF_$(*F).s

kill_hls_fedec_BASIC_POFF_%:
	@bdw_kill -job hls.fedec.BASIC_POFF_$(*F)
	@bdw_kill -job hls.fedec.BASIC_POFF_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),BASIC_POFF)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/fedec/BASIC_POFF/fedec.d
                -include $(memlib_WORKLIB)/memlib.d
                BDW_LIB_DEPS =  $(memlib_DEPS)
            endif
        endif
    endif
endif


html_fedec_BASIC_POFF :
	bdw_htmlgen -project project.tcl -module fedec -cynthconfig BASIC_POFF

BDW_fedec_BASIC_POFF_HLS_TARGETS := $(BDW_WORKLIB)/modules/fedec/BASIC_POFF/fedec_rtl.cpp $(BDW_WORKLIB)/modules/fedec/BASIC_POFF/fedec_rtl.v $(BDW_WORKLIB)/modules/fedec/BASIC_POFF/stratus_hls.bdr
ifeq ($(BDW_BDR_ONLY),1)
.PHONY: $(filter %.bdr %.cpp,$(BDW_fedec_BASIC_POFF_HLS_TARGETS))
$(filter %.v %.cpp,$(BDW_fedec_BASIC_POFF_HLS_TARGETS)) : $(filter %.bdr,$(BDW_fedec_BASIC_POFF_HLS_TARGETS))
BDW_fedec_BASIC_POFF_HLS_TARGETS := $(filter %.bdr,$(BDW_fedec_BASIC_POFF_HLS_TARGETS))
endif
BDW_fedec_BASIC_POFF_HLS_SPEC_TARGETS = $(subst /BASIC_POFF/,/BASIC_POFF_%/,$(BDW_fedec_BASIC_POFF_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_fedec_BASIC_POFF_HLS_TARGETS) :  ../src/fedec.cpp   $(BDW_LIB_DEPS)
	+make --no-print-directory  $(BDW_WORKLIB)/wrappers/hl5_wrap.h
	@if [ ! -d $(BDW_WORKLIB)/modules/fedec/BASIC_POFF ]; then mkdir -p $(BDW_WORKLIB)/modules/fedec/BASIC_POFF; fi
	
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=BASIC_POFF BDW_CYNTH_CONFIG=BASIC_POFF \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/fedec/BASIC_POFF/fedec_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/fedec/BASIC_POFF/fedec_rtl.cpp \
		BDW_MODULE=fedec \
		BDW_CYNTH_CONFIG=BASIC_POFF \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/fedec/BASIC_POFF \
		BDW_HLS_CONFIG=BASIC_POFF \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/fedec/BASIC_POFF \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_fedec_BASIC_POFF)  \
		-d $(BDW_WORKLIB)/modules/fedec/BASIC_POFF -o fedec_rtl.cpp \
		--hls_module=fedec --hls_config=BASIC_POFF --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_fedec_BASIC_POFF))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_fedec_BASIC_POFF))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_fedec_BASIC_POFF))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_fedec_BASIC_POFF)   \
		 ../src/fedec.cpp
	
	
	
	

else

$(BDW_fedec_BASIC_POFF_HLS_TARGETS) :  ../src/fedec.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.fedec.BASIC_POFF.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_fedec_BASIC_POFF_HLS_TARGETS)

endif

	
$(BDW_WORKLIB)/modules/fedec/BASIC_POFF/fedec_trace.h : $(BDW_WORKLIB)/modules/fedec/BASIC_POFF/fedec_trace.h.updated

$(BDW_WORKLIB)/modules/fedec/BASIC_POFF/fedec_trace.h.updated : $(BDW_WORKLIB)/modules/fedec/BASIC_POFF/fedec_rtl.cpp $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module fedec -cynthconfig BASIC_POFF  
	@touch $(BDW_WORKLIB)/modules/fedec/BASIC_POFF/fedec_trace.h.updated

ifeq ($(CWBExec_hlsc),1)

$(BDW_fedec_BASIC_POFF_HLS_SPEC_TARGETS) :  ../src/fedec.cpp   $(BDW_LIB_DEPS)
	+make --no-print-directory  $(BDW_WORKLIB)/wrappers/hl5_wrap.h
	@if [ ! -d $(BDW_WORKLIB)/modules/fedec/BASIC_POFF_$(*F) ]; then mkdir -p $(BDW_WORKLIB)/modules/fedec/BASIC_POFF_$(*F); fi
	
	
	$(subst /BASIC_POFF ,/BASIC_POFF_$(*F) ,$(subst =BASIC_POFF ,=BASIC_POFF_$(*F) ,$(subst /fedec/BASIC_POFF/,/fedec/BASIC_POFF_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=BASIC_POFF BDW_CYNTH_CONFIG=BASIC_POFF \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/fedec/BASIC_POFF/fedec_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/fedec/BASIC_POFF/fedec_rtl.cpp \
		BDW_MODULE=fedec \
		BDW_CYNTH_CONFIG=BASIC_POFF \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/fedec/BASIC_POFF \
		BDW_HLS_CONFIG=BASIC_POFF \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/fedec/BASIC_POFF \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_fedec_BASIC_POFF)  \
		`cat  $(BDW_SPECLIB)/fedec/BASIC_POFF.$(*F).bds | grep '^cmdline:' | sed 's/^cmdline://'`\
		-d $(BDW_WORKLIB)/modules/fedec/BASIC_POFF -o fedec_rtl.cpp \
		--hls_module=fedec --hls_config=BASIC_POFF --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_fedec_BASIC_POFF))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_fedec_BASIC_POFF))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_fedec_BASIC_POFF))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_fedec_BASIC_POFF)   \
		 ../src/fedec.cpp)))
	
	
	
	

else

$(BDW_fedec_BASIC_POFF_HLS_SPEC_TARGETS) :  ../src/fedec.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.fedec.BASIC_POFF_$(*F).s $(MAKE) -j1 CWBExec_hlsc=1 $(subst %,$(*F),$(BDW_fedec_BASIC_POFF_HLS_SPEC_TARGETS))

endif

	

$(subst /BASIC_POFF/,/BASIC_POFF_%/,$(BDW_WORKLIB)/modules/fedec/BASIC_POFF/fedec_trace.h) : $(subst /BASIC_POFF/,/BASIC_POFF_%/,$(BDW_WORKLIB)/modules/fedec/BASIC_POFF/fedec_rtl.cpp) $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module fedec -cynthconfig BASIC_POFF_$(*F)  

catHLLog_fedec_BASIC_POFF:
	cat $(BDW_WORKLIB)/modules/fedec/BASIC_POFF/stratus_hls.log

#
#	stratus_vlg rule
#
cynthvlg_fedec_BASIC_POFF : hls_fedec_BASIC_POFF 


.PHONY: hls_fedec_BASIC_POFF

hls_fedec_BASIC_POFF hlsv_fedec_BASIC_POFF: $(addprefix prep_vlog_,$(LIB_NAMES_FOR_VLOG_fedec_BASIC_POFF)) 

.PHONY: hls_fedec_BASIC_POFF

hls_fedec_BASIC_POFF_% hlsv_fedec_BASIC_POFF_%: $(addprefix prep_vlog_,$(LIB_NAMES_FOR_VLOG_fedec_BASIC_POFF)) 

catVLGLog_fedec_BASIC_POFF : catHLLog_fedec_BASIC_POFF
	cat $(BDW_WORKLIB)/modules/fedec/BASIC_POFF/stratus_vlg.log

#
#	view rule
#

view_fedec_BASIC_POFF:
	@echo "ERROR: Schematic viewing target 'view_fedec_BASIC_POFF' is only supported with 'verdi'"
	@echo "The Stratus IDE includes a schematic view as an alternative."


#
#	RTL object file rule
#
$(BDW_WORKLIB)/modules/fedec/BASIC_POFF/xcelium/fedec_rtl.o : $(BDW_WORKLIB)/modules/fedec/BASIC_POFF/fedec_rtl.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(BDW_WORKLIB)/modules/fedec/BASIC_POFF/fedec_trace.h
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl fedec`
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/BASIC_POFF/ -I./ $(CCFLAGS_fedec_BASIC_POFF) $(EXTRACT_LIB_DASHI_fedec_BASIC_POFF) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/fedec/BASIC_POFF/xcelium/fedec_rtl.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp

$(BDW_WORKLIB)/modules/fedec/BASIC_POFF/xcelium/debug/fedec_rtl.o : $(BDW_WORKLIB)/modules/fedec/BASIC_POFF/fedec_rtl.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(BDW_WORKLIB)/modules/fedec/BASIC_POFF/fedec_trace.h
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl fedec`
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/BASIC_POFF/ -I./ $(CCFLAGS_fedec_BASIC_POFF) $(EXTRACT_LIB_DASHI_fedec_BASIC_POFF) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/fedec/BASIC_POFF/xcelium/debug/fedec_rtl.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp

#
#	Behavioral object file rule.  Used only for BEH configs that are 
#	associated with HLS config names.
#

$(BDW_WORKLIB)/modules/fedec/BASIC_POFF/xcelium/fedec_beh.o :  ../src/fedec.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(BDW_WORKLIB)/wrappers/fedec_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/BASIC_POFF/ -I./ $(CCFLAGS_BEH_fedec_BASIC_POFF) -o $(BDW_WORKLIB)/modules/fedec/BASIC_POFF/xcelium/fedec_beh.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp

$(BDW_WORKLIB)/modules/fedec/BASIC_POFF/xcelium/debug/fedec_beh.o :  ../src/fedec.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(BDW_WORKLIB)/wrappers/fedec_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/BASIC_POFF/ -I./ $(CCFLAGS_BEH_fedec_BASIC_POFF) -o $(BDW_WORKLIB)/modules/fedec/BASIC_POFF/xcelium/debug/fedec_beh.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp

#
# Cosim object file rule
#

$(BDW_WORKLIB)/modules/fedec/BASIC_POFF/xcelium/fedec.o :  ../src/fedec.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(BDW_WORKLIB)/wrappers/fedec_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/BASIC_POFF/ -I./ $(CCFLAGS_COSIM_fedec_BASIC_POFF) -o $(BDW_WORKLIB)/modules/fedec/BASIC_POFF/xcelium/fedec.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp
    

$(BDW_WORKLIB)/modules/fedec/BASIC_POFF/xcelium/fedec_hoist.o :  ../src/fedec.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(BDW_WORKLIB)/wrappers/fedec_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/BASIC_POFF/ -I./ $(CCFLAGS_fedec_BASIC_POFF) $(EXTRACT_LIB_DASHI_fedec_BASIC_POFF) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/fedec/BASIC_POFF/xcelium/fedec_hoist.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp
    

$(BDW_WORKLIB)/modules/fedec/BASIC_POFF/xcelium/debug/fedec.o :  ../src/fedec.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(BDW_WORKLIB)/wrappers/fedec_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/BASIC_POFF/ -I./ $(CCFLAGS_COSIM_fedec_BASIC_POFF) -o $(BDW_WORKLIB)/modules/fedec/BASIC_POFF/xcelium/debug/fedec.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp


$(BDW_WORKLIB)/modules/fedec/BASIC_POFF/xcelium/debug/fedec_hoist.o :  ../src/fedec.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(BDW_WORKLIB)/wrappers/fedec_trace.h
