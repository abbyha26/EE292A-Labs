#
#	view rule
#

view_hl5_PIPE_SOFT2:
	@echo "ERROR: Schematic viewing target 'view_hl5_PIPE_SOFT2' is only supported with 'verdi'"
	@echo "The Stratus IDE includes a schematic view as an alternative."


#
#	RTL object file rule
#
$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/xcelium/hl5_rtl.o : $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/hl5_rtl.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/hl5_trace.h
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl hl5`
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/ -I./ $(CCFLAGS_hl5_PIPE_SOFT2) $(EXTRACT_LIB_DASHI_hl5_PIPE_SOFT2) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/xcelium/hl5_rtl.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp

$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/xcelium/debug/hl5_rtl.o : $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/hl5_rtl.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/hl5_trace.h
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl hl5`
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/ -I./ $(CCFLAGS_hl5_PIPE_SOFT2) $(EXTRACT_LIB_DASHI_hl5_PIPE_SOFT2) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/xcelium/debug/hl5_rtl.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp

#
#	Behavioral object file rule.  Used only for BEH configs that are 
#	associated with HLS config names.
#

$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/xcelium/hl5_beh.o :  ../src/hl5.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.h $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(BDW_WORKLIB)/wrappers/hl5_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/ -I./ $(CCFLAGS_BEH_hl5_PIPE_SOFT2) -o $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/xcelium/hl5_beh.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp

$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/xcelium/debug/hl5_beh.o :  ../src/hl5.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.h $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(BDW_WORKLIB)/wrappers/hl5_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/ -I./ $(CCFLAGS_BEH_hl5_PIPE_SOFT2) -o $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/xcelium/debug/hl5_beh.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp

#
# Cosim object file rule
#

$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/xcelium/hl5.o :  ../src/hl5.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.h $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(BDW_WORKLIB)/wrappers/hl5_trace.h
