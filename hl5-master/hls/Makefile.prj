#
#	Dependency generation rule
#
$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/hl5.d :  ../src/hl5.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config PIPE_SOFT2 of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_hl5_PIPE_SOFT2)  ../src/hl5.cpp \
	| sed 's|hl5\.o[ :]*|$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/hl5_rtl.cpp $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/xcelium/hl5_beh.o $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/xcelium/debug/hl5_beh.o $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/hl5.d : $(memlib_WORKLIB)/memlib.d |' $(BDW_DEP_FILTER)  > $@

#
#	Library post-proc rules
#



##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2"
##############################################################

hl5_PIPE_SOFT2_SRCDIR = $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2
hl5_PIPE_SOFT2_BEH_SRCDIR = $(BDW_WORKLIB)/libs/hl5_PIPE_SOFT2
hl5_PIPE_SOFT2_LIBNAME = hl5_PIPE_SOFT2
hl5_PIPE_SOFT2_WORKLIB = $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT2/xcelium
hl5_PIPE_SOFT2_C_PARTS_A = $(hl5_PIPE_SOFT2_WORKLIB)/objs/libhl5_PIPE_SOFT2.a

prep_c_hl5_PIPE_SOFT2 : $(hl5_PIPE_SOFT2_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(hl5_PIPE_SOFT2_WORKLIB) prep_c

prep_vlog_hl5_PIPE_SOFT2 : $(hl5_PIPE_SOFT2_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(hl5_PIPE_SOFT2_WORKLIB) prep_vlog

prep_hl5_PIPE_SOFT2 : $(hl5_PIPE_SOFT2_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(hl5_PIPE_SOFT2_WORKLIB) prep

$(hl5_PIPE_SOFT2_WORKLIB)/Makefile : $(hl5_PIPE_SOFT2_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(hl5_PIPE_SOFT2_WORKLIB) ]; then mkdir -p $(hl5_PIPE_SOFT2_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(hl5_PIPE_SOFT2_SRCDIR) -o $(hl5_PIPE_SOFT2_WORKLIB)/Makefile -module hl5 -cynthconfig PIPE_SOFT2   

$(hl5_PIPE_SOFT2_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(hl5_PIPE_SOFT2_WORKLIB) ]; then mkdir -p $(hl5_PIPE_SOFT2_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



prep_c_hl5_PIPE_SOFT2_% : $(subst PIPE_SOFT2,PIPE_SOFT2_%,$(hl5_PIPE_SOFT2_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst PIPE_SOFT2,PIPE_SOFT2_$(*F),$(hl5_PIPE_SOFT2_WORKLIB)) prep_c

prep_vlog_hl5_PIPE_SOFT2_% : $(subst PIPE_SOFT2,PIPE_SOFT2_%,$(hl5_PIPE_SOFT2_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst PIPE_SOFT2,PIPE_SOFT2_$(*F),$(hl5_PIPE_SOFT2_WORKLIB)) prep_vlog

prep_hl5_PIPE_SOFT2_% : $(subst PIPE_SOFT2,PIPE_SOFT2_%,$(hl5_PIPE_SOFT2_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst PIPE_SOFT2,PIPE_SOFT2_$(*F),$(hl5_PIPE_SOFT2_WORKLIB)) prep

$(subst PIPE_SOFT2,PIPE_SOFT2_%,$(hl5_PIPE_SOFT2_WORKLIB))/Makefile : $(hl5_PIPE_SOFT2_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(subst PIPE_SOFT2,PIPE_SOFT2_$(*F),$(hl5_PIPE_SOFT2_WORKLIB)) ]; then mkdir -p $(subst PIPE_SOFT2,PIPE_SOFT2_$(*F),$(hl5_PIPE_SOFT2_WORKLIB)); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(hl5_PIPE_SOFT2_SRCDIR)_$(*F) -o $(subst PIPE_SOFT2,PIPE_SOFT2_$(*F),$(hl5_PIPE_SOFT2_WORKLIB))/Makefile -module hl5 -cynthconfig PIPE_SOFT2_$(*F)   

$(hl5_PIPE_SOFT2_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(subst PIPE_SOFT2,PIPE_SOFT2_$(*F),$(hl5_PIPE_SOFT2_WORKLIB)) ]; then mkdir -p $(subst PIPE_SOFT2,PIPE_SOFT2_$(*F),$(hl5_PIPE_SOFT2_WORKLIB)); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(hl5_PIPE_SOFT2_WORKLIB)/hl5_PIPE_SOFT2.d :
	@if [ ! -d $(hl5_PIPE_SOFT2_WORKLIB) ]; then mkdir -p $(hl5_PIPE_SOFT2_WORKLIB); fi
	@touch $(hl5_PIPE_SOFT2_WORKLIB)/hl5_PIPE_SOFT2.d



#
# HLS config PIPE_SOFT3
#

#
#	stratus_hls rule
#
LIB_DIRS_hl5_PIPE_SOFT3 = $(memlib_SRCDIR) 
LIB_INCLUDES_hl5_PIPE_SOFT3 = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_hl5_PIPE_SOFT3))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_hl5_PIPE_SOFT3 = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_hl5_PIPE_SOFT3 = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_hl5_PIPE_SOFT3 = 
EXTRACT_LIB_DASHI_hl5_PIPE_SOFT3 = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl hl5 PIPE_SOFT3]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_hl5_PIPE_SOFT3 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT3/c_parts -DPIPE_SOFT3=1 -DBDW_RTL_hl5_PIPE_SOFT3=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DPIPE_SOFT_STALL3=1 $(LIB_INCLUDES_hl5_PIPE_SOFT3)
CCFLAGS_COSIM_hl5_PIPE_SOFT3 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT3/c_parts -DPIPE_SOFT3=1 -DBDW_RTL_hl5_PIPE_SOFT3=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DPIPE_SOFT_STALL3=1 $(LIB_INCLUDES_hl5_PIPE_SOFT3)
CCFLAGS_BEH_hl5_PIPE_SOFT3 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT3/c_parts -DPIPE_SOFT3=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DPIPE_SOFT_STALL3=1 $(LIB_INCLUDES_hl5_PIPE_SOFT3)
CCFLAGS_hl5_PIPE_SOFT3 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_hl5_PIPE_SOFT3 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_hl5_PIPE_SOFT3 += ${BDW_CCFLAGS_TAIL}

.PHONY: hlsc_hl5_PIPE_SOFT3 hls_hl5_PIPE_SOFT3

hls_hl5_PIPE_SOFT3 : hlsc_hl5_PIPE_SOFT3

cynth_hl5_PIPE_SOFT3 : hlsc_hl5_PIPE_SOFT3

elab_hl5_PIPE_SOFT3 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT3/stratus_hls.bdr

optim_hl5_PIPE_SOFT3 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT3/stratus_hls.bdr

sched_hl5_PIPE_SOFT3 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT3/stratus_hls.bdr

hlsc_hl5_PIPE_SOFT3 : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT3/hl5_rtl.cpp BDW_DEP_CYNTH_CONFIG=PIPE_SOFT3 BDW_MODULE=hl5 BDW_HLS_CONFIG=PIPE_SOFT3 
else
	@bdw_exec -jobproject project.tcl -job hls.hl5.PIPE_SOFT3 $(MAKE) CWBExec_hls=1 hlsc_hl5_PIPE_SOFT3
endif

clean_cynth_hl5_PIPE_SOFT3: clean_hls_hl5_PIPE_SOFT3

clean_hl5_PIPE_SOFT3: clean_hls_hl5_PIPE_SOFT3

clean_hls_hl5_PIPE_SOFT3:
	@rm -rf $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT3
	@rm -rf $(BDW_WORKLIB)/jobs/hls.hl5.PIPE_SOFT3
	@rm -rf $(BDW_WORKLIB)/jobs/hls.hl5.PIPE_SOFT3.s

kill_hls_hl5_PIPE_SOFT3:
	@bdw_kill -job hls.hl5.PIPE_SOFT3
	@bdw_kill -job hls.hl5.PIPE_SOFT3.s


hls_hl5_PIPE_SOFT3_% : hlsc_hl5_PIPE_SOFT3_%

cynth_hl5_PIPE_SOFT3_% : hlsc_hl5_PIPE_SOFT3_%

elab_hl5_PIPE_SOFT3_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(subst /PIPE_SOFT3/,/PIPE_SOFT3_$(*F)/,$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT3/stratus_hls.bdr)

optim_hl5_PIPE_SOFT3_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(subst /PIPE_SOFT3/,/PIPE_SOFT3_$(*F)/,$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT3/stratus_hls.bdr)

sched_hl5_PIPE_SOFT3_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(subst /PIPE_SOFT3/,/PIPE_SOFT3_$(*F)/,$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT3/stratus_hls.bdr)

hlsc_hl5_PIPE_SOFT3_% hls_hl5_PIPE_SOFT3_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /PIPE_SOFT3/,/PIPE_SOFT3_$(*F)/,$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT3/hl5_rtl.cpp) BDW_DEP_CYNTH_CONFIG=PIPE_SOFT3 BDW_MODULE=hl5 BDW_HLS_CONFIG=PIPE_SOFT3_$(*F) 
else
	@bdw_exec -jobproject project.tcl -job hls.hl5.PIPE_SOFT3_$(*F) $(MAKE) CWBExec_hls=1 hlsc_hl5_PIPE_SOFT3_$(*F)
endif

clean_cynth_hl5_PIPE_SOFT3_%: clean_hls_hl5_PIPE_SOFT3_%

clean_hl5_PIPE_SOFT3_%: clean_hls_hl5_PIPE_SOFT3_%

clean_hls_hl5_PIPE_SOFT3_%:
	@rm -rf $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT3_$(*F)
