#
#	Dependency generation rule
#
$(BDW_WORKLIB)/modules/hl5/RADIX_2/hl5.d :  ../src/hl5.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config RADIX_2 of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_hl5_RADIX_2)  ../src/hl5.cpp \
	| sed 's|hl5\.o[ :]*|$(BDW_WORKLIB)/modules/hl5/RADIX_2/hl5_rtl.cpp $(BDW_WORKLIB)/modules/hl5/RADIX_2/xcelium/hl5_beh.o $(BDW_WORKLIB)/modules/hl5/RADIX_2/xcelium/debug/hl5_beh.o $(BDW_WORKLIB)/modules/hl5/RADIX_2/hl5.d : $(memlib_WORKLIB)/memlib.d |' $(BDW_DEP_FILTER)  > $@

#
#	Library post-proc rules
#



##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/hl5/RADIX_2"
##############################################################

hl5_RADIX_2_SRCDIR = $(BDW_WORKLIB)/modules/hl5/RADIX_2
hl5_RADIX_2_BEH_SRCDIR = $(BDW_WORKLIB)/libs/hl5_RADIX_2
hl5_RADIX_2_LIBNAME = hl5_RADIX_2
hl5_RADIX_2_WORKLIB = $(BDW_WORKLIB)/modules/hl5/RADIX_2/xcelium
hl5_RADIX_2_C_PARTS_A = $(hl5_RADIX_2_WORKLIB)/objs/libhl5_RADIX_2.a

prep_c_hl5_RADIX_2 : $(hl5_RADIX_2_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(hl5_RADIX_2_WORKLIB) prep_c

prep_vlog_hl5_RADIX_2 : $(hl5_RADIX_2_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(hl5_RADIX_2_WORKLIB) prep_vlog

prep_hl5_RADIX_2 : $(hl5_RADIX_2_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(hl5_RADIX_2_WORKLIB) prep

$(hl5_RADIX_2_WORKLIB)/Makefile : $(hl5_RADIX_2_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(hl5_RADIX_2_WORKLIB) ]; then mkdir -p $(hl5_RADIX_2_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(hl5_RADIX_2_SRCDIR) -o $(hl5_RADIX_2_WORKLIB)/Makefile -module hl5 -cynthconfig RADIX_2   

$(hl5_RADIX_2_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(hl5_RADIX_2_WORKLIB) ]; then mkdir -p $(hl5_RADIX_2_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



prep_c_hl5_RADIX_2_% : $(subst RADIX_2,RADIX_2_%,$(hl5_RADIX_2_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst RADIX_2,RADIX_2_$(*F),$(hl5_RADIX_2_WORKLIB)) prep_c

prep_vlog_hl5_RADIX_2_% : $(subst RADIX_2,RADIX_2_%,$(hl5_RADIX_2_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst RADIX_2,RADIX_2_$(*F),$(hl5_RADIX_2_WORKLIB)) prep_vlog

prep_hl5_RADIX_2_% : $(subst RADIX_2,RADIX_2_%,$(hl5_RADIX_2_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst RADIX_2,RADIX_2_$(*F),$(hl5_RADIX_2_WORKLIB)) prep

$(subst RADIX_2,RADIX_2_%,$(hl5_RADIX_2_WORKLIB))/Makefile : $(hl5_RADIX_2_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(subst RADIX_2,RADIX_2_$(*F),$(hl5_RADIX_2_WORKLIB)) ]; then mkdir -p $(subst RADIX_2,RADIX_2_$(*F),$(hl5_RADIX_2_WORKLIB)); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(hl5_RADIX_2_SRCDIR)_$(*F) -o $(subst RADIX_2,RADIX_2_$(*F),$(hl5_RADIX_2_WORKLIB))/Makefile -module hl5 -cynthconfig RADIX_2_$(*F)   

$(hl5_RADIX_2_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(subst RADIX_2,RADIX_2_$(*F),$(hl5_RADIX_2_WORKLIB)) ]; then mkdir -p $(subst RADIX_2,RADIX_2_$(*F),$(hl5_RADIX_2_WORKLIB)); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(hl5_RADIX_2_WORKLIB)/hl5_RADIX_2.d :
	@if [ ! -d $(hl5_RADIX_2_WORKLIB) ]; then mkdir -p $(hl5_RADIX_2_WORKLIB); fi
	@touch $(hl5_RADIX_2_WORKLIB)/hl5_RADIX_2.d



#
# HLS config RADIX_4
#

#
#	stratus_hls rule
#
LIB_DIRS_hl5_RADIX_4 = $(memlib_SRCDIR) 
LIB_INCLUDES_hl5_RADIX_4 = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_hl5_RADIX_4))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_hl5_RADIX_4 = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_hl5_RADIX_4 = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_hl5_RADIX_4 = 
EXTRACT_LIB_DASHI_hl5_RADIX_4 = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl hl5 RADIX_4]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_hl5_RADIX_4 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/hl5/RADIX_4/c_parts -DRADIX_4=1 -DBDW_RTL_hl5_RADIX_4=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DDIV_RADIX_4 $(LIB_INCLUDES_hl5_RADIX_4)
CCFLAGS_COSIM_hl5_RADIX_4 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/hl5/RADIX_4/c_parts -DRADIX_4=1 -DBDW_RTL_hl5_RADIX_4=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DDIV_RADIX_4 $(LIB_INCLUDES_hl5_RADIX_4)
CCFLAGS_BEH_hl5_RADIX_4 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/hl5/RADIX_4/c_parts -DRADIX_4=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DDIV_RADIX_4 $(LIB_INCLUDES_hl5_RADIX_4)
CCFLAGS_hl5_RADIX_4 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_hl5_RADIX_4 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_hl5_RADIX_4 += ${BDW_CCFLAGS_TAIL}

.PHONY: hlsc_hl5_RADIX_4 hls_hl5_RADIX_4

hls_hl5_RADIX_4 : hlsc_hl5_RADIX_4

cynth_hl5_RADIX_4 : hlsc_hl5_RADIX_4

elab_hl5_RADIX_4 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/hl5/RADIX_4/stratus_hls.bdr

optim_hl5_RADIX_4 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/hl5/RADIX_4/stratus_hls.bdr

sched_hl5_RADIX_4 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/hl5/RADIX_4/stratus_hls.bdr

hlsc_hl5_RADIX_4 : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/hl5/RADIX_4/hl5_rtl.cpp BDW_DEP_CYNTH_CONFIG=RADIX_4 BDW_MODULE=hl5 BDW_HLS_CONFIG=RADIX_4 
else
	@bdw_exec -jobproject project.tcl -job hls.hl5.RADIX_4 $(MAKE) CWBExec_hls=1 hlsc_hl5_RADIX_4
endif

clean_cynth_hl5_RADIX_4: clean_hls_hl5_RADIX_4

clean_hl5_RADIX_4: clean_hls_hl5_RADIX_4

clean_hls_hl5_RADIX_4:
	@rm -rf $(BDW_WORKLIB)/modules/hl5/RADIX_4
	@rm -rf $(BDW_WORKLIB)/jobs/hls.hl5.RADIX_4
	@rm -rf $(BDW_WORKLIB)/jobs/hls.hl5.RADIX_4.s

kill_hls_hl5_RADIX_4:
	@bdw_kill -job hls.hl5.RADIX_4
	@bdw_kill -job hls.hl5.RADIX_4.s


hls_hl5_RADIX_4_% : hlsc_hl5_RADIX_4_%

cynth_hl5_RADIX_4_% : hlsc_hl5_RADIX_4_%

