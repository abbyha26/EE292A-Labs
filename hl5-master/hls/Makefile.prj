#
#	Dependency generation rule
#
$(BDW_WORKLIB)/modules/hl5/RADIX_4/hl5.d :  ../src/hl5.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config RADIX_4 of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_hl5_RADIX_4)  ../src/hl5.cpp \
	| sed 's|hl5\.o[ :]*|$(BDW_WORKLIB)/modules/hl5/RADIX_4/hl5_rtl.cpp $(BDW_WORKLIB)/modules/hl5/RADIX_4/xcelium/hl5_beh.o $(BDW_WORKLIB)/modules/hl5/RADIX_4/xcelium/debug/hl5_beh.o $(BDW_WORKLIB)/modules/hl5/RADIX_4/hl5.d : $(memlib_WORKLIB)/memlib.d |' $(BDW_DEP_FILTER)  > $@

#
#	Library post-proc rules
#



##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/hl5/RADIX_4"
##############################################################

hl5_RADIX_4_SRCDIR = $(BDW_WORKLIB)/modules/hl5/RADIX_4
hl5_RADIX_4_BEH_SRCDIR = $(BDW_WORKLIB)/libs/hl5_RADIX_4
hl5_RADIX_4_LIBNAME = hl5_RADIX_4
hl5_RADIX_4_WORKLIB = $(BDW_WORKLIB)/modules/hl5/RADIX_4/xcelium
hl5_RADIX_4_C_PARTS_A = $(hl5_RADIX_4_WORKLIB)/objs/libhl5_RADIX_4.a

prep_c_hl5_RADIX_4 : $(hl5_RADIX_4_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(hl5_RADIX_4_WORKLIB) prep_c

prep_vlog_hl5_RADIX_4 : $(hl5_RADIX_4_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(hl5_RADIX_4_WORKLIB) prep_vlog

prep_hl5_RADIX_4 : $(hl5_RADIX_4_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(hl5_RADIX_4_WORKLIB) prep

$(hl5_RADIX_4_WORKLIB)/Makefile : $(hl5_RADIX_4_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(hl5_RADIX_4_WORKLIB) ]; then mkdir -p $(hl5_RADIX_4_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(hl5_RADIX_4_SRCDIR) -o $(hl5_RADIX_4_WORKLIB)/Makefile -module hl5 -cynthconfig RADIX_4   

$(hl5_RADIX_4_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(hl5_RADIX_4_WORKLIB) ]; then mkdir -p $(hl5_RADIX_4_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



prep_c_hl5_RADIX_4_% : $(subst RADIX_4,RADIX_4_%,$(hl5_RADIX_4_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst RADIX_4,RADIX_4_$(*F),$(hl5_RADIX_4_WORKLIB)) prep_c

prep_vlog_hl5_RADIX_4_% : $(subst RADIX_4,RADIX_4_%,$(hl5_RADIX_4_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst RADIX_4,RADIX_4_$(*F),$(hl5_RADIX_4_WORKLIB)) prep_vlog

prep_hl5_RADIX_4_% : $(subst RADIX_4,RADIX_4_%,$(hl5_RADIX_4_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst RADIX_4,RADIX_4_$(*F),$(hl5_RADIX_4_WORKLIB)) prep

$(subst RADIX_4,RADIX_4_%,$(hl5_RADIX_4_WORKLIB))/Makefile : $(hl5_RADIX_4_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(subst RADIX_4,RADIX_4_$(*F),$(hl5_RADIX_4_WORKLIB)) ]; then mkdir -p $(subst RADIX_4,RADIX_4_$(*F),$(hl5_RADIX_4_WORKLIB)); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(hl5_RADIX_4_SRCDIR)_$(*F) -o $(subst RADIX_4,RADIX_4_$(*F),$(hl5_RADIX_4_WORKLIB))/Makefile -module hl5 -cynthconfig RADIX_4_$(*F)   

$(hl5_RADIX_4_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(subst RADIX_4,RADIX_4_$(*F),$(hl5_RADIX_4_WORKLIB)) ]; then mkdir -p $(subst RADIX_4,RADIX_4_$(*F),$(hl5_RADIX_4_WORKLIB)); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(hl5_RADIX_4_WORKLIB)/hl5_RADIX_4.d :
	@if [ ! -d $(hl5_RADIX_4_WORKLIB) ]; then mkdir -p $(hl5_RADIX_4_WORKLIB); fi
	@touch $(hl5_RADIX_4_WORKLIB)/hl5_RADIX_4.d



#
# Rules for configured systemModules
#


#
#	Behavioral object file rule.  Used only for BEH configs that are
#	associated with system config names.
#

LIB_DIRS_main_PIN = $(memlib_SRCDIR) 
LIB_INCLUDES_main_PIN = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_main_PIN)))
CCFLAGS_main_PIN = -I./ -I$(BDW_WRAPDIR) $(LIB_INCLUDES_main_PIN)   -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  
CCFLAGS_main_PIN += ${BDW_CCFLAGS_TAIL}

$(BDW_WORKLIB)/modules/main/PIN/xcelium/sc_main_beh.o : ../tb/sc_main.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/main/PIN -I./ $(CCFLAGS_main_PIN) -o $(BDW_WORKLIB)/modules/main/PIN/xcelium/sc_main_beh.o " ../tb/sc_main.cpp

$(BDW_WORKLIB)/modules/main/PIN/xcelium/debug/sc_main_beh.o : ../tb/sc_main.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/main/PIN -I./ $(CCFLAGS_main_PIN) -o $(BDW_WORKLIB)/modules/main/PIN/xcelium/debug/sc_main_beh.o " ../tb/sc_main.cpp

$(BDW_WORKLIB)/modules/main/PIN/sc_main.d: ../tb/sc_main.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for system config PIN of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_main_PIN) $< \
	| sed 's|sc_main\.o[ :]*|$(BDW_WORKLIB)/modules/main/PIN/xcelium/sc_main_beh.o $(BDW_WORKLIB)/modules/main/PIN/xcelium/debug/sc_main_beh.o $(BDW_WORKLIB)/modules/main/PIN/sc_main.d : |' $(BDW_DEP_FILTER)  > $@


#
#	Behavioral object file rule.  Used only for BEH configs that are
#	associated with system config names.
#

LIB_DIRS_system_PIN = $(memlib_SRCDIR) 
LIB_INCLUDES_system_PIN = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_system_PIN)))
CCFLAGS_system_PIN = -I./ -I$(BDW_WRAPDIR) $(LIB_INCLUDES_system_PIN)   -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  
CCFLAGS_system_PIN += ${BDW_CCFLAGS_TAIL}

$(BDW_WORKLIB)/modules/system/PIN/xcelium/system_beh.o : ../tb/system.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/system/PIN -I./ $(CCFLAGS_system_PIN) -o $(BDW_WORKLIB)/modules/system/PIN/xcelium/system_beh.o " ../tb/system.cpp

$(BDW_WORKLIB)/modules/system/PIN/xcelium/debug/system_beh.o : ../tb/system.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/system/PIN -I./ $(CCFLAGS_system_PIN) -o $(BDW_WORKLIB)/modules/system/PIN/xcelium/debug/system_beh.o " ../tb/system.cpp

$(BDW_WORKLIB)/modules/system/PIN/system.d: ../tb/system.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for system config PIN of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_system_PIN) $< \
	| sed 's|system\.o[ :]*|$(BDW_WORKLIB)/modules/system/PIN/xcelium/system_beh.o $(BDW_WORKLIB)/modules/system/PIN/xcelium/debug/system_beh.o $(BDW_WORKLIB)/modules/system/PIN/system.d : |' $(BDW_DEP_FILTER)  > $@


#
#	Behavioral object file rule.  Used only for BEH configs that are
#	associated with system config names.
#

LIB_DIRS_tb_PIN = $(memlib_SRCDIR) 
