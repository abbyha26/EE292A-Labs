memwb_PIPE_SOFT1_SRCDIR = $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT1
memwb_PIPE_SOFT1_BEH_SRCDIR = $(BDW_WORKLIB)/libs/memwb_PIPE_SOFT1
memwb_PIPE_SOFT1_LIBNAME = memwb_PIPE_SOFT1
memwb_PIPE_SOFT1_WORKLIB = $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT1/xcelium
memwb_PIPE_SOFT1_C_PARTS_A = $(memwb_PIPE_SOFT1_WORKLIB)/objs/libmemwb_PIPE_SOFT1.a

prep_c_memwb_PIPE_SOFT1 : $(memwb_PIPE_SOFT1_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(memwb_PIPE_SOFT1_WORKLIB) prep_c

prep_vlog_memwb_PIPE_SOFT1 : $(memwb_PIPE_SOFT1_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(memwb_PIPE_SOFT1_WORKLIB) prep_vlog

prep_memwb_PIPE_SOFT1 : $(memwb_PIPE_SOFT1_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(memwb_PIPE_SOFT1_WORKLIB) prep

$(memwb_PIPE_SOFT1_WORKLIB)/Makefile : $(memwb_PIPE_SOFT1_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(memwb_PIPE_SOFT1_WORKLIB) ]; then mkdir -p $(memwb_PIPE_SOFT1_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(memwb_PIPE_SOFT1_SRCDIR) -o $(memwb_PIPE_SOFT1_WORKLIB)/Makefile -module memwb -cynthconfig PIPE_SOFT1   

$(memwb_PIPE_SOFT1_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(memwb_PIPE_SOFT1_WORKLIB) ]; then mkdir -p $(memwb_PIPE_SOFT1_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



