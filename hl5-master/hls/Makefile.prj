	@if [ ! -d $(BDW_WORKLIB)/modules/hl5/BASIC_POFF_$(*F) ]; then mkdir -p $(BDW_WORKLIB)/modules/hl5/BASIC_POFF_$(*F); fi
	
	
	$(subst /BASIC_POFF ,/BASIC_POFF_$(*F) ,$(subst =BASIC_POFF ,=BASIC_POFF_$(*F) ,$(subst /hl5/BASIC_POFF/,/hl5/BASIC_POFF_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=BASIC_POFF BDW_CYNTH_CONFIG=BASIC_POFF \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/hl5/BASIC_POFF/hl5_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/hl5/BASIC_POFF/hl5_rtl.cpp \
