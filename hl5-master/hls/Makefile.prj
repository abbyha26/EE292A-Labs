	@if [ ! -d $(subst PIPE_SOFT1,PIPE_SOFT1_$(*F),$(memwb_PIPE_SOFT1_WORKLIB)) ]; then mkdir -p $(subst PIPE_SOFT1,PIPE_SOFT1_$(*F),$(memwb_PIPE_SOFT1_WORKLIB)); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(memwb_PIPE_SOFT1_SRCDIR)_$(*F) -o $(subst PIPE_SOFT1,PIPE_SOFT1_$(*F),$(memwb_PIPE_SOFT1_WORKLIB))/Makefile -module memwb -cynthconfig PIPE_SOFT1_$(*F)   

