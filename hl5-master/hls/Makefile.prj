sim_sub_DPA_aes256_10_V_%:
	@bdw_exec -jobproject project.tcl -job sim_sub.DPA_aes256_10_V_$(*F).s $(BDW_LAUNCH_SIM_COMMAND) $(MAKE) CWBExec_sim=1 sim_sub_DPA_aes256_10_V_$(*F)
