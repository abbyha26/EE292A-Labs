$(BDW_WORKLIB)/modules/fedec/RADIX_4/xcelium/fedec_hoist.o :  ../src/fedec.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(BDW_WORKLIB)/wrappers/fedec_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/RADIX_4/ -I./ $(CCFLAGS_fedec_RADIX_4) $(EXTRACT_LIB_DASHI_fedec_RADIX_4) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/fedec/RADIX_4/xcelium/fedec_hoist.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp
    

$(BDW_WORKLIB)/modules/fedec/RADIX_4/xcelium/debug/fedec.o :  ../src/fedec.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(BDW_WORKLIB)/wrappers/fedec_trace.h
