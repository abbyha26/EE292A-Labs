$(BDW_WORKLIB)/modules/execute/BASIC_POFF/xcelium/execute_hoist.o :  ../src/execute.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.cpp $(BDW_WORKLIB)/wrappers/execute_cosim.h $(BDW_WORKLIB)/wrappers/execute_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/execute/BASIC_POFF/ -I./ $(CCFLAGS_execute_BASIC_POFF) $(EXTRACT_LIB_DASHI_execute_BASIC_POFF) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/execute/BASIC_POFF/xcelium/execute_hoist.o " $(BDW_WORKLIB)/wrappers/execute_wrap.cpp
    

$(BDW_WORKLIB)/modules/execute/BASIC_POFF/xcelium/debug/execute.o :  ../src/execute.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/execute_cosim.h $(BDW_WORKLIB)/wrappers/execute_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
