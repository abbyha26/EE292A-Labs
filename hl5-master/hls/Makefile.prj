	@rm -rf $(BDW_WORKLIB)/jobs/hls.fedec.RADIX_4.s

kill_hls_fedec_RADIX_4:
	@bdw_kill -job hls.fedec.RADIX_4
	@bdw_kill -job hls.fedec.RADIX_4.s


