	@bdw_kill -job hls.fedec.RADIX_4_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),RADIX_4)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/fedec/RADIX_4/fedec.d
                -include $(memlib_WORKLIB)/memlib.d
                BDW_LIB_DEPS =  $(memlib_DEPS)
            endif
        endif
    endif
endif


html_fedec_RADIX_4 :
	bdw_htmlgen -project project.tcl -module fedec -cynthconfig RADIX_4

BDW_fedec_RADIX_4_HLS_TARGETS := $(BDW_WORKLIB)/modules/fedec/RADIX_4/fedec_rtl.cpp $(BDW_WORKLIB)/modules/fedec/RADIX_4/fedec_rtl.v $(BDW_WORKLIB)/modules/fedec/RADIX_4/stratus_hls.bdr
ifeq ($(BDW_BDR_ONLY),1)
.PHONY: $(filter %.bdr %.cpp,$(BDW_fedec_RADIX_4_HLS_TARGETS))
$(filter %.v %.cpp,$(BDW_fedec_RADIX_4_HLS_TARGETS)) : $(filter %.bdr,$(BDW_fedec_RADIX_4_HLS_TARGETS))
BDW_fedec_RADIX_4_HLS_TARGETS := $(filter %.bdr,$(BDW_fedec_RADIX_4_HLS_TARGETS))
endif
BDW_fedec_RADIX_4_HLS_SPEC_TARGETS = $(subst /RADIX_4/,/RADIX_4_%/,$(BDW_fedec_RADIX_4_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_fedec_RADIX_4_HLS_TARGETS) :  ../src/fedec.cpp   $(BDW_LIB_DEPS)
	+make --no-print-directory  $(BDW_WORKLIB)/wrappers/hl5_wrap.h
	@if [ ! -d $(BDW_WORKLIB)/modules/fedec/RADIX_4 ]; then mkdir -p $(BDW_WORKLIB)/modules/fedec/RADIX_4; fi
	
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=RADIX_4 BDW_CYNTH_CONFIG=RADIX_4 \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/fedec/RADIX_4/fedec_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/fedec/RADIX_4/fedec_rtl.cpp \
		BDW_MODULE=fedec \
		BDW_CYNTH_CONFIG=RADIX_4 \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/fedec/RADIX_4 \
		BDW_HLS_CONFIG=RADIX_4 \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/fedec/RADIX_4 \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_fedec_RADIX_4)  \
		-d $(BDW_WORKLIB)/modules/fedec/RADIX_4 -o fedec_rtl.cpp \
		--hls_module=fedec --hls_config=RADIX_4 --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_fedec_RADIX_4))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_fedec_RADIX_4))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_fedec_RADIX_4))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_fedec_RADIX_4)   \
		 ../src/fedec.cpp
	
	
	
	

else

$(BDW_fedec_RADIX_4_HLS_TARGETS) :  ../src/fedec.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.fedec.RADIX_4.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_fedec_RADIX_4_HLS_TARGETS)

endif

	
$(BDW_WORKLIB)/modules/fedec/RADIX_4/fedec_trace.h : $(BDW_WORKLIB)/modules/fedec/RADIX_4/fedec_trace.h.updated

$(BDW_WORKLIB)/modules/fedec/RADIX_4/fedec_trace.h.updated : $(BDW_WORKLIB)/modules/fedec/RADIX_4/fedec_rtl.cpp $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module fedec -cynthconfig RADIX_4  
	@touch $(BDW_WORKLIB)/modules/fedec/RADIX_4/fedec_trace.h.updated

ifeq ($(CWBExec_hlsc),1)

$(BDW_fedec_RADIX_4_HLS_SPEC_TARGETS) :  ../src/fedec.cpp   $(BDW_LIB_DEPS)
	+make --no-print-directory  $(BDW_WORKLIB)/wrappers/hl5_wrap.h
	@if [ ! -d $(BDW_WORKLIB)/modules/fedec/RADIX_4_$(*F) ]; then mkdir -p $(BDW_WORKLIB)/modules/fedec/RADIX_4_$(*F); fi
	
	
	$(subst /RADIX_4 ,/RADIX_4_$(*F) ,$(subst =RADIX_4 ,=RADIX_4_$(*F) ,$(subst /fedec/RADIX_4/,/fedec/RADIX_4_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=RADIX_4 BDW_CYNTH_CONFIG=RADIX_4 \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/fedec/RADIX_4/fedec_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/fedec/RADIX_4/fedec_rtl.cpp \
		BDW_MODULE=fedec \
		BDW_CYNTH_CONFIG=RADIX_4 \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/fedec/RADIX_4 \
		BDW_HLS_CONFIG=RADIX_4 \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/fedec/RADIX_4 \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_fedec_RADIX_4)  \
		`cat  $(BDW_SPECLIB)/fedec/RADIX_4.$(*F).bds | grep '^cmdline:' | sed 's/^cmdline://'`\
		-d $(BDW_WORKLIB)/modules/fedec/RADIX_4 -o fedec_rtl.cpp \
		--hls_module=fedec --hls_config=RADIX_4 --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_fedec_RADIX_4))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_fedec_RADIX_4))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_fedec_RADIX_4))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_fedec_RADIX_4)   \
		 ../src/fedec.cpp)))
	
	
	
	

else

$(BDW_fedec_RADIX_4_HLS_SPEC_TARGETS) :  ../src/fedec.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.fedec.RADIX_4_$(*F).s $(MAKE) -j1 CWBExec_hlsc=1 $(subst %,$(*F),$(BDW_fedec_RADIX_4_HLS_SPEC_TARGETS))

endif

	

