	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(memwb_PIPE_SOFT3_WORKLIB) prep

$(memwb_PIPE_SOFT3_WORKLIB)/Makefile : $(memwb_PIPE_SOFT3_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(memwb_PIPE_SOFT3_WORKLIB) ]; then mkdir -p $(memwb_PIPE_SOFT3_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(memwb_PIPE_SOFT3_SRCDIR) -o $(memwb_PIPE_SOFT3_WORKLIB)/Makefile -module memwb -cynthconfig PIPE_SOFT3   

$(memwb_PIPE_SOFT3_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(memwb_PIPE_SOFT3_WORKLIB) ]; then mkdir -p $(memwb_PIPE_SOFT3_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



