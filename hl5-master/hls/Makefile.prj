	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl memwb`
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/PIN/ -I./ $(CCFLAGS_memwb_PIN) $(EXTRACT_LIB_DASHI_memwb_PIN) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/memwb/PIN/xcelium/memwb_rtl.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp

$(BDW_WORKLIB)/modules/memwb/PIN/xcelium/debug/memwb_rtl.o : $(BDW_WORKLIB)/modules/memwb/PIN/memwb_rtl.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(BDW_WORKLIB)/modules/memwb/PIN/memwb_trace.h
