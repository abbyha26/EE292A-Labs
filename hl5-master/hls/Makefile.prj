#
#	Dependency generation rule
#
$(BDW_WORKLIB)/modules/execute/PIPE_SOFT3/execute.d :  ../src/execute.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config PIPE_SOFT3 of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_execute_PIPE_SOFT3)  ../src/execute.cpp \
	| sed 's|execute\.o[ :]*|$(BDW_WORKLIB)/modules/execute/PIPE_SOFT3/execute_rtl.cpp $(BDW_WORKLIB)/modules/execute/PIPE_SOFT3/xcelium/execute_beh.o $(BDW_WORKLIB)/modules/execute/PIPE_SOFT3/xcelium/debug/execute_beh.o $(BDW_WORKLIB)/modules/execute/PIPE_SOFT3/execute.d : $(memlib_WORKLIB)/memlib.d |' $(BDW_DEP_FILTER)  > $@

#
#	Library post-proc rules
#



##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/execute/PIPE_SOFT3"
##############################################################

execute_PIPE_SOFT3_SRCDIR = $(BDW_WORKLIB)/modules/execute/PIPE_SOFT3
execute_PIPE_SOFT3_BEH_SRCDIR = $(BDW_WORKLIB)/libs/execute_PIPE_SOFT3
execute_PIPE_SOFT3_LIBNAME = execute_PIPE_SOFT3
execute_PIPE_SOFT3_WORKLIB = $(BDW_WORKLIB)/modules/execute/PIPE_SOFT3/xcelium
execute_PIPE_SOFT3_C_PARTS_A = $(execute_PIPE_SOFT3_WORKLIB)/objs/libexecute_PIPE_SOFT3.a

prep_c_execute_PIPE_SOFT3 : $(execute_PIPE_SOFT3_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(execute_PIPE_SOFT3_WORKLIB) prep_c

prep_vlog_execute_PIPE_SOFT3 : $(execute_PIPE_SOFT3_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(execute_PIPE_SOFT3_WORKLIB) prep_vlog

prep_execute_PIPE_SOFT3 : $(execute_PIPE_SOFT3_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(execute_PIPE_SOFT3_WORKLIB) prep

$(execute_PIPE_SOFT3_WORKLIB)/Makefile : $(execute_PIPE_SOFT3_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(execute_PIPE_SOFT3_WORKLIB) ]; then mkdir -p $(execute_PIPE_SOFT3_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(execute_PIPE_SOFT3_SRCDIR) -o $(execute_PIPE_SOFT3_WORKLIB)/Makefile -module execute -cynthconfig PIPE_SOFT3   

$(execute_PIPE_SOFT3_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(execute_PIPE_SOFT3_WORKLIB) ]; then mkdir -p $(execute_PIPE_SOFT3_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



prep_c_execute_PIPE_SOFT3_% : $(subst PIPE_SOFT3,PIPE_SOFT3_%,$(execute_PIPE_SOFT3_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst PIPE_SOFT3,PIPE_SOFT3_$(*F),$(execute_PIPE_SOFT3_WORKLIB)) prep_c

prep_vlog_execute_PIPE_SOFT3_% : $(subst PIPE_SOFT3,PIPE_SOFT3_%,$(execute_PIPE_SOFT3_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst PIPE_SOFT3,PIPE_SOFT3_$(*F),$(execute_PIPE_SOFT3_WORKLIB)) prep_vlog

prep_execute_PIPE_SOFT3_% : $(subst PIPE_SOFT3,PIPE_SOFT3_%,$(execute_PIPE_SOFT3_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst PIPE_SOFT3,PIPE_SOFT3_$(*F),$(execute_PIPE_SOFT3_WORKLIB)) prep

$(subst PIPE_SOFT3,PIPE_SOFT3_%,$(execute_PIPE_SOFT3_WORKLIB))/Makefile : $(execute_PIPE_SOFT3_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(subst PIPE_SOFT3,PIPE_SOFT3_$(*F),$(execute_PIPE_SOFT3_WORKLIB)) ]; then mkdir -p $(subst PIPE_SOFT3,PIPE_SOFT3_$(*F),$(execute_PIPE_SOFT3_WORKLIB)); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(execute_PIPE_SOFT3_SRCDIR)_$(*F) -o $(subst PIPE_SOFT3,PIPE_SOFT3_$(*F),$(execute_PIPE_SOFT3_WORKLIB))/Makefile -module execute -cynthconfig PIPE_SOFT3_$(*F)   

$(execute_PIPE_SOFT3_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(subst PIPE_SOFT3,PIPE_SOFT3_$(*F),$(execute_PIPE_SOFT3_WORKLIB)) ]; then mkdir -p $(subst PIPE_SOFT3,PIPE_SOFT3_$(*F),$(execute_PIPE_SOFT3_WORKLIB)); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(execute_PIPE_SOFT3_WORKLIB)/execute_PIPE_SOFT3.d :
	@if [ ! -d $(execute_PIPE_SOFT3_WORKLIB) ]; then mkdir -p $(execute_PIPE_SOFT3_WORKLIB); fi
	@touch $(execute_PIPE_SOFT3_WORKLIB)/execute_PIPE_SOFT3.d



#
# HLS config RADIX_2
#

#
#	stratus_hls rule
#
LIB_DIRS_execute_RADIX_2 = $(memlib_SRCDIR) 
LIB_INCLUDES_execute_RADIX_2 = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_execute_RADIX_2))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_execute_RADIX_2 = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_execute_RADIX_2 = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_execute_RADIX_2 = 
EXTRACT_LIB_DASHI_execute_RADIX_2 = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl execute RADIX_2]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_execute_RADIX_2 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/execute/RADIX_2/c_parts -DRADIX_2=1 -DBDW_RTL_execute_RADIX_2=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DDIV_RADIX_2 $(LIB_INCLUDES_execute_RADIX_2)
CCFLAGS_COSIM_execute_RADIX_2 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/execute/RADIX_2/c_parts -DRADIX_2=1 -DBDW_RTL_execute_RADIX_2=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DDIV_RADIX_2 $(LIB_INCLUDES_execute_RADIX_2)
CCFLAGS_BEH_execute_RADIX_2 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/execute/RADIX_2/c_parts -DRADIX_2=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DDIV_RADIX_2 $(LIB_INCLUDES_execute_RADIX_2)
CCFLAGS_execute_RADIX_2 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_execute_RADIX_2 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_execute_RADIX_2 += ${BDW_CCFLAGS_TAIL}

.PHONY: hlsc_execute_RADIX_2 hls_execute_RADIX_2

hls_execute_RADIX_2 : hlsc_execute_RADIX_2

cynth_execute_RADIX_2 : hlsc_execute_RADIX_2

elab_execute_RADIX_2 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/execute/RADIX_2/stratus_hls.bdr

optim_execute_RADIX_2 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/execute/RADIX_2/stratus_hls.bdr

sched_execute_RADIX_2 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/execute/RADIX_2/stratus_hls.bdr

hlsc_execute_RADIX_2 : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/execute/RADIX_2/execute_rtl.cpp BDW_DEP_CYNTH_CONFIG=RADIX_2 BDW_MODULE=execute BDW_HLS_CONFIG=RADIX_2 
else
	@bdw_exec -jobproject project.tcl -job hls.execute.RADIX_2 $(MAKE) CWBExec_hls=1 hlsc_execute_RADIX_2
endif

clean_cynth_execute_RADIX_2: clean_hls_execute_RADIX_2

clean_execute_RADIX_2: clean_hls_execute_RADIX_2

clean_hls_execute_RADIX_2:
	@rm -rf $(BDW_WORKLIB)/modules/execute/RADIX_2
	@rm -rf $(BDW_WORKLIB)/jobs/hls.execute.RADIX_2
	@rm -rf $(BDW_WORKLIB)/jobs/hls.execute.RADIX_2.s

kill_hls_execute_RADIX_2:
	@bdw_kill -job hls.execute.RADIX_2
	@bdw_kill -job hls.execute.RADIX_2.s


