	@echo "ERROR: Schematic viewing target 'view_fedec_PIPE_SOFT1' is only supported with 'verdi'"
	@echo "The Stratus IDE includes a schematic view as an alternative."


#
#	RTL object file rule
#
$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/xcelium/fedec_rtl.o : $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/fedec_rtl.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/fedec_trace.h
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl fedec`
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/ -I./ $(CCFLAGS_fedec_PIPE_SOFT1) $(EXTRACT_LIB_DASHI_fedec_PIPE_SOFT1) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/xcelium/fedec_rtl.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp

$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/xcelium/debug/fedec_rtl.o : $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/fedec_rtl.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/fedec_trace.h
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl fedec`
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/ -I./ $(CCFLAGS_fedec_PIPE_SOFT1) $(EXTRACT_LIB_DASHI_fedec_PIPE_SOFT1) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/xcelium/debug/fedec_rtl.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp

#
#	Behavioral object file rule.  Used only for BEH configs that are 
#	associated with HLS config names.
#

$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/xcelium/fedec_beh.o :  ../src/fedec.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(BDW_WORKLIB)/wrappers/fedec_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/ -I./ $(CCFLAGS_BEH_fedec_PIPE_SOFT1) -o $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/xcelium/fedec_beh.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp

$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/xcelium/debug/fedec_beh.o :  ../src/fedec.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(BDW_WORKLIB)/wrappers/fedec_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/ -I./ $(CCFLAGS_BEH_fedec_PIPE_SOFT1) -o $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/xcelium/debug/fedec_beh.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp

#
