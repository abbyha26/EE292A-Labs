prep_DPA_aes256_10_V_%: prebuild_DPA_aes256_10_V_%
	@$(MAKE) sim_DPA_aes256_10_V_$(*F) BDW_XRUN_ELAB=-elaborate

ifeq ($(CWBExec_build),1)

dbg_build_DPA_aes256_10_V_%:
	@if [ ! -e systemc ] ; then ln -s $(STRATUS_HOME)/tools.lnx86/stratus/systemc ; fi
	@$(MAKE) siminfo BDW_SIM_CONFIG=DPA_aes256_10_V_$(*F)
	@$(MAKE) BDW_DEBUG=1 build_DPA_aes256_10_V_$(*F)


build_DPA_aes256_10_V_% build_DPA_aes256_10_V_sub_%: bdw_prebuild_wrappers  
	$(MAKE) -j1 CWBExec_hls=1 `$(BDW_SPEC_FILTER) project.db $(*F)  hls_fedec_DPA hls_execute_DPA hls_memwb_DPA` 
	$(MAKE) -j1 CWBExec_hls=1 `$(BDW_SPEC_FILTER) project.db $(*F)  hls_hl5_DPA`
	@$(MAKE) siminfo BDW_SIM_CONFIG=DPA_aes256_10_V_$(*F)
	@$(BDW_EXEC_CMD) $(MAKE) $(BDW_PMAKE_FLG) build_sim_image BDW_SIM_CONFIG=DPA_aes256_10_V_$(*F) BDW_GENDEPS=1 BDW_BASE_SIM_CONFIG=DPA_aes256_10_V BDW_SPEC_NAME=$(*F)

build_only_DPA_aes256_10_V_%:
	@$(MAKE) siminfo BDW_SIM_CONFIG=DPA_aes256_10_V_$(*F)
	@$(BDW_EXEC_CMD) $(MAKE) $(BDW_PMAKE_FLG) build_sim_image BDW_SIM_CONFIG=DPA_aes256_10_V_$(*F) BDW_GENDEPS=1 BDW_BASE_SIM_CONFIG=DPA_aes256_10_V BDW_SPEC_NAME=$(*F)

