#	Library post-proc rules
#



##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/memwb/RADIX_4"
##############################################################

memwb_RADIX_4_SRCDIR = $(BDW_WORKLIB)/modules/memwb/RADIX_4
memwb_RADIX_4_BEH_SRCDIR = $(BDW_WORKLIB)/libs/memwb_RADIX_4
memwb_RADIX_4_LIBNAME = memwb_RADIX_4
memwb_RADIX_4_WORKLIB = $(BDW_WORKLIB)/modules/memwb/RADIX_4/xcelium
memwb_RADIX_4_C_PARTS_A = $(memwb_RADIX_4_WORKLIB)/objs/libmemwb_RADIX_4.a

prep_c_memwb_RADIX_4 : $(memwb_RADIX_4_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(memwb_RADIX_4_WORKLIB) prep_c

prep_vlog_memwb_RADIX_4 : $(memwb_RADIX_4_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(memwb_RADIX_4_WORKLIB) prep_vlog

prep_memwb_RADIX_4 : $(memwb_RADIX_4_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(memwb_RADIX_4_WORKLIB) prep

$(memwb_RADIX_4_WORKLIB)/Makefile : $(memwb_RADIX_4_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(memwb_RADIX_4_WORKLIB) ]; then mkdir -p $(memwb_RADIX_4_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(memwb_RADIX_4_SRCDIR) -o $(memwb_RADIX_4_WORKLIB)/Makefile -module memwb -cynthconfig RADIX_4   

$(memwb_RADIX_4_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(memwb_RADIX_4_WORKLIB) ]; then mkdir -p $(memwb_RADIX_4_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



prep_c_memwb_RADIX_4_% : $(subst RADIX_4,RADIX_4_%,$(memwb_RADIX_4_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst RADIX_4,RADIX_4_$(*F),$(memwb_RADIX_4_WORKLIB)) prep_c

prep_vlog_memwb_RADIX_4_% : $(subst RADIX_4,RADIX_4_%,$(memwb_RADIX_4_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst RADIX_4,RADIX_4_$(*F),$(memwb_RADIX_4_WORKLIB)) prep_vlog

prep_memwb_RADIX_4_% : $(subst RADIX_4,RADIX_4_%,$(memwb_RADIX_4_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst RADIX_4,RADIX_4_$(*F),$(memwb_RADIX_4_WORKLIB)) prep

$(subst RADIX_4,RADIX_4_%,$(memwb_RADIX_4_WORKLIB))/Makefile : $(memwb_RADIX_4_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(subst RADIX_4,RADIX_4_$(*F),$(memwb_RADIX_4_WORKLIB)) ]; then mkdir -p $(subst RADIX_4,RADIX_4_$(*F),$(memwb_RADIX_4_WORKLIB)); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(memwb_RADIX_4_SRCDIR)_$(*F) -o $(subst RADIX_4,RADIX_4_$(*F),$(memwb_RADIX_4_WORKLIB))/Makefile -module memwb -cynthconfig RADIX_4_$(*F)   

$(memwb_RADIX_4_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(subst RADIX_4,RADIX_4_$(*F),$(memwb_RADIX_4_WORKLIB)) ]; then mkdir -p $(subst RADIX_4,RADIX_4_$(*F),$(memwb_RADIX_4_WORKLIB)); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(memwb_RADIX_4_WORKLIB)/memwb_RADIX_4.d :
	@if [ ! -d $(memwb_RADIX_4_WORKLIB) ]; then mkdir -p $(memwb_RADIX_4_WORKLIB); fi
	@touch $(memwb_RADIX_4_WORKLIB)/memwb_RADIX_4.d



##############################################################
## HLS Module "hl5"
##############################################################


#
# Dependency Generation rule for BEH module
#
$(BDW_OBJDIR)/hl5.d :  ../src/hl5.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for $< "
	@set -e; $(BDW_CCDEP) -MM -MG $(BDW_CCFLAGS)  ../src/hl5.cpp \
	| sed 's|hl5\.o[ :]*|$(BDW_OBJDIR)/hl5.o $(BDW_OBJDIR)/hl5.d : |' $(BDW_DEP_FILTER)  > $@

$(BDW_WORKLIB)/wrappers/hl5_trace.h : $(BDW_WORKLIB)/wrappers/hl5_trace.h.updated

$(BDW_WORKLIB)/wrappers/hl5_trace.h.updated :  ../src/hl5.cpp $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module hl5  
	@touch $(BDW_WORKLIB)/wrappers/hl5_trace.h.updated



$(BDW_WORKLIB)/sims/$(BDW_SIM_CONFIG)/xcelium/hl5.o:  ../src/hl5.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.h $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(BDW_WORKLIB)/wrappers/hl5_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " $(BDW_CCFLAGS) -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -o $(BDW_WORKLIB)/sims/$(BDW_SIM_CONFIG)/xcelium/hl5.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp

$(BDW_WORKLIB)/sims/$(BDW_SIM_CONFIG)/xcelium/debug/hl5.o:  ../src/hl5.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.h $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(BDW_WORKLIB)/wrappers/hl5_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " $(BDW_CCFLAGS) -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -o $(BDW_WORKLIB)/sims/$(BDW_SIM_CONFIG)/xcelium/debug/hl5.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp

.INTERMEDIATE : hl5_wrap.h

hl5_wrap.h : $(BDW_WORKLIB)/wrappers/hl5_wrap.h

$(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.h $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(BDW_WORKLIB)/wrappers/hl5_cosim.v   : $(BDW_WRAPDIR)/hl5.updated

$(BDW_WRAPDIR)/hl5.updated :  ../src/hl5.cpp 
	@if [ ! -d $(BDW_WRAPDIR) ]; then mkdir -p $(BDW_WRAPDIR); fi
	$(BDW_WRAPGEN_COMMAND) -project project.tcl -module hl5 "-I$(BDW_WRAPDIR) $(BDW_LIB_DASHI) $(BDW_CCOPTIONS) $(BDW_EXTRA_CCFLAGS)"
	@touch $(BDW_WRAPDIR)/hl5.updated
	$(STRATUS_HOME)/bin/bdw_tracegen -module hl5  
	@touch $(BDW_WORKLIB)/wrappers/hl5_trace.h.updated

$(BDW_WORKLIB)/wrappers/hl5_wrap.d :  ../src/hl5.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@set -e; $(BDW_CCDEP) -MM -MG $(BDW_CCFLAGS) -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  ../src/hl5.cpp \
		| sed 's|hl5\.o[ :]*|$(BDW_WRAPDIR)/hl5.updated $(BDW_WORKLIB)/wrappers/hl5_wrap.d :  memlib/memlib.bdl |' $(BDW_DEP_FILTER) > $(BDW_WORKLIB)/wrappers/hl5_wrap.d 




##############################################################
## HLS Module "hl5" - cynthConfigs
##############################################################


#
# HLS config PIN
#

#
#	stratus_hls rule
#
LIB_DIRS_hl5_PIN = $(memlib_SRCDIR) 
LIB_INCLUDES_hl5_PIN = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_hl5_PIN))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_hl5_PIN = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_hl5_PIN = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_hl5_PIN = 
EXTRACT_LIB_DASHI_hl5_PIN = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl hl5 PIN]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_hl5_PIN = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/hl5/PIN/c_parts  -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_hl5_PIN)
CCFLAGS_COSIM_hl5_PIN = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/hl5/PIN/c_parts  -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_hl5_PIN)
CCFLAGS_BEH_hl5_PIN = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/hl5/PIN/c_parts  -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_hl5_PIN)
CCFLAGS_hl5_PIN += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_hl5_PIN += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_hl5_PIN += ${BDW_CCFLAGS_TAIL}

.PHONY: hlsc_hl5_PIN hls_hl5_PIN

hls_hl5_PIN : hlsc_hl5_PIN

cynth_hl5_PIN : hlsc_hl5_PIN

elab_hl5_PIN : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/hl5/PIN/stratus_hls.bdr

optim_hl5_PIN : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/hl5/PIN/stratus_hls.bdr

sched_hl5_PIN : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/hl5/PIN/stratus_hls.bdr

hlsc_hl5_PIN : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/hl5/PIN/hl5_rtl.cpp BDW_DEP_CYNTH_CONFIG=PIN BDW_MODULE=hl5 BDW_HLS_CONFIG=PIN 
else
	@bdw_exec -jobproject project.tcl -job hls.hl5.PIN $(MAKE) CWBExec_hls=1 hlsc_hl5_PIN
endif

clean_cynth_hl5_PIN: clean_hls_hl5_PIN

clean_hl5_PIN: clean_hls_hl5_PIN

clean_hls_hl5_PIN:
	@rm -rf $(BDW_WORKLIB)/modules/hl5/PIN
	@rm -rf $(BDW_WORKLIB)/jobs/hls.hl5.PIN
	@rm -rf $(BDW_WORKLIB)/jobs/hls.hl5.PIN.s

kill_hls_hl5_PIN:
	@bdw_kill -job hls.hl5.PIN
	@bdw_kill -job hls.hl5.PIN.s


hls_hl5_PIN_% : hlsc_hl5_PIN_%

cynth_hl5_PIN_% : hlsc_hl5_PIN_%

elab_hl5_PIN_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(subst /PIN/,/PIN_$(*F)/,$(BDW_WORKLIB)/modules/hl5/PIN/stratus_hls.bdr)

optim_hl5_PIN_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(subst /PIN/,/PIN_$(*F)/,$(BDW_WORKLIB)/modules/hl5/PIN/stratus_hls.bdr)

sched_hl5_PIN_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(subst /PIN/,/PIN_$(*F)/,$(BDW_WORKLIB)/modules/hl5/PIN/stratus_hls.bdr)

hlsc_hl5_PIN_% hls_hl5_PIN_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /PIN/,/PIN_$(*F)/,$(BDW_WORKLIB)/modules/hl5/PIN/hl5_rtl.cpp) BDW_DEP_CYNTH_CONFIG=PIN BDW_MODULE=hl5 BDW_HLS_CONFIG=PIN_$(*F) 
else
	@bdw_exec -jobproject project.tcl -job hls.hl5.PIN_$(*F) $(MAKE) CWBExec_hls=1 hlsc_hl5_PIN_$(*F)
endif

clean_cynth_hl5_PIN_%: clean_hls_hl5_PIN_%

clean_hl5_PIN_%: clean_hls_hl5_PIN_%

clean_hls_hl5_PIN_%:
	@rm -rf $(BDW_WORKLIB)/modules/hl5/PIN_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.hl5.PIN_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.hl5.PIN_$(*F).s

kill_hls_hl5_PIN_%:
	@bdw_kill -job hls.hl5.PIN_$(*F)
	@bdw_kill -job hls.hl5.PIN_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),PIN)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/hl5/PIN/hl5.d
                -include $(memlib_WORKLIB)/memlib.d
                BDW_LIB_DEPS =  $(memlib_DEPS)
            endif
        endif
    endif
endif


html_hl5_PIN :
	bdw_htmlgen -project project.tcl -module hl5 -cynthconfig PIN

BDW_hl5_PIN_HLS_TARGETS := $(BDW_WORKLIB)/modules/hl5/PIN/hl5_rtl.cpp $(BDW_WORKLIB)/modules/hl5/PIN/hl5_rtl.v $(BDW_WORKLIB)/modules/hl5/PIN/stratus_hls.bdr
ifeq ($(BDW_BDR_ONLY),1)
.PHONY: $(filter %.bdr %.cpp,$(BDW_hl5_PIN_HLS_TARGETS))
$(filter %.v %.cpp,$(BDW_hl5_PIN_HLS_TARGETS)) : $(filter %.bdr,$(BDW_hl5_PIN_HLS_TARGETS))
BDW_hl5_PIN_HLS_TARGETS := $(filter %.bdr,$(BDW_hl5_PIN_HLS_TARGETS))
endif
BDW_hl5_PIN_HLS_SPEC_TARGETS = $(subst /PIN/,/PIN_%/,$(BDW_hl5_PIN_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_hl5_PIN_HLS_TARGETS) :  ../src/hl5.cpp  $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/memwb_wrap.h  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/hl5/PIN ]; then mkdir -p $(BDW_WORKLIB)/modules/hl5/PIN; fi
	
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=PIN BDW_CYNTH_CONFIG=PIN \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/hl5/PIN/hl5_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/hl5/PIN/hl5_rtl.cpp \
		BDW_MODULE=hl5 \
		BDW_CYNTH_CONFIG=PIN \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/hl5/PIN \
		BDW_HLS_CONFIG=PIN \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/hl5/PIN \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_hl5_PIN)  \
		-d $(BDW_WORKLIB)/modules/hl5/PIN -o hl5_rtl.cpp \
		--hls_module=hl5 --hls_config=PIN --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_hl5_PIN))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_hl5_PIN))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_hl5_PIN))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_hl5_PIN)   \
		 ../src/hl5.cpp
	
	
	
	

else

$(BDW_hl5_PIN_HLS_TARGETS) :  ../src/hl5.cpp  $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.hl5.PIN.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_hl5_PIN_HLS_TARGETS)

endif

	
$(BDW_WORKLIB)/modules/hl5/PIN/hl5_trace.h : $(BDW_WORKLIB)/modules/hl5/PIN/hl5_trace.h.updated

$(BDW_WORKLIB)/modules/hl5/PIN/hl5_trace.h.updated : $(BDW_WORKLIB)/modules/hl5/PIN/hl5_rtl.cpp $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module hl5 -cynthconfig PIN  
	@touch $(BDW_WORKLIB)/modules/hl5/PIN/hl5_trace.h.updated

ifeq ($(CWBExec_hlsc),1)

$(BDW_hl5_PIN_HLS_SPEC_TARGETS) :  ../src/hl5.cpp  $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/memwb_wrap.h  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/hl5/PIN_$(*F) ]; then mkdir -p $(BDW_WORKLIB)/modules/hl5/PIN_$(*F); fi
	
	
	$(subst /PIN ,/PIN_$(*F) ,$(subst =PIN ,=PIN_$(*F) ,$(subst /hl5/PIN/,/hl5/PIN_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=PIN BDW_CYNTH_CONFIG=PIN \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/hl5/PIN/hl5_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/hl5/PIN/hl5_rtl.cpp \
		BDW_MODULE=hl5 \
		BDW_CYNTH_CONFIG=PIN \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/hl5/PIN \
		BDW_HLS_CONFIG=PIN \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/hl5/PIN \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_hl5_PIN)  \
		`cat  $(BDW_SPECLIB)/hl5/PIN.$(*F).bds | grep '^cmdline:' | sed 's/^cmdline://'`\
		-d $(BDW_WORKLIB)/modules/hl5/PIN -o hl5_rtl.cpp \
		--hls_module=hl5 --hls_config=PIN --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_hl5_PIN))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_hl5_PIN))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_hl5_PIN))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_hl5_PIN)   \
		 ../src/hl5.cpp)))
	
	
	
	

else

$(BDW_hl5_PIN_HLS_SPEC_TARGETS) :  ../src/hl5.cpp  $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.hl5.PIN_$(*F).s $(MAKE) -j1 CWBExec_hlsc=1 $(subst %,$(*F),$(BDW_hl5_PIN_HLS_SPEC_TARGETS))

endif

	

$(subst /PIN/,/PIN_%/,$(BDW_WORKLIB)/modules/hl5/PIN/hl5_trace.h) : $(subst /PIN/,/PIN_%/,$(BDW_WORKLIB)/modules/hl5/PIN/hl5_rtl.cpp) $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module hl5 -cynthconfig PIN_$(*F)  

catHLLog_hl5_PIN:
	cat $(BDW_WORKLIB)/modules/hl5/PIN/stratus_hls.log

#
#	stratus_vlg rule
#
cynthvlg_hl5_PIN : hls_hl5_PIN 


.PHONY: hls_hl5_PIN

hls_hl5_PIN hlsv_hl5_PIN: $(addprefix prep_vlog_,$(LIB_NAMES_FOR_VLOG_hl5_PIN)) 

.PHONY: hls_hl5_PIN

hls_hl5_PIN_% hlsv_hl5_PIN_%: $(addprefix prep_vlog_,$(LIB_NAMES_FOR_VLOG_hl5_PIN)) 

catVLGLog_hl5_PIN : catHLLog_hl5_PIN
	cat $(BDW_WORKLIB)/modules/hl5/PIN/stratus_vlg.log

#
#	view rule
#

view_hl5_PIN:
	@echo "ERROR: Schematic viewing target 'view_hl5_PIN' is only supported with 'verdi'"
	@echo "The Stratus IDE includes a schematic view as an alternative."


#
#	RTL object file rule
#
$(BDW_WORKLIB)/modules/hl5/PIN/xcelium/hl5_rtl.o : $(BDW_WORKLIB)/modules/hl5/PIN/hl5_rtl.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(BDW_WORKLIB)/modules/hl5/PIN/hl5_trace.h
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl hl5`
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/PIN/ -I./ $(CCFLAGS_hl5_PIN) $(EXTRACT_LIB_DASHI_hl5_PIN) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/hl5/PIN/xcelium/hl5_rtl.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp

$(BDW_WORKLIB)/modules/hl5/PIN/xcelium/debug/hl5_rtl.o : $(BDW_WORKLIB)/modules/hl5/PIN/hl5_rtl.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(BDW_WORKLIB)/modules/hl5/PIN/hl5_trace.h
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl hl5`
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/PIN/ -I./ $(CCFLAGS_hl5_PIN) $(EXTRACT_LIB_DASHI_hl5_PIN) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/hl5/PIN/xcelium/debug/hl5_rtl.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp

#
#	Behavioral object file rule.  Used only for BEH configs that are 
#	associated with HLS config names.
#

$(BDW_WORKLIB)/modules/hl5/PIN/xcelium/hl5_beh.o :  ../src/hl5.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.h $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(BDW_WORKLIB)/wrappers/hl5_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/PIN/ -I./ $(CCFLAGS_BEH_hl5_PIN) -o $(BDW_WORKLIB)/modules/hl5/PIN/xcelium/hl5_beh.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp

$(BDW_WORKLIB)/modules/hl5/PIN/xcelium/debug/hl5_beh.o :  ../src/hl5.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.h $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(BDW_WORKLIB)/wrappers/hl5_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/PIN/ -I./ $(CCFLAGS_BEH_hl5_PIN) -o $(BDW_WORKLIB)/modules/hl5/PIN/xcelium/debug/hl5_beh.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp

#
# Cosim object file rule
#

$(BDW_WORKLIB)/modules/hl5/PIN/xcelium/hl5.o :  ../src/hl5.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.h $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(BDW_WORKLIB)/wrappers/hl5_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/PIN/ -I./ $(CCFLAGS_COSIM_hl5_PIN) -o $(BDW_WORKLIB)/modules/hl5/PIN/xcelium/hl5.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp
    

$(BDW_WORKLIB)/modules/hl5/PIN/xcelium/hl5_hoist.o :  ../src/hl5.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(BDW_WORKLIB)/wrappers/hl5_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/PIN/ -I./ $(CCFLAGS_hl5_PIN) $(EXTRACT_LIB_DASHI_hl5_PIN) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/hl5/PIN/xcelium/hl5_hoist.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp
    

$(BDW_WORKLIB)/modules/hl5/PIN/xcelium/debug/hl5.o :  ../src/hl5.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.h $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(BDW_WORKLIB)/wrappers/hl5_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/PIN/ -I./ $(CCFLAGS_COSIM_hl5_PIN) -o $(BDW_WORKLIB)/modules/hl5/PIN/xcelium/debug/hl5.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp


$(BDW_WORKLIB)/modules/hl5/PIN/xcelium/debug/hl5_hoist.o :  ../src/hl5.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(BDW_WORKLIB)/wrappers/hl5_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/PIN/ -I./ $(CCFLAGS_hl5_PIN) $(EXTRACT_LIB_DASHI_hl5_PIN) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/hl5/PIN/xcelium/debug/hl5_hoist.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp
    

view_hl5_PIN_%:
	@echo "ERROR: Schematic viewing target 'view_hl5_PIN_$(*F)' is only supported with 'verdi'"
	@echo "The Stratus IDE includes a schematic view as an alternative."

ifneq ($(BDW_SPEC_NAME),)
#
#	RTL object file rule
#
$(subst /PIN/,/PIN$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/hl5/PIN/xcelium/hl5_rtl.o) : $(subst /PIN/,/PIN$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/hl5/PIN/hl5_rtl.cpp) $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(subst /PIN/,/PIN$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/hl5/PIN/hl5_trace.h)
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl hl5`
	$(subst /PIN/,/PIN$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/PIN/ -I./ $(CCFLAGS_hl5_PIN) $(EXTRACT_LIB_DASHI_hl5_PIN) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/hl5/PIN/xcelium/hl5_rtl.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp)

$(subst /PIN/,/PIN$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/hl5/PIN/xcelium/debug/hl5_rtl.o) : $(subst /PIN/,/PIN$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/hl5/PIN/hl5_rtl.cpp) $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(subst /PIN/,/PIN$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/hl5/PIN/hl5_trace.h)
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl hl5`
	$(subst /PIN/,/PIN$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/PIN/ -I./ $(CCFLAGS_hl5_PIN) $(EXTRACT_LIB_DASHI_hl5_PIN) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/hl5/PIN/xcelium/debug/hl5_rtl.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp)

#
#	Behavioral object file rule.  Used only for BEH configs that are 
#	associated with HLS config names.
#

$(subst /PIN/,/PIN$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/hl5/PIN/xcelium/hl5_beh.o) :  ../src/hl5.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.h $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(subst /PIN/,/PIN$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/hl5_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /PIN/,/PIN$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/PIN/ -I./ $(CCFLAGS_BEH_hl5_PIN) -o $(BDW_WORKLIB)/modules/hl5/PIN/xcelium/hl5_beh.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp)

$(subst /PIN/,/PIN$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/hl5/PIN/xcelium/debug/hl5_beh.o) :  ../src/hl5.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.h $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(subst /PIN/,/PIN$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/hl5_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /PIN/,/PIN$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/PIN/ -I./ $(CCFLAGS_BEH_hl5_PIN) -o $(BDW_WORKLIB)/modules/hl5/PIN/xcelium/debug/hl5_beh.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp)

#
# Cosim object file rule
#

$(subst /PIN/,/PIN$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/hl5/PIN/xcelium/hl5.o) :  ../src/hl5.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.h $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(subst /PIN/,/PIN$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/hl5_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /PIN/,/PIN$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/PIN/ -I./ $(CCFLAGS_COSIM_hl5_PIN) -o $(BDW_WORKLIB)/modules/hl5/PIN/xcelium/hl5.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp)
    

$(subst /PIN/,/PIN$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/hl5/PIN/xcelium/hl5_hoist.o) :  ../src/hl5.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(subst /PIN/,/PIN$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/hl5_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /PIN/,/PIN$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/PIN/ -I./ $(CCFLAGS_hl5_PIN) $(EXTRACT_LIB_DASHI_hl5_PIN) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/hl5/PIN/xcelium/hl5_hoist.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp)
    

$(subst /PIN/,/PIN$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/hl5/PIN/xcelium/debug/hl5.o) :  ../src/hl5.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.h $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(subst /PIN/,/PIN$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/hl5_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /PIN/,/PIN$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/PIN/ -I./ $(CCFLAGS_COSIM_hl5_PIN) -o $(BDW_WORKLIB)/modules/hl5/PIN/xcelium/debug/hl5.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp)


$(subst /PIN/,/PIN$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/hl5/PIN/xcelium/debug/hl5_hoist.o) :  ../src/hl5.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(subst /PIN/,/PIN$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/hl5_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /PIN/,/PIN$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/PIN/ -I./ $(CCFLAGS_hl5_PIN) $(EXTRACT_LIB_DASHI_hl5_PIN) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/hl5/PIN/xcelium/debug/hl5_hoist.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp)
    
endif

#
#	Dependency generation rule
#
$(BDW_WORKLIB)/modules/hl5/PIN/hl5.d :  ../src/hl5.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config PIN of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_hl5_PIN)  ../src/hl5.cpp \
	| sed 's|hl5\.o[ :]*|$(BDW_WORKLIB)/modules/hl5/PIN/hl5_rtl.cpp $(BDW_WORKLIB)/modules/hl5/PIN/xcelium/hl5_beh.o $(BDW_WORKLIB)/modules/hl5/PIN/xcelium/debug/hl5_beh.o $(BDW_WORKLIB)/modules/hl5/PIN/hl5.d : $(memlib_WORKLIB)/memlib.d |' $(BDW_DEP_FILTER)  > $@

#
#	Library post-proc rules
#



##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/hl5/PIN"
##############################################################

hl5_PIN_SRCDIR = $(BDW_WORKLIB)/modules/hl5/PIN
hl5_PIN_BEH_SRCDIR = $(BDW_WORKLIB)/libs/hl5_PIN
hl5_PIN_LIBNAME = hl5_PIN
hl5_PIN_WORKLIB = $(BDW_WORKLIB)/modules/hl5/PIN/xcelium
hl5_PIN_C_PARTS_A = $(hl5_PIN_WORKLIB)/objs/libhl5_PIN.a

prep_c_hl5_PIN : $(hl5_PIN_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(hl5_PIN_WORKLIB) prep_c

prep_vlog_hl5_PIN : $(hl5_PIN_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(hl5_PIN_WORKLIB) prep_vlog

prep_hl5_PIN : $(hl5_PIN_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(hl5_PIN_WORKLIB) prep

$(hl5_PIN_WORKLIB)/Makefile : $(hl5_PIN_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(hl5_PIN_WORKLIB) ]; then mkdir -p $(hl5_PIN_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(hl5_PIN_SRCDIR) -o $(hl5_PIN_WORKLIB)/Makefile -module hl5 -cynthconfig PIN   

$(hl5_PIN_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(hl5_PIN_WORKLIB) ]; then mkdir -p $(hl5_PIN_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



prep_c_hl5_PIN_% : $(subst PIN,PIN_%,$(hl5_PIN_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst PIN,PIN_$(*F),$(hl5_PIN_WORKLIB)) prep_c

prep_vlog_hl5_PIN_% : $(subst PIN,PIN_%,$(hl5_PIN_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst PIN,PIN_$(*F),$(hl5_PIN_WORKLIB)) prep_vlog

prep_hl5_PIN_% : $(subst PIN,PIN_%,$(hl5_PIN_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst PIN,PIN_$(*F),$(hl5_PIN_WORKLIB)) prep

$(subst PIN,PIN_%,$(hl5_PIN_WORKLIB))/Makefile : $(hl5_PIN_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(subst PIN,PIN_$(*F),$(hl5_PIN_WORKLIB)) ]; then mkdir -p $(subst PIN,PIN_$(*F),$(hl5_PIN_WORKLIB)); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(hl5_PIN_SRCDIR)_$(*F) -o $(subst PIN,PIN_$(*F),$(hl5_PIN_WORKLIB))/Makefile -module hl5 -cynthconfig PIN_$(*F)   

$(hl5_PIN_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(subst PIN,PIN_$(*F),$(hl5_PIN_WORKLIB)) ]; then mkdir -p $(subst PIN,PIN_$(*F),$(hl5_PIN_WORKLIB)); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(hl5_PIN_WORKLIB)/hl5_PIN.d :
	@if [ ! -d $(hl5_PIN_WORKLIB) ]; then mkdir -p $(hl5_PIN_WORKLIB); fi
	@touch $(hl5_PIN_WORKLIB)/hl5_PIN.d



#
# HLS config BASIC
#

#
#	stratus_hls rule
#
LIB_DIRS_hl5_BASIC = $(memlib_SRCDIR) 
LIB_INCLUDES_hl5_BASIC = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_hl5_BASIC))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_hl5_BASIC = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_hl5_BASIC = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_hl5_BASIC = 
EXTRACT_LIB_DASHI_hl5_BASIC = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl hl5 BASIC]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_hl5_BASIC = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/hl5/BASIC/c_parts -DBASIC=1 -DBDW_RTL_hl5_BASIC=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_hl5_BASIC)
CCFLAGS_COSIM_hl5_BASIC = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/hl5/BASIC/c_parts -DBASIC=1 -DBDW_RTL_hl5_BASIC=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_hl5_BASIC)
CCFLAGS_BEH_hl5_BASIC = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/hl5/BASIC/c_parts -DBASIC=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_hl5_BASIC)
CCFLAGS_hl5_BASIC += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_hl5_BASIC += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_hl5_BASIC += ${BDW_CCFLAGS_TAIL}

.PHONY: hlsc_hl5_BASIC hls_hl5_BASIC

hls_hl5_BASIC : hlsc_hl5_BASIC

cynth_hl5_BASIC : hlsc_hl5_BASIC

elab_hl5_BASIC : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/hl5/BASIC/stratus_hls.bdr

optim_hl5_BASIC : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/hl5/BASIC/stratus_hls.bdr

sched_hl5_BASIC : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/hl5/BASIC/stratus_hls.bdr

hlsc_hl5_BASIC : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/hl5/BASIC/hl5_rtl.cpp BDW_DEP_CYNTH_CONFIG=BASIC BDW_MODULE=hl5 BDW_HLS_CONFIG=BASIC 
else
	@bdw_exec -jobproject project.tcl -job hls.hl5.BASIC $(MAKE) CWBExec_hls=1 hlsc_hl5_BASIC
endif

clean_cynth_hl5_BASIC: clean_hls_hl5_BASIC

clean_hl5_BASIC: clean_hls_hl5_BASIC

clean_hls_hl5_BASIC:
	@rm -rf $(BDW_WORKLIB)/modules/hl5/BASIC
	@rm -rf $(BDW_WORKLIB)/jobs/hls.hl5.BASIC
	@rm -rf $(BDW_WORKLIB)/jobs/hls.hl5.BASIC.s

kill_hls_hl5_BASIC:
	@bdw_kill -job hls.hl5.BASIC
	@bdw_kill -job hls.hl5.BASIC.s


hls_hl5_BASIC_% : hlsc_hl5_BASIC_%

cynth_hl5_BASIC_% : hlsc_hl5_BASIC_%

elab_hl5_BASIC_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(subst /BASIC/,/BASIC_$(*F)/,$(BDW_WORKLIB)/modules/hl5/BASIC/stratus_hls.bdr)

optim_hl5_BASIC_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(subst /BASIC/,/BASIC_$(*F)/,$(BDW_WORKLIB)/modules/hl5/BASIC/stratus_hls.bdr)

sched_hl5_BASIC_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(subst /BASIC/,/BASIC_$(*F)/,$(BDW_WORKLIB)/modules/hl5/BASIC/stratus_hls.bdr)

hlsc_hl5_BASIC_% hls_hl5_BASIC_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /BASIC/,/BASIC_$(*F)/,$(BDW_WORKLIB)/modules/hl5/BASIC/hl5_rtl.cpp) BDW_DEP_CYNTH_CONFIG=BASIC BDW_MODULE=hl5 BDW_HLS_CONFIG=BASIC_$(*F) 
else
	@bdw_exec -jobproject project.tcl -job hls.hl5.BASIC_$(*F) $(MAKE) CWBExec_hls=1 hlsc_hl5_BASIC_$(*F)
endif

clean_cynth_hl5_BASIC_%: clean_hls_hl5_BASIC_%

clean_hl5_BASIC_%: clean_hls_hl5_BASIC_%

clean_hls_hl5_BASIC_%:
	@rm -rf $(BDW_WORKLIB)/modules/hl5/BASIC_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.hl5.BASIC_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.hl5.BASIC_$(*F).s

kill_hls_hl5_BASIC_%:
	@bdw_kill -job hls.hl5.BASIC_$(*F)
	@bdw_kill -job hls.hl5.BASIC_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),BASIC)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/hl5/BASIC/hl5.d
                -include $(memlib_WORKLIB)/memlib.d
                BDW_LIB_DEPS =  $(memlib_DEPS)
            endif
        endif
    endif
endif


html_hl5_BASIC :
	bdw_htmlgen -project project.tcl -module hl5 -cynthconfig BASIC

BDW_hl5_BASIC_HLS_TARGETS := $(BDW_WORKLIB)/modules/hl5/BASIC/hl5_rtl.cpp $(BDW_WORKLIB)/modules/hl5/BASIC/hl5_rtl.v $(BDW_WORKLIB)/modules/hl5/BASIC/stratus_hls.bdr
ifeq ($(BDW_BDR_ONLY),1)
.PHONY: $(filter %.bdr %.cpp,$(BDW_hl5_BASIC_HLS_TARGETS))
$(filter %.v %.cpp,$(BDW_hl5_BASIC_HLS_TARGETS)) : $(filter %.bdr,$(BDW_hl5_BASIC_HLS_TARGETS))
BDW_hl5_BASIC_HLS_TARGETS := $(filter %.bdr,$(BDW_hl5_BASIC_HLS_TARGETS))
endif
BDW_hl5_BASIC_HLS_SPEC_TARGETS = $(subst /BASIC/,/BASIC_%/,$(BDW_hl5_BASIC_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_hl5_BASIC_HLS_TARGETS) :  ../src/hl5.cpp  $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/memwb_wrap.h  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/hl5/BASIC ]; then mkdir -p $(BDW_WORKLIB)/modules/hl5/BASIC; fi
	
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=BASIC BDW_CYNTH_CONFIG=BASIC \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/hl5/BASIC/hl5_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/hl5/BASIC/hl5_rtl.cpp \
		BDW_MODULE=hl5 \
		BDW_CYNTH_CONFIG=BASIC \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/hl5/BASIC \
		BDW_HLS_CONFIG=BASIC \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/hl5/BASIC \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_hl5_BASIC)  \
		-d $(BDW_WORKLIB)/modules/hl5/BASIC -o hl5_rtl.cpp \
		--hls_module=hl5 --hls_config=BASIC --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_hl5_BASIC))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_hl5_BASIC))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_hl5_BASIC))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_hl5_BASIC)   \
		 ../src/hl5.cpp
	
	
	
	

else

$(BDW_hl5_BASIC_HLS_TARGETS) :  ../src/hl5.cpp  $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.hl5.BASIC.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_hl5_BASIC_HLS_TARGETS)

endif

	
$(BDW_WORKLIB)/modules/hl5/BASIC/hl5_trace.h : $(BDW_WORKLIB)/modules/hl5/BASIC/hl5_trace.h.updated

$(BDW_WORKLIB)/modules/hl5/BASIC/hl5_trace.h.updated : $(BDW_WORKLIB)/modules/hl5/BASIC/hl5_rtl.cpp $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module hl5 -cynthconfig BASIC  
	@touch $(BDW_WORKLIB)/modules/hl5/BASIC/hl5_trace.h.updated

ifeq ($(CWBExec_hlsc),1)

$(BDW_hl5_BASIC_HLS_SPEC_TARGETS) :  ../src/hl5.cpp  $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/memwb_wrap.h  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/hl5/BASIC_$(*F) ]; then mkdir -p $(BDW_WORKLIB)/modules/hl5/BASIC_$(*F); fi
	
	
	$(subst /BASIC ,/BASIC_$(*F) ,$(subst =BASIC ,=BASIC_$(*F) ,$(subst /hl5/BASIC/,/hl5/BASIC_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=BASIC BDW_CYNTH_CONFIG=BASIC \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/hl5/BASIC/hl5_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/hl5/BASIC/hl5_rtl.cpp \
		BDW_MODULE=hl5 \
		BDW_CYNTH_CONFIG=BASIC \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/hl5/BASIC \
		BDW_HLS_CONFIG=BASIC \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/hl5/BASIC \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_hl5_BASIC)  \
		`cat  $(BDW_SPECLIB)/hl5/BASIC.$(*F).bds | grep '^cmdline:' | sed 's/^cmdline://'`\
		-d $(BDW_WORKLIB)/modules/hl5/BASIC -o hl5_rtl.cpp \
		--hls_module=hl5 --hls_config=BASIC --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_hl5_BASIC))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_hl5_BASIC))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_hl5_BASIC))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_hl5_BASIC)   \
		 ../src/hl5.cpp)))
	
	
	
	

else

$(BDW_hl5_BASIC_HLS_SPEC_TARGETS) :  ../src/hl5.cpp  $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.hl5.BASIC_$(*F).s $(MAKE) -j1 CWBExec_hlsc=1 $(subst %,$(*F),$(BDW_hl5_BASIC_HLS_SPEC_TARGETS))

endif

	

$(subst /BASIC/,/BASIC_%/,$(BDW_WORKLIB)/modules/hl5/BASIC/hl5_trace.h) : $(subst /BASIC/,/BASIC_%/,$(BDW_WORKLIB)/modules/hl5/BASIC/hl5_rtl.cpp) $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module hl5 -cynthconfig BASIC_$(*F)  

catHLLog_hl5_BASIC:
	cat $(BDW_WORKLIB)/modules/hl5/BASIC/stratus_hls.log

#
#	stratus_vlg rule
#
cynthvlg_hl5_BASIC : hls_hl5_BASIC 


.PHONY: hls_hl5_BASIC

hls_hl5_BASIC hlsv_hl5_BASIC: $(addprefix prep_vlog_,$(LIB_NAMES_FOR_VLOG_hl5_BASIC)) 

.PHONY: hls_hl5_BASIC

hls_hl5_BASIC_% hlsv_hl5_BASIC_%: $(addprefix prep_vlog_,$(LIB_NAMES_FOR_VLOG_hl5_BASIC)) 

catVLGLog_hl5_BASIC : catHLLog_hl5_BASIC
	cat $(BDW_WORKLIB)/modules/hl5/BASIC/stratus_vlg.log

#
#	view rule
#

view_hl5_BASIC:
	@echo "ERROR: Schematic viewing target 'view_hl5_BASIC' is only supported with 'verdi'"
	@echo "The Stratus IDE includes a schematic view as an alternative."


#
#	RTL object file rule
#
$(BDW_WORKLIB)/modules/hl5/BASIC/xcelium/hl5_rtl.o : $(BDW_WORKLIB)/modules/hl5/BASIC/hl5_rtl.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(BDW_WORKLIB)/modules/hl5/BASIC/hl5_trace.h
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl hl5`
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/BASIC/ -I./ $(CCFLAGS_hl5_BASIC) $(EXTRACT_LIB_DASHI_hl5_BASIC) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/hl5/BASIC/xcelium/hl5_rtl.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp

