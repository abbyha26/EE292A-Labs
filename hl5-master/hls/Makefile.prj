	@bdw_exec -jobproject project.tcl -job sim.DPA_aes256_GP_$(*F) $(BDW_LAUNCH_SIM_COMMAND) $(MAKE) CWBExec_sim=1 sim_DPA_aes256_GP_$(*F)

sim_sub_DPA_aes256_GP_%:
	@bdw_exec -jobproject project.tcl -job sim_sub.DPA_aes256_GP_$(*F).s $(BDW_LAUNCH_SIM_COMMAND) $(MAKE) CWBExec_sim=1 sim_sub_DPA_aes256_GP_$(*F)
endif


kill_sim_DPA_aes256_GP_%:
	@bdw_kill -job sim.DPA_aes256_GP_$(*F)
	@bdw_kill -job sim.DPA_aes256_GP_$(*F).s


