	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/PIN/ -I./ $(CCFLAGS_memwb_PIN) $(EXTRACT_LIB_DASHI_memwb_PIN) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/memwb/PIN/xcelium/debug/memwb_rtl.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp

