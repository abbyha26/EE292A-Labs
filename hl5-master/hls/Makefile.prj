#
#	Dependency generation rule
#
$(BDW_WORKLIB)/modules/execute/DPA/execute.d :  ../src/execute.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config DPA of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_execute_DPA)  ../src/execute.cpp \
	| sed 's|execute\.o[ :]*|$(BDW_WORKLIB)/modules/execute/DPA/execute_rtl.cpp $(BDW_WORKLIB)/modules/execute/DPA/xcelium/execute_beh.o $(BDW_WORKLIB)/modules/execute/DPA/xcelium/debug/execute_beh.o $(BDW_WORKLIB)/modules/execute/DPA/execute.d : $(memlib_WORKLIB)/memlib.d |' $(BDW_DEP_FILTER)  > $@

#
#	Library post-proc rules
#



##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/execute/DPA"
##############################################################

execute_DPA_SRCDIR = $(BDW_WORKLIB)/modules/execute/DPA
execute_DPA_BEH_SRCDIR = $(BDW_WORKLIB)/libs/execute_DPA
execute_DPA_LIBNAME = execute_DPA
execute_DPA_WORKLIB = $(BDW_WORKLIB)/modules/execute/DPA/xcelium
execute_DPA_C_PARTS_A = $(execute_DPA_WORKLIB)/objs/libexecute_DPA.a

prep_c_execute_DPA : $(execute_DPA_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(execute_DPA_WORKLIB) prep_c

prep_vlog_execute_DPA : $(execute_DPA_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(execute_DPA_WORKLIB) prep_vlog

prep_execute_DPA : $(execute_DPA_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(execute_DPA_WORKLIB) prep

$(execute_DPA_WORKLIB)/Makefile : $(execute_DPA_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(execute_DPA_WORKLIB) ]; then mkdir -p $(execute_DPA_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(execute_DPA_SRCDIR) -o $(execute_DPA_WORKLIB)/Makefile -module execute -cynthconfig DPA   

$(execute_DPA_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(execute_DPA_WORKLIB) ]; then mkdir -p $(execute_DPA_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



prep_c_execute_DPA_% : $(subst DPA,DPA_%,$(execute_DPA_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst DPA,DPA_$(*F),$(execute_DPA_WORKLIB)) prep_c

prep_vlog_execute_DPA_% : $(subst DPA,DPA_%,$(execute_DPA_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst DPA,DPA_$(*F),$(execute_DPA_WORKLIB)) prep_vlog

prep_execute_DPA_% : $(subst DPA,DPA_%,$(execute_DPA_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst DPA,DPA_$(*F),$(execute_DPA_WORKLIB)) prep

$(subst DPA,DPA_%,$(execute_DPA_WORKLIB))/Makefile : $(execute_DPA_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(subst DPA,DPA_$(*F),$(execute_DPA_WORKLIB)) ]; then mkdir -p $(subst DPA,DPA_$(*F),$(execute_DPA_WORKLIB)); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(execute_DPA_SRCDIR)_$(*F) -o $(subst DPA,DPA_$(*F),$(execute_DPA_WORKLIB))/Makefile -module execute -cynthconfig DPA_$(*F)   

$(execute_DPA_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(subst DPA,DPA_$(*F),$(execute_DPA_WORKLIB)) ]; then mkdir -p $(subst DPA,DPA_$(*F),$(execute_DPA_WORKLIB)); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(execute_DPA_WORKLIB)/execute_DPA.d :
	@if [ ! -d $(execute_DPA_WORKLIB) ]; then mkdir -p $(execute_DPA_WORKLIB); fi
	@touch $(execute_DPA_WORKLIB)/execute_DPA.d



#
# HLS config PIPE_SOFT1
#

#
#	stratus_hls rule
#
LIB_DIRS_execute_PIPE_SOFT1 = $(memlib_SRCDIR) 
LIB_INCLUDES_execute_PIPE_SOFT1 = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_execute_PIPE_SOFT1))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_execute_PIPE_SOFT1 = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_execute_PIPE_SOFT1 = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_execute_PIPE_SOFT1 = 
EXTRACT_LIB_DASHI_execute_PIPE_SOFT1 = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl execute PIPE_SOFT1]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_execute_PIPE_SOFT1 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/execute/PIPE_SOFT1/c_parts -DPIPE_SOFT1=1 -DBDW_RTL_execute_PIPE_SOFT1=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DPIPE_SOFT_STALL1=1 $(LIB_INCLUDES_execute_PIPE_SOFT1)
CCFLAGS_COSIM_execute_PIPE_SOFT1 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/execute/PIPE_SOFT1/c_parts -DPIPE_SOFT1=1 -DBDW_RTL_execute_PIPE_SOFT1=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DPIPE_SOFT_STALL1=1 $(LIB_INCLUDES_execute_PIPE_SOFT1)
CCFLAGS_BEH_execute_PIPE_SOFT1 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/execute/PIPE_SOFT1/c_parts -DPIPE_SOFT1=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DPIPE_SOFT_STALL1=1 $(LIB_INCLUDES_execute_PIPE_SOFT1)
CCFLAGS_execute_PIPE_SOFT1 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_execute_PIPE_SOFT1 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_execute_PIPE_SOFT1 += ${BDW_CCFLAGS_TAIL}

.PHONY: hlsc_execute_PIPE_SOFT1 hls_execute_PIPE_SOFT1

hls_execute_PIPE_SOFT1 : hlsc_execute_PIPE_SOFT1

cynth_execute_PIPE_SOFT1 : hlsc_execute_PIPE_SOFT1

elab_execute_PIPE_SOFT1 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/execute/PIPE_SOFT1/stratus_hls.bdr

optim_execute_PIPE_SOFT1 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/execute/PIPE_SOFT1/stratus_hls.bdr

sched_execute_PIPE_SOFT1 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/execute/PIPE_SOFT1/stratus_hls.bdr

hlsc_execute_PIPE_SOFT1 : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/execute/PIPE_SOFT1/execute_rtl.cpp BDW_DEP_CYNTH_CONFIG=PIPE_SOFT1 BDW_MODULE=execute BDW_HLS_CONFIG=PIPE_SOFT1 
else
	@bdw_exec -jobproject project.tcl -job hls.execute.PIPE_SOFT1 $(MAKE) CWBExec_hls=1 hlsc_execute_PIPE_SOFT1
endif

clean_cynth_execute_PIPE_SOFT1: clean_hls_execute_PIPE_SOFT1

clean_execute_PIPE_SOFT1: clean_hls_execute_PIPE_SOFT1

clean_hls_execute_PIPE_SOFT1:
	@rm -rf $(BDW_WORKLIB)/modules/execute/PIPE_SOFT1
	@rm -rf $(BDW_WORKLIB)/jobs/hls.execute.PIPE_SOFT1
	@rm -rf $(BDW_WORKLIB)/jobs/hls.execute.PIPE_SOFT1.s

kill_hls_execute_PIPE_SOFT1:
	@bdw_kill -job hls.execute.PIPE_SOFT1
	@bdw_kill -job hls.execute.PIPE_SOFT1.s


hls_execute_PIPE_SOFT1_% : hlsc_execute_PIPE_SOFT1_%

cynth_execute_PIPE_SOFT1_% : hlsc_execute_PIPE_SOFT1_%

elab_execute_PIPE_SOFT1_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(subst /PIPE_SOFT1/,/PIPE_SOFT1_$(*F)/,$(BDW_WORKLIB)/modules/execute/PIPE_SOFT1/stratus_hls.bdr)

optim_execute_PIPE_SOFT1_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(subst /PIPE_SOFT1/,/PIPE_SOFT1_$(*F)/,$(BDW_WORKLIB)/modules/execute/PIPE_SOFT1/stratus_hls.bdr)

sched_execute_PIPE_SOFT1_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(subst /PIPE_SOFT1/,/PIPE_SOFT1_$(*F)/,$(BDW_WORKLIB)/modules/execute/PIPE_SOFT1/stratus_hls.bdr)

hlsc_execute_PIPE_SOFT1_% hls_execute_PIPE_SOFT1_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /PIPE_SOFT1/,/PIPE_SOFT1_$(*F)/,$(BDW_WORKLIB)/modules/execute/PIPE_SOFT1/execute_rtl.cpp) BDW_DEP_CYNTH_CONFIG=PIPE_SOFT1 BDW_MODULE=execute BDW_HLS_CONFIG=PIPE_SOFT1_$(*F) 
else
	@bdw_exec -jobproject project.tcl -job hls.execute.PIPE_SOFT1_$(*F) $(MAKE) CWBExec_hls=1 hlsc_execute_PIPE_SOFT1_$(*F)
endif

clean_cynth_execute_PIPE_SOFT1_%: clean_hls_execute_PIPE_SOFT1_%

clean_execute_PIPE_SOFT1_%: clean_hls_execute_PIPE_SOFT1_%

clean_hls_execute_PIPE_SOFT1_%:
	@rm -rf $(BDW_WORKLIB)/modules/execute/PIPE_SOFT1_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.execute.PIPE_SOFT1_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.execute.PIPE_SOFT1_$(*F).s

