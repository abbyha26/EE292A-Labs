sim_PIPE_SOFT1_aes256_10_V_%:
	@bdw_exec -jobproject project.tcl -job sim.PIPE_SOFT1_aes256_10_V_$(*F) $(BDW_LAUNCH_SIM_COMMAND) $(MAKE) CWBExec_sim=1 sim_PIPE_SOFT1_aes256_10_V_$(*F)

sim_sub_PIPE_SOFT1_aes256_10_V_%:
	@bdw_exec -jobproject project.tcl -job sim_sub.PIPE_SOFT1_aes256_10_V_$(*F).s $(BDW_LAUNCH_SIM_COMMAND) $(MAKE) CWBExec_sim=1 sim_sub_PIPE_SOFT1_aes256_10_V_$(*F)
