ifeq ($(CWBExec_build),1)

dbg_build_BASIC_div_10_V_%:
	@if [ ! -e systemc ] ; then ln -s $(STRATUS_HOME)/tools.lnx86/stratus/systemc ; fi
	@$(MAKE) siminfo BDW_SIM_CONFIG=BASIC_div_10_V_$(*F)
	@$(MAKE) BDW_DEBUG=1 build_BASIC_div_10_V_$(*F)


build_BASIC_div_10_V_% build_BASIC_div_10_V_sub_%: bdw_prebuild_wrappers  
	$(MAKE) -j1 CWBExec_hls=1 `$(BDW_SPEC_FILTER) project.db $(*F)  hls_fedec_BASIC hls_execute_BASIC hls_memwb_BASIC` 
	$(MAKE) -j1 CWBExec_hls=1 `$(BDW_SPEC_FILTER) project.db $(*F)  hls_hl5_BASIC`
	@$(MAKE) siminfo BDW_SIM_CONFIG=BASIC_div_10_V_$(*F)
	@$(BDW_EXEC_CMD) $(MAKE) $(BDW_PMAKE_FLG) build_sim_image BDW_SIM_CONFIG=BASIC_div_10_V_$(*F) BDW_GENDEPS=1 BDW_BASE_SIM_CONFIG=BASIC_div_10_V BDW_SPEC_NAME=$(*F)

build_only_BASIC_div_10_V_%:
