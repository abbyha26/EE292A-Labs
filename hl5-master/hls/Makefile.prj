	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl fedec`
	$(subst /PIPE_SOFT1/,/PIPE_SOFT1$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/ -I./ $(CCFLAGS_fedec_PIPE_SOFT1) $(EXTRACT_LIB_DASHI_fedec_PIPE_SOFT1) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/xcelium/debug/fedec_rtl.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp)

#
#	Behavioral object file rule.  Used only for BEH configs that are 
#	associated with HLS config names.
#

$(subst /PIPE_SOFT1/,/PIPE_SOFT1$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/xcelium/fedec_beh.o) :  ../src/fedec.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(subst /PIPE_SOFT1/,/PIPE_SOFT1$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/fedec_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /PIPE_SOFT1/,/PIPE_SOFT1$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/ -I./ $(CCFLAGS_BEH_fedec_PIPE_SOFT1) -o $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/xcelium/fedec_beh.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp)

$(subst /PIPE_SOFT1/,/PIPE_SOFT1$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/xcelium/debug/fedec_beh.o) :  ../src/fedec.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(subst /PIPE_SOFT1/,/PIPE_SOFT1$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/fedec_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /PIPE_SOFT1/,/PIPE_SOFT1$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/ -I./ $(CCFLAGS_BEH_fedec_PIPE_SOFT1) -o $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/xcelium/debug/fedec_beh.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp)

#
# Cosim object file rule
#

$(subst /PIPE_SOFT1/,/PIPE_SOFT1$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/xcelium/fedec.o) :  ../src/fedec.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(subst /PIPE_SOFT1/,/PIPE_SOFT1$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/fedec_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /PIPE_SOFT1/,/PIPE_SOFT1$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/ -I./ $(CCFLAGS_COSIM_fedec_PIPE_SOFT1) -o $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/xcelium/fedec.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp)
    

$(subst /PIPE_SOFT1/,/PIPE_SOFT1$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/xcelium/fedec_hoist.o) :  ../src/fedec.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(subst /PIPE_SOFT1/,/PIPE_SOFT1$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/fedec_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /PIPE_SOFT1/,/PIPE_SOFT1$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/ -I./ $(CCFLAGS_fedec_PIPE_SOFT1) $(EXTRACT_LIB_DASHI_fedec_PIPE_SOFT1) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/xcelium/fedec_hoist.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp)
    

$(subst /PIPE_SOFT1/,/PIPE_SOFT1$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/xcelium/debug/fedec.o) :  ../src/fedec.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(subst /PIPE_SOFT1/,/PIPE_SOFT1$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/fedec_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /PIPE_SOFT1/,/PIPE_SOFT1$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/ -I./ $(CCFLAGS_COSIM_fedec_PIPE_SOFT1) -o $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/xcelium/debug/fedec.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp)


$(subst /PIPE_SOFT1/,/PIPE_SOFT1$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/xcelium/debug/fedec_hoist.o) :  ../src/fedec.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(subst /PIPE_SOFT1/,/PIPE_SOFT1$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/fedec_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /PIPE_SOFT1/,/PIPE_SOFT1$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/ -I./ $(CCFLAGS_fedec_PIPE_SOFT1) $(EXTRACT_LIB_DASHI_fedec_PIPE_SOFT1) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/xcelium/debug/fedec_hoist.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp)
    
endif

#
#	Dependency generation rule
#
$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/fedec.d :  ../src/fedec.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config PIPE_SOFT1 of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_fedec_PIPE_SOFT1)  ../src/fedec.cpp \
	| sed 's|fedec\.o[ :]*|$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/fedec_rtl.cpp $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/xcelium/fedec_beh.o $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/xcelium/debug/fedec_beh.o $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/fedec.d : $(memlib_WORKLIB)/memlib.d |' $(BDW_DEP_FILTER)  > $@

#
#	Library post-proc rules
#



##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1"
##############################################################

fedec_PIPE_SOFT1_SRCDIR = $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1
fedec_PIPE_SOFT1_BEH_SRCDIR = $(BDW_WORKLIB)/libs/fedec_PIPE_SOFT1
fedec_PIPE_SOFT1_LIBNAME = fedec_PIPE_SOFT1
fedec_PIPE_SOFT1_WORKLIB = $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/xcelium
fedec_PIPE_SOFT1_C_PARTS_A = $(fedec_PIPE_SOFT1_WORKLIB)/objs/libfedec_PIPE_SOFT1.a

prep_c_fedec_PIPE_SOFT1 : $(fedec_PIPE_SOFT1_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(fedec_PIPE_SOFT1_WORKLIB) prep_c

prep_vlog_fedec_PIPE_SOFT1 : $(fedec_PIPE_SOFT1_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(fedec_PIPE_SOFT1_WORKLIB) prep_vlog

prep_fedec_PIPE_SOFT1 : $(fedec_PIPE_SOFT1_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(fedec_PIPE_SOFT1_WORKLIB) prep

$(fedec_PIPE_SOFT1_WORKLIB)/Makefile : $(fedec_PIPE_SOFT1_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(fedec_PIPE_SOFT1_WORKLIB) ]; then mkdir -p $(fedec_PIPE_SOFT1_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(fedec_PIPE_SOFT1_SRCDIR) -o $(fedec_PIPE_SOFT1_WORKLIB)/Makefile -module fedec -cynthconfig PIPE_SOFT1   

$(fedec_PIPE_SOFT1_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(fedec_PIPE_SOFT1_WORKLIB) ]; then mkdir -p $(fedec_PIPE_SOFT1_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



prep_c_fedec_PIPE_SOFT1_% : $(subst PIPE_SOFT1,PIPE_SOFT1_%,$(fedec_PIPE_SOFT1_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst PIPE_SOFT1,PIPE_SOFT1_$(*F),$(fedec_PIPE_SOFT1_WORKLIB)) prep_c

prep_vlog_fedec_PIPE_SOFT1_% : $(subst PIPE_SOFT1,PIPE_SOFT1_%,$(fedec_PIPE_SOFT1_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst PIPE_SOFT1,PIPE_SOFT1_$(*F),$(fedec_PIPE_SOFT1_WORKLIB)) prep_vlog

prep_fedec_PIPE_SOFT1_% : $(subst PIPE_SOFT1,PIPE_SOFT1_%,$(fedec_PIPE_SOFT1_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst PIPE_SOFT1,PIPE_SOFT1_$(*F),$(fedec_PIPE_SOFT1_WORKLIB)) prep

$(subst PIPE_SOFT1,PIPE_SOFT1_%,$(fedec_PIPE_SOFT1_WORKLIB))/Makefile : $(fedec_PIPE_SOFT1_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(subst PIPE_SOFT1,PIPE_SOFT1_$(*F),$(fedec_PIPE_SOFT1_WORKLIB)) ]; then mkdir -p $(subst PIPE_SOFT1,PIPE_SOFT1_$(*F),$(fedec_PIPE_SOFT1_WORKLIB)); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(fedec_PIPE_SOFT1_SRCDIR)_$(*F) -o $(subst PIPE_SOFT1,PIPE_SOFT1_$(*F),$(fedec_PIPE_SOFT1_WORKLIB))/Makefile -module fedec -cynthconfig PIPE_SOFT1_$(*F)   

$(fedec_PIPE_SOFT1_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(subst PIPE_SOFT1,PIPE_SOFT1_$(*F),$(fedec_PIPE_SOFT1_WORKLIB)) ]; then mkdir -p $(subst PIPE_SOFT1,PIPE_SOFT1_$(*F),$(fedec_PIPE_SOFT1_WORKLIB)); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(fedec_PIPE_SOFT1_WORKLIB)/fedec_PIPE_SOFT1.d :
	@if [ ! -d $(fedec_PIPE_SOFT1_WORKLIB) ]; then mkdir -p $(fedec_PIPE_SOFT1_WORKLIB); fi
	@touch $(fedec_PIPE_SOFT1_WORKLIB)/fedec_PIPE_SOFT1.d



#
# HLS config PIPE_SOFT2
#

#
#	stratus_hls rule
#
LIB_DIRS_fedec_PIPE_SOFT2 = $(memlib_SRCDIR) 
LIB_INCLUDES_fedec_PIPE_SOFT2 = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_fedec_PIPE_SOFT2))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_fedec_PIPE_SOFT2 = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_fedec_PIPE_SOFT2 = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_fedec_PIPE_SOFT2 = 
EXTRACT_LIB_DASHI_fedec_PIPE_SOFT2 = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl fedec PIPE_SOFT2]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_fedec_PIPE_SOFT2 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT2/c_parts -DPIPE_SOFT2=1 -DBDW_RTL_fedec_PIPE_SOFT2=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DPIPE_SOFT_STALL2=1 $(LIB_INCLUDES_fedec_PIPE_SOFT2)
CCFLAGS_COSIM_fedec_PIPE_SOFT2 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT2/c_parts -DPIPE_SOFT2=1 -DBDW_RTL_fedec_PIPE_SOFT2=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DPIPE_SOFT_STALL2=1 $(LIB_INCLUDES_fedec_PIPE_SOFT2)
CCFLAGS_BEH_fedec_PIPE_SOFT2 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT2/c_parts -DPIPE_SOFT2=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DPIPE_SOFT_STALL2=1 $(LIB_INCLUDES_fedec_PIPE_SOFT2)
CCFLAGS_fedec_PIPE_SOFT2 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_fedec_PIPE_SOFT2 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_fedec_PIPE_SOFT2 += ${BDW_CCFLAGS_TAIL}

