	$(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/RADIX_2/ -I./ $(CCFLAGS_memwb_RADIX_2) $(EXTRACT_LIB_DASHI_memwb_RADIX_2) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/memwb/RADIX_2/xcelium/memwb_rtl.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp)

$(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/RADIX_2/xcelium/debug/memwb_rtl.o) : $(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/RADIX_2/memwb_rtl.cpp) $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/RADIX_2/memwb_trace.h)
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl memwb`
	$(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/RADIX_2/ -I./ $(CCFLAGS_memwb_RADIX_2) $(EXTRACT_LIB_DASHI_memwb_RADIX_2) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/memwb/RADIX_2/xcelium/debug/memwb_rtl.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp)

#
#	Behavioral object file rule.  Used only for BEH configs that are 
#	associated with HLS config names.
#

$(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/RADIX_2/xcelium/memwb_beh.o) :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/memwb_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/RADIX_2/ -I./ $(CCFLAGS_BEH_memwb_RADIX_2) -o $(BDW_WORKLIB)/modules/memwb/RADIX_2/xcelium/memwb_beh.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp)

$(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/RADIX_2/xcelium/debug/memwb_beh.o) :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/memwb_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/RADIX_2/ -I./ $(CCFLAGS_BEH_memwb_RADIX_2) -o $(BDW_WORKLIB)/modules/memwb/RADIX_2/xcelium/debug/memwb_beh.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp)

#
# Cosim object file rule
#

$(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/RADIX_2/xcelium/memwb.o) :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/memwb_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/RADIX_2/ -I./ $(CCFLAGS_COSIM_memwb_RADIX_2) -o $(BDW_WORKLIB)/modules/memwb/RADIX_2/xcelium/memwb.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp)
    

$(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/RADIX_2/xcelium/memwb_hoist.o) :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/memwb_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/RADIX_2/ -I./ $(CCFLAGS_memwb_RADIX_2) $(EXTRACT_LIB_DASHI_memwb_RADIX_2) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/memwb/RADIX_2/xcelium/memwb_hoist.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp)
    

$(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/RADIX_2/xcelium/debug/memwb.o) :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/memwb_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/RADIX_2/ -I./ $(CCFLAGS_COSIM_memwb_RADIX_2) -o $(BDW_WORKLIB)/modules/memwb/RADIX_2/xcelium/debug/memwb.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp)


$(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/RADIX_2/xcelium/debug/memwb_hoist.o) :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/memwb_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/RADIX_2/ -I./ $(CCFLAGS_memwb_RADIX_2) $(EXTRACT_LIB_DASHI_memwb_RADIX_2) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/memwb/RADIX_2/xcelium/debug/memwb_hoist.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp)
    
endif

#
#	Dependency generation rule
#
$(BDW_WORKLIB)/modules/memwb/RADIX_2/memwb.d :  ../src/memwb.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config RADIX_2 of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_memwb_RADIX_2)  ../src/memwb.cpp \
	| sed 's|memwb\.o[ :]*|$(BDW_WORKLIB)/modules/memwb/RADIX_2/memwb_rtl.cpp $(BDW_WORKLIB)/modules/memwb/RADIX_2/xcelium/memwb_beh.o $(BDW_WORKLIB)/modules/memwb/RADIX_2/xcelium/debug/memwb_beh.o $(BDW_WORKLIB)/modules/memwb/RADIX_2/memwb.d : $(memlib_WORKLIB)/memlib.d |' $(BDW_DEP_FILTER)  > $@

#
#	Library post-proc rules
#



##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/memwb/RADIX_2"
##############################################################

memwb_RADIX_2_SRCDIR = $(BDW_WORKLIB)/modules/memwb/RADIX_2
memwb_RADIX_2_BEH_SRCDIR = $(BDW_WORKLIB)/libs/memwb_RADIX_2
memwb_RADIX_2_LIBNAME = memwb_RADIX_2
memwb_RADIX_2_WORKLIB = $(BDW_WORKLIB)/modules/memwb/RADIX_2/xcelium
memwb_RADIX_2_C_PARTS_A = $(memwb_RADIX_2_WORKLIB)/objs/libmemwb_RADIX_2.a

prep_c_memwb_RADIX_2 : $(memwb_RADIX_2_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(memwb_RADIX_2_WORKLIB) prep_c

prep_vlog_memwb_RADIX_2 : $(memwb_RADIX_2_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(memwb_RADIX_2_WORKLIB) prep_vlog

prep_memwb_RADIX_2 : $(memwb_RADIX_2_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(memwb_RADIX_2_WORKLIB) prep

$(memwb_RADIX_2_WORKLIB)/Makefile : $(memwb_RADIX_2_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(memwb_RADIX_2_WORKLIB) ]; then mkdir -p $(memwb_RADIX_2_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(memwb_RADIX_2_SRCDIR) -o $(memwb_RADIX_2_WORKLIB)/Makefile -module memwb -cynthconfig RADIX_2   

$(memwb_RADIX_2_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(memwb_RADIX_2_WORKLIB) ]; then mkdir -p $(memwb_RADIX_2_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



prep_c_memwb_RADIX_2_% : $(subst RADIX_2,RADIX_2_%,$(memwb_RADIX_2_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst RADIX_2,RADIX_2_$(*F),$(memwb_RADIX_2_WORKLIB)) prep_c

prep_vlog_memwb_RADIX_2_% : $(subst RADIX_2,RADIX_2_%,$(memwb_RADIX_2_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst RADIX_2,RADIX_2_$(*F),$(memwb_RADIX_2_WORKLIB)) prep_vlog

prep_memwb_RADIX_2_% : $(subst RADIX_2,RADIX_2_%,$(memwb_RADIX_2_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst RADIX_2,RADIX_2_$(*F),$(memwb_RADIX_2_WORKLIB)) prep

$(subst RADIX_2,RADIX_2_%,$(memwb_RADIX_2_WORKLIB))/Makefile : $(memwb_RADIX_2_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(subst RADIX_2,RADIX_2_$(*F),$(memwb_RADIX_2_WORKLIB)) ]; then mkdir -p $(subst RADIX_2,RADIX_2_$(*F),$(memwb_RADIX_2_WORKLIB)); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(memwb_RADIX_2_SRCDIR)_$(*F) -o $(subst RADIX_2,RADIX_2_$(*F),$(memwb_RADIX_2_WORKLIB))/Makefile -module memwb -cynthconfig RADIX_2_$(*F)   

$(memwb_RADIX_2_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(subst RADIX_2,RADIX_2_$(*F),$(memwb_RADIX_2_WORKLIB)) ]; then mkdir -p $(subst RADIX_2,RADIX_2_$(*F),$(memwb_RADIX_2_WORKLIB)); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(memwb_RADIX_2_WORKLIB)/memwb_RADIX_2.d :
	@if [ ! -d $(memwb_RADIX_2_WORKLIB) ]; then mkdir -p $(memwb_RADIX_2_WORKLIB); fi
	@touch $(memwb_RADIX_2_WORKLIB)/memwb_RADIX_2.d



#
# HLS config RADIX_4
#

#
#	stratus_hls rule
#
LIB_DIRS_memwb_RADIX_4 = $(memlib_SRCDIR) 
LIB_INCLUDES_memwb_RADIX_4 = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_memwb_RADIX_4))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_memwb_RADIX_4 = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_memwb_RADIX_4 = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_memwb_RADIX_4 = 
EXTRACT_LIB_DASHI_memwb_RADIX_4 = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl memwb RADIX_4]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_memwb_RADIX_4 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/memwb/RADIX_4/c_parts -DRADIX_4=1 -DBDW_RTL_memwb_RADIX_4=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DDIV_RADIX_4 $(LIB_INCLUDES_memwb_RADIX_4)
CCFLAGS_COSIM_memwb_RADIX_4 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/memwb/RADIX_4/c_parts -DRADIX_4=1 -DBDW_RTL_memwb_RADIX_4=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DDIV_RADIX_4 $(LIB_INCLUDES_memwb_RADIX_4)
CCFLAGS_BEH_memwb_RADIX_4 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/memwb/RADIX_4/c_parts -DRADIX_4=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DDIV_RADIX_4 $(LIB_INCLUDES_memwb_RADIX_4)
CCFLAGS_memwb_RADIX_4 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_memwb_RADIX_4 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_memwb_RADIX_4 += ${BDW_CCFLAGS_TAIL}

.PHONY: hlsc_memwb_RADIX_4 hls_memwb_RADIX_4

hls_memwb_RADIX_4 : hlsc_memwb_RADIX_4

cynth_memwb_RADIX_4 : hlsc_memwb_RADIX_4

elab_memwb_RADIX_4 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/memwb/RADIX_4/stratus_hls.bdr

optim_memwb_RADIX_4 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/memwb/RADIX_4/stratus_hls.bdr

sched_memwb_RADIX_4 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/memwb/RADIX_4/stratus_hls.bdr

hlsc_memwb_RADIX_4 : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/memwb/RADIX_4/memwb_rtl.cpp BDW_DEP_CYNTH_CONFIG=RADIX_4 BDW_MODULE=memwb BDW_HLS_CONFIG=RADIX_4 
else
	@bdw_exec -jobproject project.tcl -job hls.memwb.RADIX_4 $(MAKE) CWBExec_hls=1 hlsc_memwb_RADIX_4
endif

clean_cynth_memwb_RADIX_4: clean_hls_memwb_RADIX_4

clean_memwb_RADIX_4: clean_hls_memwb_RADIX_4

clean_hls_memwb_RADIX_4:
	@rm -rf $(BDW_WORKLIB)/modules/memwb/RADIX_4
	@rm -rf $(BDW_WORKLIB)/jobs/hls.memwb.RADIX_4
	@rm -rf $(BDW_WORKLIB)/jobs/hls.memwb.RADIX_4.s

kill_hls_memwb_RADIX_4:
	@bdw_kill -job hls.memwb.RADIX_4
	@bdw_kill -job hls.memwb.RADIX_4.s


hls_memwb_RADIX_4_% : hlsc_memwb_RADIX_4_%

cynth_memwb_RADIX_4_% : hlsc_memwb_RADIX_4_%

elab_memwb_RADIX_4_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(subst /RADIX_4/,/RADIX_4_$(*F)/,$(BDW_WORKLIB)/modules/memwb/RADIX_4/stratus_hls.bdr)

optim_memwb_RADIX_4_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(subst /RADIX_4/,/RADIX_4_$(*F)/,$(BDW_WORKLIB)/modules/memwb/RADIX_4/stratus_hls.bdr)

sched_memwb_RADIX_4_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(subst /RADIX_4/,/RADIX_4_$(*F)/,$(BDW_WORKLIB)/modules/memwb/RADIX_4/stratus_hls.bdr)

hlsc_memwb_RADIX_4_% hls_memwb_RADIX_4_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /RADIX_4/,/RADIX_4_$(*F)/,$(BDW_WORKLIB)/modules/memwb/RADIX_4/memwb_rtl.cpp) BDW_DEP_CYNTH_CONFIG=RADIX_4 BDW_MODULE=memwb BDW_HLS_CONFIG=RADIX_4_$(*F) 
else
	@bdw_exec -jobproject project.tcl -job hls.memwb.RADIX_4_$(*F) $(MAKE) CWBExec_hls=1 hlsc_memwb_RADIX_4_$(*F)
endif

clean_cynth_memwb_RADIX_4_%: clean_hls_memwb_RADIX_4_%

clean_memwb_RADIX_4_%: clean_hls_memwb_RADIX_4_%

clean_hls_memwb_RADIX_4_%:
	@rm -rf $(BDW_WORKLIB)/modules/memwb/RADIX_4_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.memwb.RADIX_4_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.memwb.RADIX_4_$(*F).s

kill_hls_memwb_RADIX_4_%:
	@bdw_kill -job hls.memwb.RADIX_4_$(*F)
	@bdw_kill -job hls.memwb.RADIX_4_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),RADIX_4)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/memwb/RADIX_4/memwb.d
                -include $(memlib_WORKLIB)/memlib.d
                BDW_LIB_DEPS =  $(memlib_DEPS)
            endif
        endif
    endif
endif


html_memwb_RADIX_4 :
	bdw_htmlgen -project project.tcl -module memwb -cynthconfig RADIX_4

BDW_memwb_RADIX_4_HLS_TARGETS := $(BDW_WORKLIB)/modules/memwb/RADIX_4/memwb_rtl.cpp $(BDW_WORKLIB)/modules/memwb/RADIX_4/memwb_rtl.v $(BDW_WORKLIB)/modules/memwb/RADIX_4/stratus_hls.bdr
ifeq ($(BDW_BDR_ONLY),1)
.PHONY: $(filter %.bdr %.cpp,$(BDW_memwb_RADIX_4_HLS_TARGETS))
$(filter %.v %.cpp,$(BDW_memwb_RADIX_4_HLS_TARGETS)) : $(filter %.bdr,$(BDW_memwb_RADIX_4_HLS_TARGETS))
BDW_memwb_RADIX_4_HLS_TARGETS := $(filter %.bdr,$(BDW_memwb_RADIX_4_HLS_TARGETS))
endif
BDW_memwb_RADIX_4_HLS_SPEC_TARGETS = $(subst /RADIX_4/,/RADIX_4_%/,$(BDW_memwb_RADIX_4_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_memwb_RADIX_4_HLS_TARGETS) :  ../src/memwb.cpp   $(BDW_LIB_DEPS)
	+make --no-print-directory  $(BDW_WORKLIB)/wrappers/hl5_wrap.h
	@if [ ! -d $(BDW_WORKLIB)/modules/memwb/RADIX_4 ]; then mkdir -p $(BDW_WORKLIB)/modules/memwb/RADIX_4; fi
	
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=RADIX_4 BDW_CYNTH_CONFIG=RADIX_4 \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/memwb/RADIX_4/memwb_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/memwb/RADIX_4/memwb_rtl.cpp \
		BDW_MODULE=memwb \
		BDW_CYNTH_CONFIG=RADIX_4 \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/memwb/RADIX_4 \
		BDW_HLS_CONFIG=RADIX_4 \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/memwb/RADIX_4 \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_memwb_RADIX_4)  \
		-d $(BDW_WORKLIB)/modules/memwb/RADIX_4 -o memwb_rtl.cpp \
		--hls_module=memwb --hls_config=RADIX_4 --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_memwb_RADIX_4))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_memwb_RADIX_4))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_memwb_RADIX_4))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_memwb_RADIX_4)   \
		 ../src/memwb.cpp
	
	
	
	

else

$(BDW_memwb_RADIX_4_HLS_TARGETS) :  ../src/memwb.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.memwb.RADIX_4.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_memwb_RADIX_4_HLS_TARGETS)

endif

	
$(BDW_WORKLIB)/modules/memwb/RADIX_4/memwb_trace.h : $(BDW_WORKLIB)/modules/memwb/RADIX_4/memwb_trace.h.updated

$(BDW_WORKLIB)/modules/memwb/RADIX_4/memwb_trace.h.updated : $(BDW_WORKLIB)/modules/memwb/RADIX_4/memwb_rtl.cpp $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module memwb -cynthconfig RADIX_4  
	@touch $(BDW_WORKLIB)/modules/memwb/RADIX_4/memwb_trace.h.updated

ifeq ($(CWBExec_hlsc),1)

$(BDW_memwb_RADIX_4_HLS_SPEC_TARGETS) :  ../src/memwb.cpp   $(BDW_LIB_DEPS)
	+make --no-print-directory  $(BDW_WORKLIB)/wrappers/hl5_wrap.h
	@if [ ! -d $(BDW_WORKLIB)/modules/memwb/RADIX_4_$(*F) ]; then mkdir -p $(BDW_WORKLIB)/modules/memwb/RADIX_4_$(*F); fi
	
	
	$(subst /RADIX_4 ,/RADIX_4_$(*F) ,$(subst =RADIX_4 ,=RADIX_4_$(*F) ,$(subst /memwb/RADIX_4/,/memwb/RADIX_4_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=RADIX_4 BDW_CYNTH_CONFIG=RADIX_4 \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/memwb/RADIX_4/memwb_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/memwb/RADIX_4/memwb_rtl.cpp \
		BDW_MODULE=memwb \
		BDW_CYNTH_CONFIG=RADIX_4 \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/memwb/RADIX_4 \
		BDW_HLS_CONFIG=RADIX_4 \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/memwb/RADIX_4 \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_memwb_RADIX_4)  \
		`cat  $(BDW_SPECLIB)/memwb/RADIX_4.$(*F).bds | grep '^cmdline:' | sed 's/^cmdline://'`\
		-d $(BDW_WORKLIB)/modules/memwb/RADIX_4 -o memwb_rtl.cpp \
		--hls_module=memwb --hls_config=RADIX_4 --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_memwb_RADIX_4))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_memwb_RADIX_4))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_memwb_RADIX_4))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_memwb_RADIX_4)   \
		 ../src/memwb.cpp)))
	
	
	
	

else

$(BDW_memwb_RADIX_4_HLS_SPEC_TARGETS) :  ../src/memwb.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.memwb.RADIX_4_$(*F).s $(MAKE) -j1 CWBExec_hlsc=1 $(subst %,$(*F),$(BDW_memwb_RADIX_4_HLS_SPEC_TARGETS))

endif

	

