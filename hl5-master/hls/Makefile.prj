	@if [ ! -d $(BDW_WORKLIB)/modules/hl5/BASIC_POFF ]; then mkdir -p $(BDW_WORKLIB)/modules/hl5/BASIC_POFF; fi
	
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=BASIC_POFF BDW_CYNTH_CONFIG=BASIC_POFF \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/hl5/BASIC_POFF/hl5_rtl.v \
