	@$(MAKE) run_sim BDW_DEBUG=1 BDW_SIM_CONFIG=PIPE_SOFT_MIXED_mmult_10_GP_$(*F)  BDW_BASE_SIM_CONFIG=PIPE_SOFT_MIXED_mmult_10_GP BDW_SPEC_NAME=$(*F) RUN_DEBUGGER=1
    
ifeq ($(CWBExec_view),1)
view_PIPE_SOFT_MIXED_mmult_10_GP_%:
	@if [ -e $(subst /PIPE_SOFT_MIXED_mmult_10_GP/,/PIPE_SOFT_MIXED_mmult_10_GP_$(*F)/,$(BDW_WORKLIB)/sims/PIPE_SOFT_MIXED_mmult_10_GP/PIPE_SOFT_MIXED_mmult_10_GP.shm) ]; then \
	bdw_view_waveform -project project.tcl -simconfig PIPE_SOFT_MIXED_mmult_10_GP_$(*F) ;\
	else   \
	$(MAKE) sim_PIPE_SOFT_MIXED_mmult_10_GP_$(*F) ;\
	bdw_view_waveform -project project.tcl -simconfig PIPE_SOFT_MIXED_mmult_10_GP_$(*F) ;\
    fi
else
view_PIPE_SOFT_MIXED_mmult_10_GP_%:
	@bdw_exec -jobproject project.tcl -job view.PIPE_SOFT_MIXED_mmult_10_GP_$(*F) $(MAKE) CWBExec_view=1 view_PIPE_SOFT_MIXED_mmult_10_GP_$(*F)
endif
    



clean_PIPE_SOFT_MIXED_mmult_10_GP_%: clean_hls_PIPE_SOFT_MIXED_mmult_10_GP_% clean_sim_PIPE_SOFT_MIXED_mmult_10_GP_%

clean_sim_PIPE_SOFT_MIXED_mmult_10_GP_%:
	@rm -rf $(BDW_WORKLIB)/jobs/sim.PIPE_SOFT_MIXED_mmult_10_GP_$(*F).s
	@rm -rf $(BDW_WORKLIB)/jobs/sim.PIPE_SOFT_MIXED_mmult_10_GP_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/build.PIPE_SOFT_MIXED_mmult_10_GP_$(*F)
	@rm -f $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT1/xcelium/hl5_rtl.o $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/xcelium/fedec_rtl.o $(BDW_WORKLIB)/modules/execute/PIPE_SOFT1/xcelium/execute_rtl.o $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3/xcelium/memwb_rtl.o
	@rm -rf $(BDW_WORKLIB)/sims/PIPE_SOFT_MIXED_mmult_10_GP_$(*F) $(subst .v,_$(*F).v,$(BDW_WORKLIB)/sims/top_PIPE_SOFT_MIXED_mmult_10_GP.v) $(BDW_WORKLIB)/sims/PIPE_SOFT_MIXED_mmult_10_GP/xcelium/sim_PIPE_SOFT_MIXED_mmult_10_GP.so
	@$(MAKE) clean_sim_objs BDW_SIM_CONFIG=PIPE_SOFT_MIXED_mmult_10_GP_$(*F)  BDW_BASE_SIM_CONFIG=PIPE_SOFT_MIXED_mmult_10_GP BDW_SPEC_NAME=$(*F)



$(BDW_WORKLIB)/sims/top_PIPE_SOFT_MIXED_mmult_10_GP.v : top_v.bdt $(BDW_LOGOPTIONS_FILE) $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT1/hl5_rtl.v   $(BDW_VLOG_DUT_FILES)
	@if [ ! -d $(BDW_WRAPDIR) ]; then mkdir -p $(BDW_WRAPDIR); fi
	$(BDW_WRAPGEN_COMMAND) -project project.tcl -simconfig PIPE_SOFT_MIXED_mmult_10_GP -top top

$(subst .v,_%.v,$(BDW_WORKLIB)/sims/top_PIPE_SOFT_MIXED_mmult_10_GP.v) : top_v.bdt $(BDW_LOGOPTIONS_FILE) $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT1/hl5_rtl.v  
	@$(MAKE) `$(BDW_SPEC_FILTER) project.db $(*F) $(BDW_VLOG_DUT_FILES)`
	@if [ ! -d $(BDW_WRAPDIR) ]; then mkdir -p $(BDW_WRAPDIR); fi
	$(BDW_WRAPGEN_COMMAND) -project project.tcl -simconfig PIPE_SOFT_MIXED_mmult_10_GP_$(*F) -top top


#############################################################################
# libesc building rules
#############################################################################

ifeq ($(BDW_DEBUG),1)
libesc_WORKDIR = $(BDW_WORKLIB)/libesc/xcelium/debug
else
libesc_WORKDIR = $(BDW_WORKLIB)/libesc/xcelium
endif

BDW_ESC_SOURCES = libesc.o esc_elab.o esc_cleanup.o
BDW_ESC_OBJS = $(addprefix $(libesc_WORKDIR)/, $(BDW_ESC_SOURCES))

$(libesc_WORKDIR)/libesc.a : $(BDW_ESC_OBJS)
	$(BDW_AR) $(libesc_WORKDIR)/libesc.a $(BDW_ESC_OBJS)

${libesc_WORKDIR}/%.o   :   ${STRATUS_HOME}/share/stratus/source/%.cc 
	@if [ ! -d ${libesc_WORKDIR} ]; then mkdir -p ${libesc_WORKDIR}; fi
ifeq ($(BDW_NCSC),1)
	${BDW_CC} " ${BDW_CCFLAGS} ${BDW_COUT}$@ " $<
else
	${BDW_CC} ${BDW_CCFLAGS} ${BDW_COUT}$@ $<
endif




##############################################################
## Parts Library "./memlib"
##############################################################

memlib_SRCDIR = ./memlib
memlib_BEH_SRCDIR = $(BDW_WORKLIB)/libs/memlib
memlib_LIBNAME = memlib
memlib_WORKLIB = $(BDW_WORKLIB)/libs/memlib/xcelium
memlib_C_PARTS_A = $(memlib_WORKLIB)/objs/libmemlib.a

prep_c_memlib : $(memlib_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(memlib_WORKLIB) prep_c

prep_vlog_memlib : $(memlib_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(memlib_WORKLIB) prep_vlog

prep_memlib : $(memlib_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(memlib_WORKLIB) prep

$(memlib_WORKLIB)/Makefile : $(memlib_SRCDIR)/
	@if [ ! -d $(memlib_WORKLIB) ]; then mkdir -p $(memlib_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen  -scsim xcelium -lib $(memlib_SRCDIR) -o $(memlib_WORKLIB)/Makefile -module  -cynthconfig    -project project.tcl

$(memlib_SRCDIR)/ :
	@if [ ! -d $(memlib_WORKLIB) ]; then mkdir -p $(memlib_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi




BDW_LIBEXT_memlib=$(shell if test -f $(memlib_SRCDIR)/c_parts/memlib.cc ; then echo "cc"; else echo "cpp"; fi)

$(memlib_WORKLIB)/memlib.d : $(memlib_SRCDIR)/c_parts/memlib.$(BDW_LIBEXT_memlib)
	@if [ ! -d $(memlib_WORKLIB) ]; then mkdir -p $(memlib_WORKLIB); fi
	@set -e; $(BDW_CCDEP) -MM -MG $(BDW_CCFLAGS) $< | sed 's|memlib\.o[ :]*|memlib_DEPS = |' $(BDW_DEP_FILTER) > $@



BDW_C_LIBPREP += prep_c_memlib
BDW_C_LIBREF += $(memlib_WORKLIB)/INCA_libs/memlib_worklib
BDW_VLOG_LIBPREP += prep_vlog_memlib
BDW_BOTH_LIBPREP += prep_memlib


BDW_HLSLIB_DIRS += $(BDW_WORKLIB)/libs/memlib/xcelium
BDW_HLSLIB_NAMES += $(memlib_LIBNAME)


BDW_WHOLELIB_DIRS += $(memlib_SRCDIR)
BDW_WHOLELIB_NAMES += $(memlib_LIBNAME)



##############################################################
## Parts Library "$(BDW_WORKLIB)/wrappers/system_PIN_extract_lib"
##############################################################

system_PIN_extract_lib_SRCDIR = $(BDW_WORKLIB)/wrappers/system_PIN_extract_lib
system_PIN_extract_lib_BEH_SRCDIR = $(BDW_WORKLIB)/libs/system_PIN_extract_lib
system_PIN_extract_lib_LIBNAME = system_PIN_extract_lib
system_PIN_extract_lib_WORKLIB = $(BDW_WORKLIB)/wrappers/system_PIN_extract_lib/xcelium
system_PIN_extract_lib_C_PARTS_A = $(system_PIN_extract_lib_WORKLIB)/objs/libsystem_PIN_extract_lib.a

prep_c_system_PIN_extract_lib : $(system_PIN_extract_lib_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(system_PIN_extract_lib_WORKLIB) prep_c

prep_vlog_system_PIN_extract_lib : $(system_PIN_extract_lib_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(system_PIN_extract_lib_WORKLIB) prep_vlog

prep_system_PIN_extract_lib : $(system_PIN_extract_lib_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(system_PIN_extract_lib_WORKLIB) prep

$(system_PIN_extract_lib_WORKLIB)/Makefile : $(system_PIN_extract_lib_SRCDIR)/system_PIN_extract_lib.bdl
	@if [ ! -d $(system_PIN_extract_lib_WORKLIB) ]; then mkdir -p $(system_PIN_extract_lib_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(system_PIN_extract_lib_SRCDIR) -o $(system_PIN_extract_lib_WORKLIB)/Makefile -module  -cynthconfig    

$(system_PIN_extract_lib_SRCDIR)/system_PIN_extract_lib.bdl :
	@if [ ! -d $(system_PIN_extract_lib_WORKLIB) ]; then mkdir -p $(system_PIN_extract_lib_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi




$(system_PIN_extract_lib_WORKLIB)/system_PIN_extract_lib.d :
	@if [ ! -d $(system_PIN_extract_lib_WORKLIB) ]; then mkdir -p $(system_PIN_extract_lib_WORKLIB); fi
	@touch $(system_PIN_extract_lib_WORKLIB)/system_PIN_extract_lib.d



