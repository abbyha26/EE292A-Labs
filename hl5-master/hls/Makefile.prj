#
#	Dependency generation rule
#
$(BDW_WORKLIB)/modules/fedec/DPA/fedec.d :  ../src/fedec.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config DPA of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_fedec_DPA)  ../src/fedec.cpp \
	| sed 's|fedec\.o[ :]*|$(BDW_WORKLIB)/modules/fedec/DPA/fedec_rtl.cpp $(BDW_WORKLIB)/modules/fedec/DPA/xcelium/fedec_beh.o $(BDW_WORKLIB)/modules/fedec/DPA/xcelium/debug/fedec_beh.o $(BDW_WORKLIB)/modules/fedec/DPA/fedec.d : $(memlib_WORKLIB)/memlib.d |' $(BDW_DEP_FILTER)  > $@

#
#	Library post-proc rules
#



##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/fedec/DPA"
##############################################################

fedec_DPA_SRCDIR = $(BDW_WORKLIB)/modules/fedec/DPA
fedec_DPA_BEH_SRCDIR = $(BDW_WORKLIB)/libs/fedec_DPA
fedec_DPA_LIBNAME = fedec_DPA
fedec_DPA_WORKLIB = $(BDW_WORKLIB)/modules/fedec/DPA/xcelium
fedec_DPA_C_PARTS_A = $(fedec_DPA_WORKLIB)/objs/libfedec_DPA.a

prep_c_fedec_DPA : $(fedec_DPA_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(fedec_DPA_WORKLIB) prep_c

prep_vlog_fedec_DPA : $(fedec_DPA_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(fedec_DPA_WORKLIB) prep_vlog

prep_fedec_DPA : $(fedec_DPA_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(fedec_DPA_WORKLIB) prep

$(fedec_DPA_WORKLIB)/Makefile : $(fedec_DPA_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(fedec_DPA_WORKLIB) ]; then mkdir -p $(fedec_DPA_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(fedec_DPA_SRCDIR) -o $(fedec_DPA_WORKLIB)/Makefile -module fedec -cynthconfig DPA   

$(fedec_DPA_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(fedec_DPA_WORKLIB) ]; then mkdir -p $(fedec_DPA_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



prep_c_fedec_DPA_% : $(subst DPA,DPA_%,$(fedec_DPA_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst DPA,DPA_$(*F),$(fedec_DPA_WORKLIB)) prep_c

prep_vlog_fedec_DPA_% : $(subst DPA,DPA_%,$(fedec_DPA_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst DPA,DPA_$(*F),$(fedec_DPA_WORKLIB)) prep_vlog

prep_fedec_DPA_% : $(subst DPA,DPA_%,$(fedec_DPA_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst DPA,DPA_$(*F),$(fedec_DPA_WORKLIB)) prep

$(subst DPA,DPA_%,$(fedec_DPA_WORKLIB))/Makefile : $(fedec_DPA_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(subst DPA,DPA_$(*F),$(fedec_DPA_WORKLIB)) ]; then mkdir -p $(subst DPA,DPA_$(*F),$(fedec_DPA_WORKLIB)); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(fedec_DPA_SRCDIR)_$(*F) -o $(subst DPA,DPA_$(*F),$(fedec_DPA_WORKLIB))/Makefile -module fedec -cynthconfig DPA_$(*F)   

$(fedec_DPA_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(subst DPA,DPA_$(*F),$(fedec_DPA_WORKLIB)) ]; then mkdir -p $(subst DPA,DPA_$(*F),$(fedec_DPA_WORKLIB)); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(fedec_DPA_WORKLIB)/fedec_DPA.d :
	@if [ ! -d $(fedec_DPA_WORKLIB) ]; then mkdir -p $(fedec_DPA_WORKLIB); fi
	@touch $(fedec_DPA_WORKLIB)/fedec_DPA.d



#
# HLS config PIPE_SOFT1
#

#
#	stratus_hls rule
#
LIB_DIRS_fedec_PIPE_SOFT1 = $(memlib_SRCDIR) 
LIB_INCLUDES_fedec_PIPE_SOFT1 = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_fedec_PIPE_SOFT1))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_fedec_PIPE_SOFT1 = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_fedec_PIPE_SOFT1 = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_fedec_PIPE_SOFT1 = 
EXTRACT_LIB_DASHI_fedec_PIPE_SOFT1 = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl fedec PIPE_SOFT1]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_fedec_PIPE_SOFT1 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/c_parts -DPIPE_SOFT1=1 -DBDW_RTL_fedec_PIPE_SOFT1=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DPIPE_SOFT_STALL1=1 $(LIB_INCLUDES_fedec_PIPE_SOFT1)
CCFLAGS_COSIM_fedec_PIPE_SOFT1 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/c_parts -DPIPE_SOFT1=1 -DBDW_RTL_fedec_PIPE_SOFT1=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DPIPE_SOFT_STALL1=1 $(LIB_INCLUDES_fedec_PIPE_SOFT1)
CCFLAGS_BEH_fedec_PIPE_SOFT1 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT1/c_parts -DPIPE_SOFT1=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DPIPE_SOFT_STALL1=1 $(LIB_INCLUDES_fedec_PIPE_SOFT1)
CCFLAGS_fedec_PIPE_SOFT1 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_fedec_PIPE_SOFT1 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_fedec_PIPE_SOFT1 += ${BDW_CCFLAGS_TAIL}

