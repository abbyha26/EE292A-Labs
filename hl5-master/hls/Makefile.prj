ifneq (hls_fedec_DPA hls_execute_DPA hls_memwb_DPA hls_hl5_DPA,)
	@$(MAKE)  $(addprefix clean_, hls_fedec_DPA hls_execute_DPA hls_memwb_DPA hls_hl5_DPA)
endif

