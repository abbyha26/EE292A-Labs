#

$(BDW_WORKLIB)/modules/execute/BASIC_POFF/xcelium/execute.o :  ../src/execute.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/execute_cosim.h $(BDW_WORKLIB)/wrappers/execute_trace.h
