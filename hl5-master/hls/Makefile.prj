	@if [ ! -d $(fedec_PIPE_SOFT2_WORKLIB) ]; then mkdir -p $(fedec_PIPE_SOFT2_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(fedec_PIPE_SOFT2_SRCDIR) -o $(fedec_PIPE_SOFT2_WORKLIB)/Makefile -module fedec -cynthconfig PIPE_SOFT2   

$(fedec_PIPE_SOFT2_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(fedec_PIPE_SOFT2_WORKLIB) ]; then mkdir -p $(fedec_PIPE_SOFT2_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



