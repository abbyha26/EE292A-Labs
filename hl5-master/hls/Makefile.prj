sched_memwb_PIPE_SOFT3_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(subst /PIPE_SOFT3/,/PIPE_SOFT3_$(*F)/,$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3/stratus_hls.bdr)

hlsc_memwb_PIPE_SOFT3_% hls_memwb_PIPE_SOFT3_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /PIPE_SOFT3/,/PIPE_SOFT3_$(*F)/,$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3/memwb_rtl.cpp) BDW_DEP_CYNTH_CONFIG=PIPE_SOFT3 BDW_MODULE=memwb BDW_HLS_CONFIG=PIPE_SOFT3_$(*F) 
else
	@bdw_exec -jobproject project.tcl -job hls.memwb.PIPE_SOFT3_$(*F) $(MAKE) CWBExec_hls=1 hlsc_memwb_PIPE_SOFT3_$(*F)
