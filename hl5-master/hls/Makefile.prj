	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl hl5`
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/BASIC/ -I./ $(CCFLAGS_hl5_BASIC) $(EXTRACT_LIB_DASHI_hl5_BASIC) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/hl5/BASIC/xcelium/debug/hl5_rtl.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp

