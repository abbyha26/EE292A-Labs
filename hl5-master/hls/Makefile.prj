	@$(MAKE)  $(BDW_WORKLIB)/wrappers/execute_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl execute`
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/execute/PIN/ -I./ $(CCFLAGS_execute_PIN) $(EXTRACT_LIB_DASHI_execute_PIN) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/execute/PIN/xcelium/execute_rtl.o " $(BDW_WORKLIB)/wrappers/execute_wrap.cpp

