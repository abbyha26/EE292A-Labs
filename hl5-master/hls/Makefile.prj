$(subst /BASIC_POFF/,/BASIC_POFF$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/hl5/BASIC_POFF/xcelium/debug/hl5_hoist.o) :  ../src/hl5.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(subst /BASIC_POFF/,/BASIC_POFF$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/hl5_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /BASIC_POFF/,/BASIC_POFF$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/BASIC_POFF/ -I./ $(CCFLAGS_hl5_BASIC_POFF) $(EXTRACT_LIB_DASHI_hl5_BASIC_POFF) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/hl5/BASIC_POFF/xcelium/debug/hl5_hoist.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp)
    
endif

#
#	Dependency generation rule
#
$(BDW_WORKLIB)/modules/hl5/BASIC_POFF/hl5.d :  ../src/hl5.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config BASIC_POFF of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_hl5_BASIC_POFF)  ../src/hl5.cpp \
	| sed 's|hl5\.o[ :]*|$(BDW_WORKLIB)/modules/hl5/BASIC_POFF/hl5_rtl.cpp $(BDW_WORKLIB)/modules/hl5/BASIC_POFF/xcelium/hl5_beh.o $(BDW_WORKLIB)/modules/hl5/BASIC_POFF/xcelium/debug/hl5_beh.o $(BDW_WORKLIB)/modules/hl5/BASIC_POFF/hl5.d : $(memlib_WORKLIB)/memlib.d |' $(BDW_DEP_FILTER)  > $@

#
#	Library post-proc rules
#



##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/hl5/BASIC_POFF"
##############################################################

hl5_BASIC_POFF_SRCDIR = $(BDW_WORKLIB)/modules/hl5/BASIC_POFF
hl5_BASIC_POFF_BEH_SRCDIR = $(BDW_WORKLIB)/libs/hl5_BASIC_POFF
hl5_BASIC_POFF_LIBNAME = hl5_BASIC_POFF
hl5_BASIC_POFF_WORKLIB = $(BDW_WORKLIB)/modules/hl5/BASIC_POFF/xcelium
hl5_BASIC_POFF_C_PARTS_A = $(hl5_BASIC_POFF_WORKLIB)/objs/libhl5_BASIC_POFF.a

prep_c_hl5_BASIC_POFF : $(hl5_BASIC_POFF_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(hl5_BASIC_POFF_WORKLIB) prep_c

prep_vlog_hl5_BASIC_POFF : $(hl5_BASIC_POFF_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(hl5_BASIC_POFF_WORKLIB) prep_vlog

prep_hl5_BASIC_POFF : $(hl5_BASIC_POFF_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(hl5_BASIC_POFF_WORKLIB) prep

$(hl5_BASIC_POFF_WORKLIB)/Makefile : $(hl5_BASIC_POFF_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(hl5_BASIC_POFF_WORKLIB) ]; then mkdir -p $(hl5_BASIC_POFF_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(hl5_BASIC_POFF_SRCDIR) -o $(hl5_BASIC_POFF_WORKLIB)/Makefile -module hl5 -cynthconfig BASIC_POFF   

$(hl5_BASIC_POFF_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(hl5_BASIC_POFF_WORKLIB) ]; then mkdir -p $(hl5_BASIC_POFF_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



prep_c_hl5_BASIC_POFF_% : $(subst BASIC_POFF,BASIC_POFF_%,$(hl5_BASIC_POFF_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst BASIC_POFF,BASIC_POFF_$(*F),$(hl5_BASIC_POFF_WORKLIB)) prep_c

prep_vlog_hl5_BASIC_POFF_% : $(subst BASIC_POFF,BASIC_POFF_%,$(hl5_BASIC_POFF_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst BASIC_POFF,BASIC_POFF_$(*F),$(hl5_BASIC_POFF_WORKLIB)) prep_vlog

prep_hl5_BASIC_POFF_% : $(subst BASIC_POFF,BASIC_POFF_%,$(hl5_BASIC_POFF_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst BASIC_POFF,BASIC_POFF_$(*F),$(hl5_BASIC_POFF_WORKLIB)) prep

$(subst BASIC_POFF,BASIC_POFF_%,$(hl5_BASIC_POFF_WORKLIB))/Makefile : $(hl5_BASIC_POFF_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(subst BASIC_POFF,BASIC_POFF_$(*F),$(hl5_BASIC_POFF_WORKLIB)) ]; then mkdir -p $(subst BASIC_POFF,BASIC_POFF_$(*F),$(hl5_BASIC_POFF_WORKLIB)); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(hl5_BASIC_POFF_SRCDIR)_$(*F) -o $(subst BASIC_POFF,BASIC_POFF_$(*F),$(hl5_BASIC_POFF_WORKLIB))/Makefile -module hl5 -cynthconfig BASIC_POFF_$(*F)   

$(hl5_BASIC_POFF_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(subst BASIC_POFF,BASIC_POFF_$(*F),$(hl5_BASIC_POFF_WORKLIB)) ]; then mkdir -p $(subst BASIC_POFF,BASIC_POFF_$(*F),$(hl5_BASIC_POFF_WORKLIB)); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(hl5_BASIC_POFF_WORKLIB)/hl5_BASIC_POFF.d :
	@if [ ! -d $(hl5_BASIC_POFF_WORKLIB) ]; then mkdir -p $(hl5_BASIC_POFF_WORKLIB); fi
	@touch $(hl5_BASIC_POFF_WORKLIB)/hl5_BASIC_POFF.d



#
# HLS config DPA
#

#
#	stratus_hls rule
#
LIB_DIRS_hl5_DPA = $(memlib_SRCDIR) 
LIB_INCLUDES_hl5_DPA = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_hl5_DPA))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_hl5_DPA = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_hl5_DPA = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_hl5_DPA = 
EXTRACT_LIB_DASHI_hl5_DPA = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl hl5 DPA]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_hl5_DPA = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/hl5/DPA/c_parts -DDPA=1 -DBDW_RTL_hl5_DPA=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_hl5_DPA)
CCFLAGS_COSIM_hl5_DPA = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/hl5/DPA/c_parts -DDPA=1 -DBDW_RTL_hl5_DPA=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_hl5_DPA)
CCFLAGS_BEH_hl5_DPA = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/hl5/DPA/c_parts -DDPA=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_hl5_DPA)
CCFLAGS_hl5_DPA += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_hl5_DPA += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_hl5_DPA += ${BDW_CCFLAGS_TAIL}

.PHONY: hlsc_hl5_DPA hls_hl5_DPA

hls_hl5_DPA : hlsc_hl5_DPA

cynth_hl5_DPA : hlsc_hl5_DPA

elab_hl5_DPA : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/hl5/DPA/stratus_hls.bdr

optim_hl5_DPA : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/hl5/DPA/stratus_hls.bdr

sched_hl5_DPA : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/hl5/DPA/stratus_hls.bdr

hlsc_hl5_DPA : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/hl5/DPA/hl5_rtl.cpp BDW_DEP_CYNTH_CONFIG=DPA BDW_MODULE=hl5 BDW_HLS_CONFIG=DPA 
else
	@bdw_exec -jobproject project.tcl -job hls.hl5.DPA $(MAKE) CWBExec_hls=1 hlsc_hl5_DPA
endif

clean_cynth_hl5_DPA: clean_hls_hl5_DPA

clean_hl5_DPA: clean_hls_hl5_DPA

clean_hls_hl5_DPA:
	@rm -rf $(BDW_WORKLIB)/modules/hl5/DPA
	@rm -rf $(BDW_WORKLIB)/jobs/hls.hl5.DPA
	@rm -rf $(BDW_WORKLIB)/jobs/hls.hl5.DPA.s

kill_hls_hl5_DPA:
	@bdw_kill -job hls.hl5.DPA
	@bdw_kill -job hls.hl5.DPA.s


hls_hl5_DPA_% : hlsc_hl5_DPA_%

cynth_hl5_DPA_% : hlsc_hl5_DPA_%

elab_hl5_DPA_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(subst /DPA/,/DPA_$(*F)/,$(BDW_WORKLIB)/modules/hl5/DPA/stratus_hls.bdr)

optim_hl5_DPA_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(subst /DPA/,/DPA_$(*F)/,$(BDW_WORKLIB)/modules/hl5/DPA/stratus_hls.bdr)

sched_hl5_DPA_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(subst /DPA/,/DPA_$(*F)/,$(BDW_WORKLIB)/modules/hl5/DPA/stratus_hls.bdr)

hlsc_hl5_DPA_% hls_hl5_DPA_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /DPA/,/DPA_$(*F)/,$(BDW_WORKLIB)/modules/hl5/DPA/hl5_rtl.cpp) BDW_DEP_CYNTH_CONFIG=DPA BDW_MODULE=hl5 BDW_HLS_CONFIG=DPA_$(*F) 
else
	@bdw_exec -jobproject project.tcl -job hls.hl5.DPA_$(*F) $(MAKE) CWBExec_hls=1 hlsc_hl5_DPA_$(*F)
endif

clean_cynth_hl5_DPA_%: clean_hls_hl5_DPA_%

clean_hl5_DPA_%: clean_hls_hl5_DPA_%

clean_hls_hl5_DPA_%:
	@rm -rf $(BDW_WORKLIB)/modules/hl5/DPA_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.hl5.DPA_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.hl5.DPA_$(*F).s

kill_hls_hl5_DPA_%:
	@bdw_kill -job hls.hl5.DPA_$(*F)
	@bdw_kill -job hls.hl5.DPA_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),DPA)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/hl5/DPA/hl5.d
                -include $(memlib_WORKLIB)/memlib.d
                BDW_LIB_DEPS =  $(memlib_DEPS)
            endif
        endif
    endif
endif


html_hl5_DPA :
	bdw_htmlgen -project project.tcl -module hl5 -cynthconfig DPA

BDW_hl5_DPA_HLS_TARGETS := $(BDW_WORKLIB)/modules/hl5/DPA/hl5_rtl.cpp $(BDW_WORKLIB)/modules/hl5/DPA/hl5_rtl.v $(BDW_WORKLIB)/modules/hl5/DPA/stratus_hls.bdr
ifeq ($(BDW_BDR_ONLY),1)
.PHONY: $(filter %.bdr %.cpp,$(BDW_hl5_DPA_HLS_TARGETS))
$(filter %.v %.cpp,$(BDW_hl5_DPA_HLS_TARGETS)) : $(filter %.bdr,$(BDW_hl5_DPA_HLS_TARGETS))
BDW_hl5_DPA_HLS_TARGETS := $(filter %.bdr,$(BDW_hl5_DPA_HLS_TARGETS))
endif
BDW_hl5_DPA_HLS_SPEC_TARGETS = $(subst /DPA/,/DPA_%/,$(BDW_hl5_DPA_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_hl5_DPA_HLS_TARGETS) :  ../src/hl5.cpp  $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/memwb_wrap.h  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/hl5/DPA ]; then mkdir -p $(BDW_WORKLIB)/modules/hl5/DPA; fi
	
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=DPA BDW_CYNTH_CONFIG=DPA \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/hl5/DPA/hl5_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/hl5/DPA/hl5_rtl.cpp \
		BDW_MODULE=hl5 \
		BDW_CYNTH_CONFIG=DPA \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/hl5/DPA \
		BDW_HLS_CONFIG=DPA \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/hl5/DPA \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_hl5_DPA)  \
		-d $(BDW_WORKLIB)/modules/hl5/DPA -o hl5_rtl.cpp \
		--hls_module=hl5 --hls_config=DPA --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_hl5_DPA))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_hl5_DPA))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_hl5_DPA))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_hl5_DPA)   \
		 ../src/hl5.cpp
	
	
	
	

else

$(BDW_hl5_DPA_HLS_TARGETS) :  ../src/hl5.cpp  $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.hl5.DPA.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_hl5_DPA_HLS_TARGETS)

endif

	
$(BDW_WORKLIB)/modules/hl5/DPA/hl5_trace.h : $(BDW_WORKLIB)/modules/hl5/DPA/hl5_trace.h.updated

$(BDW_WORKLIB)/modules/hl5/DPA/hl5_trace.h.updated : $(BDW_WORKLIB)/modules/hl5/DPA/hl5_rtl.cpp $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module hl5 -cynthconfig DPA  
	@touch $(BDW_WORKLIB)/modules/hl5/DPA/hl5_trace.h.updated

ifeq ($(CWBExec_hlsc),1)

$(BDW_hl5_DPA_HLS_SPEC_TARGETS) :  ../src/hl5.cpp  $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/memwb_wrap.h  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/hl5/DPA_$(*F) ]; then mkdir -p $(BDW_WORKLIB)/modules/hl5/DPA_$(*F); fi
	
	
	$(subst /DPA ,/DPA_$(*F) ,$(subst =DPA ,=DPA_$(*F) ,$(subst /hl5/DPA/,/hl5/DPA_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=DPA BDW_CYNTH_CONFIG=DPA \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/hl5/DPA/hl5_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/hl5/DPA/hl5_rtl.cpp \
		BDW_MODULE=hl5 \
		BDW_CYNTH_CONFIG=DPA \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/hl5/DPA \
		BDW_HLS_CONFIG=DPA \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/hl5/DPA \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_hl5_DPA)  \
		`cat  $(BDW_SPECLIB)/hl5/DPA.$(*F).bds | grep '^cmdline:' | sed 's/^cmdline://'`\
		-d $(BDW_WORKLIB)/modules/hl5/DPA -o hl5_rtl.cpp \
		--hls_module=hl5 --hls_config=DPA --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_hl5_DPA))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_hl5_DPA))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_hl5_DPA))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_hl5_DPA)   \
		 ../src/hl5.cpp)))
	
	
	
	

else

$(BDW_hl5_DPA_HLS_SPEC_TARGETS) :  ../src/hl5.cpp  $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.hl5.DPA_$(*F).s $(MAKE) -j1 CWBExec_hlsc=1 $(subst %,$(*F),$(BDW_hl5_DPA_HLS_SPEC_TARGETS))

endif

	

$(subst /DPA/,/DPA_%/,$(BDW_WORKLIB)/modules/hl5/DPA/hl5_trace.h) : $(subst /DPA/,/DPA_%/,$(BDW_WORKLIB)/modules/hl5/DPA/hl5_rtl.cpp) $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module hl5 -cynthconfig DPA_$(*F)  

catHLLog_hl5_DPA:
	cat $(BDW_WORKLIB)/modules/hl5/DPA/stratus_hls.log

#
#	stratus_vlg rule
#
cynthvlg_hl5_DPA : hls_hl5_DPA 


.PHONY: hls_hl5_DPA

hls_hl5_DPA hlsv_hl5_DPA: $(addprefix prep_vlog_,$(LIB_NAMES_FOR_VLOG_hl5_DPA)) 

.PHONY: hls_hl5_DPA

hls_hl5_DPA_% hlsv_hl5_DPA_%: $(addprefix prep_vlog_,$(LIB_NAMES_FOR_VLOG_hl5_DPA)) 

catVLGLog_hl5_DPA : catHLLog_hl5_DPA
	cat $(BDW_WORKLIB)/modules/hl5/DPA/stratus_vlg.log

#
#	view rule
#

view_hl5_DPA:
	@echo "ERROR: Schematic viewing target 'view_hl5_DPA' is only supported with 'verdi'"
	@echo "The Stratus IDE includes a schematic view as an alternative."


#
#	RTL object file rule
#
$(BDW_WORKLIB)/modules/hl5/DPA/xcelium/hl5_rtl.o : $(BDW_WORKLIB)/modules/hl5/DPA/hl5_rtl.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(BDW_WORKLIB)/modules/hl5/DPA/hl5_trace.h
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl hl5`
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/DPA/ -I./ $(CCFLAGS_hl5_DPA) $(EXTRACT_LIB_DASHI_hl5_DPA) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/hl5/DPA/xcelium/hl5_rtl.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp

$(BDW_WORKLIB)/modules/hl5/DPA/xcelium/debug/hl5_rtl.o : $(BDW_WORKLIB)/modules/hl5/DPA/hl5_rtl.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(BDW_WORKLIB)/modules/hl5/DPA/hl5_trace.h
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl hl5`
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/DPA/ -I./ $(CCFLAGS_hl5_DPA) $(EXTRACT_LIB_DASHI_hl5_DPA) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/hl5/DPA/xcelium/debug/hl5_rtl.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp

#
#	Behavioral object file rule.  Used only for BEH configs that are 
#	associated with HLS config names.
#

$(BDW_WORKLIB)/modules/hl5/DPA/xcelium/hl5_beh.o :  ../src/hl5.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.h $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(BDW_WORKLIB)/wrappers/hl5_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/DPA/ -I./ $(CCFLAGS_BEH_hl5_DPA) -o $(BDW_WORKLIB)/modules/hl5/DPA/xcelium/hl5_beh.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp

$(BDW_WORKLIB)/modules/hl5/DPA/xcelium/debug/hl5_beh.o :  ../src/hl5.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.h $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(BDW_WORKLIB)/wrappers/hl5_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/DPA/ -I./ $(CCFLAGS_BEH_hl5_DPA) -o $(BDW_WORKLIB)/modules/hl5/DPA/xcelium/debug/hl5_beh.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp

#
# Cosim object file rule
#

$(BDW_WORKLIB)/modules/hl5/DPA/xcelium/hl5.o :  ../src/hl5.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.h $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(BDW_WORKLIB)/wrappers/hl5_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/DPA/ -I./ $(CCFLAGS_COSIM_hl5_DPA) -o $(BDW_WORKLIB)/modules/hl5/DPA/xcelium/hl5.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp
    

$(BDW_WORKLIB)/modules/hl5/DPA/xcelium/hl5_hoist.o :  ../src/hl5.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(BDW_WORKLIB)/wrappers/hl5_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/DPA/ -I./ $(CCFLAGS_hl5_DPA) $(EXTRACT_LIB_DASHI_hl5_DPA) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/hl5/DPA/xcelium/hl5_hoist.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp
    

$(BDW_WORKLIB)/modules/hl5/DPA/xcelium/debug/hl5.o :  ../src/hl5.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.h $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(BDW_WORKLIB)/wrappers/hl5_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/DPA/ -I./ $(CCFLAGS_COSIM_hl5_DPA) -o $(BDW_WORKLIB)/modules/hl5/DPA/xcelium/debug/hl5.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp


$(BDW_WORKLIB)/modules/hl5/DPA/xcelium/debug/hl5_hoist.o :  ../src/hl5.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(BDW_WORKLIB)/wrappers/hl5_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/DPA/ -I./ $(CCFLAGS_hl5_DPA) $(EXTRACT_LIB_DASHI_hl5_DPA) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/hl5/DPA/xcelium/debug/hl5_hoist.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp
    

view_hl5_DPA_%:
	@echo "ERROR: Schematic viewing target 'view_hl5_DPA_$(*F)' is only supported with 'verdi'"
	@echo "The Stratus IDE includes a schematic view as an alternative."

ifneq ($(BDW_SPEC_NAME),)
#
#	RTL object file rule
#
$(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/hl5/DPA/xcelium/hl5_rtl.o) : $(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/hl5/DPA/hl5_rtl.cpp) $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/hl5/DPA/hl5_trace.h)
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl hl5`
	$(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/DPA/ -I./ $(CCFLAGS_hl5_DPA) $(EXTRACT_LIB_DASHI_hl5_DPA) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/hl5/DPA/xcelium/hl5_rtl.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp)

$(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/hl5/DPA/xcelium/debug/hl5_rtl.o) : $(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/hl5/DPA/hl5_rtl.cpp) $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/hl5/DPA/hl5_trace.h)
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl hl5`
	$(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/DPA/ -I./ $(CCFLAGS_hl5_DPA) $(EXTRACT_LIB_DASHI_hl5_DPA) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/hl5/DPA/xcelium/debug/hl5_rtl.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp)

#
#	Behavioral object file rule.  Used only for BEH configs that are 
#	associated with HLS config names.
#

$(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/hl5/DPA/xcelium/hl5_beh.o) :  ../src/hl5.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.h $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/hl5_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/DPA/ -I./ $(CCFLAGS_BEH_hl5_DPA) -o $(BDW_WORKLIB)/modules/hl5/DPA/xcelium/hl5_beh.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp)

$(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/hl5/DPA/xcelium/debug/hl5_beh.o) :  ../src/hl5.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.h $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/hl5_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/DPA/ -I./ $(CCFLAGS_BEH_hl5_DPA) -o $(BDW_WORKLIB)/modules/hl5/DPA/xcelium/debug/hl5_beh.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp)

#
# Cosim object file rule
#

$(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/hl5/DPA/xcelium/hl5.o) :  ../src/hl5.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.h $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/hl5_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/DPA/ -I./ $(CCFLAGS_COSIM_hl5_DPA) -o $(BDW_WORKLIB)/modules/hl5/DPA/xcelium/hl5.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp)
    

$(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/hl5/DPA/xcelium/hl5_hoist.o) :  ../src/hl5.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/hl5_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/DPA/ -I./ $(CCFLAGS_hl5_DPA) $(EXTRACT_LIB_DASHI_hl5_DPA) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/hl5/DPA/xcelium/hl5_hoist.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp)
    

$(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/hl5/DPA/xcelium/debug/hl5.o) :  ../src/hl5.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.h $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/hl5_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/DPA/ -I./ $(CCFLAGS_COSIM_hl5_DPA) -o $(BDW_WORKLIB)/modules/hl5/DPA/xcelium/debug/hl5.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp)


$(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/hl5/DPA/xcelium/debug/hl5_hoist.o) :  ../src/hl5.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/hl5_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/DPA/ -I./ $(CCFLAGS_hl5_DPA) $(EXTRACT_LIB_DASHI_hl5_DPA) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/hl5/DPA/xcelium/debug/hl5_hoist.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp)
    
endif

#
#	Dependency generation rule
#
$(BDW_WORKLIB)/modules/hl5/DPA/hl5.d :  ../src/hl5.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config DPA of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_hl5_DPA)  ../src/hl5.cpp \
	| sed 's|hl5\.o[ :]*|$(BDW_WORKLIB)/modules/hl5/DPA/hl5_rtl.cpp $(BDW_WORKLIB)/modules/hl5/DPA/xcelium/hl5_beh.o $(BDW_WORKLIB)/modules/hl5/DPA/xcelium/debug/hl5_beh.o $(BDW_WORKLIB)/modules/hl5/DPA/hl5.d : $(memlib_WORKLIB)/memlib.d |' $(BDW_DEP_FILTER)  > $@

#
#	Library post-proc rules
#



##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/hl5/DPA"
##############################################################

hl5_DPA_SRCDIR = $(BDW_WORKLIB)/modules/hl5/DPA
hl5_DPA_BEH_SRCDIR = $(BDW_WORKLIB)/libs/hl5_DPA
hl5_DPA_LIBNAME = hl5_DPA
hl5_DPA_WORKLIB = $(BDW_WORKLIB)/modules/hl5/DPA/xcelium
hl5_DPA_C_PARTS_A = $(hl5_DPA_WORKLIB)/objs/libhl5_DPA.a

prep_c_hl5_DPA : $(hl5_DPA_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(hl5_DPA_WORKLIB) prep_c

prep_vlog_hl5_DPA : $(hl5_DPA_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(hl5_DPA_WORKLIB) prep_vlog

prep_hl5_DPA : $(hl5_DPA_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(hl5_DPA_WORKLIB) prep

$(hl5_DPA_WORKLIB)/Makefile : $(hl5_DPA_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(hl5_DPA_WORKLIB) ]; then mkdir -p $(hl5_DPA_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(hl5_DPA_SRCDIR) -o $(hl5_DPA_WORKLIB)/Makefile -module hl5 -cynthconfig DPA   

$(hl5_DPA_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(hl5_DPA_WORKLIB) ]; then mkdir -p $(hl5_DPA_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



prep_c_hl5_DPA_% : $(subst DPA,DPA_%,$(hl5_DPA_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst DPA,DPA_$(*F),$(hl5_DPA_WORKLIB)) prep_c

prep_vlog_hl5_DPA_% : $(subst DPA,DPA_%,$(hl5_DPA_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst DPA,DPA_$(*F),$(hl5_DPA_WORKLIB)) prep_vlog

prep_hl5_DPA_% : $(subst DPA,DPA_%,$(hl5_DPA_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst DPA,DPA_$(*F),$(hl5_DPA_WORKLIB)) prep

$(subst DPA,DPA_%,$(hl5_DPA_WORKLIB))/Makefile : $(hl5_DPA_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(subst DPA,DPA_$(*F),$(hl5_DPA_WORKLIB)) ]; then mkdir -p $(subst DPA,DPA_$(*F),$(hl5_DPA_WORKLIB)); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(hl5_DPA_SRCDIR)_$(*F) -o $(subst DPA,DPA_$(*F),$(hl5_DPA_WORKLIB))/Makefile -module hl5 -cynthconfig DPA_$(*F)   

$(hl5_DPA_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(subst DPA,DPA_$(*F),$(hl5_DPA_WORKLIB)) ]; then mkdir -p $(subst DPA,DPA_$(*F),$(hl5_DPA_WORKLIB)); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(hl5_DPA_WORKLIB)/hl5_DPA.d :
	@if [ ! -d $(hl5_DPA_WORKLIB) ]; then mkdir -p $(hl5_DPA_WORKLIB); fi
	@touch $(hl5_DPA_WORKLIB)/hl5_DPA.d



#
# HLS config PIPE_SOFT1
#

#
#	stratus_hls rule
#
LIB_DIRS_hl5_PIPE_SOFT1 = $(memlib_SRCDIR) 
LIB_INCLUDES_hl5_PIPE_SOFT1 = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_hl5_PIPE_SOFT1))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_hl5_PIPE_SOFT1 = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_hl5_PIPE_SOFT1 = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_hl5_PIPE_SOFT1 = 
EXTRACT_LIB_DASHI_hl5_PIPE_SOFT1 = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl hl5 PIPE_SOFT1]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_hl5_PIPE_SOFT1 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT1/c_parts -DPIPE_SOFT1=1 -DBDW_RTL_hl5_PIPE_SOFT1=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DPIPE_SOFT_STALL1=1 $(LIB_INCLUDES_hl5_PIPE_SOFT1)
CCFLAGS_COSIM_hl5_PIPE_SOFT1 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT1/c_parts -DPIPE_SOFT1=1 -DBDW_RTL_hl5_PIPE_SOFT1=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DPIPE_SOFT_STALL1=1 $(LIB_INCLUDES_hl5_PIPE_SOFT1)
CCFLAGS_BEH_hl5_PIPE_SOFT1 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT1/c_parts -DPIPE_SOFT1=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DPIPE_SOFT_STALL1=1 $(LIB_INCLUDES_hl5_PIPE_SOFT1)
CCFLAGS_hl5_PIPE_SOFT1 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_hl5_PIPE_SOFT1 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_hl5_PIPE_SOFT1 += ${BDW_CCFLAGS_TAIL}

.PHONY: hlsc_hl5_PIPE_SOFT1 hls_hl5_PIPE_SOFT1

hls_hl5_PIPE_SOFT1 : hlsc_hl5_PIPE_SOFT1

cynth_hl5_PIPE_SOFT1 : hlsc_hl5_PIPE_SOFT1

elab_hl5_PIPE_SOFT1 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT1/stratus_hls.bdr

optim_hl5_PIPE_SOFT1 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT1/stratus_hls.bdr

sched_hl5_PIPE_SOFT1 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT1/stratus_hls.bdr

hlsc_hl5_PIPE_SOFT1 : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT1/hl5_rtl.cpp BDW_DEP_CYNTH_CONFIG=PIPE_SOFT1 BDW_MODULE=hl5 BDW_HLS_CONFIG=PIPE_SOFT1 
else
	@bdw_exec -jobproject project.tcl -job hls.hl5.PIPE_SOFT1 $(MAKE) CWBExec_hls=1 hlsc_hl5_PIPE_SOFT1
endif

clean_cynth_hl5_PIPE_SOFT1: clean_hls_hl5_PIPE_SOFT1

clean_hl5_PIPE_SOFT1: clean_hls_hl5_PIPE_SOFT1

clean_hls_hl5_PIPE_SOFT1:
	@rm -rf $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT1
	@rm -rf $(BDW_WORKLIB)/jobs/hls.hl5.PIPE_SOFT1
	@rm -rf $(BDW_WORKLIB)/jobs/hls.hl5.PIPE_SOFT1.s

kill_hls_hl5_PIPE_SOFT1:
	@bdw_kill -job hls.hl5.PIPE_SOFT1
	@bdw_kill -job hls.hl5.PIPE_SOFT1.s


hls_hl5_PIPE_SOFT1_% : hlsc_hl5_PIPE_SOFT1_%

cynth_hl5_PIPE_SOFT1_% : hlsc_hl5_PIPE_SOFT1_%

elab_hl5_PIPE_SOFT1_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(subst /PIPE_SOFT1/,/PIPE_SOFT1_$(*F)/,$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT1/stratus_hls.bdr)

optim_hl5_PIPE_SOFT1_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(subst /PIPE_SOFT1/,/PIPE_SOFT1_$(*F)/,$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT1/stratus_hls.bdr)

sched_hl5_PIPE_SOFT1_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(subst /PIPE_SOFT1/,/PIPE_SOFT1_$(*F)/,$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT1/stratus_hls.bdr)

hlsc_hl5_PIPE_SOFT1_% hls_hl5_PIPE_SOFT1_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /PIPE_SOFT1/,/PIPE_SOFT1_$(*F)/,$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT1/hl5_rtl.cpp) BDW_DEP_CYNTH_CONFIG=PIPE_SOFT1 BDW_MODULE=hl5 BDW_HLS_CONFIG=PIPE_SOFT1_$(*F) 
else
	@bdw_exec -jobproject project.tcl -job hls.hl5.PIPE_SOFT1_$(*F) $(MAKE) CWBExec_hls=1 hlsc_hl5_PIPE_SOFT1_$(*F)
endif

clean_cynth_hl5_PIPE_SOFT1_%: clean_hls_hl5_PIPE_SOFT1_%

clean_hl5_PIPE_SOFT1_%: clean_hls_hl5_PIPE_SOFT1_%

clean_hls_hl5_PIPE_SOFT1_%:
	@rm -rf $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT1_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.hl5.PIPE_SOFT1_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.hl5.PIPE_SOFT1_$(*F).s

kill_hls_hl5_PIPE_SOFT1_%:
	@bdw_kill -job hls.hl5.PIPE_SOFT1_$(*F)
	@bdw_kill -job hls.hl5.PIPE_SOFT1_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),PIPE_SOFT1)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT1/hl5.d
                -include $(memlib_WORKLIB)/memlib.d
                BDW_LIB_DEPS =  $(memlib_DEPS)
            endif
        endif
    endif
endif


html_hl5_PIPE_SOFT1 :
	bdw_htmlgen -project project.tcl -module hl5 -cynthconfig PIPE_SOFT1

BDW_hl5_PIPE_SOFT1_HLS_TARGETS := $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT1/hl5_rtl.cpp $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT1/hl5_rtl.v $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT1/stratus_hls.bdr
ifeq ($(BDW_BDR_ONLY),1)
.PHONY: $(filter %.bdr %.cpp,$(BDW_hl5_PIPE_SOFT1_HLS_TARGETS))
$(filter %.v %.cpp,$(BDW_hl5_PIPE_SOFT1_HLS_TARGETS)) : $(filter %.bdr,$(BDW_hl5_PIPE_SOFT1_HLS_TARGETS))
BDW_hl5_PIPE_SOFT1_HLS_TARGETS := $(filter %.bdr,$(BDW_hl5_PIPE_SOFT1_HLS_TARGETS))
endif
BDW_hl5_PIPE_SOFT1_HLS_SPEC_TARGETS = $(subst /PIPE_SOFT1/,/PIPE_SOFT1_%/,$(BDW_hl5_PIPE_SOFT1_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_hl5_PIPE_SOFT1_HLS_TARGETS) :  ../src/hl5.cpp  $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/memwb_wrap.h  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT1 ]; then mkdir -p $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT1; fi
	
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=PIPE_SOFT1 BDW_CYNTH_CONFIG=PIPE_SOFT1 \
