	$(subst /PIPE_SOFT2/,/PIPE_SOFT2$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/ -I./ $(CCFLAGS_memwb_PIPE_SOFT2) $(EXTRACT_LIB_DASHI_memwb_PIPE_SOFT2) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/xcelium/memwb_rtl.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp)

