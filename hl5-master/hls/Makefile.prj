clean_wrap_all:
	@rm -fr $(BDW_WORKLIB)/wrappers

clean_spec_%:
	@$(BDW_SPEC_CLEAN) $(*F) -prefix

delete_spec_%:
	@$(BDW_SPEC_DELETE) $(*F) -prefix

kill_all: 
	@bdw_kill -all


clean_cachelib:
	@rm -rf /hls/users/skanchi/Stanford/cynthApps/Forte/columbia_RSICV/hl5-master/hls/cachelib

clean_all:
	@if [ -d $(BDW_WORKLIB) ] ; then \
		td=`mktemp -d $(BDW_WORKLIB).XXXXXXXX` ; \
		mv $(BDW_WORKLIB) $${td} ; \
		for f in *.vcd *.fsdb ; do \
			if [ -f $$f ] ; then \
				mv $$f $${td} ; \
			fi ; \
		done ; \
		rm -rf $${td} & \
	fi

