	@rm -rf $(BDW_WORKLIB)/jobs/hls.memwb.RADIX_2
	@rm -rf $(BDW_WORKLIB)/jobs/hls.memwb.RADIX_2.s

kill_hls_memwb_RADIX_2:
	@bdw_kill -job hls.memwb.RADIX_2
	@bdw_kill -job hls.memwb.RADIX_2.s


