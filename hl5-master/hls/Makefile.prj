	@rm -rf $(BDW_WORKLIB)/jobs/hls.memwb.PIPE_SOFT3
	@rm -rf $(BDW_WORKLIB)/jobs/hls.memwb.PIPE_SOFT3.s

kill_hls_memwb_PIPE_SOFT3:
	@bdw_kill -job hls.memwb.PIPE_SOFT3
	@bdw_kill -job hls.memwb.PIPE_SOFT3.s


hls_memwb_PIPE_SOFT3_% : hlsc_memwb_PIPE_SOFT3_%

cynth_memwb_PIPE_SOFT3_% : hlsc_memwb_PIPE_SOFT3_%

elab_memwb_PIPE_SOFT3_% : 
