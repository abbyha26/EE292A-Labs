	@bdw_kill -job hls.fedec.PIPE_SOFT2_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),PIPE_SOFT2)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT2/fedec.d
                -include $(memlib_WORKLIB)/memlib.d
                BDW_LIB_DEPS =  $(memlib_DEPS)
            endif
        endif
    endif
endif


html_fedec_PIPE_SOFT2 :
	bdw_htmlgen -project project.tcl -module fedec -cynthconfig PIPE_SOFT2

BDW_fedec_PIPE_SOFT2_HLS_TARGETS := $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT2/fedec_rtl.cpp $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT2/fedec_rtl.v $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT2/stratus_hls.bdr
ifeq ($(BDW_BDR_ONLY),1)
.PHONY: $(filter %.bdr %.cpp,$(BDW_fedec_PIPE_SOFT2_HLS_TARGETS))
$(filter %.v %.cpp,$(BDW_fedec_PIPE_SOFT2_HLS_TARGETS)) : $(filter %.bdr,$(BDW_fedec_PIPE_SOFT2_HLS_TARGETS))
BDW_fedec_PIPE_SOFT2_HLS_TARGETS := $(filter %.bdr,$(BDW_fedec_PIPE_SOFT2_HLS_TARGETS))
endif
BDW_fedec_PIPE_SOFT2_HLS_SPEC_TARGETS = $(subst /PIPE_SOFT2/,/PIPE_SOFT2_%/,$(BDW_fedec_PIPE_SOFT2_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_fedec_PIPE_SOFT2_HLS_TARGETS) :  ../src/fedec.cpp   $(BDW_LIB_DEPS)
	+make --no-print-directory  $(BDW_WORKLIB)/wrappers/hl5_wrap.h
	@if [ ! -d $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT2 ]; then mkdir -p $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT2; fi
	
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=PIPE_SOFT2 BDW_CYNTH_CONFIG=PIPE_SOFT2 \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT2/fedec_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT2/fedec_rtl.cpp \
		BDW_MODULE=fedec \
		BDW_CYNTH_CONFIG=PIPE_SOFT2 \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT2 \
		BDW_HLS_CONFIG=PIPE_SOFT2 \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT2 \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_fedec_PIPE_SOFT2)  \
		-d $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT2 -o fedec_rtl.cpp \
		--hls_module=fedec --hls_config=PIPE_SOFT2 --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_fedec_PIPE_SOFT2))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_fedec_PIPE_SOFT2))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_fedec_PIPE_SOFT2))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_fedec_PIPE_SOFT2)   \
		 ../src/fedec.cpp
	
	
	
	

else

$(BDW_fedec_PIPE_SOFT2_HLS_TARGETS) :  ../src/fedec.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.fedec.PIPE_SOFT2.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_fedec_PIPE_SOFT2_HLS_TARGETS)

endif

	
$(BDW_WORKLIB)/modules/fedec/PIPE_SOFT2/fedec_trace.h : $(BDW_WORKLIB)/modules/fedec/PIPE_SOFT2/fedec_trace.h.updated

