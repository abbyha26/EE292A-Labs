#
$(BDW_WORKLIB)/modules/execute/BASIC/execute.d :  ../src/execute.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config BASIC of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_execute_BASIC)  ../src/execute.cpp \
	| sed 's|execute\.o[ :]*|$(BDW_WORKLIB)/modules/execute/BASIC/execute_rtl.cpp $(BDW_WORKLIB)/modules/execute/BASIC/xcelium/execute_beh.o $(BDW_WORKLIB)/modules/execute/BASIC/xcelium/debug/execute_beh.o $(BDW_WORKLIB)/modules/execute/BASIC/execute.d : $(memlib_WORKLIB)/memlib.d |' $(BDW_DEP_FILTER)  > $@

#
#	Library post-proc rules
#



##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/execute/BASIC"
##############################################################

execute_BASIC_SRCDIR = $(BDW_WORKLIB)/modules/execute/BASIC
execute_BASIC_BEH_SRCDIR = $(BDW_WORKLIB)/libs/execute_BASIC
execute_BASIC_LIBNAME = execute_BASIC
execute_BASIC_WORKLIB = $(BDW_WORKLIB)/modules/execute/BASIC/xcelium
execute_BASIC_C_PARTS_A = $(execute_BASIC_WORKLIB)/objs/libexecute_BASIC.a

prep_c_execute_BASIC : $(execute_BASIC_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(execute_BASIC_WORKLIB) prep_c

prep_vlog_execute_BASIC : $(execute_BASIC_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(execute_BASIC_WORKLIB) prep_vlog

prep_execute_BASIC : $(execute_BASIC_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(execute_BASIC_WORKLIB) prep

$(execute_BASIC_WORKLIB)/Makefile : $(execute_BASIC_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(execute_BASIC_WORKLIB) ]; then mkdir -p $(execute_BASIC_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(execute_BASIC_SRCDIR) -o $(execute_BASIC_WORKLIB)/Makefile -module execute -cynthconfig BASIC   

$(execute_BASIC_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(execute_BASIC_WORKLIB) ]; then mkdir -p $(execute_BASIC_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



prep_c_execute_BASIC_% : $(subst BASIC,BASIC_%,$(execute_BASIC_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst BASIC,BASIC_$(*F),$(execute_BASIC_WORKLIB)) prep_c

prep_vlog_execute_BASIC_% : $(subst BASIC,BASIC_%,$(execute_BASIC_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst BASIC,BASIC_$(*F),$(execute_BASIC_WORKLIB)) prep_vlog

prep_execute_BASIC_% : $(subst BASIC,BASIC_%,$(execute_BASIC_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst BASIC,BASIC_$(*F),$(execute_BASIC_WORKLIB)) prep

$(subst BASIC,BASIC_%,$(execute_BASIC_WORKLIB))/Makefile : $(execute_BASIC_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(subst BASIC,BASIC_$(*F),$(execute_BASIC_WORKLIB)) ]; then mkdir -p $(subst BASIC,BASIC_$(*F),$(execute_BASIC_WORKLIB)); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(execute_BASIC_SRCDIR)_$(*F) -o $(subst BASIC,BASIC_$(*F),$(execute_BASIC_WORKLIB))/Makefile -module execute -cynthconfig BASIC_$(*F)   

$(execute_BASIC_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(subst BASIC,BASIC_$(*F),$(execute_BASIC_WORKLIB)) ]; then mkdir -p $(subst BASIC,BASIC_$(*F),$(execute_BASIC_WORKLIB)); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(execute_BASIC_WORKLIB)/execute_BASIC.d :
	@if [ ! -d $(execute_BASIC_WORKLIB) ]; then mkdir -p $(execute_BASIC_WORKLIB); fi
	@touch $(execute_BASIC_WORKLIB)/execute_BASIC.d



#
# HLS config BASIC_POFF
#

#
#	stratus_hls rule
#
LIB_DIRS_execute_BASIC_POFF = $(memlib_SRCDIR) 
LIB_INCLUDES_execute_BASIC_POFF = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_execute_BASIC_POFF))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_execute_BASIC_POFF = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_execute_BASIC_POFF = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_execute_BASIC_POFF = 
EXTRACT_LIB_DASHI_execute_BASIC_POFF = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl execute BASIC_POFF]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_execute_BASIC_POFF = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/execute/BASIC_POFF/c_parts -DBASIC_POFF=1 -DBDW_RTL_execute_BASIC_POFF=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_execute_BASIC_POFF)
CCFLAGS_COSIM_execute_BASIC_POFF = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/execute/BASIC_POFF/c_parts -DBASIC_POFF=1 -DBDW_RTL_execute_BASIC_POFF=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_execute_BASIC_POFF)
CCFLAGS_BEH_execute_BASIC_POFF = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/execute/BASIC_POFF/c_parts -DBASIC_POFF=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_execute_BASIC_POFF)
CCFLAGS_execute_BASIC_POFF += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_execute_BASIC_POFF += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_execute_BASIC_POFF += ${BDW_CCFLAGS_TAIL}

.PHONY: hlsc_execute_BASIC_POFF hls_execute_BASIC_POFF

hls_execute_BASIC_POFF : hlsc_execute_BASIC_POFF

cynth_execute_BASIC_POFF : hlsc_execute_BASIC_POFF

elab_execute_BASIC_POFF : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/execute/BASIC_POFF/stratus_hls.bdr

optim_execute_BASIC_POFF : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/execute/BASIC_POFF/stratus_hls.bdr

sched_execute_BASIC_POFF : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/execute/BASIC_POFF/stratus_hls.bdr

hlsc_execute_BASIC_POFF : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/execute/BASIC_POFF/execute_rtl.cpp BDW_DEP_CYNTH_CONFIG=BASIC_POFF BDW_MODULE=execute BDW_HLS_CONFIG=BASIC_POFF 
else
	@bdw_exec -jobproject project.tcl -job hls.execute.BASIC_POFF $(MAKE) CWBExec_hls=1 hlsc_execute_BASIC_POFF
endif

clean_cynth_execute_BASIC_POFF: clean_hls_execute_BASIC_POFF

clean_execute_BASIC_POFF: clean_hls_execute_BASIC_POFF

clean_hls_execute_BASIC_POFF:
	@rm -rf $(BDW_WORKLIB)/modules/execute/BASIC_POFF
	@rm -rf $(BDW_WORKLIB)/jobs/hls.execute.BASIC_POFF
	@rm -rf $(BDW_WORKLIB)/jobs/hls.execute.BASIC_POFF.s

kill_hls_execute_BASIC_POFF:
	@bdw_kill -job hls.execute.BASIC_POFF
	@bdw_kill -job hls.execute.BASIC_POFF.s


