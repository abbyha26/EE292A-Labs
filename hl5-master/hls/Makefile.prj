clean_cynth_memwb_PIPE_SOFT3_%: clean_hls_memwb_PIPE_SOFT3_%

clean_memwb_PIPE_SOFT3_%: clean_hls_memwb_PIPE_SOFT3_%

clean_hls_memwb_PIPE_SOFT3_%:
	@rm -rf $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.memwb.PIPE_SOFT3_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.memwb.PIPE_SOFT3_$(*F).s

kill_hls_memwb_PIPE_SOFT3_%:
	@bdw_kill -job hls.memwb.PIPE_SOFT3_$(*F)
	@bdw_kill -job hls.memwb.PIPE_SOFT3_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),PIPE_SOFT3)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3/memwb.d
                -include $(memlib_WORKLIB)/memlib.d
                BDW_LIB_DEPS =  $(memlib_DEPS)
            endif
        endif
    endif
endif


html_memwb_PIPE_SOFT3 :
	bdw_htmlgen -project project.tcl -module memwb -cynthconfig PIPE_SOFT3

BDW_memwb_PIPE_SOFT3_HLS_TARGETS := $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3/memwb_rtl.cpp $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3/memwb_rtl.v $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3/stratus_hls.bdr
ifeq ($(BDW_BDR_ONLY),1)
.PHONY: $(filter %.bdr %.cpp,$(BDW_memwb_PIPE_SOFT3_HLS_TARGETS))
$(filter %.v %.cpp,$(BDW_memwb_PIPE_SOFT3_HLS_TARGETS)) : $(filter %.bdr,$(BDW_memwb_PIPE_SOFT3_HLS_TARGETS))
BDW_memwb_PIPE_SOFT3_HLS_TARGETS := $(filter %.bdr,$(BDW_memwb_PIPE_SOFT3_HLS_TARGETS))
endif
BDW_memwb_PIPE_SOFT3_HLS_SPEC_TARGETS = $(subst /PIPE_SOFT3/,/PIPE_SOFT3_%/,$(BDW_memwb_PIPE_SOFT3_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_memwb_PIPE_SOFT3_HLS_TARGETS) :  ../src/memwb.cpp   $(BDW_LIB_DEPS)
	+make --no-print-directory  $(BDW_WORKLIB)/wrappers/hl5_wrap.h
	@if [ ! -d $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3 ]; then mkdir -p $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3; fi
	
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=PIPE_SOFT3 BDW_CYNTH_CONFIG=PIPE_SOFT3 \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3/memwb_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3/memwb_rtl.cpp \
		BDW_MODULE=memwb \
		BDW_CYNTH_CONFIG=PIPE_SOFT3 \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3 \
		BDW_HLS_CONFIG=PIPE_SOFT3 \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3 \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_memwb_PIPE_SOFT3)  \
		-d $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3 -o memwb_rtl.cpp \
		--hls_module=memwb --hls_config=PIPE_SOFT3 --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_memwb_PIPE_SOFT3))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_memwb_PIPE_SOFT3))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_memwb_PIPE_SOFT3))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_memwb_PIPE_SOFT3)   \
		 ../src/memwb.cpp
	
	
	
	

else

$(BDW_memwb_PIPE_SOFT3_HLS_TARGETS) :  ../src/memwb.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.memwb.PIPE_SOFT3.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_memwb_PIPE_SOFT3_HLS_TARGETS)

endif

	
$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3/memwb_trace.h : $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3/memwb_trace.h.updated

$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3/memwb_trace.h.updated : $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3/memwb_rtl.cpp $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module memwb -cynthconfig PIPE_SOFT3  
	@touch $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3/memwb_trace.h.updated

ifeq ($(CWBExec_hlsc),1)

$(BDW_memwb_PIPE_SOFT3_HLS_SPEC_TARGETS) :  ../src/memwb.cpp   $(BDW_LIB_DEPS)
	+make --no-print-directory  $(BDW_WORKLIB)/wrappers/hl5_wrap.h
	@if [ ! -d $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3_$(*F) ]; then mkdir -p $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3_$(*F); fi
	
	
	$(subst /PIPE_SOFT3 ,/PIPE_SOFT3_$(*F) ,$(subst =PIPE_SOFT3 ,=PIPE_SOFT3_$(*F) ,$(subst /memwb/PIPE_SOFT3/,/memwb/PIPE_SOFT3_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=PIPE_SOFT3 BDW_CYNTH_CONFIG=PIPE_SOFT3 \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3/memwb_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3/memwb_rtl.cpp \
		BDW_MODULE=memwb \
		BDW_CYNTH_CONFIG=PIPE_SOFT3 \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3 \
		BDW_HLS_CONFIG=PIPE_SOFT3 \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3 \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_memwb_PIPE_SOFT3)  \
		`cat  $(BDW_SPECLIB)/memwb/PIPE_SOFT3.$(*F).bds | grep '^cmdline:' | sed 's/^cmdline://'`\
		-d $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3 -o memwb_rtl.cpp \
		--hls_module=memwb --hls_config=PIPE_SOFT3 --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_memwb_PIPE_SOFT3))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_memwb_PIPE_SOFT3))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_memwb_PIPE_SOFT3))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_memwb_PIPE_SOFT3)   \
		 ../src/memwb.cpp)))
	
	
	
	

else

$(BDW_memwb_PIPE_SOFT3_HLS_SPEC_TARGETS) :  ../src/memwb.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.memwb.PIPE_SOFT3_$(*F).s $(MAKE) -j1 CWBExec_hlsc=1 $(subst %,$(*F),$(BDW_memwb_PIPE_SOFT3_HLS_SPEC_TARGETS))

endif

	

