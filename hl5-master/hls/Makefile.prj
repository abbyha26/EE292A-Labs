	@if [ ! -d $(subst PIPE_SOFT3,PIPE_SOFT3_$(*F),$(memwb_PIPE_SOFT3_WORKLIB)) ]; then mkdir -p $(subst PIPE_SOFT3,PIPE_SOFT3_$(*F),$(memwb_PIPE_SOFT3_WORKLIB)); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(memwb_PIPE_SOFT3_SRCDIR)_$(*F) -o $(subst PIPE_SOFT3,PIPE_SOFT3_$(*F),$(memwb_PIPE_SOFT3_WORKLIB))/Makefile -module memwb -cynthconfig PIPE_SOFT3_$(*F)   

$(memwb_PIPE_SOFT3_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(subst PIPE_SOFT3,PIPE_SOFT3_$(*F),$(memwb_PIPE_SOFT3_WORKLIB)) ]; then mkdir -p $(subst PIPE_SOFT3,PIPE_SOFT3_$(*F),$(memwb_PIPE_SOFT3_WORKLIB)); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(memwb_PIPE_SOFT3_WORKLIB)/memwb_PIPE_SOFT3.d :
	@if [ ! -d $(memwb_PIPE_SOFT3_WORKLIB) ]; then mkdir -p $(memwb_PIPE_SOFT3_WORKLIB); fi
	@touch $(memwb_PIPE_SOFT3_WORKLIB)/memwb_PIPE_SOFT3.d



#
# HLS config RADIX_2
#

#
#	stratus_hls rule
#
LIB_DIRS_memwb_RADIX_2 = $(memlib_SRCDIR) 
LIB_INCLUDES_memwb_RADIX_2 = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_memwb_RADIX_2))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_memwb_RADIX_2 = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_memwb_RADIX_2 = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_memwb_RADIX_2 = 
EXTRACT_LIB_DASHI_memwb_RADIX_2 = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl memwb RADIX_2]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_memwb_RADIX_2 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/memwb/RADIX_2/c_parts -DRADIX_2=1 -DBDW_RTL_memwb_RADIX_2=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DDIV_RADIX_2 $(LIB_INCLUDES_memwb_RADIX_2)
CCFLAGS_COSIM_memwb_RADIX_2 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/memwb/RADIX_2/c_parts -DRADIX_2=1 -DBDW_RTL_memwb_RADIX_2=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DDIV_RADIX_2 $(LIB_INCLUDES_memwb_RADIX_2)
CCFLAGS_BEH_memwb_RADIX_2 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/memwb/RADIX_2/c_parts -DRADIX_2=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DDIV_RADIX_2 $(LIB_INCLUDES_memwb_RADIX_2)
CCFLAGS_memwb_RADIX_2 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_memwb_RADIX_2 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_memwb_RADIX_2 += ${BDW_CCFLAGS_TAIL}

.PHONY: hlsc_memwb_RADIX_2 hls_memwb_RADIX_2

hls_memwb_RADIX_2 : hlsc_memwb_RADIX_2

cynth_memwb_RADIX_2 : hlsc_memwb_RADIX_2

elab_memwb_RADIX_2 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/memwb/RADIX_2/stratus_hls.bdr

optim_memwb_RADIX_2 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/memwb/RADIX_2/stratus_hls.bdr

sched_memwb_RADIX_2 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/memwb/RADIX_2/stratus_hls.bdr

hlsc_memwb_RADIX_2 : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/memwb/RADIX_2/memwb_rtl.cpp BDW_DEP_CYNTH_CONFIG=RADIX_2 BDW_MODULE=memwb BDW_HLS_CONFIG=RADIX_2 
else
