#
#	Dependency generation rule
#
$(BDW_WORKLIB)/modules/fedec/PIN/fedec.d :  ../src/fedec.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config PIN of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_fedec_PIN)  ../src/fedec.cpp \
	| sed 's|fedec\.o[ :]*|$(BDW_WORKLIB)/modules/fedec/PIN/fedec_rtl.cpp $(BDW_WORKLIB)/modules/fedec/PIN/xcelium/fedec_beh.o $(BDW_WORKLIB)/modules/fedec/PIN/xcelium/debug/fedec_beh.o $(BDW_WORKLIB)/modules/fedec/PIN/fedec.d : $(memlib_WORKLIB)/memlib.d |' $(BDW_DEP_FILTER)  > $@

#
#	Library post-proc rules
#



##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/fedec/PIN"
##############################################################

fedec_PIN_SRCDIR = $(BDW_WORKLIB)/modules/fedec/PIN
fedec_PIN_BEH_SRCDIR = $(BDW_WORKLIB)/libs/fedec_PIN
fedec_PIN_LIBNAME = fedec_PIN
fedec_PIN_WORKLIB = $(BDW_WORKLIB)/modules/fedec/PIN/xcelium
fedec_PIN_C_PARTS_A = $(fedec_PIN_WORKLIB)/objs/libfedec_PIN.a

prep_c_fedec_PIN : $(fedec_PIN_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(fedec_PIN_WORKLIB) prep_c

prep_vlog_fedec_PIN : $(fedec_PIN_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(fedec_PIN_WORKLIB) prep_vlog

prep_fedec_PIN : $(fedec_PIN_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(fedec_PIN_WORKLIB) prep

$(fedec_PIN_WORKLIB)/Makefile : $(fedec_PIN_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(fedec_PIN_WORKLIB) ]; then mkdir -p $(fedec_PIN_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(fedec_PIN_SRCDIR) -o $(fedec_PIN_WORKLIB)/Makefile -module fedec -cynthconfig PIN   

$(fedec_PIN_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(fedec_PIN_WORKLIB) ]; then mkdir -p $(fedec_PIN_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



prep_c_fedec_PIN_% : $(subst PIN,PIN_%,$(fedec_PIN_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst PIN,PIN_$(*F),$(fedec_PIN_WORKLIB)) prep_c

prep_vlog_fedec_PIN_% : $(subst PIN,PIN_%,$(fedec_PIN_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst PIN,PIN_$(*F),$(fedec_PIN_WORKLIB)) prep_vlog

prep_fedec_PIN_% : $(subst PIN,PIN_%,$(fedec_PIN_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst PIN,PIN_$(*F),$(fedec_PIN_WORKLIB)) prep

$(subst PIN,PIN_%,$(fedec_PIN_WORKLIB))/Makefile : $(fedec_PIN_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(subst PIN,PIN_$(*F),$(fedec_PIN_WORKLIB)) ]; then mkdir -p $(subst PIN,PIN_$(*F),$(fedec_PIN_WORKLIB)); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(fedec_PIN_SRCDIR)_$(*F) -o $(subst PIN,PIN_$(*F),$(fedec_PIN_WORKLIB))/Makefile -module fedec -cynthconfig PIN_$(*F)   

$(fedec_PIN_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(subst PIN,PIN_$(*F),$(fedec_PIN_WORKLIB)) ]; then mkdir -p $(subst PIN,PIN_$(*F),$(fedec_PIN_WORKLIB)); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(fedec_PIN_WORKLIB)/fedec_PIN.d :
	@if [ ! -d $(fedec_PIN_WORKLIB) ]; then mkdir -p $(fedec_PIN_WORKLIB); fi
	@touch $(fedec_PIN_WORKLIB)/fedec_PIN.d



#
# HLS config BASIC
#

#
#	stratus_hls rule
#
LIB_DIRS_fedec_BASIC = $(memlib_SRCDIR) 
LIB_INCLUDES_fedec_BASIC = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_fedec_BASIC))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_fedec_BASIC = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_fedec_BASIC = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_fedec_BASIC = 
EXTRACT_LIB_DASHI_fedec_BASIC = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl fedec BASIC]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_fedec_BASIC = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/fedec/BASIC/c_parts -DBASIC=1 -DBDW_RTL_fedec_BASIC=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_fedec_BASIC)
CCFLAGS_COSIM_fedec_BASIC = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/fedec/BASIC/c_parts -DBASIC=1 -DBDW_RTL_fedec_BASIC=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_fedec_BASIC)
CCFLAGS_BEH_fedec_BASIC = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/fedec/BASIC/c_parts -DBASIC=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_fedec_BASIC)
CCFLAGS_fedec_BASIC += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_fedec_BASIC += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_fedec_BASIC += ${BDW_CCFLAGS_TAIL}

.PHONY: hlsc_fedec_BASIC hls_fedec_BASIC

hls_fedec_BASIC : hlsc_fedec_BASIC

cynth_fedec_BASIC : hlsc_fedec_BASIC

elab_fedec_BASIC : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/fedec/BASIC/stratus_hls.bdr

optim_fedec_BASIC : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/fedec/BASIC/stratus_hls.bdr

sched_fedec_BASIC : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/fedec/BASIC/stratus_hls.bdr

hlsc_fedec_BASIC : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/fedec/BASIC/fedec_rtl.cpp BDW_DEP_CYNTH_CONFIG=BASIC BDW_MODULE=fedec BDW_HLS_CONFIG=BASIC 
else
	@bdw_exec -jobproject project.tcl -job hls.fedec.BASIC $(MAKE) CWBExec_hls=1 hlsc_fedec_BASIC
endif

clean_cynth_fedec_BASIC: clean_hls_fedec_BASIC

clean_fedec_BASIC: clean_hls_fedec_BASIC

clean_hls_fedec_BASIC:
	@rm -rf $(BDW_WORKLIB)/modules/fedec/BASIC
	@rm -rf $(BDW_WORKLIB)/jobs/hls.fedec.BASIC
	@rm -rf $(BDW_WORKLIB)/jobs/hls.fedec.BASIC.s

kill_hls_fedec_BASIC:
	@bdw_kill -job hls.fedec.BASIC
	@bdw_kill -job hls.fedec.BASIC.s


hls_fedec_BASIC_% : hlsc_fedec_BASIC_%

cynth_fedec_BASIC_% : hlsc_fedec_BASIC_%

elab_fedec_BASIC_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(subst /BASIC/,/BASIC_$(*F)/,$(BDW_WORKLIB)/modules/fedec/BASIC/stratus_hls.bdr)

optim_fedec_BASIC_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(subst /BASIC/,/BASIC_$(*F)/,$(BDW_WORKLIB)/modules/fedec/BASIC/stratus_hls.bdr)

sched_fedec_BASIC_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(subst /BASIC/,/BASIC_$(*F)/,$(BDW_WORKLIB)/modules/fedec/BASIC/stratus_hls.bdr)

hlsc_fedec_BASIC_% hls_fedec_BASIC_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /BASIC/,/BASIC_$(*F)/,$(BDW_WORKLIB)/modules/fedec/BASIC/fedec_rtl.cpp) BDW_DEP_CYNTH_CONFIG=BASIC BDW_MODULE=fedec BDW_HLS_CONFIG=BASIC_$(*F) 
else
	@bdw_exec -jobproject project.tcl -job hls.fedec.BASIC_$(*F) $(MAKE) CWBExec_hls=1 hlsc_fedec_BASIC_$(*F)
endif

clean_cynth_fedec_BASIC_%: clean_hls_fedec_BASIC_%

clean_fedec_BASIC_%: clean_hls_fedec_BASIC_%

clean_hls_fedec_BASIC_%:
	@rm -rf $(BDW_WORKLIB)/modules/fedec/BASIC_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.fedec.BASIC_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.fedec.BASIC_$(*F).s

kill_hls_fedec_BASIC_%:
	@bdw_kill -job hls.fedec.BASIC_$(*F)
	@bdw_kill -job hls.fedec.BASIC_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),BASIC)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/fedec/BASIC/fedec.d
                -include $(memlib_WORKLIB)/memlib.d
                BDW_LIB_DEPS =  $(memlib_DEPS)
            endif
        endif
    endif
endif


html_fedec_BASIC :
	bdw_htmlgen -project project.tcl -module fedec -cynthconfig BASIC

BDW_fedec_BASIC_HLS_TARGETS := $(BDW_WORKLIB)/modules/fedec/BASIC/fedec_rtl.cpp $(BDW_WORKLIB)/modules/fedec/BASIC/fedec_rtl.v $(BDW_WORKLIB)/modules/fedec/BASIC/stratus_hls.bdr
ifeq ($(BDW_BDR_ONLY),1)
.PHONY: $(filter %.bdr %.cpp,$(BDW_fedec_BASIC_HLS_TARGETS))
$(filter %.v %.cpp,$(BDW_fedec_BASIC_HLS_TARGETS)) : $(filter %.bdr,$(BDW_fedec_BASIC_HLS_TARGETS))
BDW_fedec_BASIC_HLS_TARGETS := $(filter %.bdr,$(BDW_fedec_BASIC_HLS_TARGETS))
endif
BDW_fedec_BASIC_HLS_SPEC_TARGETS = $(subst /BASIC/,/BASIC_%/,$(BDW_fedec_BASIC_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_fedec_BASIC_HLS_TARGETS) :  ../src/fedec.cpp   $(BDW_LIB_DEPS)
	+make --no-print-directory  $(BDW_WORKLIB)/wrappers/hl5_wrap.h
	@if [ ! -d $(BDW_WORKLIB)/modules/fedec/BASIC ]; then mkdir -p $(BDW_WORKLIB)/modules/fedec/BASIC; fi
	
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=BASIC BDW_CYNTH_CONFIG=BASIC \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/fedec/BASIC/fedec_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/fedec/BASIC/fedec_rtl.cpp \
		BDW_MODULE=fedec \
		BDW_CYNTH_CONFIG=BASIC \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/fedec/BASIC \
		BDW_HLS_CONFIG=BASIC \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/fedec/BASIC \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_fedec_BASIC)  \
		-d $(BDW_WORKLIB)/modules/fedec/BASIC -o fedec_rtl.cpp \
		--hls_module=fedec --hls_config=BASIC --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_fedec_BASIC))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_fedec_BASIC))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_fedec_BASIC))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_fedec_BASIC)   \
		 ../src/fedec.cpp
	
	
	
	

else

$(BDW_fedec_BASIC_HLS_TARGETS) :  ../src/fedec.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.fedec.BASIC.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_fedec_BASIC_HLS_TARGETS)

endif

	
$(BDW_WORKLIB)/modules/fedec/BASIC/fedec_trace.h : $(BDW_WORKLIB)/modules/fedec/BASIC/fedec_trace.h.updated

$(BDW_WORKLIB)/modules/fedec/BASIC/fedec_trace.h.updated : $(BDW_WORKLIB)/modules/fedec/BASIC/fedec_rtl.cpp $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module fedec -cynthconfig BASIC  
	@touch $(BDW_WORKLIB)/modules/fedec/BASIC/fedec_trace.h.updated

ifeq ($(CWBExec_hlsc),1)

$(BDW_fedec_BASIC_HLS_SPEC_TARGETS) :  ../src/fedec.cpp   $(BDW_LIB_DEPS)
	+make --no-print-directory  $(BDW_WORKLIB)/wrappers/hl5_wrap.h
	@if [ ! -d $(BDW_WORKLIB)/modules/fedec/BASIC_$(*F) ]; then mkdir -p $(BDW_WORKLIB)/modules/fedec/BASIC_$(*F); fi
	
	
	$(subst /BASIC ,/BASIC_$(*F) ,$(subst =BASIC ,=BASIC_$(*F) ,$(subst /fedec/BASIC/,/fedec/BASIC_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=BASIC BDW_CYNTH_CONFIG=BASIC \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/fedec/BASIC/fedec_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/fedec/BASIC/fedec_rtl.cpp \
		BDW_MODULE=fedec \
		BDW_CYNTH_CONFIG=BASIC \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/fedec/BASIC \
		BDW_HLS_CONFIG=BASIC \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/fedec/BASIC \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_fedec_BASIC)  \
		`cat  $(BDW_SPECLIB)/fedec/BASIC.$(*F).bds | grep '^cmdline:' | sed 's/^cmdline://'`\
		-d $(BDW_WORKLIB)/modules/fedec/BASIC -o fedec_rtl.cpp \
		--hls_module=fedec --hls_config=BASIC --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_fedec_BASIC))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_fedec_BASIC))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_fedec_BASIC))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_fedec_BASIC)   \
		 ../src/fedec.cpp)))
	
	
	
	

else

$(BDW_fedec_BASIC_HLS_SPEC_TARGETS) :  ../src/fedec.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.fedec.BASIC_$(*F).s $(MAKE) -j1 CWBExec_hlsc=1 $(subst %,$(*F),$(BDW_fedec_BASIC_HLS_SPEC_TARGETS))

endif

	

$(subst /BASIC/,/BASIC_%/,$(BDW_WORKLIB)/modules/fedec/BASIC/fedec_trace.h) : $(subst /BASIC/,/BASIC_%/,$(BDW_WORKLIB)/modules/fedec/BASIC/fedec_rtl.cpp) $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module fedec -cynthconfig BASIC_$(*F)  

catHLLog_fedec_BASIC:
	cat $(BDW_WORKLIB)/modules/fedec/BASIC/stratus_hls.log

#
#	stratus_vlg rule
#
cynthvlg_fedec_BASIC : hls_fedec_BASIC 


.PHONY: hls_fedec_BASIC

hls_fedec_BASIC hlsv_fedec_BASIC: $(addprefix prep_vlog_,$(LIB_NAMES_FOR_VLOG_fedec_BASIC)) 

.PHONY: hls_fedec_BASIC

hls_fedec_BASIC_% hlsv_fedec_BASIC_%: $(addprefix prep_vlog_,$(LIB_NAMES_FOR_VLOG_fedec_BASIC)) 

catVLGLog_fedec_BASIC : catHLLog_fedec_BASIC
	cat $(BDW_WORKLIB)/modules/fedec/BASIC/stratus_vlg.log

#
#	view rule
#

view_fedec_BASIC:
	@echo "ERROR: Schematic viewing target 'view_fedec_BASIC' is only supported with 'verdi'"
	@echo "The Stratus IDE includes a schematic view as an alternative."


#
#	RTL object file rule
#
$(BDW_WORKLIB)/modules/fedec/BASIC/xcelium/fedec_rtl.o : $(BDW_WORKLIB)/modules/fedec/BASIC/fedec_rtl.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(BDW_WORKLIB)/modules/fedec/BASIC/fedec_trace.h
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl fedec`
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/BASIC/ -I./ $(CCFLAGS_fedec_BASIC) $(EXTRACT_LIB_DASHI_fedec_BASIC) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/fedec/BASIC/xcelium/fedec_rtl.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp

$(BDW_WORKLIB)/modules/fedec/BASIC/xcelium/debug/fedec_rtl.o : $(BDW_WORKLIB)/modules/fedec/BASIC/fedec_rtl.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(BDW_WORKLIB)/modules/fedec/BASIC/fedec_trace.h
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl fedec`
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/BASIC/ -I./ $(CCFLAGS_fedec_BASIC) $(EXTRACT_LIB_DASHI_fedec_BASIC) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/fedec/BASIC/xcelium/debug/fedec_rtl.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp

#
#	Behavioral object file rule.  Used only for BEH configs that are 
#	associated with HLS config names.
#

$(BDW_WORKLIB)/modules/fedec/BASIC/xcelium/fedec_beh.o :  ../src/fedec.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(BDW_WORKLIB)/wrappers/fedec_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/BASIC/ -I./ $(CCFLAGS_BEH_fedec_BASIC) -o $(BDW_WORKLIB)/modules/fedec/BASIC/xcelium/fedec_beh.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp

$(BDW_WORKLIB)/modules/fedec/BASIC/xcelium/debug/fedec_beh.o :  ../src/fedec.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(BDW_WORKLIB)/wrappers/fedec_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/BASIC/ -I./ $(CCFLAGS_BEH_fedec_BASIC) -o $(BDW_WORKLIB)/modules/fedec/BASIC/xcelium/debug/fedec_beh.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp

#
# Cosim object file rule
#

$(BDW_WORKLIB)/modules/fedec/BASIC/xcelium/fedec.o :  ../src/fedec.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(BDW_WORKLIB)/wrappers/fedec_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/BASIC/ -I./ $(CCFLAGS_COSIM_fedec_BASIC) -o $(BDW_WORKLIB)/modules/fedec/BASIC/xcelium/fedec.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp
    

$(BDW_WORKLIB)/modules/fedec/BASIC/xcelium/fedec_hoist.o :  ../src/fedec.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(BDW_WORKLIB)/wrappers/fedec_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/BASIC/ -I./ $(CCFLAGS_fedec_BASIC) $(EXTRACT_LIB_DASHI_fedec_BASIC) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/fedec/BASIC/xcelium/fedec_hoist.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp
    

$(BDW_WORKLIB)/modules/fedec/BASIC/xcelium/debug/fedec.o :  ../src/fedec.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(BDW_WORKLIB)/wrappers/fedec_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/BASIC/ -I./ $(CCFLAGS_COSIM_fedec_BASIC) -o $(BDW_WORKLIB)/modules/fedec/BASIC/xcelium/debug/fedec.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp


$(BDW_WORKLIB)/modules/fedec/BASIC/xcelium/debug/fedec_hoist.o :  ../src/fedec.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(BDW_WORKLIB)/wrappers/fedec_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/BASIC/ -I./ $(CCFLAGS_fedec_BASIC) $(EXTRACT_LIB_DASHI_fedec_BASIC) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/fedec/BASIC/xcelium/debug/fedec_hoist.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp
    

view_fedec_BASIC_%:
	@echo "ERROR: Schematic viewing target 'view_fedec_BASIC_$(*F)' is only supported with 'verdi'"
	@echo "The Stratus IDE includes a schematic view as an alternative."

ifneq ($(BDW_SPEC_NAME),)
#
#	RTL object file rule
#
$(subst /BASIC/,/BASIC$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/fedec/BASIC/xcelium/fedec_rtl.o) : $(subst /BASIC/,/BASIC$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/fedec/BASIC/fedec_rtl.cpp) $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(subst /BASIC/,/BASIC$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/fedec/BASIC/fedec_trace.h)
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl fedec`
	$(subst /BASIC/,/BASIC$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/BASIC/ -I./ $(CCFLAGS_fedec_BASIC) $(EXTRACT_LIB_DASHI_fedec_BASIC) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/fedec/BASIC/xcelium/fedec_rtl.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp)

$(subst /BASIC/,/BASIC$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/fedec/BASIC/xcelium/debug/fedec_rtl.o) : $(subst /BASIC/,/BASIC$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/fedec/BASIC/fedec_rtl.cpp) $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(subst /BASIC/,/BASIC$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/fedec/BASIC/fedec_trace.h)
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl fedec`
	$(subst /BASIC/,/BASIC$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/fedec/BASIC/ -I./ $(CCFLAGS_fedec_BASIC) $(EXTRACT_LIB_DASHI_fedec_BASIC) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/fedec/BASIC/xcelium/debug/fedec_rtl.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp)

