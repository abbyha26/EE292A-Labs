$(BDW_WORKLIB)/modules/execute/RADIX_2/xcelium/execute_hoist.o :  ../src/execute.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.cpp $(BDW_WORKLIB)/wrappers/execute_cosim.h $(BDW_WORKLIB)/wrappers/execute_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/execute/RADIX_2/ -I./ $(CCFLAGS_execute_RADIX_2) $(EXTRACT_LIB_DASHI_execute_RADIX_2) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/execute/RADIX_2/xcelium/execute_hoist.o " $(BDW_WORKLIB)/wrappers/execute_wrap.cpp
    

$(BDW_WORKLIB)/modules/execute/RADIX_2/xcelium/debug/execute.o :  ../src/execute.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/execute_cosim.h $(BDW_WORKLIB)/wrappers/execute_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/execute/RADIX_2/ -I./ $(CCFLAGS_COSIM_execute_RADIX_2) -o $(BDW_WORKLIB)/modules/execute/RADIX_2/xcelium/debug/execute.o " $(BDW_WORKLIB)/wrappers/execute_wrap.cpp


$(BDW_WORKLIB)/modules/execute/RADIX_2/xcelium/debug/execute_hoist.o :  ../src/execute.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.cpp $(BDW_WORKLIB)/wrappers/execute_cosim.h $(BDW_WORKLIB)/wrappers/execute_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/execute/RADIX_2/ -I./ $(CCFLAGS_execute_RADIX_2) $(EXTRACT_LIB_DASHI_execute_RADIX_2) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/execute/RADIX_2/xcelium/debug/execute_hoist.o " $(BDW_WORKLIB)/wrappers/execute_wrap.cpp
    

