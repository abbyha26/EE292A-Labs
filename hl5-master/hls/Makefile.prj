	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl memwb`
	$(subst /PIPE_SOFT2/,/PIPE_SOFT2$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/ -I./ $(CCFLAGS_memwb_PIPE_SOFT2) $(EXTRACT_LIB_DASHI_memwb_PIPE_SOFT2) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/xcelium/debug/memwb_rtl.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp)

#
#	Behavioral object file rule.  Used only for BEH configs that are 
#	associated with HLS config names.
#

$(subst /PIPE_SOFT2/,/PIPE_SOFT2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/xcelium/memwb_beh.o) :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(subst /PIPE_SOFT2/,/PIPE_SOFT2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/memwb_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /PIPE_SOFT2/,/PIPE_SOFT2$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/ -I./ $(CCFLAGS_BEH_memwb_PIPE_SOFT2) -o $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/xcelium/memwb_beh.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp)

$(subst /PIPE_SOFT2/,/PIPE_SOFT2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/xcelium/debug/memwb_beh.o) :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(subst /PIPE_SOFT2/,/PIPE_SOFT2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/memwb_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /PIPE_SOFT2/,/PIPE_SOFT2$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/ -I./ $(CCFLAGS_BEH_memwb_PIPE_SOFT2) -o $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/xcelium/debug/memwb_beh.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp)

#
# Cosim object file rule
#

$(subst /PIPE_SOFT2/,/PIPE_SOFT2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/xcelium/memwb.o) :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(subst /PIPE_SOFT2/,/PIPE_SOFT2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/memwb_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /PIPE_SOFT2/,/PIPE_SOFT2$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/ -I./ $(CCFLAGS_COSIM_memwb_PIPE_SOFT2) -o $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/xcelium/memwb.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp)
    

$(subst /PIPE_SOFT2/,/PIPE_SOFT2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/xcelium/memwb_hoist.o) :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(subst /PIPE_SOFT2/,/PIPE_SOFT2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/memwb_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /PIPE_SOFT2/,/PIPE_SOFT2$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/ -I./ $(CCFLAGS_memwb_PIPE_SOFT2) $(EXTRACT_LIB_DASHI_memwb_PIPE_SOFT2) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/xcelium/memwb_hoist.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp)
    

$(subst /PIPE_SOFT2/,/PIPE_SOFT2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/xcelium/debug/memwb.o) :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(subst /PIPE_SOFT2/,/PIPE_SOFT2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/memwb_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /PIPE_SOFT2/,/PIPE_SOFT2$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/ -I./ $(CCFLAGS_COSIM_memwb_PIPE_SOFT2) -o $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/xcelium/debug/memwb.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp)


$(subst /PIPE_SOFT2/,/PIPE_SOFT2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/xcelium/debug/memwb_hoist.o) :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(subst /PIPE_SOFT2/,/PIPE_SOFT2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/memwb_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /PIPE_SOFT2/,/PIPE_SOFT2$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/ -I./ $(CCFLAGS_memwb_PIPE_SOFT2) $(EXTRACT_LIB_DASHI_memwb_PIPE_SOFT2) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/xcelium/debug/memwb_hoist.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp)
    
endif

#
#	Dependency generation rule
#
$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/memwb.d :  ../src/memwb.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config PIPE_SOFT2 of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_memwb_PIPE_SOFT2)  ../src/memwb.cpp \
	| sed 's|memwb\.o[ :]*|$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/memwb_rtl.cpp $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/xcelium/memwb_beh.o $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/xcelium/debug/memwb_beh.o $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/memwb.d : $(memlib_WORKLIB)/memlib.d |' $(BDW_DEP_FILTER)  > $@

#
#	Library post-proc rules
#



##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2"
##############################################################

memwb_PIPE_SOFT2_SRCDIR = $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2
memwb_PIPE_SOFT2_BEH_SRCDIR = $(BDW_WORKLIB)/libs/memwb_PIPE_SOFT2
memwb_PIPE_SOFT2_LIBNAME = memwb_PIPE_SOFT2
memwb_PIPE_SOFT2_WORKLIB = $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT2/xcelium
memwb_PIPE_SOFT2_C_PARTS_A = $(memwb_PIPE_SOFT2_WORKLIB)/objs/libmemwb_PIPE_SOFT2.a

prep_c_memwb_PIPE_SOFT2 : $(memwb_PIPE_SOFT2_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(memwb_PIPE_SOFT2_WORKLIB) prep_c

prep_vlog_memwb_PIPE_SOFT2 : $(memwb_PIPE_SOFT2_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(memwb_PIPE_SOFT2_WORKLIB) prep_vlog

prep_memwb_PIPE_SOFT2 : $(memwb_PIPE_SOFT2_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(memwb_PIPE_SOFT2_WORKLIB) prep

$(memwb_PIPE_SOFT2_WORKLIB)/Makefile : $(memwb_PIPE_SOFT2_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(memwb_PIPE_SOFT2_WORKLIB) ]; then mkdir -p $(memwb_PIPE_SOFT2_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(memwb_PIPE_SOFT2_SRCDIR) -o $(memwb_PIPE_SOFT2_WORKLIB)/Makefile -module memwb -cynthconfig PIPE_SOFT2   

$(memwb_PIPE_SOFT2_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(memwb_PIPE_SOFT2_WORKLIB) ]; then mkdir -p $(memwb_PIPE_SOFT2_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



prep_c_memwb_PIPE_SOFT2_% : $(subst PIPE_SOFT2,PIPE_SOFT2_%,$(memwb_PIPE_SOFT2_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst PIPE_SOFT2,PIPE_SOFT2_$(*F),$(memwb_PIPE_SOFT2_WORKLIB)) prep_c

prep_vlog_memwb_PIPE_SOFT2_% : $(subst PIPE_SOFT2,PIPE_SOFT2_%,$(memwb_PIPE_SOFT2_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst PIPE_SOFT2,PIPE_SOFT2_$(*F),$(memwb_PIPE_SOFT2_WORKLIB)) prep_vlog

prep_memwb_PIPE_SOFT2_% : $(subst PIPE_SOFT2,PIPE_SOFT2_%,$(memwb_PIPE_SOFT2_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst PIPE_SOFT2,PIPE_SOFT2_$(*F),$(memwb_PIPE_SOFT2_WORKLIB)) prep

$(subst PIPE_SOFT2,PIPE_SOFT2_%,$(memwb_PIPE_SOFT2_WORKLIB))/Makefile : $(memwb_PIPE_SOFT2_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(subst PIPE_SOFT2,PIPE_SOFT2_$(*F),$(memwb_PIPE_SOFT2_WORKLIB)) ]; then mkdir -p $(subst PIPE_SOFT2,PIPE_SOFT2_$(*F),$(memwb_PIPE_SOFT2_WORKLIB)); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(memwb_PIPE_SOFT2_SRCDIR)_$(*F) -o $(subst PIPE_SOFT2,PIPE_SOFT2_$(*F),$(memwb_PIPE_SOFT2_WORKLIB))/Makefile -module memwb -cynthconfig PIPE_SOFT2_$(*F)   

$(memwb_PIPE_SOFT2_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(subst PIPE_SOFT2,PIPE_SOFT2_$(*F),$(memwb_PIPE_SOFT2_WORKLIB)) ]; then mkdir -p $(subst PIPE_SOFT2,PIPE_SOFT2_$(*F),$(memwb_PIPE_SOFT2_WORKLIB)); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(memwb_PIPE_SOFT2_WORKLIB)/memwb_PIPE_SOFT2.d :
	@if [ ! -d $(memwb_PIPE_SOFT2_WORKLIB) ]; then mkdir -p $(memwb_PIPE_SOFT2_WORKLIB); fi
	@touch $(memwb_PIPE_SOFT2_WORKLIB)/memwb_PIPE_SOFT2.d



#
# HLS config PIPE_SOFT3
#

#
#	stratus_hls rule
#
LIB_DIRS_memwb_PIPE_SOFT3 = $(memlib_SRCDIR) 
LIB_INCLUDES_memwb_PIPE_SOFT3 = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_memwb_PIPE_SOFT3))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_memwb_PIPE_SOFT3 = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_memwb_PIPE_SOFT3 = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_memwb_PIPE_SOFT3 = 
EXTRACT_LIB_DASHI_memwb_PIPE_SOFT3 = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl memwb PIPE_SOFT3]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_memwb_PIPE_SOFT3 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3/c_parts -DPIPE_SOFT3=1 -DBDW_RTL_memwb_PIPE_SOFT3=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DPIPE_SOFT_STALL3=1 $(LIB_INCLUDES_memwb_PIPE_SOFT3)
CCFLAGS_COSIM_memwb_PIPE_SOFT3 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3/c_parts -DPIPE_SOFT3=1 -DBDW_RTL_memwb_PIPE_SOFT3=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DPIPE_SOFT_STALL3=1 $(LIB_INCLUDES_memwb_PIPE_SOFT3)
CCFLAGS_BEH_memwb_PIPE_SOFT3 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3/c_parts -DPIPE_SOFT3=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DPIPE_SOFT_STALL3=1 $(LIB_INCLUDES_memwb_PIPE_SOFT3)
CCFLAGS_memwb_PIPE_SOFT3 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_memwb_PIPE_SOFT3 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_memwb_PIPE_SOFT3 += ${BDW_CCFLAGS_TAIL}

.PHONY: hlsc_memwb_PIPE_SOFT3 hls_memwb_PIPE_SOFT3

hls_memwb_PIPE_SOFT3 : hlsc_memwb_PIPE_SOFT3

cynth_memwb_PIPE_SOFT3 : hlsc_memwb_PIPE_SOFT3

elab_memwb_PIPE_SOFT3 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3/stratus_hls.bdr

optim_memwb_PIPE_SOFT3 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3/stratus_hls.bdr

sched_memwb_PIPE_SOFT3 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3/stratus_hls.bdr

hlsc_memwb_PIPE_SOFT3 : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT3/memwb_rtl.cpp BDW_DEP_CYNTH_CONFIG=PIPE_SOFT3 BDW_MODULE=memwb BDW_HLS_CONFIG=PIPE_SOFT3 
else
	@bdw_exec -jobproject project.tcl -job hls.memwb.PIPE_SOFT3 $(MAKE) CWBExec_hls=1 hlsc_memwb_PIPE_SOFT3
endif

clean_cynth_memwb_PIPE_SOFT3: clean_hls_memwb_PIPE_SOFT3

clean_memwb_PIPE_SOFT3: clean_hls_memwb_PIPE_SOFT3

