$(subst /PIN/,/PIN$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/PIN/xcelium/memwb.o) :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(subst /PIN/,/PIN$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/memwb_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /PIN/,/PIN$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/PIN/ -I./ $(CCFLAGS_COSIM_memwb_PIN) -o $(BDW_WORKLIB)/modules/memwb/PIN/xcelium/memwb.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp)
    

$(subst /PIN/,/PIN$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/PIN/xcelium/memwb_hoist.o) :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(subst /PIN/,/PIN$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/memwb_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /PIN/,/PIN$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/PIN/ -I./ $(CCFLAGS_memwb_PIN) $(EXTRACT_LIB_DASHI_memwb_PIN) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/memwb/PIN/xcelium/memwb_hoist.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp)
    

$(subst /PIN/,/PIN$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/PIN/xcelium/debug/memwb.o) :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(subst /PIN/,/PIN$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/memwb_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /PIN/,/PIN$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/PIN/ -I./ $(CCFLAGS_COSIM_memwb_PIN) -o $(BDW_WORKLIB)/modules/memwb/PIN/xcelium/debug/memwb.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp)


$(subst /PIN/,/PIN$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/PIN/xcelium/debug/memwb_hoist.o) :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(subst /PIN/,/PIN$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/memwb_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /PIN/,/PIN$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/PIN/ -I./ $(CCFLAGS_memwb_PIN) $(EXTRACT_LIB_DASHI_memwb_PIN) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/memwb/PIN/xcelium/debug/memwb_hoist.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp)
    
endif

#
#	Dependency generation rule
#
$(BDW_WORKLIB)/modules/memwb/PIN/memwb.d :  ../src/memwb.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config PIN of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_memwb_PIN)  ../src/memwb.cpp \
	| sed 's|memwb\.o[ :]*|$(BDW_WORKLIB)/modules/memwb/PIN/memwb_rtl.cpp $(BDW_WORKLIB)/modules/memwb/PIN/xcelium/memwb_beh.o $(BDW_WORKLIB)/modules/memwb/PIN/xcelium/debug/memwb_beh.o $(BDW_WORKLIB)/modules/memwb/PIN/memwb.d : $(memlib_WORKLIB)/memlib.d |' $(BDW_DEP_FILTER)  > $@

#
#	Library post-proc rules
#



##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/memwb/PIN"
##############################################################

memwb_PIN_SRCDIR = $(BDW_WORKLIB)/modules/memwb/PIN
memwb_PIN_BEH_SRCDIR = $(BDW_WORKLIB)/libs/memwb_PIN
memwb_PIN_LIBNAME = memwb_PIN
memwb_PIN_WORKLIB = $(BDW_WORKLIB)/modules/memwb/PIN/xcelium
memwb_PIN_C_PARTS_A = $(memwb_PIN_WORKLIB)/objs/libmemwb_PIN.a

prep_c_memwb_PIN : $(memwb_PIN_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(memwb_PIN_WORKLIB) prep_c

prep_vlog_memwb_PIN : $(memwb_PIN_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(memwb_PIN_WORKLIB) prep_vlog

prep_memwb_PIN : $(memwb_PIN_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(memwb_PIN_WORKLIB) prep

$(memwb_PIN_WORKLIB)/Makefile : $(memwb_PIN_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(memwb_PIN_WORKLIB) ]; then mkdir -p $(memwb_PIN_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(memwb_PIN_SRCDIR) -o $(memwb_PIN_WORKLIB)/Makefile -module memwb -cynthconfig PIN   

$(memwb_PIN_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(memwb_PIN_WORKLIB) ]; then mkdir -p $(memwb_PIN_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



prep_c_memwb_PIN_% : $(subst PIN,PIN_%,$(memwb_PIN_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst PIN,PIN_$(*F),$(memwb_PIN_WORKLIB)) prep_c

prep_vlog_memwb_PIN_% : $(subst PIN,PIN_%,$(memwb_PIN_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst PIN,PIN_$(*F),$(memwb_PIN_WORKLIB)) prep_vlog

prep_memwb_PIN_% : $(subst PIN,PIN_%,$(memwb_PIN_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst PIN,PIN_$(*F),$(memwb_PIN_WORKLIB)) prep

$(subst PIN,PIN_%,$(memwb_PIN_WORKLIB))/Makefile : $(memwb_PIN_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(subst PIN,PIN_$(*F),$(memwb_PIN_WORKLIB)) ]; then mkdir -p $(subst PIN,PIN_$(*F),$(memwb_PIN_WORKLIB)); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(memwb_PIN_SRCDIR)_$(*F) -o $(subst PIN,PIN_$(*F),$(memwb_PIN_WORKLIB))/Makefile -module memwb -cynthconfig PIN_$(*F)   

$(memwb_PIN_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(subst PIN,PIN_$(*F),$(memwb_PIN_WORKLIB)) ]; then mkdir -p $(subst PIN,PIN_$(*F),$(memwb_PIN_WORKLIB)); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(memwb_PIN_WORKLIB)/memwb_PIN.d :
	@if [ ! -d $(memwb_PIN_WORKLIB) ]; then mkdir -p $(memwb_PIN_WORKLIB); fi
	@touch $(memwb_PIN_WORKLIB)/memwb_PIN.d



#
# HLS config BASIC
#

#
#	stratus_hls rule
#
LIB_DIRS_memwb_BASIC = $(memlib_SRCDIR) 
LIB_INCLUDES_memwb_BASIC = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_memwb_BASIC))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_memwb_BASIC = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_memwb_BASIC = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_memwb_BASIC = 
EXTRACT_LIB_DASHI_memwb_BASIC = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl memwb BASIC]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_memwb_BASIC = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/memwb/BASIC/c_parts -DBASIC=1 -DBDW_RTL_memwb_BASIC=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_memwb_BASIC)
CCFLAGS_COSIM_memwb_BASIC = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/memwb/BASIC/c_parts -DBASIC=1 -DBDW_RTL_memwb_BASIC=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_memwb_BASIC)
CCFLAGS_BEH_memwb_BASIC = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/memwb/BASIC/c_parts -DBASIC=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_memwb_BASIC)
CCFLAGS_memwb_BASIC += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_memwb_BASIC += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_memwb_BASIC += ${BDW_CCFLAGS_TAIL}

.PHONY: hlsc_memwb_BASIC hls_memwb_BASIC

hls_memwb_BASIC : hlsc_memwb_BASIC

cynth_memwb_BASIC : hlsc_memwb_BASIC

elab_memwb_BASIC : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/memwb/BASIC/stratus_hls.bdr

optim_memwb_BASIC : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/memwb/BASIC/stratus_hls.bdr

sched_memwb_BASIC : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/memwb/BASIC/stratus_hls.bdr

hlsc_memwb_BASIC : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/memwb/BASIC/memwb_rtl.cpp BDW_DEP_CYNTH_CONFIG=BASIC BDW_MODULE=memwb BDW_HLS_CONFIG=BASIC 
else
	@bdw_exec -jobproject project.tcl -job hls.memwb.BASIC $(MAKE) CWBExec_hls=1 hlsc_memwb_BASIC
endif

clean_cynth_memwb_BASIC: clean_hls_memwb_BASIC

clean_memwb_BASIC: clean_hls_memwb_BASIC

clean_hls_memwb_BASIC:
	@rm -rf $(BDW_WORKLIB)/modules/memwb/BASIC
	@rm -rf $(BDW_WORKLIB)/jobs/hls.memwb.BASIC
	@rm -rf $(BDW_WORKLIB)/jobs/hls.memwb.BASIC.s

kill_hls_memwb_BASIC:
	@bdw_kill -job hls.memwb.BASIC
	@bdw_kill -job hls.memwb.BASIC.s


hls_memwb_BASIC_% : hlsc_memwb_BASIC_%

cynth_memwb_BASIC_% : hlsc_memwb_BASIC_%

elab_memwb_BASIC_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(subst /BASIC/,/BASIC_$(*F)/,$(BDW_WORKLIB)/modules/memwb/BASIC/stratus_hls.bdr)

optim_memwb_BASIC_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(subst /BASIC/,/BASIC_$(*F)/,$(BDW_WORKLIB)/modules/memwb/BASIC/stratus_hls.bdr)

sched_memwb_BASIC_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(subst /BASIC/,/BASIC_$(*F)/,$(BDW_WORKLIB)/modules/memwb/BASIC/stratus_hls.bdr)

hlsc_memwb_BASIC_% hls_memwb_BASIC_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /BASIC/,/BASIC_$(*F)/,$(BDW_WORKLIB)/modules/memwb/BASIC/memwb_rtl.cpp) BDW_DEP_CYNTH_CONFIG=BASIC BDW_MODULE=memwb BDW_HLS_CONFIG=BASIC_$(*F) 
else
	@bdw_exec -jobproject project.tcl -job hls.memwb.BASIC_$(*F) $(MAKE) CWBExec_hls=1 hlsc_memwb_BASIC_$(*F)
endif

clean_cynth_memwb_BASIC_%: clean_hls_memwb_BASIC_%

clean_memwb_BASIC_%: clean_hls_memwb_BASIC_%

clean_hls_memwb_BASIC_%:
	@rm -rf $(BDW_WORKLIB)/modules/memwb/BASIC_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.memwb.BASIC_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.memwb.BASIC_$(*F).s

kill_hls_memwb_BASIC_%:
	@bdw_kill -job hls.memwb.BASIC_$(*F)
	@bdw_kill -job hls.memwb.BASIC_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),BASIC)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/memwb/BASIC/memwb.d
                -include $(memlib_WORKLIB)/memlib.d
                BDW_LIB_DEPS =  $(memlib_DEPS)
            endif
        endif
    endif
endif


html_memwb_BASIC :
	bdw_htmlgen -project project.tcl -module memwb -cynthconfig BASIC

BDW_memwb_BASIC_HLS_TARGETS := $(BDW_WORKLIB)/modules/memwb/BASIC/memwb_rtl.cpp $(BDW_WORKLIB)/modules/memwb/BASIC/memwb_rtl.v $(BDW_WORKLIB)/modules/memwb/BASIC/stratus_hls.bdr
ifeq ($(BDW_BDR_ONLY),1)
.PHONY: $(filter %.bdr %.cpp,$(BDW_memwb_BASIC_HLS_TARGETS))
$(filter %.v %.cpp,$(BDW_memwb_BASIC_HLS_TARGETS)) : $(filter %.bdr,$(BDW_memwb_BASIC_HLS_TARGETS))
BDW_memwb_BASIC_HLS_TARGETS := $(filter %.bdr,$(BDW_memwb_BASIC_HLS_TARGETS))
endif
BDW_memwb_BASIC_HLS_SPEC_TARGETS = $(subst /BASIC/,/BASIC_%/,$(BDW_memwb_BASIC_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_memwb_BASIC_HLS_TARGETS) :  ../src/memwb.cpp   $(BDW_LIB_DEPS)
	+make --no-print-directory  $(BDW_WORKLIB)/wrappers/hl5_wrap.h
	@if [ ! -d $(BDW_WORKLIB)/modules/memwb/BASIC ]; then mkdir -p $(BDW_WORKLIB)/modules/memwb/BASIC; fi
	
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=BASIC BDW_CYNTH_CONFIG=BASIC \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/memwb/BASIC/memwb_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/memwb/BASIC/memwb_rtl.cpp \
		BDW_MODULE=memwb \
		BDW_CYNTH_CONFIG=BASIC \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/memwb/BASIC \
		BDW_HLS_CONFIG=BASIC \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/memwb/BASIC \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_memwb_BASIC)  \
		-d $(BDW_WORKLIB)/modules/memwb/BASIC -o memwb_rtl.cpp \
		--hls_module=memwb --hls_config=BASIC --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_memwb_BASIC))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_memwb_BASIC))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_memwb_BASIC))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_memwb_BASIC)   \
		 ../src/memwb.cpp
	
	
	
	

else

$(BDW_memwb_BASIC_HLS_TARGETS) :  ../src/memwb.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.memwb.BASIC.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_memwb_BASIC_HLS_TARGETS)

endif

	
$(BDW_WORKLIB)/modules/memwb/BASIC/memwb_trace.h : $(BDW_WORKLIB)/modules/memwb/BASIC/memwb_trace.h.updated

$(BDW_WORKLIB)/modules/memwb/BASIC/memwb_trace.h.updated : $(BDW_WORKLIB)/modules/memwb/BASIC/memwb_rtl.cpp $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module memwb -cynthconfig BASIC  
	@touch $(BDW_WORKLIB)/modules/memwb/BASIC/memwb_trace.h.updated

ifeq ($(CWBExec_hlsc),1)

$(BDW_memwb_BASIC_HLS_SPEC_TARGETS) :  ../src/memwb.cpp   $(BDW_LIB_DEPS)
	+make --no-print-directory  $(BDW_WORKLIB)/wrappers/hl5_wrap.h
	@if [ ! -d $(BDW_WORKLIB)/modules/memwb/BASIC_$(*F) ]; then mkdir -p $(BDW_WORKLIB)/modules/memwb/BASIC_$(*F); fi
	
	
	$(subst /BASIC ,/BASIC_$(*F) ,$(subst =BASIC ,=BASIC_$(*F) ,$(subst /memwb/BASIC/,/memwb/BASIC_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=BASIC BDW_CYNTH_CONFIG=BASIC \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/memwb/BASIC/memwb_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/memwb/BASIC/memwb_rtl.cpp \
		BDW_MODULE=memwb \
		BDW_CYNTH_CONFIG=BASIC \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/memwb/BASIC \
		BDW_HLS_CONFIG=BASIC \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/memwb/BASIC \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_memwb_BASIC)  \
		`cat  $(BDW_SPECLIB)/memwb/BASIC.$(*F).bds | grep '^cmdline:' | sed 's/^cmdline://'`\
		-d $(BDW_WORKLIB)/modules/memwb/BASIC -o memwb_rtl.cpp \
		--hls_module=memwb --hls_config=BASIC --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_memwb_BASIC))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_memwb_BASIC))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_memwb_BASIC))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_memwb_BASIC)   \
		 ../src/memwb.cpp)))
	
	
	
	

else

$(BDW_memwb_BASIC_HLS_SPEC_TARGETS) :  ../src/memwb.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.memwb.BASIC_$(*F).s $(MAKE) -j1 CWBExec_hlsc=1 $(subst %,$(*F),$(BDW_memwb_BASIC_HLS_SPEC_TARGETS))

endif

	

$(subst /BASIC/,/BASIC_%/,$(BDW_WORKLIB)/modules/memwb/BASIC/memwb_trace.h) : $(subst /BASIC/,/BASIC_%/,$(BDW_WORKLIB)/modules/memwb/BASIC/memwb_rtl.cpp) $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module memwb -cynthconfig BASIC_$(*F)  

catHLLog_memwb_BASIC:
	cat $(BDW_WORKLIB)/modules/memwb/BASIC/stratus_hls.log

#
#	stratus_vlg rule
#
cynthvlg_memwb_BASIC : hls_memwb_BASIC 


.PHONY: hls_memwb_BASIC

hls_memwb_BASIC hlsv_memwb_BASIC: $(addprefix prep_vlog_,$(LIB_NAMES_FOR_VLOG_memwb_BASIC)) 

.PHONY: hls_memwb_BASIC

hls_memwb_BASIC_% hlsv_memwb_BASIC_%: $(addprefix prep_vlog_,$(LIB_NAMES_FOR_VLOG_memwb_BASIC)) 

catVLGLog_memwb_BASIC : catHLLog_memwb_BASIC
	cat $(BDW_WORKLIB)/modules/memwb/BASIC/stratus_vlg.log

#
#	view rule
#

view_memwb_BASIC:
	@echo "ERROR: Schematic viewing target 'view_memwb_BASIC' is only supported with 'verdi'"
	@echo "The Stratus IDE includes a schematic view as an alternative."


#
#	RTL object file rule
#
$(BDW_WORKLIB)/modules/memwb/BASIC/xcelium/memwb_rtl.o : $(BDW_WORKLIB)/modules/memwb/BASIC/memwb_rtl.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(BDW_WORKLIB)/modules/memwb/BASIC/memwb_trace.h
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl memwb`
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/BASIC/ -I./ $(CCFLAGS_memwb_BASIC) $(EXTRACT_LIB_DASHI_memwb_BASIC) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/memwb/BASIC/xcelium/memwb_rtl.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp

$(BDW_WORKLIB)/modules/memwb/BASIC/xcelium/debug/memwb_rtl.o : $(BDW_WORKLIB)/modules/memwb/BASIC/memwb_rtl.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(BDW_WORKLIB)/modules/memwb/BASIC/memwb_trace.h
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl memwb`
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/BASIC/ -I./ $(CCFLAGS_memwb_BASIC) $(EXTRACT_LIB_DASHI_memwb_BASIC) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/memwb/BASIC/xcelium/debug/memwb_rtl.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp

#
#	Behavioral object file rule.  Used only for BEH configs that are 
#	associated with HLS config names.
#

$(BDW_WORKLIB)/modules/memwb/BASIC/xcelium/memwb_beh.o :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(BDW_WORKLIB)/wrappers/memwb_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/BASIC/ -I./ $(CCFLAGS_BEH_memwb_BASIC) -o $(BDW_WORKLIB)/modules/memwb/BASIC/xcelium/memwb_beh.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp

$(BDW_WORKLIB)/modules/memwb/BASIC/xcelium/debug/memwb_beh.o :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(BDW_WORKLIB)/wrappers/memwb_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/BASIC/ -I./ $(CCFLAGS_BEH_memwb_BASIC) -o $(BDW_WORKLIB)/modules/memwb/BASIC/xcelium/debug/memwb_beh.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp

#
# Cosim object file rule
#

$(BDW_WORKLIB)/modules/memwb/BASIC/xcelium/memwb.o :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(BDW_WORKLIB)/wrappers/memwb_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/BASIC/ -I./ $(CCFLAGS_COSIM_memwb_BASIC) -o $(BDW_WORKLIB)/modules/memwb/BASIC/xcelium/memwb.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp
    

$(BDW_WORKLIB)/modules/memwb/BASIC/xcelium/memwb_hoist.o :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(BDW_WORKLIB)/wrappers/memwb_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/BASIC/ -I./ $(CCFLAGS_memwb_BASIC) $(EXTRACT_LIB_DASHI_memwb_BASIC) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/memwb/BASIC/xcelium/memwb_hoist.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp
    

$(BDW_WORKLIB)/modules/memwb/BASIC/xcelium/debug/memwb.o :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(BDW_WORKLIB)/wrappers/memwb_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/BASIC/ -I./ $(CCFLAGS_COSIM_memwb_BASIC) -o $(BDW_WORKLIB)/modules/memwb/BASIC/xcelium/debug/memwb.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp


$(BDW_WORKLIB)/modules/memwb/BASIC/xcelium/debug/memwb_hoist.o :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(BDW_WORKLIB)/wrappers/memwb_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/BASIC/ -I./ $(CCFLAGS_memwb_BASIC) $(EXTRACT_LIB_DASHI_memwb_BASIC) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/memwb/BASIC/xcelium/debug/memwb_hoist.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp
    

view_memwb_BASIC_%:
	@echo "ERROR: Schematic viewing target 'view_memwb_BASIC_$(*F)' is only supported with 'verdi'"
	@echo "The Stratus IDE includes a schematic view as an alternative."

ifneq ($(BDW_SPEC_NAME),)
#
#	RTL object file rule
#
$(subst /BASIC/,/BASIC$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/BASIC/xcelium/memwb_rtl.o) : $(subst /BASIC/,/BASIC$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/BASIC/memwb_rtl.cpp) $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(subst /BASIC/,/BASIC$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/BASIC/memwb_trace.h)
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl memwb`
	$(subst /BASIC/,/BASIC$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/BASIC/ -I./ $(CCFLAGS_memwb_BASIC) $(EXTRACT_LIB_DASHI_memwb_BASIC) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/memwb/BASIC/xcelium/memwb_rtl.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp)

$(subst /BASIC/,/BASIC$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/BASIC/xcelium/debug/memwb_rtl.o) : $(subst /BASIC/,/BASIC$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/BASIC/memwb_rtl.cpp) $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(subst /BASIC/,/BASIC$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/BASIC/memwb_trace.h)
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl memwb`
	$(subst /BASIC/,/BASIC$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/BASIC/ -I./ $(CCFLAGS_memwb_BASIC) $(EXTRACT_LIB_DASHI_memwb_BASIC) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/memwb/BASIC/xcelium/debug/memwb_rtl.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp)

#
#	Behavioral object file rule.  Used only for BEH configs that are 
#	associated with HLS config names.
#

$(subst /BASIC/,/BASIC$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/BASIC/xcelium/memwb_beh.o) :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(subst /BASIC/,/BASIC$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/memwb_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /BASIC/,/BASIC$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/BASIC/ -I./ $(CCFLAGS_BEH_memwb_BASIC) -o $(BDW_WORKLIB)/modules/memwb/BASIC/xcelium/memwb_beh.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp)

$(subst /BASIC/,/BASIC$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/BASIC/xcelium/debug/memwb_beh.o) :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(subst /BASIC/,/BASIC$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/memwb_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /BASIC/,/BASIC$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/BASIC/ -I./ $(CCFLAGS_BEH_memwb_BASIC) -o $(BDW_WORKLIB)/modules/memwb/BASIC/xcelium/debug/memwb_beh.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp)

#
# Cosim object file rule
#

$(subst /BASIC/,/BASIC$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/BASIC/xcelium/memwb.o) :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(subst /BASIC/,/BASIC$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/memwb_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /BASIC/,/BASIC$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/BASIC/ -I./ $(CCFLAGS_COSIM_memwb_BASIC) -o $(BDW_WORKLIB)/modules/memwb/BASIC/xcelium/memwb.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp)
    

$(subst /BASIC/,/BASIC$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/BASIC/xcelium/memwb_hoist.o) :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(subst /BASIC/,/BASIC$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/memwb_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /BASIC/,/BASIC$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/BASIC/ -I./ $(CCFLAGS_memwb_BASIC) $(EXTRACT_LIB_DASHI_memwb_BASIC) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/memwb/BASIC/xcelium/memwb_hoist.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp)
    

$(subst /BASIC/,/BASIC$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/BASIC/xcelium/debug/memwb.o) :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(subst /BASIC/,/BASIC$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/memwb_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /BASIC/,/BASIC$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/BASIC/ -I./ $(CCFLAGS_COSIM_memwb_BASIC) -o $(BDW_WORKLIB)/modules/memwb/BASIC/xcelium/debug/memwb.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp)


$(subst /BASIC/,/BASIC$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/BASIC/xcelium/debug/memwb_hoist.o) :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(subst /BASIC/,/BASIC$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/memwb_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /BASIC/,/BASIC$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/BASIC/ -I./ $(CCFLAGS_memwb_BASIC) $(EXTRACT_LIB_DASHI_memwb_BASIC) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/memwb/BASIC/xcelium/debug/memwb_hoist.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp)
    
endif

#
#	Dependency generation rule
#
$(BDW_WORKLIB)/modules/memwb/BASIC/memwb.d :  ../src/memwb.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config BASIC of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_memwb_BASIC)  ../src/memwb.cpp \
	| sed 's|memwb\.o[ :]*|$(BDW_WORKLIB)/modules/memwb/BASIC/memwb_rtl.cpp $(BDW_WORKLIB)/modules/memwb/BASIC/xcelium/memwb_beh.o $(BDW_WORKLIB)/modules/memwb/BASIC/xcelium/debug/memwb_beh.o $(BDW_WORKLIB)/modules/memwb/BASIC/memwb.d : $(memlib_WORKLIB)/memlib.d |' $(BDW_DEP_FILTER)  > $@

#
#	Library post-proc rules
#



##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/memwb/BASIC"
##############################################################

memwb_BASIC_SRCDIR = $(BDW_WORKLIB)/modules/memwb/BASIC
memwb_BASIC_BEH_SRCDIR = $(BDW_WORKLIB)/libs/memwb_BASIC
memwb_BASIC_LIBNAME = memwb_BASIC
memwb_BASIC_WORKLIB = $(BDW_WORKLIB)/modules/memwb/BASIC/xcelium
memwb_BASIC_C_PARTS_A = $(memwb_BASIC_WORKLIB)/objs/libmemwb_BASIC.a

prep_c_memwb_BASIC : $(memwb_BASIC_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(memwb_BASIC_WORKLIB) prep_c

prep_vlog_memwb_BASIC : $(memwb_BASIC_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(memwb_BASIC_WORKLIB) prep_vlog

prep_memwb_BASIC : $(memwb_BASIC_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(memwb_BASIC_WORKLIB) prep

$(memwb_BASIC_WORKLIB)/Makefile : $(memwb_BASIC_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(memwb_BASIC_WORKLIB) ]; then mkdir -p $(memwb_BASIC_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(memwb_BASIC_SRCDIR) -o $(memwb_BASIC_WORKLIB)/Makefile -module memwb -cynthconfig BASIC   

$(memwb_BASIC_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(memwb_BASIC_WORKLIB) ]; then mkdir -p $(memwb_BASIC_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



prep_c_memwb_BASIC_% : $(subst BASIC,BASIC_%,$(memwb_BASIC_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst BASIC,BASIC_$(*F),$(memwb_BASIC_WORKLIB)) prep_c

prep_vlog_memwb_BASIC_% : $(subst BASIC,BASIC_%,$(memwb_BASIC_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst BASIC,BASIC_$(*F),$(memwb_BASIC_WORKLIB)) prep_vlog

prep_memwb_BASIC_% : $(subst BASIC,BASIC_%,$(memwb_BASIC_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst BASIC,BASIC_$(*F),$(memwb_BASIC_WORKLIB)) prep

$(subst BASIC,BASIC_%,$(memwb_BASIC_WORKLIB))/Makefile : $(memwb_BASIC_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(subst BASIC,BASIC_$(*F),$(memwb_BASIC_WORKLIB)) ]; then mkdir -p $(subst BASIC,BASIC_$(*F),$(memwb_BASIC_WORKLIB)); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(memwb_BASIC_SRCDIR)_$(*F) -o $(subst BASIC,BASIC_$(*F),$(memwb_BASIC_WORKLIB))/Makefile -module memwb -cynthconfig BASIC_$(*F)   

$(memwb_BASIC_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(subst BASIC,BASIC_$(*F),$(memwb_BASIC_WORKLIB)) ]; then mkdir -p $(subst BASIC,BASIC_$(*F),$(memwb_BASIC_WORKLIB)); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(memwb_BASIC_WORKLIB)/memwb_BASIC.d :
	@if [ ! -d $(memwb_BASIC_WORKLIB) ]; then mkdir -p $(memwb_BASIC_WORKLIB); fi
	@touch $(memwb_BASIC_WORKLIB)/memwb_BASIC.d



#
# HLS config BASIC_POFF
#

#
#	stratus_hls rule
#
LIB_DIRS_memwb_BASIC_POFF = $(memlib_SRCDIR) 
LIB_INCLUDES_memwb_BASIC_POFF = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_memwb_BASIC_POFF))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_memwb_BASIC_POFF = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_memwb_BASIC_POFF = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_memwb_BASIC_POFF = 
EXTRACT_LIB_DASHI_memwb_BASIC_POFF = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl memwb BASIC_POFF]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_memwb_BASIC_POFF = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/memwb/BASIC_POFF/c_parts -DBASIC_POFF=1 -DBDW_RTL_memwb_BASIC_POFF=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_memwb_BASIC_POFF)
CCFLAGS_COSIM_memwb_BASIC_POFF = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/memwb/BASIC_POFF/c_parts -DBASIC_POFF=1 -DBDW_RTL_memwb_BASIC_POFF=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_memwb_BASIC_POFF)
CCFLAGS_BEH_memwb_BASIC_POFF = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/memwb/BASIC_POFF/c_parts -DBASIC_POFF=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_memwb_BASIC_POFF)
CCFLAGS_memwb_BASIC_POFF += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_memwb_BASIC_POFF += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_memwb_BASIC_POFF += ${BDW_CCFLAGS_TAIL}

.PHONY: hlsc_memwb_BASIC_POFF hls_memwb_BASIC_POFF

hls_memwb_BASIC_POFF : hlsc_memwb_BASIC_POFF

cynth_memwb_BASIC_POFF : hlsc_memwb_BASIC_POFF

elab_memwb_BASIC_POFF : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/memwb/BASIC_POFF/stratus_hls.bdr

optim_memwb_BASIC_POFF : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/memwb/BASIC_POFF/stratus_hls.bdr

sched_memwb_BASIC_POFF : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/memwb/BASIC_POFF/stratus_hls.bdr

hlsc_memwb_BASIC_POFF : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/memwb/BASIC_POFF/memwb_rtl.cpp BDW_DEP_CYNTH_CONFIG=BASIC_POFF BDW_MODULE=memwb BDW_HLS_CONFIG=BASIC_POFF 
else
	@bdw_exec -jobproject project.tcl -job hls.memwb.BASIC_POFF $(MAKE) CWBExec_hls=1 hlsc_memwb_BASIC_POFF
endif

clean_cynth_memwb_BASIC_POFF: clean_hls_memwb_BASIC_POFF

clean_memwb_BASIC_POFF: clean_hls_memwb_BASIC_POFF

clean_hls_memwb_BASIC_POFF:
	@rm -rf $(BDW_WORKLIB)/modules/memwb/BASIC_POFF
	@rm -rf $(BDW_WORKLIB)/jobs/hls.memwb.BASIC_POFF
	@rm -rf $(BDW_WORKLIB)/jobs/hls.memwb.BASIC_POFF.s

kill_hls_memwb_BASIC_POFF:
	@bdw_kill -job hls.memwb.BASIC_POFF
	@bdw_kill -job hls.memwb.BASIC_POFF.s


hls_memwb_BASIC_POFF_% : hlsc_memwb_BASIC_POFF_%

cynth_memwb_BASIC_POFF_% : hlsc_memwb_BASIC_POFF_%

elab_memwb_BASIC_POFF_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(subst /BASIC_POFF/,/BASIC_POFF_$(*F)/,$(BDW_WORKLIB)/modules/memwb/BASIC_POFF/stratus_hls.bdr)

optim_memwb_BASIC_POFF_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(subst /BASIC_POFF/,/BASIC_POFF_$(*F)/,$(BDW_WORKLIB)/modules/memwb/BASIC_POFF/stratus_hls.bdr)

sched_memwb_BASIC_POFF_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(subst /BASIC_POFF/,/BASIC_POFF_$(*F)/,$(BDW_WORKLIB)/modules/memwb/BASIC_POFF/stratus_hls.bdr)

hlsc_memwb_BASIC_POFF_% hls_memwb_BASIC_POFF_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /BASIC_POFF/,/BASIC_POFF_$(*F)/,$(BDW_WORKLIB)/modules/memwb/BASIC_POFF/memwb_rtl.cpp) BDW_DEP_CYNTH_CONFIG=BASIC_POFF BDW_MODULE=memwb BDW_HLS_CONFIG=BASIC_POFF_$(*F) 
else
	@bdw_exec -jobproject project.tcl -job hls.memwb.BASIC_POFF_$(*F) $(MAKE) CWBExec_hls=1 hlsc_memwb_BASIC_POFF_$(*F)
endif

clean_cynth_memwb_BASIC_POFF_%: clean_hls_memwb_BASIC_POFF_%

clean_memwb_BASIC_POFF_%: clean_hls_memwb_BASIC_POFF_%

clean_hls_memwb_BASIC_POFF_%:
	@rm -rf $(BDW_WORKLIB)/modules/memwb/BASIC_POFF_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.memwb.BASIC_POFF_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.memwb.BASIC_POFF_$(*F).s

kill_hls_memwb_BASIC_POFF_%:
	@bdw_kill -job hls.memwb.BASIC_POFF_$(*F)
	@bdw_kill -job hls.memwb.BASIC_POFF_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),BASIC_POFF)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/memwb/BASIC_POFF/memwb.d
                -include $(memlib_WORKLIB)/memlib.d
                BDW_LIB_DEPS =  $(memlib_DEPS)
            endif
        endif
    endif
endif


html_memwb_BASIC_POFF :
	bdw_htmlgen -project project.tcl -module memwb -cynthconfig BASIC_POFF

BDW_memwb_BASIC_POFF_HLS_TARGETS := $(BDW_WORKLIB)/modules/memwb/BASIC_POFF/memwb_rtl.cpp $(BDW_WORKLIB)/modules/memwb/BASIC_POFF/memwb_rtl.v $(BDW_WORKLIB)/modules/memwb/BASIC_POFF/stratus_hls.bdr
ifeq ($(BDW_BDR_ONLY),1)
.PHONY: $(filter %.bdr %.cpp,$(BDW_memwb_BASIC_POFF_HLS_TARGETS))
$(filter %.v %.cpp,$(BDW_memwb_BASIC_POFF_HLS_TARGETS)) : $(filter %.bdr,$(BDW_memwb_BASIC_POFF_HLS_TARGETS))
BDW_memwb_BASIC_POFF_HLS_TARGETS := $(filter %.bdr,$(BDW_memwb_BASIC_POFF_HLS_TARGETS))
endif
BDW_memwb_BASIC_POFF_HLS_SPEC_TARGETS = $(subst /BASIC_POFF/,/BASIC_POFF_%/,$(BDW_memwb_BASIC_POFF_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_memwb_BASIC_POFF_HLS_TARGETS) :  ../src/memwb.cpp   $(BDW_LIB_DEPS)
	+make --no-print-directory  $(BDW_WORKLIB)/wrappers/hl5_wrap.h
	@if [ ! -d $(BDW_WORKLIB)/modules/memwb/BASIC_POFF ]; then mkdir -p $(BDW_WORKLIB)/modules/memwb/BASIC_POFF; fi
	
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=BASIC_POFF BDW_CYNTH_CONFIG=BASIC_POFF \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/memwb/BASIC_POFF/memwb_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/memwb/BASIC_POFF/memwb_rtl.cpp \
		BDW_MODULE=memwb \
		BDW_CYNTH_CONFIG=BASIC_POFF \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/memwb/BASIC_POFF \
		BDW_HLS_CONFIG=BASIC_POFF \
