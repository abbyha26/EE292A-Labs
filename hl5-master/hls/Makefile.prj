##############################################################
## HLS Module "fedec"
##############################################################


#
# Dependency Generation rule for BEH module
#
$(BDW_OBJDIR)/fedec.d :  ../src/fedec.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for $< "
	@set -e; $(BDW_CCDEP) -MM -MG $(BDW_CCFLAGS)  ../src/fedec.cpp \
	| sed 's|fedec\.o[ :]*|$(BDW_OBJDIR)/fedec.o $(BDW_OBJDIR)/fedec.d : |' $(BDW_DEP_FILTER)  > $@

$(BDW_WORKLIB)/wrappers/fedec_trace.h : $(BDW_WORKLIB)/wrappers/fedec_trace.h.updated

$(BDW_WORKLIB)/wrappers/fedec_trace.h.updated :  ../src/fedec.cpp $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module fedec  
	@touch $(BDW_WORKLIB)/wrappers/fedec_trace.h.updated



$(BDW_WORKLIB)/sims/$(BDW_SIM_CONFIG)/xcelium/fedec.o:  ../src/fedec.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(BDW_WORKLIB)/wrappers/fedec_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " $(BDW_CCFLAGS) -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -o $(BDW_WORKLIB)/sims/$(BDW_SIM_CONFIG)/xcelium/fedec.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp

$(BDW_WORKLIB)/sims/$(BDW_SIM_CONFIG)/xcelium/debug/fedec.o:  ../src/fedec.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(BDW_WORKLIB)/wrappers/fedec_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " $(BDW_CCFLAGS) -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -o $(BDW_WORKLIB)/sims/$(BDW_SIM_CONFIG)/xcelium/debug/fedec.o " $(BDW_WORKLIB)/wrappers/fedec_wrap.cpp

.INTERMEDIATE : fedec_wrap.h

fedec_wrap.h : $(BDW_WORKLIB)/wrappers/fedec_wrap.h

$(BDW_WORKLIB)/wrappers/fedec_wrap.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/fedec_cosim.h $(BDW_WORKLIB)/wrappers/fedec_cosim.v   : $(BDW_WRAPDIR)/fedec.updated

$(BDW_WRAPDIR)/fedec.updated :  ../src/fedec.cpp 
	@if [ ! -d $(BDW_WRAPDIR) ]; then mkdir -p $(BDW_WRAPDIR); fi
	$(BDW_WRAPGEN_COMMAND) -project project.tcl -module fedec "-I$(BDW_WRAPDIR) $(BDW_LIB_DASHI) $(BDW_CCOPTIONS) $(BDW_EXTRA_CCFLAGS)"
	@touch $(BDW_WRAPDIR)/fedec.updated
	$(STRATUS_HOME)/bin/bdw_tracegen -module fedec  
	@touch $(BDW_WORKLIB)/wrappers/fedec_trace.h.updated

$(BDW_WORKLIB)/wrappers/fedec_wrap.d :  ../src/fedec.cpp $(BDW_WORKLIB)/wrappers/fedec_wrap.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@set -e; $(BDW_CCDEP) -MM -MG $(BDW_CCFLAGS) -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  ../src/fedec.cpp \
		| sed 's|fedec\.o[ :]*|$(BDW_WRAPDIR)/fedec.updated $(BDW_WORKLIB)/wrappers/fedec_wrap.d :  memlib/memlib.bdl |' $(BDW_DEP_FILTER) > $(BDW_WORKLIB)/wrappers/fedec_wrap.d 




##############################################################
## HLS Module "fedec" - cynthConfigs
##############################################################


#
# HLS config PIN
#

#
#	stratus_hls rule
#
LIB_DIRS_fedec_PIN = $(memlib_SRCDIR) 
LIB_INCLUDES_fedec_PIN = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_fedec_PIN))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_fedec_PIN = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_fedec_PIN = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_fedec_PIN = 
EXTRACT_LIB_DASHI_fedec_PIN = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl fedec PIN]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_fedec_PIN = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/fedec/PIN/c_parts  -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_fedec_PIN)
CCFLAGS_COSIM_fedec_PIN = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/fedec/PIN/c_parts  -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_fedec_PIN)
CCFLAGS_BEH_fedec_PIN = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/fedec/PIN/c_parts  -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_fedec_PIN)
CCFLAGS_fedec_PIN += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_fedec_PIN += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_fedec_PIN += ${BDW_CCFLAGS_TAIL}

.PHONY: hlsc_fedec_PIN hls_fedec_PIN

hls_fedec_PIN : hlsc_fedec_PIN

cynth_fedec_PIN : hlsc_fedec_PIN

elab_fedec_PIN : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/fedec/PIN/stratus_hls.bdr

optim_fedec_PIN : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/fedec/PIN/stratus_hls.bdr

sched_fedec_PIN : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/fedec/PIN/stratus_hls.bdr

hlsc_fedec_PIN : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/fedec/PIN/fedec_rtl.cpp BDW_DEP_CYNTH_CONFIG=PIN BDW_MODULE=fedec BDW_HLS_CONFIG=PIN 
else
	@bdw_exec -jobproject project.tcl -job hls.fedec.PIN $(MAKE) CWBExec_hls=1 hlsc_fedec_PIN
endif

clean_cynth_fedec_PIN: clean_hls_fedec_PIN

clean_fedec_PIN: clean_hls_fedec_PIN

clean_hls_fedec_PIN:
	@rm -rf $(BDW_WORKLIB)/modules/fedec/PIN
	@rm -rf $(BDW_WORKLIB)/jobs/hls.fedec.PIN
	@rm -rf $(BDW_WORKLIB)/jobs/hls.fedec.PIN.s

kill_hls_fedec_PIN:
	@bdw_kill -job hls.fedec.PIN
	@bdw_kill -job hls.fedec.PIN.s


hls_fedec_PIN_% : hlsc_fedec_PIN_%

cynth_fedec_PIN_% : hlsc_fedec_PIN_%

elab_fedec_PIN_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(subst /PIN/,/PIN_$(*F)/,$(BDW_WORKLIB)/modules/fedec/PIN/stratus_hls.bdr)

optim_fedec_PIN_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(subst /PIN/,/PIN_$(*F)/,$(BDW_WORKLIB)/modules/fedec/PIN/stratus_hls.bdr)

sched_fedec_PIN_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(subst /PIN/,/PIN_$(*F)/,$(BDW_WORKLIB)/modules/fedec/PIN/stratus_hls.bdr)

hlsc_fedec_PIN_% hls_fedec_PIN_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /PIN/,/PIN_$(*F)/,$(BDW_WORKLIB)/modules/fedec/PIN/fedec_rtl.cpp) BDW_DEP_CYNTH_CONFIG=PIN BDW_MODULE=fedec BDW_HLS_CONFIG=PIN_$(*F) 
else
	@bdw_exec -jobproject project.tcl -job hls.fedec.PIN_$(*F) $(MAKE) CWBExec_hls=1 hlsc_fedec_PIN_$(*F)
endif

clean_cynth_fedec_PIN_%: clean_hls_fedec_PIN_%

clean_fedec_PIN_%: clean_hls_fedec_PIN_%

clean_hls_fedec_PIN_%:
	@rm -rf $(BDW_WORKLIB)/modules/fedec/PIN_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.fedec.PIN_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.fedec.PIN_$(*F).s

kill_hls_fedec_PIN_%:
	@bdw_kill -job hls.fedec.PIN_$(*F)
	@bdw_kill -job hls.fedec.PIN_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),PIN)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/fedec/PIN/fedec.d
                -include $(memlib_WORKLIB)/memlib.d
                BDW_LIB_DEPS =  $(memlib_DEPS)
            endif
        endif
    endif
endif


html_fedec_PIN :
	bdw_htmlgen -project project.tcl -module fedec -cynthconfig PIN

BDW_fedec_PIN_HLS_TARGETS := $(BDW_WORKLIB)/modules/fedec/PIN/fedec_rtl.cpp $(BDW_WORKLIB)/modules/fedec/PIN/fedec_rtl.v $(BDW_WORKLIB)/modules/fedec/PIN/stratus_hls.bdr
ifeq ($(BDW_BDR_ONLY),1)
.PHONY: $(filter %.bdr %.cpp,$(BDW_fedec_PIN_HLS_TARGETS))
$(filter %.v %.cpp,$(BDW_fedec_PIN_HLS_TARGETS)) : $(filter %.bdr,$(BDW_fedec_PIN_HLS_TARGETS))
BDW_fedec_PIN_HLS_TARGETS := $(filter %.bdr,$(BDW_fedec_PIN_HLS_TARGETS))
endif
BDW_fedec_PIN_HLS_SPEC_TARGETS = $(subst /PIN/,/PIN_%/,$(BDW_fedec_PIN_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_fedec_PIN_HLS_TARGETS) :  ../src/fedec.cpp   $(BDW_LIB_DEPS)
	+make --no-print-directory  $(BDW_WORKLIB)/wrappers/hl5_wrap.h
	@if [ ! -d $(BDW_WORKLIB)/modules/fedec/PIN ]; then mkdir -p $(BDW_WORKLIB)/modules/fedec/PIN; fi
	
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=PIN BDW_CYNTH_CONFIG=PIN \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/fedec/PIN/fedec_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/fedec/PIN/fedec_rtl.cpp \
		BDW_MODULE=fedec \
		BDW_CYNTH_CONFIG=PIN \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/fedec/PIN \
		BDW_HLS_CONFIG=PIN \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/fedec/PIN \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_fedec_PIN)  \
		-d $(BDW_WORKLIB)/modules/fedec/PIN -o fedec_rtl.cpp \
		--hls_module=fedec --hls_config=PIN --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_fedec_PIN))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_fedec_PIN))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_fedec_PIN))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_fedec_PIN)   \
		 ../src/fedec.cpp
	
	
	
	

else

$(BDW_fedec_PIN_HLS_TARGETS) :  ../src/fedec.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.fedec.PIN.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_fedec_PIN_HLS_TARGETS)

endif

	
$(BDW_WORKLIB)/modules/fedec/PIN/fedec_trace.h : $(BDW_WORKLIB)/modules/fedec/PIN/fedec_trace.h.updated

$(BDW_WORKLIB)/modules/fedec/PIN/fedec_trace.h.updated : $(BDW_WORKLIB)/modules/fedec/PIN/fedec_rtl.cpp $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module fedec -cynthconfig PIN  
	@touch $(BDW_WORKLIB)/modules/fedec/PIN/fedec_trace.h.updated

ifeq ($(CWBExec_hlsc),1)

$(BDW_fedec_PIN_HLS_SPEC_TARGETS) :  ../src/fedec.cpp   $(BDW_LIB_DEPS)
	+make --no-print-directory  $(BDW_WORKLIB)/wrappers/hl5_wrap.h
	@if [ ! -d $(BDW_WORKLIB)/modules/fedec/PIN_$(*F) ]; then mkdir -p $(BDW_WORKLIB)/modules/fedec/PIN_$(*F); fi
	
	
	$(subst /PIN ,/PIN_$(*F) ,$(subst =PIN ,=PIN_$(*F) ,$(subst /fedec/PIN/,/fedec/PIN_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=PIN BDW_CYNTH_CONFIG=PIN \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/fedec/PIN/fedec_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/fedec/PIN/fedec_rtl.cpp \
		BDW_MODULE=fedec \
		BDW_CYNTH_CONFIG=PIN \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/fedec/PIN \
		BDW_HLS_CONFIG=PIN \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/fedec/PIN \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_fedec_PIN)  \
		`cat  $(BDW_SPECLIB)/fedec/PIN.$(*F).bds | grep '^cmdline:' | sed 's/^cmdline://'`\
		-d $(BDW_WORKLIB)/modules/fedec/PIN -o fedec_rtl.cpp \
		--hls_module=fedec --hls_config=PIN --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_fedec_PIN))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_fedec_PIN))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_fedec_PIN))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_fedec_PIN)   \
		 ../src/fedec.cpp)))
	
	
	
	

else

$(BDW_fedec_PIN_HLS_SPEC_TARGETS) :  ../src/fedec.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.fedec.PIN_$(*F).s $(MAKE) -j1 CWBExec_hlsc=1 $(subst %,$(*F),$(BDW_fedec_PIN_HLS_SPEC_TARGETS))

endif

	

$(subst /PIN/,/PIN_%/,$(BDW_WORKLIB)/modules/fedec/PIN/fedec_trace.h) : $(subst /PIN/,/PIN_%/,$(BDW_WORKLIB)/modules/fedec/PIN/fedec_rtl.cpp) $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module fedec -cynthconfig PIN_$(*F)  

catHLLog_fedec_PIN:
	cat $(BDW_WORKLIB)/modules/fedec/PIN/stratus_hls.log

#
#	stratus_vlg rule
#
cynthvlg_fedec_PIN : hls_fedec_PIN 


