ifeq ($(CWBExec_view),1)
view_PIPE_SOFT_MIXED_aes256_GP:
	@if [ -e $(BDW_WORKLIB)/sims/PIPE_SOFT_MIXED_aes256_GP/PIPE_SOFT_MIXED_aes256_GP.shm ]; then \
	bdw_view_waveform -project project.tcl -simconfig PIPE_SOFT_MIXED_aes256_GP ;\
	else   \
	$(MAKE) sim_PIPE_SOFT_MIXED_aes256_GP ;\
	bdw_view_waveform -project project.tcl -simconfig PIPE_SOFT_MIXED_aes256_GP ;\
    fi
else
view_PIPE_SOFT_MIXED_aes256_GP:
	@bdw_exec -jobproject project.tcl -job view.PIPE_SOFT_MIXED_aes256_GP $(MAKE) CWBExec_view=1 view_PIPE_SOFT_MIXED_aes256_GP
endif
    



