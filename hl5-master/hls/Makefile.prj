		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_hl5_PIPE_SOFT3)   \
		 ../src/hl5.cpp)))
	
	
	
	

else

