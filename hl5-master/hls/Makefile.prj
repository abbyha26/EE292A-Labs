	@if [ ! -d $(memwb_BASIC_POFF_WORKLIB) ]; then mkdir -p $(memwb_BASIC_POFF_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(memwb_BASIC_POFF_SRCDIR) -o $(memwb_BASIC_POFF_WORKLIB)/Makefile -module memwb -cynthconfig BASIC_POFF   

$(memwb_BASIC_POFF_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(memwb_BASIC_POFF_WORKLIB) ]; then mkdir -p $(memwb_BASIC_POFF_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



prep_c_memwb_BASIC_POFF_% : $(subst BASIC_POFF,BASIC_POFF_%,$(memwb_BASIC_POFF_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst BASIC_POFF,BASIC_POFF_$(*F),$(memwb_BASIC_POFF_WORKLIB)) prep_c

prep_vlog_memwb_BASIC_POFF_% : $(subst BASIC_POFF,BASIC_POFF_%,$(memwb_BASIC_POFF_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst BASIC_POFF,BASIC_POFF_$(*F),$(memwb_BASIC_POFF_WORKLIB)) prep_vlog

prep_memwb_BASIC_POFF_% : $(subst BASIC_POFF,BASIC_POFF_%,$(memwb_BASIC_POFF_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst BASIC_POFF,BASIC_POFF_$(*F),$(memwb_BASIC_POFF_WORKLIB)) prep

$(subst BASIC_POFF,BASIC_POFF_%,$(memwb_BASIC_POFF_WORKLIB))/Makefile : $(memwb_BASIC_POFF_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(subst BASIC_POFF,BASIC_POFF_$(*F),$(memwb_BASIC_POFF_WORKLIB)) ]; then mkdir -p $(subst BASIC_POFF,BASIC_POFF_$(*F),$(memwb_BASIC_POFF_WORKLIB)); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(memwb_BASIC_POFF_SRCDIR)_$(*F) -o $(subst BASIC_POFF,BASIC_POFF_$(*F),$(memwb_BASIC_POFF_WORKLIB))/Makefile -module memwb -cynthconfig BASIC_POFF_$(*F)   

$(memwb_BASIC_POFF_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(subst BASIC_POFF,BASIC_POFF_$(*F),$(memwb_BASIC_POFF_WORKLIB)) ]; then mkdir -p $(subst BASIC_POFF,BASIC_POFF_$(*F),$(memwb_BASIC_POFF_WORKLIB)); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(memwb_BASIC_POFF_WORKLIB)/memwb_BASIC_POFF.d :
	@if [ ! -d $(memwb_BASIC_POFF_WORKLIB) ]; then mkdir -p $(memwb_BASIC_POFF_WORKLIB); fi
	@touch $(memwb_BASIC_POFF_WORKLIB)/memwb_BASIC_POFF.d



#
# HLS config DPA
#

#
#	stratus_hls rule
#
LIB_DIRS_memwb_DPA = $(memlib_SRCDIR) 
LIB_INCLUDES_memwb_DPA = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_memwb_DPA))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_memwb_DPA = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_memwb_DPA = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_memwb_DPA = 
EXTRACT_LIB_DASHI_memwb_DPA = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl memwb DPA]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_memwb_DPA = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/memwb/DPA/c_parts -DDPA=1 -DBDW_RTL_memwb_DPA=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_memwb_DPA)
CCFLAGS_COSIM_memwb_DPA = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/memwb/DPA/c_parts -DDPA=1 -DBDW_RTL_memwb_DPA=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_memwb_DPA)
CCFLAGS_BEH_memwb_DPA = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/memwb/DPA/c_parts -DDPA=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN   $(LIB_INCLUDES_memwb_DPA)
CCFLAGS_memwb_DPA += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_memwb_DPA += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_memwb_DPA += ${BDW_CCFLAGS_TAIL}

.PHONY: hlsc_memwb_DPA hls_memwb_DPA

hls_memwb_DPA : hlsc_memwb_DPA

cynth_memwb_DPA : hlsc_memwb_DPA

elab_memwb_DPA : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/memwb/DPA/stratus_hls.bdr

optim_memwb_DPA : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/memwb/DPA/stratus_hls.bdr

sched_memwb_DPA : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/memwb/DPA/stratus_hls.bdr

hlsc_memwb_DPA : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/memwb/DPA/memwb_rtl.cpp BDW_DEP_CYNTH_CONFIG=DPA BDW_MODULE=memwb BDW_HLS_CONFIG=DPA 
else
	@bdw_exec -jobproject project.tcl -job hls.memwb.DPA $(MAKE) CWBExec_hls=1 hlsc_memwb_DPA
endif

clean_cynth_memwb_DPA: clean_hls_memwb_DPA

clean_memwb_DPA: clean_hls_memwb_DPA

clean_hls_memwb_DPA:
	@rm -rf $(BDW_WORKLIB)/modules/memwb/DPA
	@rm -rf $(BDW_WORKLIB)/jobs/hls.memwb.DPA
	@rm -rf $(BDW_WORKLIB)/jobs/hls.memwb.DPA.s

kill_hls_memwb_DPA:
	@bdw_kill -job hls.memwb.DPA
	@bdw_kill -job hls.memwb.DPA.s


hls_memwb_DPA_% : hlsc_memwb_DPA_%

cynth_memwb_DPA_% : hlsc_memwb_DPA_%

elab_memwb_DPA_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(subst /DPA/,/DPA_$(*F)/,$(BDW_WORKLIB)/modules/memwb/DPA/stratus_hls.bdr)

optim_memwb_DPA_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(subst /DPA/,/DPA_$(*F)/,$(BDW_WORKLIB)/modules/memwb/DPA/stratus_hls.bdr)

sched_memwb_DPA_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(subst /DPA/,/DPA_$(*F)/,$(BDW_WORKLIB)/modules/memwb/DPA/stratus_hls.bdr)

hlsc_memwb_DPA_% hls_memwb_DPA_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /DPA/,/DPA_$(*F)/,$(BDW_WORKLIB)/modules/memwb/DPA/memwb_rtl.cpp) BDW_DEP_CYNTH_CONFIG=DPA BDW_MODULE=memwb BDW_HLS_CONFIG=DPA_$(*F) 
else
	@bdw_exec -jobproject project.tcl -job hls.memwb.DPA_$(*F) $(MAKE) CWBExec_hls=1 hlsc_memwb_DPA_$(*F)
endif

clean_cynth_memwb_DPA_%: clean_hls_memwb_DPA_%

clean_memwb_DPA_%: clean_hls_memwb_DPA_%

clean_hls_memwb_DPA_%:
	@rm -rf $(BDW_WORKLIB)/modules/memwb/DPA_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.memwb.DPA_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.memwb.DPA_$(*F).s

kill_hls_memwb_DPA_%:
	@bdw_kill -job hls.memwb.DPA_$(*F)
	@bdw_kill -job hls.memwb.DPA_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),DPA)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/memwb/DPA/memwb.d
                -include $(memlib_WORKLIB)/memlib.d
                BDW_LIB_DEPS =  $(memlib_DEPS)
            endif
        endif
    endif
endif


html_memwb_DPA :
	bdw_htmlgen -project project.tcl -module memwb -cynthconfig DPA

BDW_memwb_DPA_HLS_TARGETS := $(BDW_WORKLIB)/modules/memwb/DPA/memwb_rtl.cpp $(BDW_WORKLIB)/modules/memwb/DPA/memwb_rtl.v $(BDW_WORKLIB)/modules/memwb/DPA/stratus_hls.bdr
ifeq ($(BDW_BDR_ONLY),1)
.PHONY: $(filter %.bdr %.cpp,$(BDW_memwb_DPA_HLS_TARGETS))
$(filter %.v %.cpp,$(BDW_memwb_DPA_HLS_TARGETS)) : $(filter %.bdr,$(BDW_memwb_DPA_HLS_TARGETS))
BDW_memwb_DPA_HLS_TARGETS := $(filter %.bdr,$(BDW_memwb_DPA_HLS_TARGETS))
endif
BDW_memwb_DPA_HLS_SPEC_TARGETS = $(subst /DPA/,/DPA_%/,$(BDW_memwb_DPA_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_memwb_DPA_HLS_TARGETS) :  ../src/memwb.cpp   $(BDW_LIB_DEPS)
	+make --no-print-directory  $(BDW_WORKLIB)/wrappers/hl5_wrap.h
	@if [ ! -d $(BDW_WORKLIB)/modules/memwb/DPA ]; then mkdir -p $(BDW_WORKLIB)/modules/memwb/DPA; fi
	
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=DPA BDW_CYNTH_CONFIG=DPA \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/memwb/DPA/memwb_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/memwb/DPA/memwb_rtl.cpp \
		BDW_MODULE=memwb \
		BDW_CYNTH_CONFIG=DPA \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/memwb/DPA \
		BDW_HLS_CONFIG=DPA \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/memwb/DPA \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_memwb_DPA)  \
		-d $(BDW_WORKLIB)/modules/memwb/DPA -o memwb_rtl.cpp \
		--hls_module=memwb --hls_config=DPA --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_memwb_DPA))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_memwb_DPA))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_memwb_DPA))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_memwb_DPA)   \
		 ../src/memwb.cpp
	
	
	
	

else

$(BDW_memwb_DPA_HLS_TARGETS) :  ../src/memwb.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.memwb.DPA.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_memwb_DPA_HLS_TARGETS)

endif

	
$(BDW_WORKLIB)/modules/memwb/DPA/memwb_trace.h : $(BDW_WORKLIB)/modules/memwb/DPA/memwb_trace.h.updated

$(BDW_WORKLIB)/modules/memwb/DPA/memwb_trace.h.updated : $(BDW_WORKLIB)/modules/memwb/DPA/memwb_rtl.cpp $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module memwb -cynthconfig DPA  
	@touch $(BDW_WORKLIB)/modules/memwb/DPA/memwb_trace.h.updated

ifeq ($(CWBExec_hlsc),1)

$(BDW_memwb_DPA_HLS_SPEC_TARGETS) :  ../src/memwb.cpp   $(BDW_LIB_DEPS)
	+make --no-print-directory  $(BDW_WORKLIB)/wrappers/hl5_wrap.h
	@if [ ! -d $(BDW_WORKLIB)/modules/memwb/DPA_$(*F) ]; then mkdir -p $(BDW_WORKLIB)/modules/memwb/DPA_$(*F); fi
	
	
	$(subst /DPA ,/DPA_$(*F) ,$(subst =DPA ,=DPA_$(*F) ,$(subst /memwb/DPA/,/memwb/DPA_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=DPA BDW_CYNTH_CONFIG=DPA \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/memwb/DPA/memwb_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/memwb/DPA/memwb_rtl.cpp \
		BDW_MODULE=memwb \
		BDW_CYNTH_CONFIG=DPA \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/memwb/DPA \
		BDW_HLS_CONFIG=DPA \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/memwb/DPA \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_memwb_DPA)  \
		`cat  $(BDW_SPECLIB)/memwb/DPA.$(*F).bds | grep '^cmdline:' | sed 's/^cmdline://'`\
		-d $(BDW_WORKLIB)/modules/memwb/DPA -o memwb_rtl.cpp \
		--hls_module=memwb --hls_config=DPA --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_memwb_DPA))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_memwb_DPA))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_memwb_DPA))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_memwb_DPA)   \
		 ../src/memwb.cpp)))
	
	
	
	

else

$(BDW_memwb_DPA_HLS_SPEC_TARGETS) :  ../src/memwb.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.memwb.DPA_$(*F).s $(MAKE) -j1 CWBExec_hlsc=1 $(subst %,$(*F),$(BDW_memwb_DPA_HLS_SPEC_TARGETS))

endif

	

$(subst /DPA/,/DPA_%/,$(BDW_WORKLIB)/modules/memwb/DPA/memwb_trace.h) : $(subst /DPA/,/DPA_%/,$(BDW_WORKLIB)/modules/memwb/DPA/memwb_rtl.cpp) $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module memwb -cynthconfig DPA_$(*F)  

catHLLog_memwb_DPA:
	cat $(BDW_WORKLIB)/modules/memwb/DPA/stratus_hls.log

#
#	stratus_vlg rule
#
cynthvlg_memwb_DPA : hls_memwb_DPA 


.PHONY: hls_memwb_DPA

hls_memwb_DPA hlsv_memwb_DPA: $(addprefix prep_vlog_,$(LIB_NAMES_FOR_VLOG_memwb_DPA)) 

.PHONY: hls_memwb_DPA

hls_memwb_DPA_% hlsv_memwb_DPA_%: $(addprefix prep_vlog_,$(LIB_NAMES_FOR_VLOG_memwb_DPA)) 

catVLGLog_memwb_DPA : catHLLog_memwb_DPA
	cat $(BDW_WORKLIB)/modules/memwb/DPA/stratus_vlg.log

#
#	view rule
#

view_memwb_DPA:
	@echo "ERROR: Schematic viewing target 'view_memwb_DPA' is only supported with 'verdi'"
	@echo "The Stratus IDE includes a schematic view as an alternative."


#
#	RTL object file rule
#
$(BDW_WORKLIB)/modules/memwb/DPA/xcelium/memwb_rtl.o : $(BDW_WORKLIB)/modules/memwb/DPA/memwb_rtl.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(BDW_WORKLIB)/modules/memwb/DPA/memwb_trace.h
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl memwb`
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/DPA/ -I./ $(CCFLAGS_memwb_DPA) $(EXTRACT_LIB_DASHI_memwb_DPA) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/memwb/DPA/xcelium/memwb_rtl.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp

$(BDW_WORKLIB)/modules/memwb/DPA/xcelium/debug/memwb_rtl.o : $(BDW_WORKLIB)/modules/memwb/DPA/memwb_rtl.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(BDW_WORKLIB)/modules/memwb/DPA/memwb_trace.h
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl memwb`
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/DPA/ -I./ $(CCFLAGS_memwb_DPA) $(EXTRACT_LIB_DASHI_memwb_DPA) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/memwb/DPA/xcelium/debug/memwb_rtl.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp

#
#	Behavioral object file rule.  Used only for BEH configs that are 
#	associated with HLS config names.
#

$(BDW_WORKLIB)/modules/memwb/DPA/xcelium/memwb_beh.o :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(BDW_WORKLIB)/wrappers/memwb_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/DPA/ -I./ $(CCFLAGS_BEH_memwb_DPA) -o $(BDW_WORKLIB)/modules/memwb/DPA/xcelium/memwb_beh.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp

$(BDW_WORKLIB)/modules/memwb/DPA/xcelium/debug/memwb_beh.o :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(BDW_WORKLIB)/wrappers/memwb_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/DPA/ -I./ $(CCFLAGS_BEH_memwb_DPA) -o $(BDW_WORKLIB)/modules/memwb/DPA/xcelium/debug/memwb_beh.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp

#
# Cosim object file rule
#

$(BDW_WORKLIB)/modules/memwb/DPA/xcelium/memwb.o :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(BDW_WORKLIB)/wrappers/memwb_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/DPA/ -I./ $(CCFLAGS_COSIM_memwb_DPA) -o $(BDW_WORKLIB)/modules/memwb/DPA/xcelium/memwb.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp
    

$(BDW_WORKLIB)/modules/memwb/DPA/xcelium/memwb_hoist.o :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(BDW_WORKLIB)/wrappers/memwb_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/DPA/ -I./ $(CCFLAGS_memwb_DPA) $(EXTRACT_LIB_DASHI_memwb_DPA) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/memwb/DPA/xcelium/memwb_hoist.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp
    

$(BDW_WORKLIB)/modules/memwb/DPA/xcelium/debug/memwb.o :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(BDW_WORKLIB)/wrappers/memwb_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/DPA/ -I./ $(CCFLAGS_COSIM_memwb_DPA) -o $(BDW_WORKLIB)/modules/memwb/DPA/xcelium/debug/memwb.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp


$(BDW_WORKLIB)/modules/memwb/DPA/xcelium/debug/memwb_hoist.o :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(BDW_WORKLIB)/wrappers/memwb_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/DPA/ -I./ $(CCFLAGS_memwb_DPA) $(EXTRACT_LIB_DASHI_memwb_DPA) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/memwb/DPA/xcelium/debug/memwb_hoist.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp
    

view_memwb_DPA_%:
	@echo "ERROR: Schematic viewing target 'view_memwb_DPA_$(*F)' is only supported with 'verdi'"
	@echo "The Stratus IDE includes a schematic view as an alternative."

ifneq ($(BDW_SPEC_NAME),)
#
#	RTL object file rule
#
$(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/DPA/xcelium/memwb_rtl.o) : $(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/DPA/memwb_rtl.cpp) $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/DPA/memwb_trace.h)
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl memwb`
	$(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/DPA/ -I./ $(CCFLAGS_memwb_DPA) $(EXTRACT_LIB_DASHI_memwb_DPA) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/memwb/DPA/xcelium/memwb_rtl.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp)

$(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/DPA/xcelium/debug/memwb_rtl.o) : $(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/DPA/memwb_rtl.cpp) $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/DPA/memwb_trace.h)
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl memwb`
	$(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/DPA/ -I./ $(CCFLAGS_memwb_DPA) $(EXTRACT_LIB_DASHI_memwb_DPA) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/memwb/DPA/xcelium/debug/memwb_rtl.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp)

#
#	Behavioral object file rule.  Used only for BEH configs that are 
#	associated with HLS config names.
#

$(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/DPA/xcelium/memwb_beh.o) :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/memwb_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/DPA/ -I./ $(CCFLAGS_BEH_memwb_DPA) -o $(BDW_WORKLIB)/modules/memwb/DPA/xcelium/memwb_beh.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp)

$(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/DPA/xcelium/debug/memwb_beh.o) :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/memwb_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/DPA/ -I./ $(CCFLAGS_BEH_memwb_DPA) -o $(BDW_WORKLIB)/modules/memwb/DPA/xcelium/debug/memwb_beh.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp)

#
# Cosim object file rule
#

$(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/DPA/xcelium/memwb.o) :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/memwb_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/DPA/ -I./ $(CCFLAGS_COSIM_memwb_DPA) -o $(BDW_WORKLIB)/modules/memwb/DPA/xcelium/memwb.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp)
    

$(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/DPA/xcelium/memwb_hoist.o) :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/memwb_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/DPA/ -I./ $(CCFLAGS_memwb_DPA) $(EXTRACT_LIB_DASHI_memwb_DPA) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/memwb/DPA/xcelium/memwb_hoist.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp)
    

$(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/DPA/xcelium/debug/memwb.o) :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/memwb_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/DPA/ -I./ $(CCFLAGS_COSIM_memwb_DPA) -o $(BDW_WORKLIB)/modules/memwb/DPA/xcelium/debug/memwb.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp)


$(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/memwb/DPA/xcelium/debug/memwb_hoist.o) :  ../src/memwb.cpp $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp $(BDW_WORKLIB)/wrappers/memwb_cosim.h $(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/memwb_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /DPA/,/DPA$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/memwb/DPA/ -I./ $(CCFLAGS_memwb_DPA) $(EXTRACT_LIB_DASHI_memwb_DPA) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/memwb/DPA/xcelium/debug/memwb_hoist.o " $(BDW_WORKLIB)/wrappers/memwb_wrap.cpp)
    
endif

#
#	Dependency generation rule
#
$(BDW_WORKLIB)/modules/memwb/DPA/memwb.d :  ../src/memwb.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config DPA of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_memwb_DPA)  ../src/memwb.cpp \
	| sed 's|memwb\.o[ :]*|$(BDW_WORKLIB)/modules/memwb/DPA/memwb_rtl.cpp $(BDW_WORKLIB)/modules/memwb/DPA/xcelium/memwb_beh.o $(BDW_WORKLIB)/modules/memwb/DPA/xcelium/debug/memwb_beh.o $(BDW_WORKLIB)/modules/memwb/DPA/memwb.d : $(memlib_WORKLIB)/memlib.d |' $(BDW_DEP_FILTER)  > $@

#
#	Library post-proc rules
#



##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/memwb/DPA"
##############################################################

memwb_DPA_SRCDIR = $(BDW_WORKLIB)/modules/memwb/DPA
memwb_DPA_BEH_SRCDIR = $(BDW_WORKLIB)/libs/memwb_DPA
memwb_DPA_LIBNAME = memwb_DPA
memwb_DPA_WORKLIB = $(BDW_WORKLIB)/modules/memwb/DPA/xcelium
memwb_DPA_C_PARTS_A = $(memwb_DPA_WORKLIB)/objs/libmemwb_DPA.a

prep_c_memwb_DPA : $(memwb_DPA_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(memwb_DPA_WORKLIB) prep_c

prep_vlog_memwb_DPA : $(memwb_DPA_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(memwb_DPA_WORKLIB) prep_vlog

prep_memwb_DPA : $(memwb_DPA_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(memwb_DPA_WORKLIB) prep

$(memwb_DPA_WORKLIB)/Makefile : $(memwb_DPA_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(memwb_DPA_WORKLIB) ]; then mkdir -p $(memwb_DPA_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(memwb_DPA_SRCDIR) -o $(memwb_DPA_WORKLIB)/Makefile -module memwb -cynthconfig DPA   

$(memwb_DPA_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(memwb_DPA_WORKLIB) ]; then mkdir -p $(memwb_DPA_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



prep_c_memwb_DPA_% : $(subst DPA,DPA_%,$(memwb_DPA_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst DPA,DPA_$(*F),$(memwb_DPA_WORKLIB)) prep_c

prep_vlog_memwb_DPA_% : $(subst DPA,DPA_%,$(memwb_DPA_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst DPA,DPA_$(*F),$(memwb_DPA_WORKLIB)) prep_vlog

prep_memwb_DPA_% : $(subst DPA,DPA_%,$(memwb_DPA_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst DPA,DPA_$(*F),$(memwb_DPA_WORKLIB)) prep

$(subst DPA,DPA_%,$(memwb_DPA_WORKLIB))/Makefile : $(memwb_DPA_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(subst DPA,DPA_$(*F),$(memwb_DPA_WORKLIB)) ]; then mkdir -p $(subst DPA,DPA_$(*F),$(memwb_DPA_WORKLIB)); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(memwb_DPA_SRCDIR)_$(*F) -o $(subst DPA,DPA_$(*F),$(memwb_DPA_WORKLIB))/Makefile -module memwb -cynthconfig DPA_$(*F)   

$(memwb_DPA_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(subst DPA,DPA_$(*F),$(memwb_DPA_WORKLIB)) ]; then mkdir -p $(subst DPA,DPA_$(*F),$(memwb_DPA_WORKLIB)); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(memwb_DPA_WORKLIB)/memwb_DPA.d :
	@if [ ! -d $(memwb_DPA_WORKLIB) ]; then mkdir -p $(memwb_DPA_WORKLIB); fi
	@touch $(memwb_DPA_WORKLIB)/memwb_DPA.d



#
# HLS config PIPE_SOFT1
#

#
#	stratus_hls rule
#
LIB_DIRS_memwb_PIPE_SOFT1 = $(memlib_SRCDIR) 
LIB_INCLUDES_memwb_PIPE_SOFT1 = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_memwb_PIPE_SOFT1))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_memwb_PIPE_SOFT1 = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_memwb_PIPE_SOFT1 = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_memwb_PIPE_SOFT1 = 
EXTRACT_LIB_DASHI_memwb_PIPE_SOFT1 = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl memwb PIPE_SOFT1]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_memwb_PIPE_SOFT1 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT1/c_parts -DPIPE_SOFT1=1 -DBDW_RTL_memwb_PIPE_SOFT1=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DPIPE_SOFT_STALL1=1 $(LIB_INCLUDES_memwb_PIPE_SOFT1)
CCFLAGS_COSIM_memwb_PIPE_SOFT1 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT1/c_parts -DPIPE_SOFT1=1 -DBDW_RTL_memwb_PIPE_SOFT1=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DPIPE_SOFT_STALL1=1 $(LIB_INCLUDES_memwb_PIPE_SOFT1)
CCFLAGS_BEH_memwb_PIPE_SOFT1 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT1/c_parts -DPIPE_SOFT1=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DPIPE_SOFT_STALL1=1 $(LIB_INCLUDES_memwb_PIPE_SOFT1)
CCFLAGS_memwb_PIPE_SOFT1 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_memwb_PIPE_SOFT1 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_memwb_PIPE_SOFT1 += ${BDW_CCFLAGS_TAIL}

.PHONY: hlsc_memwb_PIPE_SOFT1 hls_memwb_PIPE_SOFT1

hls_memwb_PIPE_SOFT1 : hlsc_memwb_PIPE_SOFT1

cynth_memwb_PIPE_SOFT1 : hlsc_memwb_PIPE_SOFT1

elab_memwb_PIPE_SOFT1 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT1/stratus_hls.bdr

optim_memwb_PIPE_SOFT1 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT1/stratus_hls.bdr

sched_memwb_PIPE_SOFT1 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT1/stratus_hls.bdr

hlsc_memwb_PIPE_SOFT1 : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT1/memwb_rtl.cpp BDW_DEP_CYNTH_CONFIG=PIPE_SOFT1 BDW_MODULE=memwb BDW_HLS_CONFIG=PIPE_SOFT1 
else
	@bdw_exec -jobproject project.tcl -job hls.memwb.PIPE_SOFT1 $(MAKE) CWBExec_hls=1 hlsc_memwb_PIPE_SOFT1
endif

clean_cynth_memwb_PIPE_SOFT1: clean_hls_memwb_PIPE_SOFT1

clean_memwb_PIPE_SOFT1: clean_hls_memwb_PIPE_SOFT1

clean_hls_memwb_PIPE_SOFT1:
	@rm -rf $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT1
	@rm -rf $(BDW_WORKLIB)/jobs/hls.memwb.PIPE_SOFT1
	@rm -rf $(BDW_WORKLIB)/jobs/hls.memwb.PIPE_SOFT1.s

kill_hls_memwb_PIPE_SOFT1:
	@bdw_kill -job hls.memwb.PIPE_SOFT1
	@bdw_kill -job hls.memwb.PIPE_SOFT1.s


hls_memwb_PIPE_SOFT1_% : hlsc_memwb_PIPE_SOFT1_%

cynth_memwb_PIPE_SOFT1_% : hlsc_memwb_PIPE_SOFT1_%

elab_memwb_PIPE_SOFT1_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(subst /PIPE_SOFT1/,/PIPE_SOFT1_$(*F)/,$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT1/stratus_hls.bdr)

optim_memwb_PIPE_SOFT1_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(subst /PIPE_SOFT1/,/PIPE_SOFT1_$(*F)/,$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT1/stratus_hls.bdr)

sched_memwb_PIPE_SOFT1_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(subst /PIPE_SOFT1/,/PIPE_SOFT1_$(*F)/,$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT1/stratus_hls.bdr)

hlsc_memwb_PIPE_SOFT1_% hls_memwb_PIPE_SOFT1_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /PIPE_SOFT1/,/PIPE_SOFT1_$(*F)/,$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT1/memwb_rtl.cpp) BDW_DEP_CYNTH_CONFIG=PIPE_SOFT1 BDW_MODULE=memwb BDW_HLS_CONFIG=PIPE_SOFT1_$(*F) 
else
	@bdw_exec -jobproject project.tcl -job hls.memwb.PIPE_SOFT1_$(*F) $(MAKE) CWBExec_hls=1 hlsc_memwb_PIPE_SOFT1_$(*F)
endif

clean_cynth_memwb_PIPE_SOFT1_%: clean_hls_memwb_PIPE_SOFT1_%

clean_memwb_PIPE_SOFT1_%: clean_hls_memwb_PIPE_SOFT1_%

clean_hls_memwb_PIPE_SOFT1_%:
	@rm -rf $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT1_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.memwb.PIPE_SOFT1_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.memwb.PIPE_SOFT1_$(*F).s

kill_hls_memwb_PIPE_SOFT1_%:
	@bdw_kill -job hls.memwb.PIPE_SOFT1_$(*F)
	@bdw_kill -job hls.memwb.PIPE_SOFT1_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),PIPE_SOFT1)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT1/memwb.d
                -include $(memlib_WORKLIB)/memlib.d
                BDW_LIB_DEPS =  $(memlib_DEPS)
            endif
        endif
    endif
endif


html_memwb_PIPE_SOFT1 :
	bdw_htmlgen -project project.tcl -module memwb -cynthconfig PIPE_SOFT1

BDW_memwb_PIPE_SOFT1_HLS_TARGETS := $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT1/memwb_rtl.cpp $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT1/memwb_rtl.v $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT1/stratus_hls.bdr
ifeq ($(BDW_BDR_ONLY),1)
.PHONY: $(filter %.bdr %.cpp,$(BDW_memwb_PIPE_SOFT1_HLS_TARGETS))
$(filter %.v %.cpp,$(BDW_memwb_PIPE_SOFT1_HLS_TARGETS)) : $(filter %.bdr,$(BDW_memwb_PIPE_SOFT1_HLS_TARGETS))
BDW_memwb_PIPE_SOFT1_HLS_TARGETS := $(filter %.bdr,$(BDW_memwb_PIPE_SOFT1_HLS_TARGETS))
endif
BDW_memwb_PIPE_SOFT1_HLS_SPEC_TARGETS = $(subst /PIPE_SOFT1/,/PIPE_SOFT1_%/,$(BDW_memwb_PIPE_SOFT1_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_memwb_PIPE_SOFT1_HLS_TARGETS) :  ../src/memwb.cpp   $(BDW_LIB_DEPS)
	+make --no-print-directory  $(BDW_WORKLIB)/wrappers/hl5_wrap.h
	@if [ ! -d $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT1 ]; then mkdir -p $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT1; fi
	
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=PIPE_SOFT1 BDW_CYNTH_CONFIG=PIPE_SOFT1 \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT1/memwb_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT1/memwb_rtl.cpp \
		BDW_MODULE=memwb \
		BDW_CYNTH_CONFIG=PIPE_SOFT1 \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT1 \
		BDW_HLS_CONFIG=PIPE_SOFT1 \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT1 \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_memwb_PIPE_SOFT1)  \
		-d $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT1 -o memwb_rtl.cpp \
		--hls_module=memwb --hls_config=PIPE_SOFT1 --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_memwb_PIPE_SOFT1))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_memwb_PIPE_SOFT1))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_memwb_PIPE_SOFT1))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_memwb_PIPE_SOFT1)   \
		 ../src/memwb.cpp
	
	
	
	

else

$(BDW_memwb_PIPE_SOFT1_HLS_TARGETS) :  ../src/memwb.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.memwb.PIPE_SOFT1.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_memwb_PIPE_SOFT1_HLS_TARGETS)

endif

	
$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT1/memwb_trace.h : $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT1/memwb_trace.h.updated

$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT1/memwb_trace.h.updated : $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT1/memwb_rtl.cpp $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module memwb -cynthconfig PIPE_SOFT1  
	@touch $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT1/memwb_trace.h.updated

ifeq ($(CWBExec_hlsc),1)

$(BDW_memwb_PIPE_SOFT1_HLS_SPEC_TARGETS) :  ../src/memwb.cpp   $(BDW_LIB_DEPS)
	+make --no-print-directory  $(BDW_WORKLIB)/wrappers/hl5_wrap.h
	@if [ ! -d $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT1_$(*F) ]; then mkdir -p $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT1_$(*F); fi
	
	
	$(subst /PIPE_SOFT1 ,/PIPE_SOFT1_$(*F) ,$(subst =PIPE_SOFT1 ,=PIPE_SOFT1_$(*F) ,$(subst /memwb/PIPE_SOFT1/,/memwb/PIPE_SOFT1_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=PIPE_SOFT1 BDW_CYNTH_CONFIG=PIPE_SOFT1 \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT1/memwb_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT1/memwb_rtl.cpp \
		BDW_MODULE=memwb \
		BDW_CYNTH_CONFIG=PIPE_SOFT1 \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT1 \
		BDW_HLS_CONFIG=PIPE_SOFT1 \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/memwb/PIPE_SOFT1 \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_memwb_PIPE_SOFT1)  \
		`cat  $(BDW_SPECLIB)/memwb/PIPE_SOFT1.$(*F).bds | grep '^cmdline:' | sed 's/^cmdline://'`\
		-d $(BDW_WORKLIB)/modules/memwb/PIPE_SOFT1 -o memwb_rtl.cpp \
		--hls_module=memwb --hls_config=PIPE_SOFT1 --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_memwb_PIPE_SOFT1))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_memwb_PIPE_SOFT1))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_memwb_PIPE_SOFT1))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_memwb_PIPE_SOFT1)   \
		 ../src/memwb.cpp)))
	
	
	
	

else

$(BDW_memwb_PIPE_SOFT1_HLS_SPEC_TARGETS) :  ../src/memwb.cpp  $(BDW_LIB_DEPS)
