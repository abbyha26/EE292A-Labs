$(subst /PIPE_SOFT3/,/PIPE_SOFT3$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT3/xcelium/debug/hl5_hoist.o) :  ../src/hl5.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(subst /PIPE_SOFT3/,/PIPE_SOFT3$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/hl5_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /PIPE_SOFT3/,/PIPE_SOFT3$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT3/ -I./ $(CCFLAGS_hl5_PIPE_SOFT3) $(EXTRACT_LIB_DASHI_hl5_PIPE_SOFT3) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT3/xcelium/debug/hl5_hoist.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp)
    
endif

#
#	Dependency generation rule
#
$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT3/hl5.d :  ../src/hl5.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config PIPE_SOFT3 of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_hl5_PIPE_SOFT3)  ../src/hl5.cpp \
	| sed 's|hl5\.o[ :]*|$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT3/hl5_rtl.cpp $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT3/xcelium/hl5_beh.o $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT3/xcelium/debug/hl5_beh.o $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT3/hl5.d : $(memlib_WORKLIB)/memlib.d |' $(BDW_DEP_FILTER)  > $@

#
#	Library post-proc rules
#



##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/hl5/PIPE_SOFT3"
##############################################################

hl5_PIPE_SOFT3_SRCDIR = $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT3
hl5_PIPE_SOFT3_BEH_SRCDIR = $(BDW_WORKLIB)/libs/hl5_PIPE_SOFT3
hl5_PIPE_SOFT3_LIBNAME = hl5_PIPE_SOFT3
hl5_PIPE_SOFT3_WORKLIB = $(BDW_WORKLIB)/modules/hl5/PIPE_SOFT3/xcelium
hl5_PIPE_SOFT3_C_PARTS_A = $(hl5_PIPE_SOFT3_WORKLIB)/objs/libhl5_PIPE_SOFT3.a

prep_c_hl5_PIPE_SOFT3 : $(hl5_PIPE_SOFT3_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(hl5_PIPE_SOFT3_WORKLIB) prep_c

prep_vlog_hl5_PIPE_SOFT3 : $(hl5_PIPE_SOFT3_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(hl5_PIPE_SOFT3_WORKLIB) prep_vlog

prep_hl5_PIPE_SOFT3 : $(hl5_PIPE_SOFT3_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(hl5_PIPE_SOFT3_WORKLIB) prep

$(hl5_PIPE_SOFT3_WORKLIB)/Makefile : $(hl5_PIPE_SOFT3_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(hl5_PIPE_SOFT3_WORKLIB) ]; then mkdir -p $(hl5_PIPE_SOFT3_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(hl5_PIPE_SOFT3_SRCDIR) -o $(hl5_PIPE_SOFT3_WORKLIB)/Makefile -module hl5 -cynthconfig PIPE_SOFT3   

$(hl5_PIPE_SOFT3_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(hl5_PIPE_SOFT3_WORKLIB) ]; then mkdir -p $(hl5_PIPE_SOFT3_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



prep_c_hl5_PIPE_SOFT3_% : $(subst PIPE_SOFT3,PIPE_SOFT3_%,$(hl5_PIPE_SOFT3_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst PIPE_SOFT3,PIPE_SOFT3_$(*F),$(hl5_PIPE_SOFT3_WORKLIB)) prep_c

prep_vlog_hl5_PIPE_SOFT3_% : $(subst PIPE_SOFT3,PIPE_SOFT3_%,$(hl5_PIPE_SOFT3_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst PIPE_SOFT3,PIPE_SOFT3_$(*F),$(hl5_PIPE_SOFT3_WORKLIB)) prep_vlog

prep_hl5_PIPE_SOFT3_% : $(subst PIPE_SOFT3,PIPE_SOFT3_%,$(hl5_PIPE_SOFT3_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst PIPE_SOFT3,PIPE_SOFT3_$(*F),$(hl5_PIPE_SOFT3_WORKLIB)) prep

$(subst PIPE_SOFT3,PIPE_SOFT3_%,$(hl5_PIPE_SOFT3_WORKLIB))/Makefile : $(hl5_PIPE_SOFT3_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(subst PIPE_SOFT3,PIPE_SOFT3_$(*F),$(hl5_PIPE_SOFT3_WORKLIB)) ]; then mkdir -p $(subst PIPE_SOFT3,PIPE_SOFT3_$(*F),$(hl5_PIPE_SOFT3_WORKLIB)); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(hl5_PIPE_SOFT3_SRCDIR)_$(*F) -o $(subst PIPE_SOFT3,PIPE_SOFT3_$(*F),$(hl5_PIPE_SOFT3_WORKLIB))/Makefile -module hl5 -cynthconfig PIPE_SOFT3_$(*F)   

$(hl5_PIPE_SOFT3_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(subst PIPE_SOFT3,PIPE_SOFT3_$(*F),$(hl5_PIPE_SOFT3_WORKLIB)) ]; then mkdir -p $(subst PIPE_SOFT3,PIPE_SOFT3_$(*F),$(hl5_PIPE_SOFT3_WORKLIB)); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(hl5_PIPE_SOFT3_WORKLIB)/hl5_PIPE_SOFT3.d :
	@if [ ! -d $(hl5_PIPE_SOFT3_WORKLIB) ]; then mkdir -p $(hl5_PIPE_SOFT3_WORKLIB); fi
	@touch $(hl5_PIPE_SOFT3_WORKLIB)/hl5_PIPE_SOFT3.d



#
# HLS config RADIX_2
#

#
#	stratus_hls rule
#
LIB_DIRS_hl5_RADIX_2 = $(memlib_SRCDIR) 
LIB_INCLUDES_hl5_RADIX_2 = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_hl5_RADIX_2))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_hl5_RADIX_2 = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_hl5_RADIX_2 = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_hl5_RADIX_2 = 
EXTRACT_LIB_DASHI_hl5_RADIX_2 = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl hl5 RADIX_2]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_hl5_RADIX_2 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/hl5/RADIX_2/c_parts -DRADIX_2=1 -DBDW_RTL_hl5_RADIX_2=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DDIV_RADIX_2 $(LIB_INCLUDES_hl5_RADIX_2)
CCFLAGS_COSIM_hl5_RADIX_2 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/hl5/RADIX_2/c_parts -DRADIX_2=1 -DBDW_RTL_hl5_RADIX_2=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DDIV_RADIX_2 $(LIB_INCLUDES_hl5_RADIX_2)
CCFLAGS_BEH_hl5_RADIX_2 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/hl5/RADIX_2/c_parts -DRADIX_2=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DDIV_RADIX_2 $(LIB_INCLUDES_hl5_RADIX_2)
CCFLAGS_hl5_RADIX_2 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_hl5_RADIX_2 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_hl5_RADIX_2 += ${BDW_CCFLAGS_TAIL}

.PHONY: hlsc_hl5_RADIX_2 hls_hl5_RADIX_2

hls_hl5_RADIX_2 : hlsc_hl5_RADIX_2

cynth_hl5_RADIX_2 : hlsc_hl5_RADIX_2

elab_hl5_RADIX_2 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/hl5/RADIX_2/stratus_hls.bdr

optim_hl5_RADIX_2 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/hl5/RADIX_2/stratus_hls.bdr

sched_hl5_RADIX_2 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/hl5/RADIX_2/stratus_hls.bdr

hlsc_hl5_RADIX_2 : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/hl5/RADIX_2/hl5_rtl.cpp BDW_DEP_CYNTH_CONFIG=RADIX_2 BDW_MODULE=hl5 BDW_HLS_CONFIG=RADIX_2 
else
	@bdw_exec -jobproject project.tcl -job hls.hl5.RADIX_2 $(MAKE) CWBExec_hls=1 hlsc_hl5_RADIX_2
endif

clean_cynth_hl5_RADIX_2: clean_hls_hl5_RADIX_2

clean_hl5_RADIX_2: clean_hls_hl5_RADIX_2

clean_hls_hl5_RADIX_2:
	@rm -rf $(BDW_WORKLIB)/modules/hl5/RADIX_2
	@rm -rf $(BDW_WORKLIB)/jobs/hls.hl5.RADIX_2
	@rm -rf $(BDW_WORKLIB)/jobs/hls.hl5.RADIX_2.s

kill_hls_hl5_RADIX_2:
	@bdw_kill -job hls.hl5.RADIX_2
	@bdw_kill -job hls.hl5.RADIX_2.s


hls_hl5_RADIX_2_% : hlsc_hl5_RADIX_2_%

cynth_hl5_RADIX_2_% : hlsc_hl5_RADIX_2_%

elab_hl5_RADIX_2_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(subst /RADIX_2/,/RADIX_2_$(*F)/,$(BDW_WORKLIB)/modules/hl5/RADIX_2/stratus_hls.bdr)

optim_hl5_RADIX_2_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(subst /RADIX_2/,/RADIX_2_$(*F)/,$(BDW_WORKLIB)/modules/hl5/RADIX_2/stratus_hls.bdr)

sched_hl5_RADIX_2_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(subst /RADIX_2/,/RADIX_2_$(*F)/,$(BDW_WORKLIB)/modules/hl5/RADIX_2/stratus_hls.bdr)

hlsc_hl5_RADIX_2_% hls_hl5_RADIX_2_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /RADIX_2/,/RADIX_2_$(*F)/,$(BDW_WORKLIB)/modules/hl5/RADIX_2/hl5_rtl.cpp) BDW_DEP_CYNTH_CONFIG=RADIX_2 BDW_MODULE=hl5 BDW_HLS_CONFIG=RADIX_2_$(*F) 
else
	@bdw_exec -jobproject project.tcl -job hls.hl5.RADIX_2_$(*F) $(MAKE) CWBExec_hls=1 hlsc_hl5_RADIX_2_$(*F)
endif

clean_cynth_hl5_RADIX_2_%: clean_hls_hl5_RADIX_2_%

clean_hl5_RADIX_2_%: clean_hls_hl5_RADIX_2_%

clean_hls_hl5_RADIX_2_%:
	@rm -rf $(BDW_WORKLIB)/modules/hl5/RADIX_2_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.hl5.RADIX_2_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.hl5.RADIX_2_$(*F).s

kill_hls_hl5_RADIX_2_%:
	@bdw_kill -job hls.hl5.RADIX_2_$(*F)
	@bdw_kill -job hls.hl5.RADIX_2_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),RADIX_2)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/hl5/RADIX_2/hl5.d
                -include $(memlib_WORKLIB)/memlib.d
                BDW_LIB_DEPS =  $(memlib_DEPS)
            endif
        endif
    endif
endif


html_hl5_RADIX_2 :
	bdw_htmlgen -project project.tcl -module hl5 -cynthconfig RADIX_2

BDW_hl5_RADIX_2_HLS_TARGETS := $(BDW_WORKLIB)/modules/hl5/RADIX_2/hl5_rtl.cpp $(BDW_WORKLIB)/modules/hl5/RADIX_2/hl5_rtl.v $(BDW_WORKLIB)/modules/hl5/RADIX_2/stratus_hls.bdr
ifeq ($(BDW_BDR_ONLY),1)
.PHONY: $(filter %.bdr %.cpp,$(BDW_hl5_RADIX_2_HLS_TARGETS))
$(filter %.v %.cpp,$(BDW_hl5_RADIX_2_HLS_TARGETS)) : $(filter %.bdr,$(BDW_hl5_RADIX_2_HLS_TARGETS))
BDW_hl5_RADIX_2_HLS_TARGETS := $(filter %.bdr,$(BDW_hl5_RADIX_2_HLS_TARGETS))
endif
BDW_hl5_RADIX_2_HLS_SPEC_TARGETS = $(subst /RADIX_2/,/RADIX_2_%/,$(BDW_hl5_RADIX_2_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_hl5_RADIX_2_HLS_TARGETS) :  ../src/hl5.cpp  $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/memwb_wrap.h  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/hl5/RADIX_2 ]; then mkdir -p $(BDW_WORKLIB)/modules/hl5/RADIX_2; fi
	
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=RADIX_2 BDW_CYNTH_CONFIG=RADIX_2 \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/hl5/RADIX_2/hl5_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/hl5/RADIX_2/hl5_rtl.cpp \
		BDW_MODULE=hl5 \
		BDW_CYNTH_CONFIG=RADIX_2 \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/hl5/RADIX_2 \
		BDW_HLS_CONFIG=RADIX_2 \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/hl5/RADIX_2 \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_hl5_RADIX_2)  \
		-d $(BDW_WORKLIB)/modules/hl5/RADIX_2 -o hl5_rtl.cpp \
		--hls_module=hl5 --hls_config=RADIX_2 --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_hl5_RADIX_2))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_hl5_RADIX_2))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_hl5_RADIX_2))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_hl5_RADIX_2)   \
		 ../src/hl5.cpp
	
	
	
	

else

$(BDW_hl5_RADIX_2_HLS_TARGETS) :  ../src/hl5.cpp  $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.hl5.RADIX_2.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_hl5_RADIX_2_HLS_TARGETS)

endif

	
$(BDW_WORKLIB)/modules/hl5/RADIX_2/hl5_trace.h : $(BDW_WORKLIB)/modules/hl5/RADIX_2/hl5_trace.h.updated

$(BDW_WORKLIB)/modules/hl5/RADIX_2/hl5_trace.h.updated : $(BDW_WORKLIB)/modules/hl5/RADIX_2/hl5_rtl.cpp $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module hl5 -cynthconfig RADIX_2  
	@touch $(BDW_WORKLIB)/modules/hl5/RADIX_2/hl5_trace.h.updated

ifeq ($(CWBExec_hlsc),1)

$(BDW_hl5_RADIX_2_HLS_SPEC_TARGETS) :  ../src/hl5.cpp  $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/memwb_wrap.h  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/hl5/RADIX_2_$(*F) ]; then mkdir -p $(BDW_WORKLIB)/modules/hl5/RADIX_2_$(*F); fi
	
	
	$(subst /RADIX_2 ,/RADIX_2_$(*F) ,$(subst =RADIX_2 ,=RADIX_2_$(*F) ,$(subst /hl5/RADIX_2/,/hl5/RADIX_2_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=RADIX_2 BDW_CYNTH_CONFIG=RADIX_2 \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/hl5/RADIX_2/hl5_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/hl5/RADIX_2/hl5_rtl.cpp \
		BDW_MODULE=hl5 \
		BDW_CYNTH_CONFIG=RADIX_2 \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/hl5/RADIX_2 \
		BDW_HLS_CONFIG=RADIX_2 \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/hl5/RADIX_2 \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_hl5_RADIX_2)  \
		`cat  $(BDW_SPECLIB)/hl5/RADIX_2.$(*F).bds | grep '^cmdline:' | sed 's/^cmdline://'`\
		-d $(BDW_WORKLIB)/modules/hl5/RADIX_2 -o hl5_rtl.cpp \
		--hls_module=hl5 --hls_config=RADIX_2 --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_hl5_RADIX_2))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_hl5_RADIX_2))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_hl5_RADIX_2))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_hl5_RADIX_2)   \
		 ../src/hl5.cpp)))
	
	
	
	

else

$(BDW_hl5_RADIX_2_HLS_SPEC_TARGETS) :  ../src/hl5.cpp  $(BDW_WORKLIB)/wrappers/fedec_wrap.h $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/memwb_wrap.h $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.hl5.RADIX_2_$(*F).s $(MAKE) -j1 CWBExec_hlsc=1 $(subst %,$(*F),$(BDW_hl5_RADIX_2_HLS_SPEC_TARGETS))

endif

	

$(subst /RADIX_2/,/RADIX_2_%/,$(BDW_WORKLIB)/modules/hl5/RADIX_2/hl5_trace.h) : $(subst /RADIX_2/,/RADIX_2_%/,$(BDW_WORKLIB)/modules/hl5/RADIX_2/hl5_rtl.cpp) $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module hl5 -cynthconfig RADIX_2_$(*F)  

catHLLog_hl5_RADIX_2:
	cat $(BDW_WORKLIB)/modules/hl5/RADIX_2/stratus_hls.log

#
#	stratus_vlg rule
#
cynthvlg_hl5_RADIX_2 : hls_hl5_RADIX_2 


.PHONY: hls_hl5_RADIX_2

hls_hl5_RADIX_2 hlsv_hl5_RADIX_2: $(addprefix prep_vlog_,$(LIB_NAMES_FOR_VLOG_hl5_RADIX_2)) 

.PHONY: hls_hl5_RADIX_2

hls_hl5_RADIX_2_% hlsv_hl5_RADIX_2_%: $(addprefix prep_vlog_,$(LIB_NAMES_FOR_VLOG_hl5_RADIX_2)) 

catVLGLog_hl5_RADIX_2 : catHLLog_hl5_RADIX_2
	cat $(BDW_WORKLIB)/modules/hl5/RADIX_2/stratus_vlg.log

#
#	view rule
#

view_hl5_RADIX_2:
	@echo "ERROR: Schematic viewing target 'view_hl5_RADIX_2' is only supported with 'verdi'"
	@echo "The Stratus IDE includes a schematic view as an alternative."


#
#	RTL object file rule
#
$(BDW_WORKLIB)/modules/hl5/RADIX_2/xcelium/hl5_rtl.o : $(BDW_WORKLIB)/modules/hl5/RADIX_2/hl5_rtl.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(BDW_WORKLIB)/modules/hl5/RADIX_2/hl5_trace.h
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl hl5`
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/RADIX_2/ -I./ $(CCFLAGS_hl5_RADIX_2) $(EXTRACT_LIB_DASHI_hl5_RADIX_2) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/hl5/RADIX_2/xcelium/hl5_rtl.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp

$(BDW_WORKLIB)/modules/hl5/RADIX_2/xcelium/debug/hl5_rtl.o : $(BDW_WORKLIB)/modules/hl5/RADIX_2/hl5_rtl.cpp $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp $(BDW_WORKLIB)/wrappers/hl5_cosim.h $(BDW_WORKLIB)/modules/hl5/RADIX_2/hl5_trace.h
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl hl5`
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/hl5/RADIX_2/ -I./ $(CCFLAGS_hl5_RADIX_2) $(EXTRACT_LIB_DASHI_hl5_RADIX_2) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/hl5/RADIX_2/xcelium/debug/hl5_rtl.o " $(BDW_WORKLIB)/wrappers/hl5_wrap.cpp

#
#	Behavioral object file rule.  Used only for BEH configs that are 
#	associated with HLS config names.
#

