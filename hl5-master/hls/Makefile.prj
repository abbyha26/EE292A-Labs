	@if [ ! -d $(fedec_RADIX_2_WORKLIB) ]; then mkdir -p $(fedec_RADIX_2_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(fedec_RADIX_2_SRCDIR) -o $(fedec_RADIX_2_WORKLIB)/Makefile -module fedec -cynthconfig RADIX_2   

