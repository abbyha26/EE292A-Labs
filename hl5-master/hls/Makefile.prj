	@$(MAKE) siminfo BDW_SIM_CONFIG=DPA_basic_V
	@$(BDW_EXEC_CMD) $(MAKE) $(BDW_PMAKE_FLG) build_sim_image BDW_SIM_CONFIG=DPA_basic_V BDW_GENDEPS=1 BDW_BASE_SIM_CONFIG=DPA_basic_V BDW_SPEC_NAME=

build_only_DPA_basic_V:
	@$(MAKE) siminfo BDW_SIM_CONFIG=DPA_basic_V
