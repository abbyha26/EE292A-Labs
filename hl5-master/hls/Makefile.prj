	@rm -rf $(BDW_WORKLIB)/jobs/hls.fedec.RADIX_4_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.fedec.RADIX_4_$(*F).s

kill_hls_fedec_RADIX_4_%:
