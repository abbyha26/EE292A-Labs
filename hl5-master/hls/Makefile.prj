ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /RADIX_4/,/RADIX_4_$(*F)/,$(BDW_WORKLIB)/modules/fedec/RADIX_4/fedec_rtl.cpp) BDW_DEP_CYNTH_CONFIG=RADIX_4 BDW_MODULE=fedec BDW_HLS_CONFIG=RADIX_4_$(*F) 
