#

view_execute_BASIC_POFF:
	@echo "ERROR: Schematic viewing target 'view_execute_BASIC_POFF' is only supported with 'verdi'"
	@echo "The Stratus IDE includes a schematic view as an alternative."


#
#	RTL object file rule
#
$(BDW_WORKLIB)/modules/execute/BASIC_POFF/xcelium/execute_rtl.o : $(BDW_WORKLIB)/modules/execute/BASIC_POFF/execute_rtl.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.cpp $(BDW_WORKLIB)/wrappers/execute_cosim.h $(BDW_WORKLIB)/modules/execute/BASIC_POFF/execute_trace.h
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/execute_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl execute`
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/execute/BASIC_POFF/ -I./ $(CCFLAGS_execute_BASIC_POFF) $(EXTRACT_LIB_DASHI_execute_BASIC_POFF) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/execute/BASIC_POFF/xcelium/execute_rtl.o " $(BDW_WORKLIB)/wrappers/execute_wrap.cpp

$(BDW_WORKLIB)/modules/execute/BASIC_POFF/xcelium/debug/execute_rtl.o : $(BDW_WORKLIB)/modules/execute/BASIC_POFF/execute_rtl.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.cpp $(BDW_WORKLIB)/wrappers/execute_cosim.h $(BDW_WORKLIB)/modules/execute/BASIC_POFF/execute_trace.h
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/execute_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl execute`
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/execute/BASIC_POFF/ -I./ $(CCFLAGS_execute_BASIC_POFF) $(EXTRACT_LIB_DASHI_execute_BASIC_POFF) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/execute/BASIC_POFF/xcelium/debug/execute_rtl.o " $(BDW_WORKLIB)/wrappers/execute_wrap.cpp

#
#	Behavioral object file rule.  Used only for BEH configs that are 
#	associated with HLS config names.
#

$(BDW_WORKLIB)/modules/execute/BASIC_POFF/xcelium/execute_beh.o :  ../src/execute.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/execute_cosim.h $(BDW_WORKLIB)/wrappers/execute_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/execute/BASIC_POFF/ -I./ $(CCFLAGS_BEH_execute_BASIC_POFF) -o $(BDW_WORKLIB)/modules/execute/BASIC_POFF/xcelium/execute_beh.o " $(BDW_WORKLIB)/wrappers/execute_wrap.cpp

$(BDW_WORKLIB)/modules/execute/BASIC_POFF/xcelium/debug/execute_beh.o :  ../src/execute.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/execute_cosim.h $(BDW_WORKLIB)/wrappers/execute_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/execute/BASIC_POFF/ -I./ $(CCFLAGS_BEH_execute_BASIC_POFF) -o $(BDW_WORKLIB)/modules/execute/BASIC_POFF/xcelium/debug/execute_beh.o " $(BDW_WORKLIB)/wrappers/execute_wrap.cpp

