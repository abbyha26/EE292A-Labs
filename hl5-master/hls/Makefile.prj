##############################################################

execute_PIPE_SOFT1_SRCDIR = $(BDW_WORKLIB)/modules/execute/PIPE_SOFT1
execute_PIPE_SOFT1_BEH_SRCDIR = $(BDW_WORKLIB)/libs/execute_PIPE_SOFT1
execute_PIPE_SOFT1_LIBNAME = execute_PIPE_SOFT1
execute_PIPE_SOFT1_WORKLIB = $(BDW_WORKLIB)/modules/execute/PIPE_SOFT1/xcelium
execute_PIPE_SOFT1_C_PARTS_A = $(execute_PIPE_SOFT1_WORKLIB)/objs/libexecute_PIPE_SOFT1.a

prep_c_execute_PIPE_SOFT1 : $(execute_PIPE_SOFT1_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(execute_PIPE_SOFT1_WORKLIB) prep_c

prep_vlog_execute_PIPE_SOFT1 : $(execute_PIPE_SOFT1_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(execute_PIPE_SOFT1_WORKLIB) prep_vlog

prep_execute_PIPE_SOFT1 : $(execute_PIPE_SOFT1_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(execute_PIPE_SOFT1_WORKLIB) prep

$(execute_PIPE_SOFT1_WORKLIB)/Makefile : $(execute_PIPE_SOFT1_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(execute_PIPE_SOFT1_WORKLIB) ]; then mkdir -p $(execute_PIPE_SOFT1_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(execute_PIPE_SOFT1_SRCDIR) -o $(execute_PIPE_SOFT1_WORKLIB)/Makefile -module execute -cynthconfig PIPE_SOFT1   

$(execute_PIPE_SOFT1_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(execute_PIPE_SOFT1_WORKLIB) ]; then mkdir -p $(execute_PIPE_SOFT1_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



prep_c_execute_PIPE_SOFT1_% : $(subst PIPE_SOFT1,PIPE_SOFT1_%,$(execute_PIPE_SOFT1_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst PIPE_SOFT1,PIPE_SOFT1_$(*F),$(execute_PIPE_SOFT1_WORKLIB)) prep_c

prep_vlog_execute_PIPE_SOFT1_% : $(subst PIPE_SOFT1,PIPE_SOFT1_%,$(execute_PIPE_SOFT1_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst PIPE_SOFT1,PIPE_SOFT1_$(*F),$(execute_PIPE_SOFT1_WORKLIB)) prep_vlog

prep_execute_PIPE_SOFT1_% : $(subst PIPE_SOFT1,PIPE_SOFT1_%,$(execute_PIPE_SOFT1_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst PIPE_SOFT1,PIPE_SOFT1_$(*F),$(execute_PIPE_SOFT1_WORKLIB)) prep

$(subst PIPE_SOFT1,PIPE_SOFT1_%,$(execute_PIPE_SOFT1_WORKLIB))/Makefile : $(execute_PIPE_SOFT1_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(subst PIPE_SOFT1,PIPE_SOFT1_$(*F),$(execute_PIPE_SOFT1_WORKLIB)) ]; then mkdir -p $(subst PIPE_SOFT1,PIPE_SOFT1_$(*F),$(execute_PIPE_SOFT1_WORKLIB)); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(execute_PIPE_SOFT1_SRCDIR)_$(*F) -o $(subst PIPE_SOFT1,PIPE_SOFT1_$(*F),$(execute_PIPE_SOFT1_WORKLIB))/Makefile -module execute -cynthconfig PIPE_SOFT1_$(*F)   

$(execute_PIPE_SOFT1_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(subst PIPE_SOFT1,PIPE_SOFT1_$(*F),$(execute_PIPE_SOFT1_WORKLIB)) ]; then mkdir -p $(subst PIPE_SOFT1,PIPE_SOFT1_$(*F),$(execute_PIPE_SOFT1_WORKLIB)); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(execute_PIPE_SOFT1_WORKLIB)/execute_PIPE_SOFT1.d :
	@if [ ! -d $(execute_PIPE_SOFT1_WORKLIB) ]; then mkdir -p $(execute_PIPE_SOFT1_WORKLIB); fi
	@touch $(execute_PIPE_SOFT1_WORKLIB)/execute_PIPE_SOFT1.d



#
# HLS config PIPE_SOFT2
#

#
#	stratus_hls rule
#
LIB_DIRS_execute_PIPE_SOFT2 = $(memlib_SRCDIR) 
LIB_INCLUDES_execute_PIPE_SOFT2 = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_execute_PIPE_SOFT2))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_execute_PIPE_SOFT2 = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_execute_PIPE_SOFT2 = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_execute_PIPE_SOFT2 = 
EXTRACT_LIB_DASHI_execute_PIPE_SOFT2 = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl execute PIPE_SOFT2]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_execute_PIPE_SOFT2 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/c_parts -DPIPE_SOFT2=1 -DBDW_RTL_execute_PIPE_SOFT2=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DPIPE_SOFT_STALL2=1 $(LIB_INCLUDES_execute_PIPE_SOFT2)
CCFLAGS_COSIM_execute_PIPE_SOFT2 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/c_parts -DPIPE_SOFT2=1 -DBDW_RTL_execute_PIPE_SOFT2=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DPIPE_SOFT_STALL2=1 $(LIB_INCLUDES_execute_PIPE_SOFT2)
CCFLAGS_BEH_execute_PIPE_SOFT2 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/c_parts -DPIPE_SOFT2=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DPIPE_SOFT_STALL2=1 $(LIB_INCLUDES_execute_PIPE_SOFT2)
CCFLAGS_execute_PIPE_SOFT2 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_execute_PIPE_SOFT2 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_execute_PIPE_SOFT2 += ${BDW_CCFLAGS_TAIL}

.PHONY: hlsc_execute_PIPE_SOFT2 hls_execute_PIPE_SOFT2

hls_execute_PIPE_SOFT2 : hlsc_execute_PIPE_SOFT2

cynth_execute_PIPE_SOFT2 : hlsc_execute_PIPE_SOFT2

elab_execute_PIPE_SOFT2 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/stratus_hls.bdr

optim_execute_PIPE_SOFT2 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/stratus_hls.bdr

sched_execute_PIPE_SOFT2 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/stratus_hls.bdr

hlsc_execute_PIPE_SOFT2 : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/execute_rtl.cpp BDW_DEP_CYNTH_CONFIG=PIPE_SOFT2 BDW_MODULE=execute BDW_HLS_CONFIG=PIPE_SOFT2 
else
	@bdw_exec -jobproject project.tcl -job hls.execute.PIPE_SOFT2 $(MAKE) CWBExec_hls=1 hlsc_execute_PIPE_SOFT2
endif

clean_cynth_execute_PIPE_SOFT2: clean_hls_execute_PIPE_SOFT2

clean_execute_PIPE_SOFT2: clean_hls_execute_PIPE_SOFT2

clean_hls_execute_PIPE_SOFT2:
	@rm -rf $(BDW_WORKLIB)/modules/execute/PIPE_SOFT2
	@rm -rf $(BDW_WORKLIB)/jobs/hls.execute.PIPE_SOFT2
	@rm -rf $(BDW_WORKLIB)/jobs/hls.execute.PIPE_SOFT2.s

kill_hls_execute_PIPE_SOFT2:
	@bdw_kill -job hls.execute.PIPE_SOFT2
	@bdw_kill -job hls.execute.PIPE_SOFT2.s


hls_execute_PIPE_SOFT2_% : hlsc_execute_PIPE_SOFT2_%

cynth_execute_PIPE_SOFT2_% : hlsc_execute_PIPE_SOFT2_%

elab_execute_PIPE_SOFT2_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(subst /PIPE_SOFT2/,/PIPE_SOFT2_$(*F)/,$(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/stratus_hls.bdr)

optim_execute_PIPE_SOFT2_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(subst /PIPE_SOFT2/,/PIPE_SOFT2_$(*F)/,$(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/stratus_hls.bdr)

sched_execute_PIPE_SOFT2_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(subst /PIPE_SOFT2/,/PIPE_SOFT2_$(*F)/,$(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/stratus_hls.bdr)

hlsc_execute_PIPE_SOFT2_% hls_execute_PIPE_SOFT2_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /PIPE_SOFT2/,/PIPE_SOFT2_$(*F)/,$(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/execute_rtl.cpp) BDW_DEP_CYNTH_CONFIG=PIPE_SOFT2 BDW_MODULE=execute BDW_HLS_CONFIG=PIPE_SOFT2_$(*F) 
else
	@bdw_exec -jobproject project.tcl -job hls.execute.PIPE_SOFT2_$(*F) $(MAKE) CWBExec_hls=1 hlsc_execute_PIPE_SOFT2_$(*F)
endif

clean_cynth_execute_PIPE_SOFT2_%: clean_hls_execute_PIPE_SOFT2_%

clean_execute_PIPE_SOFT2_%: clean_hls_execute_PIPE_SOFT2_%

clean_hls_execute_PIPE_SOFT2_%:
	@rm -rf $(BDW_WORKLIB)/modules/execute/PIPE_SOFT2_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.execute.PIPE_SOFT2_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.execute.PIPE_SOFT2_$(*F).s

kill_hls_execute_PIPE_SOFT2_%:
	@bdw_kill -job hls.execute.PIPE_SOFT2_$(*F)
	@bdw_kill -job hls.execute.PIPE_SOFT2_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),PIPE_SOFT2)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/execute.d
                -include $(memlib_WORKLIB)/memlib.d
                BDW_LIB_DEPS =  $(memlib_DEPS)
            endif
        endif
    endif
endif


html_execute_PIPE_SOFT2 :
	bdw_htmlgen -project project.tcl -module execute -cynthconfig PIPE_SOFT2

BDW_execute_PIPE_SOFT2_HLS_TARGETS := $(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/execute_rtl.cpp $(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/execute_rtl.v $(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/stratus_hls.bdr
ifeq ($(BDW_BDR_ONLY),1)
.PHONY: $(filter %.bdr %.cpp,$(BDW_execute_PIPE_SOFT2_HLS_TARGETS))
$(filter %.v %.cpp,$(BDW_execute_PIPE_SOFT2_HLS_TARGETS)) : $(filter %.bdr,$(BDW_execute_PIPE_SOFT2_HLS_TARGETS))
BDW_execute_PIPE_SOFT2_HLS_TARGETS := $(filter %.bdr,$(BDW_execute_PIPE_SOFT2_HLS_TARGETS))
endif
BDW_execute_PIPE_SOFT2_HLS_SPEC_TARGETS = $(subst /PIPE_SOFT2/,/PIPE_SOFT2_%/,$(BDW_execute_PIPE_SOFT2_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_execute_PIPE_SOFT2_HLS_TARGETS) :  ../src/execute.cpp   $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/execute/PIPE_SOFT2 ]; then mkdir -p $(BDW_WORKLIB)/modules/execute/PIPE_SOFT2; fi
	
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=PIPE_SOFT2 BDW_CYNTH_CONFIG=PIPE_SOFT2 \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/execute_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/execute_rtl.cpp \
		BDW_MODULE=execute \
		BDW_CYNTH_CONFIG=PIPE_SOFT2 \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/execute/PIPE_SOFT2 \
		BDW_HLS_CONFIG=PIPE_SOFT2 \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/execute/PIPE_SOFT2 \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_execute_PIPE_SOFT2)  \
		-d $(BDW_WORKLIB)/modules/execute/PIPE_SOFT2 -o execute_rtl.cpp \
		--hls_module=execute --hls_config=PIPE_SOFT2 --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_execute_PIPE_SOFT2))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_execute_PIPE_SOFT2))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_execute_PIPE_SOFT2))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_execute_PIPE_SOFT2)   \
		 ../src/execute.cpp
	
	
	
	

else

$(BDW_execute_PIPE_SOFT2_HLS_TARGETS) :  ../src/execute.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.execute.PIPE_SOFT2.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_execute_PIPE_SOFT2_HLS_TARGETS)

endif

	
$(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/execute_trace.h : $(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/execute_trace.h.updated

$(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/execute_trace.h.updated : $(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/execute_rtl.cpp $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module execute -cynthconfig PIPE_SOFT2  
	@touch $(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/execute_trace.h.updated

ifeq ($(CWBExec_hlsc),1)

$(BDW_execute_PIPE_SOFT2_HLS_SPEC_TARGETS) :  ../src/execute.cpp   $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/execute/PIPE_SOFT2_$(*F) ]; then mkdir -p $(BDW_WORKLIB)/modules/execute/PIPE_SOFT2_$(*F); fi
	
	
	$(subst /PIPE_SOFT2 ,/PIPE_SOFT2_$(*F) ,$(subst =PIPE_SOFT2 ,=PIPE_SOFT2_$(*F) ,$(subst /execute/PIPE_SOFT2/,/execute/PIPE_SOFT2_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=PIPE_SOFT2 BDW_CYNTH_CONFIG=PIPE_SOFT2 \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/execute_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/execute_rtl.cpp \
		BDW_MODULE=execute \
		BDW_CYNTH_CONFIG=PIPE_SOFT2 \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/execute/PIPE_SOFT2 \
		BDW_HLS_CONFIG=PIPE_SOFT2 \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/execute/PIPE_SOFT2 \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_execute_PIPE_SOFT2)  \
		`cat  $(BDW_SPECLIB)/execute/PIPE_SOFT2.$(*F).bds | grep '^cmdline:' | sed 's/^cmdline://'`\
		-d $(BDW_WORKLIB)/modules/execute/PIPE_SOFT2 -o execute_rtl.cpp \
		--hls_module=execute --hls_config=PIPE_SOFT2 --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_execute_PIPE_SOFT2))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_execute_PIPE_SOFT2))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_execute_PIPE_SOFT2))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_execute_PIPE_SOFT2)   \
		 ../src/execute.cpp)))
	
	
	
	

else

$(BDW_execute_PIPE_SOFT2_HLS_SPEC_TARGETS) :  ../src/execute.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.execute.PIPE_SOFT2_$(*F).s $(MAKE) -j1 CWBExec_hlsc=1 $(subst %,$(*F),$(BDW_execute_PIPE_SOFT2_HLS_SPEC_TARGETS))

endif

	

$(subst /PIPE_SOFT2/,/PIPE_SOFT2_%/,$(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/execute_trace.h) : $(subst /PIPE_SOFT2/,/PIPE_SOFT2_%/,$(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/execute_rtl.cpp) $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module execute -cynthconfig PIPE_SOFT2_$(*F)  

catHLLog_execute_PIPE_SOFT2:
	cat $(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/stratus_hls.log

#
#	stratus_vlg rule
#
cynthvlg_execute_PIPE_SOFT2 : hls_execute_PIPE_SOFT2 


.PHONY: hls_execute_PIPE_SOFT2

hls_execute_PIPE_SOFT2 hlsv_execute_PIPE_SOFT2: $(addprefix prep_vlog_,$(LIB_NAMES_FOR_VLOG_execute_PIPE_SOFT2)) 

.PHONY: hls_execute_PIPE_SOFT2

hls_execute_PIPE_SOFT2_% hlsv_execute_PIPE_SOFT2_%: $(addprefix prep_vlog_,$(LIB_NAMES_FOR_VLOG_execute_PIPE_SOFT2)) 

catVLGLog_execute_PIPE_SOFT2 : catHLLog_execute_PIPE_SOFT2
	cat $(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/stratus_vlg.log

#
#	view rule
#

view_execute_PIPE_SOFT2:
	@echo "ERROR: Schematic viewing target 'view_execute_PIPE_SOFT2' is only supported with 'verdi'"
	@echo "The Stratus IDE includes a schematic view as an alternative."


#
#	RTL object file rule
#
$(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/xcelium/execute_rtl.o : $(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/execute_rtl.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.cpp $(BDW_WORKLIB)/wrappers/execute_cosim.h $(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/execute_trace.h
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/execute_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl execute`
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/ -I./ $(CCFLAGS_execute_PIPE_SOFT2) $(EXTRACT_LIB_DASHI_execute_PIPE_SOFT2) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/xcelium/execute_rtl.o " $(BDW_WORKLIB)/wrappers/execute_wrap.cpp

$(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/xcelium/debug/execute_rtl.o : $(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/execute_rtl.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.cpp $(BDW_WORKLIB)/wrappers/execute_cosim.h $(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/execute_trace.h
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/execute_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl execute`
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/ -I./ $(CCFLAGS_execute_PIPE_SOFT2) $(EXTRACT_LIB_DASHI_execute_PIPE_SOFT2) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/xcelium/debug/execute_rtl.o " $(BDW_WORKLIB)/wrappers/execute_wrap.cpp

#
#	Behavioral object file rule.  Used only for BEH configs that are 
#	associated with HLS config names.
#

$(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/xcelium/execute_beh.o :  ../src/execute.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/execute_cosim.h $(BDW_WORKLIB)/wrappers/execute_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/ -I./ $(CCFLAGS_BEH_execute_PIPE_SOFT2) -o $(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/xcelium/execute_beh.o " $(BDW_WORKLIB)/wrappers/execute_wrap.cpp

$(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/xcelium/debug/execute_beh.o :  ../src/execute.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/execute_cosim.h $(BDW_WORKLIB)/wrappers/execute_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/ -I./ $(CCFLAGS_BEH_execute_PIPE_SOFT2) -o $(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/xcelium/debug/execute_beh.o " $(BDW_WORKLIB)/wrappers/execute_wrap.cpp

#
# Cosim object file rule
#

$(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/xcelium/execute.o :  ../src/execute.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/execute_cosim.h $(BDW_WORKLIB)/wrappers/execute_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/ -I./ $(CCFLAGS_COSIM_execute_PIPE_SOFT2) -o $(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/xcelium/execute.o " $(BDW_WORKLIB)/wrappers/execute_wrap.cpp
    

$(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/xcelium/execute_hoist.o :  ../src/execute.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.cpp $(BDW_WORKLIB)/wrappers/execute_cosim.h $(BDW_WORKLIB)/wrappers/execute_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC) " -I$(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/ -I./ $(CCFLAGS_execute_PIPE_SOFT2) $(EXTRACT_LIB_DASHI_execute_PIPE_SOFT2) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/execute/PIPE_SOFT2/xcelium/execute_hoist.o " $(BDW_WORKLIB)/wrappers/execute_wrap.cpp
    

