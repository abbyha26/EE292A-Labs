ifneq ($(BDW_SPEC_NAME),)
#
#	RTL object file rule
#
$(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/execute/RADIX_2/xcelium/execute_rtl.o) : $(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/execute/RADIX_2/execute_rtl.cpp) $(BDW_WORKLIB)/wrappers/execute_wrap.cpp $(BDW_WORKLIB)/wrappers/execute_cosim.h $(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/execute/RADIX_2/execute_trace.h)
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/execute_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl execute`
	$(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/execute/RADIX_2/ -I./ $(CCFLAGS_execute_RADIX_2) $(EXTRACT_LIB_DASHI_execute_RADIX_2) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/execute/RADIX_2/xcelium/execute_rtl.o " $(BDW_WORKLIB)/wrappers/execute_wrap.cpp)

$(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/execute/RADIX_2/xcelium/debug/execute_rtl.o) : $(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/execute/RADIX_2/execute_rtl.cpp) $(BDW_WORKLIB)/wrappers/execute_wrap.cpp $(BDW_WORKLIB)/wrappers/execute_cosim.h $(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/execute/RADIX_2/execute_trace.h)
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/execute_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl execute`
	$(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/execute/RADIX_2/ -I./ $(CCFLAGS_execute_RADIX_2) $(EXTRACT_LIB_DASHI_execute_RADIX_2) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/execute/RADIX_2/xcelium/debug/execute_rtl.o " $(BDW_WORKLIB)/wrappers/execute_wrap.cpp)

#
#	Behavioral object file rule.  Used only for BEH configs that are 
#	associated with HLS config names.
#

$(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/execute/RADIX_2/xcelium/execute_beh.o) :  ../src/execute.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/execute_cosim.h $(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/execute_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/execute/RADIX_2/ -I./ $(CCFLAGS_BEH_execute_RADIX_2) -o $(BDW_WORKLIB)/modules/execute/RADIX_2/xcelium/execute_beh.o " $(BDW_WORKLIB)/wrappers/execute_wrap.cpp)

$(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/execute/RADIX_2/xcelium/debug/execute_beh.o) :  ../src/execute.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/execute_cosim.h $(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/execute_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/execute/RADIX_2/ -I./ $(CCFLAGS_BEH_execute_RADIX_2) -o $(BDW_WORKLIB)/modules/execute/RADIX_2/xcelium/debug/execute_beh.o " $(BDW_WORKLIB)/wrappers/execute_wrap.cpp)

#
# Cosim object file rule
#

$(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/execute/RADIX_2/xcelium/execute.o) :  ../src/execute.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/execute_cosim.h $(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/execute_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/execute/RADIX_2/ -I./ $(CCFLAGS_COSIM_execute_RADIX_2) -o $(BDW_WORKLIB)/modules/execute/RADIX_2/xcelium/execute.o " $(BDW_WORKLIB)/wrappers/execute_wrap.cpp)
    

$(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/execute/RADIX_2/xcelium/execute_hoist.o) :  ../src/execute.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.cpp $(BDW_WORKLIB)/wrappers/execute_cosim.h $(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/execute_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/execute/RADIX_2/ -I./ $(CCFLAGS_execute_RADIX_2) $(EXTRACT_LIB_DASHI_execute_RADIX_2) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/execute/RADIX_2/xcelium/execute_hoist.o " $(BDW_WORKLIB)/wrappers/execute_wrap.cpp)
    

$(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/execute/RADIX_2/xcelium/debug/execute.o) :  ../src/execute.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.h $(BDW_WORKLIB)/wrappers/execute_cosim.h $(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/execute_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/execute/RADIX_2/ -I./ $(CCFLAGS_COSIM_execute_RADIX_2) -o $(BDW_WORKLIB)/modules/execute/RADIX_2/xcelium/debug/execute.o " $(BDW_WORKLIB)/wrappers/execute_wrap.cpp)


$(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/execute/RADIX_2/xcelium/debug/execute_hoist.o) :  ../src/execute.cpp $(BDW_WORKLIB)/wrappers/execute_wrap.cpp $(BDW_WORKLIB)/wrappers/execute_cosim.h $(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/execute_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /RADIX_2/,/RADIX_2$(BDW_SPEC_SUF)/,$(BDW_CC) " -I$(BDW_WORKLIB)/modules/execute/RADIX_2/ -I./ $(CCFLAGS_execute_RADIX_2) $(EXTRACT_LIB_DASHI_execute_RADIX_2) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/execute/RADIX_2/xcelium/debug/execute_hoist.o " $(BDW_WORKLIB)/wrappers/execute_wrap.cpp)
    
endif

#
#	Dependency generation rule
#
$(BDW_WORKLIB)/modules/execute/RADIX_2/execute.d :  ../src/execute.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config RADIX_2 of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_execute_RADIX_2)  ../src/execute.cpp \
	| sed 's|execute\.o[ :]*|$(BDW_WORKLIB)/modules/execute/RADIX_2/execute_rtl.cpp $(BDW_WORKLIB)/modules/execute/RADIX_2/xcelium/execute_beh.o $(BDW_WORKLIB)/modules/execute/RADIX_2/xcelium/debug/execute_beh.o $(BDW_WORKLIB)/modules/execute/RADIX_2/execute.d : $(memlib_WORKLIB)/memlib.d |' $(BDW_DEP_FILTER)  > $@

#
#	Library post-proc rules
#



##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/execute/RADIX_2"
##############################################################

execute_RADIX_2_SRCDIR = $(BDW_WORKLIB)/modules/execute/RADIX_2
execute_RADIX_2_BEH_SRCDIR = $(BDW_WORKLIB)/libs/execute_RADIX_2
execute_RADIX_2_LIBNAME = execute_RADIX_2
execute_RADIX_2_WORKLIB = $(BDW_WORKLIB)/modules/execute/RADIX_2/xcelium
execute_RADIX_2_C_PARTS_A = $(execute_RADIX_2_WORKLIB)/objs/libexecute_RADIX_2.a

prep_c_execute_RADIX_2 : $(execute_RADIX_2_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(execute_RADIX_2_WORKLIB) prep_c

prep_vlog_execute_RADIX_2 : $(execute_RADIX_2_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(execute_RADIX_2_WORKLIB) prep_vlog

prep_execute_RADIX_2 : $(execute_RADIX_2_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(execute_RADIX_2_WORKLIB) prep

$(execute_RADIX_2_WORKLIB)/Makefile : $(execute_RADIX_2_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(execute_RADIX_2_WORKLIB) ]; then mkdir -p $(execute_RADIX_2_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(execute_RADIX_2_SRCDIR) -o $(execute_RADIX_2_WORKLIB)/Makefile -module execute -cynthconfig RADIX_2   

$(execute_RADIX_2_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(execute_RADIX_2_WORKLIB) ]; then mkdir -p $(execute_RADIX_2_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



prep_c_execute_RADIX_2_% : $(subst RADIX_2,RADIX_2_%,$(execute_RADIX_2_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst RADIX_2,RADIX_2_$(*F),$(execute_RADIX_2_WORKLIB)) prep_c

prep_vlog_execute_RADIX_2_% : $(subst RADIX_2,RADIX_2_%,$(execute_RADIX_2_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst RADIX_2,RADIX_2_$(*F),$(execute_RADIX_2_WORKLIB)) prep_vlog

prep_execute_RADIX_2_% : $(subst RADIX_2,RADIX_2_%,$(execute_RADIX_2_WORKLIB))/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(subst RADIX_2,RADIX_2_$(*F),$(execute_RADIX_2_WORKLIB)) prep

$(subst RADIX_2,RADIX_2_%,$(execute_RADIX_2_WORKLIB))/Makefile : $(execute_RADIX_2_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(subst RADIX_2,RADIX_2_$(*F),$(execute_RADIX_2_WORKLIB)) ]; then mkdir -p $(subst RADIX_2,RADIX_2_$(*F),$(execute_RADIX_2_WORKLIB)); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim xcelium -lib $(execute_RADIX_2_SRCDIR)_$(*F) -o $(subst RADIX_2,RADIX_2_$(*F),$(execute_RADIX_2_WORKLIB))/Makefile -module execute -cynthconfig RADIX_2_$(*F)   

$(execute_RADIX_2_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(subst RADIX_2,RADIX_2_$(*F),$(execute_RADIX_2_WORKLIB)) ]; then mkdir -p $(subst RADIX_2,RADIX_2_$(*F),$(execute_RADIX_2_WORKLIB)); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(execute_RADIX_2_WORKLIB)/execute_RADIX_2.d :
	@if [ ! -d $(execute_RADIX_2_WORKLIB) ]; then mkdir -p $(execute_RADIX_2_WORKLIB); fi
	@touch $(execute_RADIX_2_WORKLIB)/execute_RADIX_2.d



#
# HLS config RADIX_4
#

#
#	stratus_hls rule
#
LIB_DIRS_execute_RADIX_4 = $(memlib_SRCDIR) 
LIB_INCLUDES_execute_RADIX_4 = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_execute_RADIX_4))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_execute_RADIX_4 = $(memlib_LIBNAME) 
LIB_NAMES_FOR_VLOG_execute_RADIX_4 = $(memlib_LIBNAME) 
PREFIXED_LIB_NAMES_execute_RADIX_4 = 
EXTRACT_LIB_DASHI_execute_RADIX_4 = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl execute RADIX_4]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_execute_RADIX_4 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/execute/RADIX_4/c_parts -DRADIX_4=1 -DBDW_RTL_execute_RADIX_4=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DDIV_RADIX_4 $(LIB_INCLUDES_execute_RADIX_4)
CCFLAGS_COSIM_execute_RADIX_4 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/execute/RADIX_4/c_parts -DRADIX_4=1 -DBDW_RTL_execute_RADIX_4=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DDIV_RADIX_4 $(LIB_INCLUDES_execute_RADIX_4)
CCFLAGS_BEH_execute_RADIX_4 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/execute/RADIX_4/c_parts -DRADIX_4=1 -DioConfig_PIN -D_p_ioConfig_PIN -DioConfig=PIN -D_wrap_ioConfig=PIN  -DDIV_RADIX_4 $(LIB_INCLUDES_execute_RADIX_4)
CCFLAGS_execute_RADIX_4 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_execute_RADIX_4 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_execute_RADIX_4 += ${BDW_CCFLAGS_TAIL}

.PHONY: hlsc_execute_RADIX_4 hls_execute_RADIX_4

hls_execute_RADIX_4 : hlsc_execute_RADIX_4

cynth_execute_RADIX_4 : hlsc_execute_RADIX_4

elab_execute_RADIX_4 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/execute/RADIX_4/stratus_hls.bdr

optim_execute_RADIX_4 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/execute/RADIX_4/stratus_hls.bdr

sched_execute_RADIX_4 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" BDW_BDR_ONLY=1 $(MAKE) $(BDW_WORKLIB)/modules/execute/RADIX_4/stratus_hls.bdr

hlsc_execute_RADIX_4 : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/execute/RADIX_4/execute_rtl.cpp BDW_DEP_CYNTH_CONFIG=RADIX_4 BDW_MODULE=execute BDW_HLS_CONFIG=RADIX_4 
else
	@bdw_exec -jobproject project.tcl -job hls.execute.RADIX_4 $(MAKE) CWBExec_hls=1 hlsc_execute_RADIX_4
endif

clean_cynth_execute_RADIX_4: clean_hls_execute_RADIX_4

clean_execute_RADIX_4: clean_hls_execute_RADIX_4

clean_hls_execute_RADIX_4:
	@rm -rf $(BDW_WORKLIB)/modules/execute/RADIX_4
	@rm -rf $(BDW_WORKLIB)/jobs/hls.execute.RADIX_4
	@rm -rf $(BDW_WORKLIB)/jobs/hls.execute.RADIX_4.s

kill_hls_execute_RADIX_4:
	@bdw_kill -job hls.execute.RADIX_4
	@bdw_kill -job hls.execute.RADIX_4.s


hls_execute_RADIX_4_% : hlsc_execute_RADIX_4_%

cynth_execute_RADIX_4_% : hlsc_execute_RADIX_4_%

elab_execute_RADIX_4_% : 
